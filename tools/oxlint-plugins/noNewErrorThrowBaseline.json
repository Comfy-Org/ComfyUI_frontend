  "src/stores/userStore.ts": {
    "new Error ( data . error ?? 'Error creating user: ' + resp . status + ' ' + resp . statusText )": 1
  },
  "src/stores/workspace/colorPaletteStore.ts": {
    "new Error ( `Palette with id ${ id } does not exist` )": 1,
    "new Error ( `Palette with id ${ palette . id } already exists` )": 1
  },
  "src/types/widgetId.ts": {
    "new Error ( 'Invalid widget id' )": 1
  },
  "src/utils/litegraphUtil.ts": {
    "new Error ( 'Infinite loop detected' )": 1
  },
  "src/utils/migration/migrateReroute.ts": {
    "new Error ( 'No reroute nodes found' )": 1
  }
}
