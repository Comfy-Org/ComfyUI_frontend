{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["./comfy.ts"],
  "overrides": [
    {
      "files": ["**/*.spec.ts"],
      "excludeFiles": [
        "**/browser_tests/tests/**/*.spec.ts",
        "**/apps/*/e2e/**/*.spec.ts"
      ],
      "rules": {
        "comfy/no-misplaced-spec-files": "error"
      }
    },
    {
      "files": ["**/apps/*/src/**/*.{ts,tsx,vue}"],
      "excludeFiles": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "comfy/no-unsafe-error-assertion": "error"
      }
    },
    {
      "files": [
        "**/apps/**/*.test.{ts,tsx}",
        "**/packages/**/*.test.{ts,tsx}",
        "**/scripts/**/*.test.{ts,tsx}",
        "**/src/extensions/core/**/*.test.{ts,tsx}",
        "**/src/scripts/**/*.test.{ts,tsx}",
        "**/tools/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "comfy/no-module-scope-vitest-mocks": "warn",
        "comfy/no-redundant-vitest-cleanup": "warn"
      }
    }
  ]
}
