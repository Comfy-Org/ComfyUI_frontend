{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["./comfy.ts"],
  "overrides": [
    {
      "files": [
        "**/*.{test,spec}.{ts,tsx}",
        "**/{__test__,__tests__,__fixtures__}/**/*.{ts,tsx}"
      ],
      "rules": {
        "comfy/use-global-pinia": "error"
      }
    },
    {
      "files": [
        "**/apps/**/*.test.{ts,tsx}",
        "**/packages/**/*.test.{ts,tsx}",
        "**/scripts/**/*.test.{ts,tsx}",
        "**/src/extensions/core/**/*.test.{ts,tsx}",
        "**/src/scripts/**/*.test.{ts,tsx}",
        "**/tools/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "comfy/no-module-scope-vitest-mocks": "error",
        "comfy/no-persistent-litegraph-registration": "error",
        "comfy/no-redundant-litegraph-cleanup": "error",
        "comfy/no-redundant-vitest-cleanup": "error"
      }
    },
    {
      "files": [
        "**/apps/**/*.test.{ts,tsx}",
        "**/packages/object-info-parser/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "comfy/no-persistent-litegraph-registration": "off",
        "comfy/no-redundant-litegraph-cleanup": "off"
      }
    }
  ]
}
