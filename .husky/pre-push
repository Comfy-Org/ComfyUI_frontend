#!/usr/bin/env bash

set -e

# Skip in CI: the canonical checks run in CI on every PR, and bot workflows
# (e.g. i18n-update-core) populate ComfyUI/ via setup-comfyui-server, which
# contaminates static-analysis project globs with the devtools copy under
# custom_nodes and produces false-positive failures.
if [ -n "${CI-}" ]; then
  exit 0
fi

pnpm knip 1>&2
git fetch --quiet --no-tags origin main
base="$(git merge-base HEAD FETCH_HEAD)"
diff_file="$(mktemp)"
trap 'rm -f "$diff_file"' 0
git diff --unified=0 --relative "$base"...HEAD -- > "$diff_file"
pnpm fallow:audit --changed-since "$base" --diff-file "$diff_file" 1>&2

if git diff --name-only "$base" HEAD | grep -q '^packages/code-quality/'; then
  pnpm --filter @comfyorg/code-quality check
  pnpm --filter @comfyorg/code-quality smoke:pack npm
  pnpm --filter @comfyorg/code-quality smoke:pack pnpm
fi
