#!/usr/bin/env bash

set -e

# Skip in CI: the canonical checks run in CI on every PR, and bot workflows
# (e.g. i18n-update-core) populate ComfyUI/ via setup-comfyui-server, which
# contaminates static-analysis project globs with the devtools copy under
# custom_nodes and produces false-positive failures.
if [ -n "${CI-}" ]; then
  exit 0
fi

pnpm knip 1>&2
base_branch="${FALLOW_AUDIT_BASE_BRANCH:-$(gh pr view --json baseRefName --jq .baseRefName 2>/dev/null || echo main)}"
git fetch origin "$base_branch" 1>&2
pnpm fallow:audit --changed-since "$(git rev-parse "origin/$base_branch")" 1>&2
