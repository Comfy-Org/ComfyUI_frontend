{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Script files configuration */
    "noEmit": true,
    "incremental": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["**/*.ts", "../src/types/**/*.d.ts", "../global.d.ts"]
}
