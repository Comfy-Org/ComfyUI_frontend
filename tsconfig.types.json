{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "incremental": false,
    "noEmit": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/utils/formatUtil": [
        "./packages/shared-frontend-utils/dist-types/formatUtil.d.ts"
      ],
      "@/utils/networkUtil": [
        "./packages/shared-frontend-utils/dist-types/networkUtil.d.ts"
      ],
      "@/utils/urlSafety": [
        "./packages/shared-frontend-utils/dist-types/urlSafety.d.ts"
      ],
      "@/base/credits/comfyCredits": [
        "./packages/shared-frontend-utils/dist-types/creditsUtil.d.ts"
      ],
      "@comfyorg/graph-model/*": ["./packages/graph-model/src/*"]
    }
  },
  "include": ["src/**/*.ts", "packages/graph-model/src/**/*.ts", "global.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.vue",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
