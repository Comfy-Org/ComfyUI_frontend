{
  "$schema": "https://raw.githubusercontent.com/sverweij/dependency-cruiser/v18.5.0/src/schema/configuration.schema.json",
  "forbidden": [
    {
      "name": "no-circular",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "queue-package-does-not-import-application",
      "severity": "error",
      "from": { "path": "^packages/api-client/src/(jobs|results)/" },
      "to": { "path": "^src/" }
    },
    {
      "name": "queue-consumers-use-public-entry-points",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "^src/platform/queue/" },
      "to": {
        "path": "^src/platform/queue/",
        "pathNot": [
          "^src/platform/queue/stores/(queueStore|queueSettingsStore|jobModelDownloadStore)\\.ts$",
          "^src/platform/queue/components/(QueueControls|QueueInlineProgress|QueueInlineProgressSummary|QueueNotificationBannerHost|QueueProgressOverlay)\\.vue$",
          "^src/platform/queue/components/run/ComfyQueueButton\\.vue$",
          "^src/platform/queue/composables/useQueueFeatureFlags\\.ts$",
          "^src/platform/queue/presentation/queueDisplay\\.ts$",
          "^src/platform/queue/runtime/(autoQueueService|legacyAutoQueue|useQueuePolling|useReconnectQueueRefresh)\\.ts$",
          "^src/platform/queue/legacy/(ComfyList|types)\\.ts$",
          "^src/platform/queue/commands/useQueueCommands\\.ts$",
          "^src/platform/queue/settings/queueSettings\\.ts$",
          "^src/platform/queue/sidebar/useJobHistorySidebarTab\\.ts$",
          "^src/platform/queue/services/jobOutputCache\\.ts$",
          "^src/platform/queue/submission/queueSubmission\\.ts$"
        ]
      }
    },
    {
      "name": "agent-feedback-through-platform-support",
      "severity": "error",
      "from": { "path": "^src/workbench/extensions/agent/" },
      "to": { "path": "^src/platform/surveys/openTypeformDialog\\.ts$" }
    },
    {
      "name": "workspace-does-not-own-billing-or-account-ui",
      "severity": "error",
      "from": { "path": "^src/platform/workspace/" },
      "to": { "path": "^src/platform/(billing|account)/" }
    },
    {
      "name": "billing-uses-workspace-ports",
      "severity": "error",
      "from": { "path": "^src/platform/billing/" },
      "to": { "path": "^src/platform/workspace/(api|stores|composables)/" }
    },
    {
      "name": "billing-does-not-own-account-ui",
      "severity": "error",
      "from": { "path": "^src/platform/billing/" },
      "to": { "path": "^src/platform/account/" }
    },
    {
      "name": "shared-ingest-is-domain-independent",
      "severity": "error",
      "from": { "path": "^src/platform/remote/ingest/" },
      "to": { "path": "^src/platform/(workspace|billing|account)/" }
    }
  ],
  "options": {
    "tsConfig": { "fileName": "tsconfig.json" },
    "tsPreCompilationDeps": "specify",
    "doNotFollow": { "path": "node_modules" },
    "exclude": {
      "path": ["\\.(test|spec|stories)\\.ts$", "/__tests?__/", "/test/"]
    },
    "enhancedResolveOptions": {
      "extensions": [".ts", ".mts", ".js", ".vue", ".json"],
      "mainFields": ["module", "main", "types"]
    }
  }
}
