{
  "$schema": "https://raw.githubusercontent.com/sverweij/dependency-cruiser/v18.5.0/src/schema/configuration.schema.json",
  "forbidden": [
    {
      "name": "no-circular",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "assets-core-is-independent-of-application-runtime",
      "severity": "error",
      "from": { "path": "^packages/assets-core/src/" },
      "to": {
        "path": "^(src/|packages/(api-client|account-core|account-ui|graph-model)/|node_modules/(vue|pinia|@vueuse)/|node_modules/\\.pnpm/[^/]+/node_modules/(vue|pinia|@vueuse)/)"
      }
    },
    {
      "name": "agent-feedback-through-platform-support",
      "severity": "error",
      "from": { "path": "^src/workbench/extensions/agent/" },
      "to": { "path": "^src/platform/surveys/openTypeformDialog\\.ts$" }
    },
    {
      "name": "workspace-does-not-own-billing-or-account-ui",
      "severity": "error",
      "from": { "path": "^src/platform/workspace/" },
      "to": { "path": "^src/platform/(billing|account)/" }
    },
    {
      "name": "billing-uses-workspace-ports",
      "severity": "error",
      "from": { "path": "^src/platform/billing/" },
      "to": { "path": "^src/platform/workspace/(api|stores|composables)/" }
    },
    {
      "name": "billing-does-not-own-account-ui",
      "severity": "error",
      "from": { "path": "^src/platform/billing/" },
      "to": { "path": "^src/platform/account/" }
    },
    {
      "name": "shared-ingest-is-domain-independent",
      "severity": "error",
      "from": { "path": "^src/platform/remote/ingest/" },
      "to": { "path": "^src/platform/(workspace|billing|account)/" }
    },
    {
      "name": "node-api-host-entry",
      "comment": "The host reaches the node API at run time only through its dispatcher over every version and the always-enabled extension name (ADR-EXTENSIONS-NODE-API-0070 decision 7, ADR-EXTENSIONS-NODE-API-0071 Consequences).",
      "severity": "error",
      "from": { "pathNot": "^src/platform/nodeApi/" },
      "to": {
        "path": "^src/platform/nodeApi/",
        "pathNot": "^src/platform/nodeApi/(nodeApiHost|shared/canvasSource|v4/defs/nodeTypeHooksName|v4/types)\\.ts$"
      }
    },
    {
      "name": "node-api-host-types-only",
      "comment": "The host reads the published types and the canvas seam, and does not import them at run time.",
      "severity": "error",
      "from": { "pathNot": "^src/platform/nodeApi/" },
      "to": {
        "path": "^src/platform/nodeApi/(v4/types|shared/canvasSource)\\.ts$",
        "dependencyTypesNot": ["type-only"]
      }
    },
    {
      "name": "node-api-store-is-host-only",
      "comment": "Only the host dispatcher reaches a version's store (ADR-EXTENSIONS-NODE-API-0070 decision 7).",
      "severity": "error",
      "from": {
        "path": "^src/platform/nodeApi/",
        "pathNot": "^src/platform/nodeApi/nodeApiHost\\.ts$"
      },
      "to": { "path": "^src/platform/nodeApi/v[0-9]+/comfyApiStore\\.ts$" }
    },
    {
      "name": "node-api-shared-is-version-free",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/shared/" },
      "to": { "path": "^src/platform/nodeApi/v[0-9]+/" }
    },
    {
      "name": "node-api-only-the-root-composes",
      "comment": "Only comfyApi.ts imports the feature folders; the other root files are the read layer every feature uses.",
      "severity": "error",
      "from": {
        "path": "^src/platform/nodeApi/v4/[^/]+\\.ts$",
        "pathNot": "^src/platform/nodeApi/v4/(comfyApi|comfyApiStore)\\.ts$"
      },
      "to": { "path": "^src/platform/nodeApi/v4/[^/]+/" }
    },
    {
      "name": "node-api-edit-layer",
      "comment": "Features import downward only: edit, widgets, defs, execution; events sit over edit.",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/edit/" },
      "to": {
        "path": "^src/platform/nodeApi/v4/(widgets|defs|events|execution|utilities)/"
      }
    },
    {
      "name": "node-api-widgets-layer",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/widgets/" },
      "to": {
        "path": "^src/platform/nodeApi/v4/(defs|events|execution|utilities)/"
      }
    },
    {
      "name": "node-api-defs-layer",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/defs/" },
      "to": { "path": "^src/platform/nodeApi/v4/(events|execution|utilities)/" }
    },
    {
      "name": "node-api-execution-layer",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/execution/" },
      "to": { "path": "^src/platform/nodeApi/v4/(events|utilities)/" }
    },
    {
      "name": "node-api-events-layer",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/events/" },
      "to": {
        "path": "^src/platform/nodeApi/v4/(widgets|defs|execution|utilities)/"
      }
    },
    {
      "name": "node-api-utilities-layer",
      "comment": "The platform services stand beside the graph features and import none of them.",
      "severity": "error",
      "from": { "path": "^src/platform/nodeApi/v4/utilities/" },
      "to": {
        "path": "^src/platform/nodeApi/v4/(edit|widgets|defs|events|execution)/"
      }
    }
  ],
  "options": {
    "tsConfig": { "fileName": "tsconfig.json" },
    "tsPreCompilationDeps": "specify",
    "doNotFollow": { "path": "node_modules" },
    "exclude": {
      "path": [
        "\\.(test|spec|stories)\\.ts$",
        "/__tests?__/",
        "/test/",
        "^src/__ecs_matrix__/"
      ]
    },
    "enhancedResolveOptions": {
      "extensions": [".ts", ".mts", ".js", ".vue", ".json"],
      "mainFields": ["module", "main", "types"]
    }
  }
}
