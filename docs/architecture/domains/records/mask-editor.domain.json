{
  "id": "mask-editor",
  "capability": "Mask editor",
  "description": "Reusable mask editing engine, image processing and presentation, with application adapters for nodes, storage, transport, dialogs and extension registration.",
  "modules": [
    {
      "path": "src/renderer/extensions/maskEditor/**"
    },
    {
      "path": "packages/mask-editor/src/**"
    }
  ],
  "publicEntryPoints": [
    "src/renderer/extensions/maskEditor/extension.ts",
    "src/renderer/extensions/maskEditor/composables/useMaskEditor.ts",
    "packages/mask-editor/src/brushUtils.ts",
    "packages/mask-editor/src/maskEditorStore.ts",
    "packages/mask-editor/src/StrokeProcessor.ts",
    "packages/mask-editor/src/types.ts",
    "packages/mask-editor/src/imageOutput.ts",
    "packages/mask-editor/src/useCanvasTransform.ts",
    "packages/mask-editor/src/ui/EditorCanvas.vue",
    "packages/mask-editor/src/ui/EditorToolbar.vue",
    "packages/mask-editor/src/ui/style.css",
    "packages/mask-editor/src/extensionTypes.ts",
    "src/renderer/extensions/maskEditor/stores/maskEditorExtensionStore.ts"
  ],
  "characterizationScenarios": [
    {
      "name": "Drawing operations preserve brush and canvas-history behavior",
      "checks": [
        "packages/mask-editor/src/useBrushDrawing.test.ts",
        "packages/mask-editor/src/useCanvasHistory.test.ts"
      ]
    },
    {
      "name": "Loading and saving preserve image-layer and widget boundaries",
      "checks": [
        "src/renderer/extensions/maskEditor/composables/useMaskEditorLoader.test.ts",
        "src/renderer/extensions/maskEditor/composables/useMaskEditorSaver.test.ts"
      ]
    },
    {
      "name": "Mask PNG encoding round-trips through the decoder fixture",
      "checks": ["packages/mask-editor/src/pngEncodeUtil.test.ts"]
    },
    {
      "name": "Core extensions register the clipspace and mask editor and open the editor from node menus",
      "checks": [
        "src/extensions/core/index.test.ts",
        "src/renderer/extensions/maskEditor/extension.test.ts",
        "src/renderer/extensions/maskEditor/composables/useMaskEditor.test.ts"
      ]
    },
    {
      "name": "The stroke engine and editor store keep their contract for the painter and undo commands",
      "checks": [
        "packages/mask-editor/src/StrokeProcessor.test.ts",
        "packages/mask-editor/src/brushUtils.test.ts",
        "packages/mask-editor/src/maskEditorStore.test.ts"
      ]
    },
    {
      "name": "External tool sessions preserve native history, image pixels, and widget serialization",
      "checks": [
        "src/renderer/extensions/maskEditor/composables/maskEditorToolSession.test.ts",
        "src/renderer/extensions/maskEditor/composables/useMaskEditorExtensionTools.test.ts",
        "src/renderer/extensions/maskEditor/stores/maskEditorExtensionStore.test.ts",
        "browser_tests/tests/maskEditor/mask-editor-extension-tools.spec.ts",
        "browser_tests/tests/maskEditor/mask-editor-extension-drag.spec.ts"
      ]
    }
  ],
  "adrs": [
    "docs/adr/MASKEDITOR-0001-reusable-editor-and-host-ownership.md",
    "docs/adr/MASKEDITOR-EXTENSIONS-0001-session-scoped-external-tools.md"
  ],
  "compatibilityPromises": [
    "The core extension remains the host integration seam for opening the editor.",
    "Image widget values and layer output remain covered by loader and saver characterization tests."
  ],
  "deepImports": "enforced"
}
