{
  "id": "mask-editor",
  "capability": "Mask editor",
  "description": "Mask editing UI, host adapters (loader, saver, image widget, dialog, brush persistence), and the core extension contract. The @comfyorg/mask-editor package holds the stroke, GPU, pan/zoom, canvas-history and tool-manager engine.",
  "modules": [
    {
      "path": "src/extensions/core/clipspace.ts",
      "role": "integration"
    },
    {
      "path": "src/extensions/core/maskeditor.ts",
      "role": "integration"
    },
    {
      "path": "src/renderer/extensions/maskEditor/components/**",
      "role": "presentation"
    },
    {
      "path": "src/renderer/extensions/maskEditor/composables/**",
      "role": "application"
    },
    {
      "path": "src/renderer/extensions/maskEditor/stores/**",
      "role": "application"
    },
    {
      "path": "src/scripts/clipspace.ts",
      "role": "application"
    },
    {
      "path": "src/utils/__fixtures__/**",
      "role": "infrastructure"
    },
    {
      "path": "src/utils/pngEncodeUtil.ts",
      "role": "infrastructure"
    },
    {
      "path": "packages/mask-editor/src/**",
      "role": "application"
    },
    {
      "path": "packages/mask-editor/src/extensionTypes.ts",
      "role": "domain"
    }
  ],
  "publicEntryPoints": [
    "packages/mask-editor/src/extensionTypes.ts",
    "src/renderer/extensions/maskEditor/stores/maskEditorExtensionStore.ts"
  ],
  "allowedDependencies": [],
  "allowedConsumers": ["extension-runtime", "workbench-shell"],
  "characterizationScenarios": [
    {
      "name": "Drawing operations preserve brush and canvas-history behavior",
      "checks": [
        "packages/mask-editor/src/useBrushDrawing.test.ts",
        "packages/mask-editor/src/useCanvasHistory.test.ts"
      ]
    },
    {
      "name": "Loading and saving preserve image-layer and widget boundaries",
      "checks": [
        "src/renderer/extensions/maskEditor/composables/useMaskEditorLoader.test.ts",
        "src/renderer/extensions/maskEditor/composables/useMaskEditorSaver.test.ts"
      ]
    },
    {
      "name": "Mask PNG encoding round-trips through the decoder fixture",
      "checks": ["src/utils/pngEncodeUtil.test.ts"]
    },
    {
      "name": "External tool registration validates descriptors and releases registrations",
      "checks": [
        "src/renderer/extensions/maskEditor/stores/maskEditorExtensionStore.test.ts"
      ]
    }
  ],
  "adrs": [
    "docs/adr/MASKEDITOR-EXTENSIONS-0001-session-scoped-external-tools.md"
  ],
  "compatibilityPromises": [
    "The core extension remains the host integration seam for opening the editor.",
    "Image widget values and layer output remain covered by loader and saver characterization tests."
  ],
  "deepImports": "enforced"
}
