    {
      "name": "Media cache fetches, reuses, and evicts object URLs for lazy images",
      "checks": ["src/services/mediaCacheService.test.ts"]
    },
    {
      "name": "Curve, range, and palette swatch editors keep value shapes, drag behaviour, and histogram paths",
      "checks": [
        "src/composables/useCurveEditor.test.ts",
        "src/composables/useRangeEditor.test.ts",
