  "characterizationScenarios": [
    {
      "name": "Bootstrap loads i18n, waits for cloud auth with a bounded retry, and loads settings and workflows once",
      "checks": ["src/stores/bootstrapStore.test.ts"]
    },
    {
      "name": "Root app component and graph view wire reconnect handling, output refresh, and global providers",
      "checks": ["src/App.test.ts", "src/views/GraphView.test.ts"]
    },
    {
      "name": "i18n setup merges custom node translations, resolves safe translations, and keeps source keys in the English catalog",
      "checks": [
        "src/i18n.test.ts",
        "src/i18n.safeTranslation.test.ts",
        "src/i18n.catalog.test.ts"
      ]
    },
    {
      "name": "Endpoint configuration falls back for servers without override keys and the build publishes only the cloud canonical tag",
      "checks": ["src/config/comfyApi.test.ts", "src/config/viteSeo.test.ts"]
    }
  ],
  "adrs": ["docs/adr/TELEMETRY-STARTUP-0030-production-startup-telemetry.md"],
