    {
      "name": "Run controls, progress, and run errors preserve app-mode execution",
      "checks": [
        "src/renderer/extensions/linearMode/LinearControls.test.ts",
        "src/renderer/extensions/linearMode/LinearRunErrorWarning.test.ts",
        "src/renderer/extensions/linearMode/getExecutionStatusMessage.test.ts",
        "browser_tests/tests/appMode.spec.ts",
        "browser_tests/tests/linearMode.spec.ts"
      ]
    },
    {
      "name": "Output preview and history follow queued and completed jobs",
      "checks": [
        "src/renderer/extensions/linearMode/linearOutputStore.test.ts",
        "src/renderer/extensions/linearMode/useOutputHistory.test.ts",
        "src/renderer/extensions/linearMode/OutputHistory.test.ts",
        "src/renderer/extensions/linearMode/LinearPreview.test.ts",
        "src/renderer/extensions/linearMode/flattenNodeOutput.test.ts",
        "browser_tests/tests/appModeMediaPreview.spec.ts"
      ]
    },
    {
      "name": "Welcome, drop zone, and mobile entry points remain reachable",
      "checks": [
        "src/renderer/extensions/linearMode/LinearWelcome.test.ts",
        "src/renderer/extensions/linearMode/DropZone.test.ts",
        "browser_tests/tests/appModeWelcome.spec.ts",
        "browser_tests/tests/appModeMobileAssets.spec.ts"
      ]
    },
    {
      "name": "App-mode toolbar offers workflow actions and enters the builder only when the graph has nodes",
      "checks": ["src/components/appMode/AppModeToolbar.test.ts"]
    },
    {
      "name": "App-mode store keeps selected inputs and outputs valid across workflow, subgraph, and node changes",
      "checks": [
        "src/stores/appModeStore.test.ts",
        "browser_tests/tests/appModePruning.spec.ts",
        "browser_tests/tests/appModeInputPersistence.spec.ts"
      ]
    },
    {
      "name": "App-mode view lays out controls, preview, builder, and mobile display",
      "checks": ["src/views/LinearView.test.ts"]
    }
  ],
