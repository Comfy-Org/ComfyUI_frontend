        "src/platform/auth/webSessionFlagOn.test.ts",
        "src/platform/auth/webSessionFlagOff.test.ts",
        "src/platform/auth/nonWebClientsStayOnTokens.test.ts",
        "src/stores/bootstrapStore.test.ts"
