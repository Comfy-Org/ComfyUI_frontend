  "characterizationScenarios": [
    {
      "name": "Jobs client fetches queue, history pages, details, and assets with schema validation",
      "checks": [
        "src/platform/remote/comfyui/jobs/fetchJobs.test.ts",
        "src/stores/resultItemParsing.test.ts"
      ]
    },
    {
      "name": "Queue store merges running, pending, and history jobs and reloads their workflows",
      "checks": [
        "src/stores/queueStore.test.ts",
        "src/stores/queueStore.loadWorkflow.test.ts",
        "src/platform/remote/comfyui/useQueuePolling.test.ts"
      ]
    },
    {
      "name": "Job list groups, filters, estimates, and exposes job menu actions",
      "checks": [
        "src/composables/queue/useJobList.test.ts",
        "src/composables/queue/jobTabs.test.ts",
        "src/composables/queue/useJobMenu.test.ts",
        "src/components/queue/job/useQueueEstimates.test.ts",
        "src/components/queue/job/useJobErrorReporting.test.ts"
      ]
    },
    {
      "name": "Queue overlay, notification banners, and progress render active and finished jobs",
      "checks": [
        "src/components/queue/QueueProgressOverlay.test.ts",
        "src/composables/queue/useQueueNotificationBanners.test.ts",
        "src/composables/queue/useQueueProgress.test.ts",
        "src/components/queue/job/JobAssetsList.test.ts"
      ]
    },
    {
      "name": "Actionbar run button queues prompts with batch count and run modes and shows queue progress",
      "checks": [
        "src/components/actionbar/ComfyActionbar.test.ts",
        "src/components/actionbar/ComfyRunButton/ComfyQueueButton.test.ts",
        "src/components/actionbar/ComfyRunButton/LocalRunButtonWrapper.test.ts",
        "src/components/actionbar/BatchCountEdit.test.ts"
      ]
    },
    {
      "name": "Auto-queue requeues on change or instant mode and respects the partner-node run gate",
      "checks": ["src/services/autoQueueService.test.ts"]
    },
    {
      "name": "Job detail, outputs, assets, and workflows are fetched and cached per job",
      "checks": [
        "src/services/jobOutputCache.test.ts",
        "src/platform/workflow/cloud/getWorkflowFromHistory.test.ts"
      ]
    },
    {
      "name": "Job display state, reconnect refresh, and job-history sidebar registration follow queue state",
      "checks": [
        "src/utils/queueDisplay.test.ts",
        "src/composables/useReconnectQueueRefresh.test.ts",
        "src/composables/sidebarTabs/useJobHistorySidebarTab.test.ts",
        "src/stores/queueStore.test.ts"
      ]
    }
