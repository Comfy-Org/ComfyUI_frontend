{
  "id": "app-builder",
  "capability": "App builder",
  "description": "Workflow app authoring: choose inputs and outputs, edit their presentation, enter builder mode, and save the resulting app. App execution remains in linear-mode.",
  "modules": [
    {
      "path": "src/components/builder/**",
      "role": "presentation"
    },
    {
      "path": "src/components/builder/builderViewOptions.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/builderViewOptions.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/types.ts",
      "role": "domain"
    },
    {
      "path": "src/components/builder/useAppModeWidgetResizing.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useAppModeWidgetResizing.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useBuilderSave.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useBuilderSave.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useBuilderSteps.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useEnterBuilder.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useEnterBuilder.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useGroupDrop.test.ts",
      "role": "integration"
    },
    {
      "path": "src/components/builder/useInputGroups.test.ts",
      "role": "integration"
    },
    {
      "path": "src/components/builder/useInputGroups.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useLoaderDropIndicator.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useLoaderDropIndicator.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useResolvedSelectedInputs.test.ts",
      "role": "application"
    },
    {
      "path": "src/components/builder/useResolvedSelectedInputs.ts",
      "role": "application"
    },
    {
      "path": "src/stores/inputGroupStore.test.ts",
      "role": "integration"
    },
    {
      "path": "src/stores/inputGroupStore.ts",
      "role": "application"
    }
  ],
  "publicEntryPoints": [
    "src/components/builder/InputGroupAccordion.vue",
    "src/components/builder/useInputGroups.ts",
    "src/components/builder/useResolvedSelectedInputs.ts",
    "src/stores/inputGroupStore.ts"
  ],
  "allowedDependencies": [
    "app-host",
    "design-system",
    "extension-runtime",
    "graph-model",
    "linear-mode",
    "litegraph-api",
    "node-widgets",
    "test-support",
    "workflow-management"
  ],
  "allowedConsumers": ["linear-mode"],
  "characterizationScenarios": [
    {
      "name": "Entering the builder guards empty workflows and walks the builder steps",
      "checks": [
        "src/components/builder/useEnterBuilder.test.ts",
        "src/components/builder/useEmptyWorkflowDialog.test.ts",
        "src/components/builder/BuilderMenu.test.ts",
        "src/components/builder/BuilderFooterToolbar.test.ts"
      ]
    },
    {
      "name": "Builder selects inputs and outputs and renders the app-mode widget list",
      "checks": [
        "src/components/builder/AppBuilder.test.ts",
        "src/components/builder/useResolvedSelectedInputs.test.ts",
        "src/components/builder/useAppModeWidgetResizing.test.ts",
        "src/components/builder/useLoaderDropIndicator.test.ts"
      ]
    },
    {
      "name": "Saving an app persists the default view and confirms overwrites",
      "checks": [
        "src/components/builder/useBuilderSave.test.ts",
        "src/components/builder/builderViewOptions.test.ts"
      ]
    },
    {
      "name": "Input groups persist, support undo and drag pairing, and hide empty groups in app mode",
      "checks": [
        "src/stores/inputGroupStore.test.ts",
        "src/components/builder/useGroupDrop.test.ts",
        "src/components/builder/useInputGroups.test.ts",
        "src/renderer/extensions/linearMode/LinearControls.test.ts",
        "browser_tests/tests/appBuilder/inputGroups.spec.ts"
      ]
    }
  ],
  "adrs": [],
  "compatibilityPromises": [
    "Inventory preserves existing exports and runtime behavior with tested entry points for input-group authoring and app-mode integration."
  ],
  "deepImports": "inventory"
}
