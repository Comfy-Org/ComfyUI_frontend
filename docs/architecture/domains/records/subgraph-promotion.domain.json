{
  "id": "subgraph-promotion",
  "capability": "Subgraph widget promotion",
  "description": "Promoting inner widgets and previews onto subgraph nodes: promotion and preview-exposure property schemas, concrete widget resolution, promoted input widgets and value controls, legacy proxy-widget migration, and promotion error reconciliation. Widget values stay in the widget value store outside this domain.",
  "modules": [
    {
      "path": "src/components/rightSidePanel/subgraph/**",
      "role": "presentation"
    },
    {
      "path": "src/composables/node/usePromotedPreviews.ts",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/**",
      "role": "domain"
    },
    {
      "path": "packages/litegraph/src/subgraph/promotion/adoptPromotedWidgetValue.ts",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/migration/**",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/promotedInputWidget.ts",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/promotedWidgetControl.ts",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/promotionAfterReplacement.test.ts",
      "role": "application"
    },
    {
      "path": "src/core/graph/subgraph/promotionUtils.ts",
      "role": "application"
    },
    {
      "path": "src/core/schemas/**",
      "role": "domain"
    },
    {
      "path": "packages/litegraph/src/subgraph/promotedWidgetStoreProjection.ts",
      "role": "application"
    },
    {
      "path": "src/services/subgraphPseudoWidgetCache.ts",
      "role": "application"
    },
    {
      "path": "src/stores/previewExposureStore.test.ts",
      "role": "application"
    }
  ],
  "publicEntryPoints": [],
  "allowedDependencies": [],
  "allowedConsumers": [],
  "characterizationScenarios": [
    {
      "name": "Promoted widgets resolve to their concrete inner widgets and keep values",
      "checks": [
        "packages/litegraph/src/subgraph/promotion/resolveConcretePromotedWidget.test.ts",
        "src/core/graph/subgraph/promotedInputWidget.test.ts",
        "src/core/graph/subgraph/promotedWidgetControl.test.ts",
        "src/core/graph/subgraph/promotionAfterReplacement.test.ts"
      ]
    },
    {
      "name": "Legacy proxy widgets and persisted promotion properties migrate safely",
      "checks": [
        "src/core/graph/subgraph/migration/proxyWidgetMigration.test.ts",
        "packages/litegraph/src/subgraph/promotion/promotionSchema.test.ts",
        "packages/litegraph/src/subgraph/promotion/proxyWidgetQuarantineSchema.test.ts",
        "packages/graph-state/src/previewExposureSchema.test.ts"
      ]
    },
    {
      "name": "Promoted widgets behave on the canvas end to end",
      "checks": [
        "browser_tests/tests/subgraph/subgraphPromotion.spec.ts",
        "browser_tests/tests/subgraphPromotedWidgetPanel.spec.ts"
      ]
    },
    {
      "name": "Subgraph editor lists, reorders, and toggles promoted widgets and previews",
      "checks": [
        "src/components/rightSidePanel/subgraph/SubgraphEditor.test.ts"
      ]
    },
    {
      "name": "Preview exposures and promoted preview pseudo-widgets resolve to their inner host nodes",
      "checks": [
        "src/stores/previewExposureStore.test.ts",
        "src/services/subgraphPseudoWidgetCache.test.ts"
      ]
    },
    {
      "name": "Subgraph nodes expose promoted inner previews",
      "checks": ["src/composables/node/usePromotedPreviews.test.ts"]
    }
  ],
  "adrs": [
    "docs/adr/SUBGRAPH-PROMOTION-0009-represent-promoted-widgets-as-linked-inputs.md",
    "docs/adr/SUBGRAPH-PROMOTION-0027-defer-promoted-widget-registration-to-onadded.md"
  ],
  "compatibilityPromises": [
    "Persisted proxyWidgets and preview-exposure node properties keep loading from existing workflows.",
    "Promoted widget state is never registered under the unassigned node id.",
    "Inventory grants no new cross-domain permissions; LGraph and SubgraphNode imports of promotion helpers remain inherited debt."
  ],
  "deepImports": "inventory"
}
