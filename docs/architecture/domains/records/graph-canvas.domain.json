  "characterizationScenarios": [
    {
      "name": "Pointer gestures resolve targets and stay interruptible",
      "checks": [
        "src/lib/litegraph/src/canvas/reduceGesture.test.ts",
        "src/lib/litegraph/src/canvas/captureGesture.test.ts",
        "src/lib/litegraph/src/LGraphCanvas.gesture.test.ts",
        "src/lib/litegraph/src/LGraphCanvas.slotHitDetection.test.ts",
        "src/lib/litegraph/src/CanvasPointer.deviceDetection.test.ts"
      ]
    },
    {
      "name": "Viewport pan, zoom, and fit keep canvas coordinates stable",
      "checks": [
        "src/lib/litegraph/src/DragAndScale.animateToBounds.test.ts",
        "src/lib/litegraph/src/DragAndScale.viewportSize.test.ts",
        "src/lib/litegraph/src/__tests__/DragAndScale.fitToBounds.test.ts",
        "browser_tests/tests/viewport.spec.ts"
      ]
    },
    {
      "name": "Canvas selection, clipboard, and context menus act on the targeted items",
      "checks": [
        "src/lib/litegraph/src/LGraphCanvas.selection.test.ts",
        "src/lib/litegraph/src/LGraphCanvas.clipboard.test.ts",
        "src/lib/litegraph/src/canvas/getCanvasContextMenuTarget.test.ts",
        "src/lib/litegraph/src/contextMenuCompat.test.ts",
        "browser_tests/tests/copyPaste.spec.ts"
      ]
    },
    {
      "name": "Canvas drawing and invalidation redraw only what changed",
      "checks": [
        "src/lib/litegraph/src/LGraphCanvas.invalidation.test.ts",
        "src/lib/litegraph/src/LGraphCanvas.drawConnections.test.ts",
        "src/lib/litegraph/src/nodeBadgeDraw.test.ts",
        "src/lib/litegraph/src/LGraphButton.test.ts"
      ]
    },
    {
      "name": "Canvas copy and paste route through clipboard storage and paste media into nodes",
      "checks": [
        "src/composables/useCopy.test.ts",
        "src/composables/usePaste.test.ts"
      ]
    },
    {
      "name": "Node badges derive id, lifecycle, source, and credit parts including pricing inputs and subgraph aggregation",
      "checks": [
        "src/systems/badgeSystem.test.ts",
        "src/systems/badgeSystem.pricing.test.ts",
        "src/systems/badgeSystem.subgraph.test.ts"
      ]
    },
    {
      "name": "Core canvas extensions filter combo menus, build group menus, and translate touch gestures",
      "checks": [
        "src/extensions/core/contextMenuFilter.test.ts",
        "src/extensions/core/contextMenuFilter.wrap.test.ts",
        "src/extensions/core/contextMenuFilter.name.test.ts",
        "src/extensions/core/groupOptions.test.ts",
        "src/extensions/core/simpleTouchSupport.test.ts"
      ]
    },
    {
      "name": "Canvas copy and paste ignore editable targets and text selections",
      "checks": ["src/workbench/eventHelpers.test.ts"]
    }
  ],
