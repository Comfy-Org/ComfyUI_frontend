        "src/platform/workspace/stores/useWorkspaceAuth.test.ts",
        "src/platform/workspace/stores/legacyWorkspaceTokenRail.test.ts",
        "src/platform/workspace/stores/legacyWorkspaceTokenRail.lifecycle.test.ts",
