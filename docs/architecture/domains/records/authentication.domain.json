    },
    {
      "name": "Sign-in dialog switches between sign-in, sign-up, and API key forms and guards sign-up with Turnstile",
      "checks": [
        "src/components/dialog/content/SignInContent.test.ts",
        "src/components/dialog/content/signin/SignInForm.test.ts",
        "src/components/dialog/content/signin/SignUpForm.test.ts",
        "src/components/dialog/content/signin/ApiKeyForm.test.ts",
        "src/components/dialog/content/signin/TurnstileWidget.test.ts",
        "src/components/dialog/content/ApiNodesSignInContent.test.ts"
