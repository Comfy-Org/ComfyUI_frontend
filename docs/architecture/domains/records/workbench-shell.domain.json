  "publicEntryPoints": [],
  "characterizationScenarios": [
    {
      "name": "Splitter overlay and top menu arrange workbench regions from layout settings",
      "checks": [
        "src/components/LiteGraphCanvasSplitterOverlay.test.ts",
        "src/components/TopMenuSection.test.ts"
      ]
    },
    {
      "name": "Side toolbar renders registered sidebar tabs and the tab host template",
      "checks": [
        "src/components/sidebar/SideToolbar.test.ts",
        "src/components/sidebar/SidebarIcon.test.ts",
        "src/components/sidebar/tabs/SidebarTabTemplate.test.ts",
        "src/components/sidebar/ComfyMenuButton.test.ts"
      ]
    },
    {
      "name": "Topbar badges render extension-contributed badges",
      "checks": ["src/components/topbar/TopbarBadge.test.ts"]
    },
    {
      "name": "Menu items, sidebar tabs, and bottom panel tabs register, order, and toggle",
      "checks": [
        "src/stores/menuItemStore.test.ts",
        "src/stores/workspace/sidebarTabStore.test.ts",
        "src/stores/workspace/bottomPanelStore.test.ts",
        "browser_tests/tests/menu.spec.ts",
        "browser_tests/tests/bottomPanel.spec.ts"
      ]
    },
    {
      "name": "The extensionManager facade keeps the legacy toast API working",
      "checks": [
        "src/stores/workspaceStore.test.ts",
        "browser_tests/tests/extensionAPI.spec.ts"
      ]
    },
    {
      "name": "Side panels keep pixel sizes across resizes and restore persisted or legacy percentage state",
      "checks": [
        "src/composables/usePanelSizing.test.ts",
        "src/utils/splitterPersistence.test.ts",
        "src/utils/splitterWidthUtil.test.ts"
      ]
    },
    {
      "name": "Docked surfaces publish and release the workspace inset",
      "checks": ["src/composables/useWorkspaceInset.test.ts"]
    }
  ],
  "adrs": [],
  "compatibilityPromises": [
