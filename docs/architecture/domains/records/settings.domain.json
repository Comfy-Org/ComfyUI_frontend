  "characterizationScenarios": [
    {
      "name": "Setting store loads, validates, migrates, persists, and reports setting values",
      "checks": [
        "src/platform/settings/settingStore.test.ts",
        "src/platform/settings/globalSettingsApi.test.ts",
        "src/platform/settings/missingWarningVisibility.test.ts"
      ]
    },
    {
      "name": "Core setting definitions keep canvas navigation presets and error-system defaults",
      "checks": [
        "src/platform/settings/constants/canvasNavigation.test.ts",
        "src/platform/settings/constants/errorSystemSettings.test.ts"
      ]
    },
    {
      "name": "Settings dialog search, navigation, panels, and URL opening",
      "checks": [
        "src/platform/settings/composables/useSettingSearch.test.ts",
        "src/platform/settings/composables/useSettingUI.test.ts",
        "src/platform/settings/composables/useSettingsDialog.test.ts",
