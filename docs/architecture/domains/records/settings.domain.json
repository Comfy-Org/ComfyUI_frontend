        "src/components/dialog/content/setting/SettingItem.test.ts"
      ]
    },
    {
      "name": "Setting changes reach LiteGraph and legacy app.ui.settings callers",
      "checks": [
        "src/platform/settings/composables/useLitegraphSettings.test.ts",
        "src/platform/settings/composables/useLitegraphSettings.reactiveEdge.test.ts",
        "src/scripts/ui/settings.test.ts"
      ]
    },
    {
      "name": "Setting form items render the field type for each setting and emit values",
      "checks": [
        "src/components/common/FormItem.test.ts",
        "src/components/common/FormRadioGroup.test.ts",
        "src/components/common/FormColorPicker.test.ts"
      ]
    },
    {
      "name": "Server config store organizes server settings and produces launch arguments from modified values",
      "checks": ["src/stores/serverConfigStore.test.ts"]
    }
  ],
  "adrs": [],
  "compatibilityPromises": [
    "Unclassified callers may import settings internals during inventory; imports from classified domains remain subject to cross-domain rules.",
    "The legacy ComfySettingsDialog behind app.ui.settings remains the extension-facing seam for addSetting, getSettingValue, setSettingValue, and per-setting change events.",
    "The agent consent setting id is classified here while its existing agent CODEOWNERS remain responsible for changes.",
    "Application code that reaches the backend through scripts/api, and setting definitions that call stores or LiteGraph from onChange, remain visible as role-boundary debt; classification does not grant dependency exceptions."
  ],
  "deepImports": "inventory"
}
