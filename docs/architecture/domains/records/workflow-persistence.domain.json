  "characterizationScenarios": [
    {
      "name": "Draft cache keeps a bounded, collision-safe LRU index of workflow drafts",
      "checks": [
        "src/platform/workflow/persistence/base/draftCacheV2.test.ts",
        "src/platform/workflow/persistence/base/draftCacheV2.property.test.ts",
        "src/platform/workflow/persistence/base/draftCacheV2.collision.test.ts"
      ]
    },
