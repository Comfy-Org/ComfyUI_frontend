  "characterizationScenarios": [
    {
      "name": "Graph configure and serialise round-trips preserve nodes, links, groups, and reroutes",
      "checks": [
        "packages/litegraph/src/LGraph.roundTrip.test.ts",
        "packages/litegraph/src/LGraph.serialise.test.ts",
        "packages/litegraph/src/LGraph.failedConfigure.test.ts",
        "packages/litegraph/src/serialization.test.ts"
      ]
    },
    {
      "name": "Entity identity allocation and collision recovery keep ids unique without link theft",
      "checks": [
        "packages/litegraph/src/idAllocation.test.ts",
        "packages/litegraph/src/idAllocation.property.test.ts",
        "packages/litegraph/src/LGraph.deepCollision.test.ts",
        "packages/litegraph/src/LGraph.remintLinkRemap.test.ts",
        "packages/litegraph/src/linkDeduplication.remapReferences.test.ts"
      ]
    },
    {
      "name": "Slots and links stay consistent with store-held topology for legacy extension access",
      "checks": [
        "packages/litegraph/src/node/slotLinks.test.ts",
        "packages/litegraph/src/node/legacySlotLinkMutations.test.ts",
        "packages/litegraph/src/node/slotEcosystemPatterns.test.ts",
        "packages/litegraph/src/LLink.store.test.ts",
        "packages/litegraph/src/Reroute.store.test.ts"
      ]
    },
    {
      "name": "Node shell state and geometry project store state onto LGraphNode",
      "checks": [
        "packages/litegraph/src/node/nodeShell/nodeShellState.test.ts",
        "packages/litegraph/src/node/nodeShell/nodeShellLifecycle.test.ts",
        "packages/litegraph/src/LGraphNode.stateProjection.test.ts",
        "packages/litegraph/src/LGraphNode.geometry.test.ts",
        "packages/litegraph/src/geometryApiContracts.test.ts"
      ]
    },
    {
      "name": "Link, reroute, node data, entity id, and graph metadata stores stay partitioned by root and owning graph and reject identity collisions",
      "checks": [
        "src/stores/storeCollisionContracts.test.ts",
        "src/stores/linkStore.test.ts",
        "packages/graph-state/src/rerouteStore.test.ts",
        "src/stores/nodeDataStore.test.ts",
        "src/stores/entityIdStore.test.ts",
        "packages/graph-state/src/graphMetadataStore.test.ts"
      ]
    },
    {
      "name": "Branded node, link, reroute, slot, and locator ids parse, compare, and reject malformed input",
      "checks": [
        "src/types/nodeId.test.ts",
        "src/types/linkId.test.ts",
        "src/types/rerouteId.test.ts",
        "src/types/slotId.test.ts",
        "src/types/nodeIdentification.test.ts"
      ]
    }
  ],
