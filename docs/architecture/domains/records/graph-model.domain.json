  "characterizationScenarios": [
    {
      "name": "Viewport keep-alive pins normalize DOM and link-drag source node ids to the graph-model identity type",
      "checks": [
        "src/types/nodeId.test.ts",
        "src/renderer/extensions/vueNodes/composables/useViewportKeepAlivePins.test.ts"
      ]
    },
    {
      "name": "Graph configure and serialise round-trips preserve nodes, links, groups, and reroutes",
      "checks": [
        "src/lib/litegraph/src/LGraph.roundTrip.test.ts",
        "src/lib/litegraph/src/LGraph.serialise.test.ts",
        "src/lib/litegraph/src/LGraph.failedConfigure.test.ts",
        "src/lib/litegraph/src/serialization.test.ts"
      ]
    },
    {
      "name": "Entity identity allocation and collision recovery keep ids unique without link theft",
      "checks": [
        "src/lib/litegraph/src/idAllocation.test.ts",
        "src/lib/litegraph/src/idAllocation.property.test.ts",
        "src/lib/litegraph/src/LGraph.deepCollision.test.ts",
        "src/lib/litegraph/src/LGraph.remintLinkRemap.test.ts",
        "src/lib/litegraph/src/linkDeduplication.remapReferences.test.ts"
      ]
    },
