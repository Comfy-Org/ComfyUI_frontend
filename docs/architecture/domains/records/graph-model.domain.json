        "src/lib/litegraph/src/node/slotLinks.test.ts",
        "src/lib/litegraph/src/node/legacySlotLinkMutations.test.ts",
        "src/lib/litegraph/src/node/slotEcosystemPatterns.test.ts",
        "src/lib/litegraph/src/LLink.store.test.ts",
        "src/lib/litegraph/src/Reroute.store.test.ts"
      ]
    },
    {
      "name": "Node shell state and geometry project store state onto LGraphNode",
