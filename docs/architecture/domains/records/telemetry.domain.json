    }
  ],
  "publicEntryPoints": [],
  "allowedDependencies": ["ingest-api", "node-replacement", "remote-config"],
  "allowedConsumers": [
    "app-host",
    "authentication",
    "billing",
    "cloud",
    "error-reporting",
    "extension-runtime",
    "mask-editor",
    "node-library",
    "selection-toolbox",
    "settings",
    "workbench-shell",
    "workflow-management",
    "workflow-templates"
  ],
  "characterizationScenarios": [
    {
      "name": "TelemetryRegistry fans each event out to every registered provider and useTelemetry exposes the active registry",
      "checks": [
        "src/platform/telemetry/TelemetryRegistry.test.ts",
        "src/platform/telemetry/useTelemetry.test.ts"
      ]
    },
    {
      "name": "Desktop host telemetry replaces the registry with the host sink and keeps the host user id in sync",
      "checks": [
        "src/platform/telemetry/initHostTelemetry.test.ts",
        "src/platform/telemetry/providers/host/HostTelemetrySink.test.ts",
        "src/platform/telemetry/hostUserIdSync.test.ts",
        "src/platform/telemetry/storeReadiness.test.ts"
      ]
    },
    {
      "name": "Node-added and search-query events carry their source and debounced query",
      "checks": [
        "src/platform/telemetry/nodeAdded/installNodeAddedTelemetry.test.ts",
        "src/platform/telemetry/searchQuery/useSearchQueryTracking.test.ts"
      ]
    },
    {
      "name": "Event metadata builders describe execution, layout, checkout attribution, payment intent, and survey answers",
      "checks": [
        "src/platform/telemetry/utils/getExecutionContext.test.ts",
        "src/platform/telemetry/utils/workflowExecutionContext.test.ts",
        "src/platform/telemetry/utils/getShellLayoutSnapshot.test.ts",
        "src/platform/telemetry/utils/getActionbarDockState.test.ts",
        "src/platform/telemetry/utils/getAgentPanelOpen.test.ts",
        "src/platform/telemetry/utils/__tests__/checkoutAttribution.test.ts",
        "src/platform/telemetry/utils/paymentIntentSource.test.ts",
        "src/platform/telemetry/utils/__tests__/surveyNormalization.test.ts",
        "src/platform/telemetry/utils/billingFailureCategory.test.ts",
        "src/platform/telemetry/utils/groupMissingNodesByPack.test.ts",
        "src/platform/telemetry/utils/normalizeEmail.test.ts"
      ]
    },
    {
      "name": "Run button telemetry reports trigger source and shell context",
      "checks": ["src/composables/useRunButtonTelemetry.test.ts"]
    }
  ],
  "adrs": [
    "docs/adr/TELEMETRY-ROUTING-0013-telemetry-routing-across-consumers.md",
    "docs/adr/BILLING-CHECKOUT-0031-checkout-journey-instrumentation-contract.md"
  ],
  "compatibilityPromises": [
    "Unclassified callers may import these internals during inventory; imports from classified domains remain subject to cross-domain rules.",
    "useTelemetry() returning null until a registry is installed remains the contract every caller and cloud provider relies on.",
    "Cloud providers consume readiness and metadata adapters; feature callers submit search inputs and event context without granting telemetry access to their stores.",
    "Metadata builders that read workflow, setting, node-definition, panel, workspace-billing, and auth stores, and the localStorage keys duplicated from their writers, remain visible as coupling debt; classification does not grant dependency exceptions."
  ],
  "deepImports": "inventory"
}
