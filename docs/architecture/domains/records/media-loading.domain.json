{
  "id": "media-loading",
  "capability": "Shared media loading",
  "description": "Shared technical module for temporary media upload, retryable media URLs, and fetching text preview content. Playback, editing, asset records, and feature-specific upload controls remain separate.",
  "modules": [
    {
      "path": "src/composables/media/**",
      "role": "application"
    },
    {
      "path": "src/composables/useTextFileContent.test.ts",
      "role": "application"
    },
    {
      "path": "src/composables/useTextFileContent.ts",
      "role": "application"
    },
    {
      "path": "src/services/uploadTempFile.ts",
      "role": "application"
    }
  ],
  "publicEntryPoints": [
    "src/composables/media/useRetryableMediaSrc.ts",
    "src/composables/useTextFileContent.ts"
  ],
  "publicConsumers": "all",
  "deepImports": "inventory"
}
