{
  "id": "extension-manager",
  "capability": "Extension manager",
  "description": "Custom-node pack discovery, compatibility checks, installation queues, and manager dialogs. Registry access, workflow state, and host dialog services remain external dependencies.",
  "modules": [
    {
      "path": "src/composables/useServerLogs.test.ts",
      "role": "infrastructure"
    },
    {
      "path": "src/composables/useServerLogs.ts",
      "role": "infrastructure"
    },
    {
      "path": "src/platform/customNodes/manager/**",
      "role": "application"
    },
    {
      "path": "src/platform/customNodes/manager/components/**",
      "role": "presentation"
    },
    {
      "path": "src/platform/customNodes/manager/services/comfyManagerService.ts",
      "role": "infrastructure"
    },
    {
      "path": "src/platform/customNodes/manager/types/comfyManagerTypes.ts",
      "role": "domain"
    },
    {
      "path": "src/platform/customNodes/manager/types/compatibility.types.ts",
      "role": "domain"
    },
    {
      "path": "src/platform/customNodes/manager/types/conflictDetectionTypes.ts",
      "role": "domain"
    },
    {
      "path": "src/platform/customNodes/manager/types/importFailedTypes.ts",
      "role": "presentation"
    },
    {
      "path": "src/platform/customNodes/manager/utils/**",
      "role": "domain"
    },
    {
      "path": "src/platform/customNodes/manager/utils/packUpdateStatus.test.ts",
      "role": "application"
    },
    {
      "path": "src/platform/customNodes/manager/utils/packUpdateStatus.ts",
      "role": "application"
    },
    {
      "path": "src/utils/mapperUtil.ts",
      "role": "domain"
    },
    {
      "path": "src/utils/packUtils.test.ts",
      "role": "domain"
    },
    {
      "path": "src/utils/packUtils.ts",
      "role": "domain"
    }
  ],
  "publicEntryPoints": [],
  "allowedDependencies": [
    "app-host",
    "comfy-registry",
    "design-system",
    "dialog-host",
    "extension-runtime",
    "keybindings",
    "system-info"
  ],
  "allowedConsumers": [
    "app-host",
    "extension-runtime",
    "help-center",
    "node-definition",
    "subgraphs",
    "workbench-shell",
    "workflow-errors"
  ],
  "characterizationScenarios": [
    {
      "name": "Compatibility and version policy determine pack conflicts and ordering",
      "checks": [
        "src/platform/customNodes/manager/utils/systemCompatibility.test.ts",
        "src/platform/customNodes/manager/utils/versionUtil.test.ts",
        "src/platform/customNodes/manager/utils/nodePackSort.test.ts"
      ]
    },
    {
      "name": "Queued pack operations and dialog lifecycle preserve manager behavior",
      "checks": [
        "src/platform/customNodes/manager/composables/useManagerQueue.test.ts",
        "src/platform/customNodes/manager/composables/useManagerDialog.test.ts",
        "src/platform/customNodes/manager/stores/comfyManagerStore.test.ts"
      ]
    },
    {
      "name": "Registry requests are cached, pack ids normalised, and install logs streamed",
      "checks": [
        "src/composables/useCachedRequest.test.ts",
        "src/utils/packUtils.test.ts",
        "src/composables/useServerLogs.test.ts"
      ]
    }
  ],
  "adrs": [],
  "compatibilityPromises": [
    "Existing menus and missing-node panels may continue importing manager internals during inventory.",
    "Application-to-dialog and utility-to-store coupling remains visible as role-boundary debt; classification does not grant dependency exceptions."
  ],
  "deepImports": "inventory"
}
