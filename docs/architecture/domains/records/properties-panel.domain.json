{
  "id": "properties-panel",
  "capability": "Properties panel",
  "description": "The properties panel: selected-node targeting, favorited widgets, parameter tabs, node settings, node information, and the panel store that opens it on a tab. The panel hosts the workflow errors tab and the subgraph editor, which remain separate.",
  "modules": [
    {
      "path": "src/renderer/extensions/propertiesPanel/**"
    }
  ],
  "publicEntryPoints": [],
  "characterizationScenarios": [
    {
      "name": "Panel routes between tabs for the current selection and reports tab telemetry",
      "checks": [
        "src/renderer/extensions/propertiesPanel/PropertiesPanel.test.ts",
        "src/renderer/extensions/propertiesPanel/propertiesPanelTabTelemetry.test.ts",
        "src/renderer/extensions/propertiesPanel/propertiesPanelStore.test.ts"
      ]
    },
    {
      "name": "Favorited widgets persist in workflow.extra, including the legacy nodeId format",
      "checks": [
        "src/renderer/extensions/propertiesPanel/favoritedWidgetsStore.test.ts"
      ]
    },
    {
      "name": "Parameter tabs search, group, and edit widgets for nodes and subgraph inputs",
      "checks": [
        "src/renderer/extensions/propertiesPanel/parameters/TabNodes.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/TabNormalInputs.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/TabSubgraphInputs.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/SectionWidgets.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/WidgetItem.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/widgetSearch.test.ts",
        "src/renderer/extensions/propertiesPanel/parameters/widgetSections.test.ts",
        "src/renderer/extensions/propertiesPanel/selectedItems.test.ts",
        "src/renderer/extensions/propertiesPanel/parentGroup.test.ts"
      ]
    },
    {
      "name": "Settings tab changes node color and toggles node and canvas settings",
      "checks": [
        "src/renderer/extensions/propertiesPanel/settings/SetNodeColor.test.ts",
        "packages/design-system/src/components/field/FieldSwitch.test.ts"
      ]
    },
    {
      "name": "Properties panel opens, switches tabs, and keeps favorited widget actions",
      "checks": [
        "browser_tests/tests/rightSidePanelTabs.spec.ts",
        "browser_tests/tests/propertiesPanel/openClose.spec.ts",
        "browser_tests/tests/propertiesPanel/widgetActionsMenu.spec.ts"
      ]
    }
  ],
  "adrs": [],
  "compatibilityPromises": [
    "Inventory preserves existing exports and runtime behavior without granting public entry points or cross-module dependency permissions."
  ],
  "deepImports": "inventory"
