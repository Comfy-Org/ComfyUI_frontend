{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/frontend-domain-v1.json",
  "title": "ComfyUI frontend domain record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "capability",
    "description",
    "modules",
    "publicEntryPoints",
    "owners",
    "allowedDependencies",
    "allowedConsumers",
    "characterizationScenarios",
    "adrs",
    "compatibilityPromises",
    "enforcement"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capability": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "pattern": "^src/" },
          "role": {
            "enum": [
              "domain",
              "application",
              "infrastructure",
              "presentation",
              "integration"
            ]
          }
        }
      }
    },
    "publicEntryPoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^src/" }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@" }
    },
    "allowedDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "allowedConsumers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "characterizationScenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "checks"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "adrs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^docs/adr/.+\\.md$" }
    },
    "compatibilityPromises": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deepImports", "dependencies"],
      "properties": {
        "deepImports": { "enum": ["inventory", "baseline", "error"] },
        "dependencies": { "enum": ["inventory", "baseline", "error"] }
      }
    }
  }
}
