{
  "boundaries": {
    "zones": [
      {
        "name": "extension-manager/domain",
        "patterns": [
          "src/workbench/extensions/manager/types/**",
          "src/workbench/extensions/manager/utils/**"
        ]
      },
      {
        "name": "extension-manager/application",
        "patterns": [
          "src/workbench/extensions/manager/composables/**",
          "src/workbench/extensions/manager/stores/**"
        ]
      },
      {
        "name": "extension-manager/infrastructure",
        "patterns": ["src/workbench/extensions/manager/services/**"]
      },
      {
        "name": "extension-manager/presentation",
        "patterns": ["src/workbench/extensions/manager/components/**"]
      },
      {
        "name": "glsl-preview/domain",
        "patterns": [
          "src/renderer/glsl/glslUtils.ts",
          "src/renderer/glsl/glslUtils.test.ts"
        ]
      },
      {
        "name": "glsl-preview/application",
        "patterns": [
          "src/renderer/glsl/glslPreviewUtils.ts",
          "src/renderer/glsl/useGLSLPreview.ts",
          "src/renderer/glsl/useGLSLPreview.test.ts",
          "src/renderer/glsl/glslPreviewStoreContract.test.ts",
          "src/renderer/glsl/useGLSLUniforms.ts",
          "src/renderer/glsl/useGLSLUniforms.test.ts",
          "src/renderer/glsl/useGLSLUniforms.promotedRead.test.ts"
        ]
      },
      {
        "name": "glsl-preview/infrastructure",
        "patterns": [
          "src/renderer/glsl/useGLSLRenderer.ts",
          "src/renderer/glsl/useGLSLRenderer.test.ts",
          "src/renderer/glsl/sharedGLContext.ts",
          "src/renderer/glsl/sharedGLContext.test.ts"
        ]
      },
      {
        "name": "image-compare/application",
        "patterns": [
          "src/renderer/extensions/vueNodes/widgets/composables/useImageCompareImages.ts",
          "src/renderer/extensions/vueNodes/widgets/composables/useImageCompareImages.test.ts"
        ]
      },
      {
        "name": "image-compare/presentation",
        "patterns": [
          "src/renderer/extensions/vueNodes/widgets/components/WidgetImageCompare.vue",
          "src/renderer/extensions/vueNodes/widgets/components/WidgetImageCompare.test.ts"
        ]
      },
      {
        "name": "image-compare/integration",
        "patterns": [
          "src/renderer/extensions/vueNodes/widgets/composables/useImageCompareWidget.ts",
          "src/extensions/core/imageCompare.ts",
          "src/lib/litegraph/src/widgets/ImageCompareWidget.ts"
        ]
      },
      {
        "name": "image-compositor/application",
        "patterns": [
          "src/renderer/extensions/compositor/components/types.ts",
          "src/renderer/extensions/compositor/composables/**"
        ]
      },
      {
        "name": "image-compositor/presentation",
        "patterns": [
          "src/renderer/extensions/compositor/components/WidgetCompositor.vue",
          "src/renderer/extensions/compositor/components/WidgetCompositor.test.ts"
        ]
      },
      {
        "name": "image-compositor/integration",
        "patterns": [
          "src/renderer/extensions/vueNodes/widgets/composables/useCompositorWidget.ts",
          "src/extensions/core/imageCompositor.ts",
          "src/extensions/core/imageCompositor.test.ts",
          "src/lib/litegraph/src/widgets/CompositorWidget.ts"
        ]
      },
      {
        "name": "image-crop/application",
        "patterns": [
          "src/composables/useImageCrop.ts",
          "src/composables/useImageCrop.test.ts"
        ]
      },
      {
        "name": "image-crop/presentation",
        "patterns": ["src/components/imagecrop/**"]
      },
      {
        "name": "image-crop/integration",
        "patterns": [
          "src/extensions/core/imageCrop.ts",
          "src/lib/litegraph/src/widgets/ImageCropWidget.ts"
        ]
      },
      {
        "name": "mask-editor/domain",
        "patterns": ["src/extensions/core/maskeditor/**"]
      },
      {
        "name": "mask-editor/application",
        "patterns": [
          "src/composables/maskeditor/**",
          "src/stores/maskEditorStore.ts",
          "src/stores/maskEditorDataStore.ts",
          "src/stores/maskEditorStore.test.ts",
          "src/stores/maskEditorDataStore.test.ts"
        ]
      },
      {
        "name": "mask-editor/presentation",
        "patterns": ["src/components/maskeditor/**"]
      },
      {
        "name": "mask-editor/integration",
        "patterns": [
          "src/extensions/core/maskeditor.ts",
          "src/extensions/core/maskeditor.test.ts"
        ]
      },
      {
        "name": "minimap/domain",
        "patterns": ["src/renderer/extensions/minimap/types.ts"]
      },
      {
        "name": "minimap/application",
        "patterns": ["src/renderer/extensions/minimap/composables/**"]
      },
      {
        "name": "minimap/infrastructure",
        "patterns": [
          "src/renderer/extensions/minimap/data/**",
          "src/renderer/extensions/minimap/minimapCanvasRenderer.ts",
          "src/renderer/extensions/minimap/minimapCanvasRenderer.test.ts",
          "src/renderer/extensions/minimap/minimapDecorationRegistry.test.ts"
        ]
      },
      {
        "name": "minimap/presentation",
        "patterns": [
          "src/renderer/extensions/minimap/MiniMap.vue",
          "src/renderer/extensions/minimap/MiniMapPanel.vue"
        ]
      },
      {
        "name": "painter/application",
        "patterns": ["src/composables/painter/**"]
      },
      {
        "name": "painter/presentation",
        "patterns": ["src/components/painter/**"]
      },
      {
        "name": "painter/integration",
        "patterns": [
          "src/renderer/extensions/vueNodes/widgets/composables/usePainterWidget.ts",
          "src/extensions/core/painter.ts",
          "src/lib/litegraph/src/widgets/PainterWidget.ts"
        ]
      },
      {
        "name": "workflow-templates/domain",
        "patterns": [
          "src/platform/workflow/templates/types/**",
          "src/platform/workflow/templates/schemas/**",
          "src/platform/workflow/templates/utils/**"
        ]
      },
      {
        "name": "workflow-templates/application",
        "patterns": [
          "src/platform/workflow/templates/composables/**",
          "src/platform/workflow/templates/services/**",
          "src/platform/workflow/templates/stores/**"
        ]
      },
      {
        "name": "workflow-templates/infrastructure",
        "patterns": ["src/platform/workflow/templates/repositories/**"]
      },
      {
        "name": "workflow-templates/presentation",
        "patterns": ["src/components/templates/**"]
      },
      {
        "name": "unclassified",
        "patterns": ["src/**"]
      }
    ],
    "rules": [
      {
        "from": "extension-manager/domain",
        "allow": ["extension-manager/domain", "unclassified"]
      },
      {
        "from": "extension-manager/application",
        "allow": [
          "extension-manager/domain",
          "extension-manager/application",
          "extension-manager/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "extension-manager/infrastructure",
        "allow": [
          "extension-manager/domain",
          "extension-manager/application",
          "extension-manager/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "extension-manager/presentation",
        "allow": [
          "extension-manager/domain",
          "extension-manager/application",
          "extension-manager/presentation",
          "unclassified"
        ]
      },
      {
        "from": "glsl-preview/domain",
        "allow": ["glsl-preview/domain", "unclassified"]
      },
      {
        "from": "glsl-preview/application",
        "allow": [
          "glsl-preview/domain",
          "glsl-preview/application",
          "glsl-preview/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "glsl-preview/infrastructure",
        "allow": [
          "glsl-preview/domain",
          "glsl-preview/application",
          "glsl-preview/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "image-compare/application",
        "allow": ["image-compare/application", "unclassified"]
      },
      {
        "from": "image-compare/presentation",
        "allow": [
          "image-compare/application",
          "image-compare/presentation",
          "unclassified"
        ]
      },
      {
        "from": "image-compare/integration",
        "allow": [
          "image-compare/application",
          "image-compare/presentation",
          "image-compare/integration",
          "unclassified"
        ]
      },
      {
        "from": "image-compositor/application",
        "allow": ["image-compositor/application", "unclassified"]
      },
      {
        "from": "image-compositor/presentation",
        "allow": [
          "image-compositor/application",
          "image-compositor/presentation",
          "unclassified"
        ]
      },
      {
        "from": "image-compositor/integration",
        "allow": [
          "image-compositor/application",
          "image-compositor/presentation",
          "image-compositor/integration",
          "unclassified"
        ]
      },
      {
        "from": "image-crop/application",
        "allow": ["image-crop/application", "unclassified"]
      },
      {
        "from": "image-crop/presentation",
        "allow": [
          "image-crop/application",
          "image-crop/presentation",
          "unclassified"
        ]
      },
      {
        "from": "image-crop/integration",
        "allow": [
          "image-crop/application",
          "image-crop/presentation",
          "image-crop/integration",
          "unclassified"
        ]
      },
      {
        "from": "mask-editor/domain",
        "allow": ["mask-editor/domain", "unclassified"]
      },
      {
        "from": "mask-editor/application",
        "allow": [
          "mask-editor/domain",
          "mask-editor/application",
          "unclassified"
        ]
      },
      {
        "from": "mask-editor/presentation",
        "allow": [
          "mask-editor/domain",
          "mask-editor/application",
          "mask-editor/presentation",
          "unclassified"
        ]
      },
      {
        "from": "mask-editor/integration",
        "allow": [
          "mask-editor/domain",
          "mask-editor/application",
          "mask-editor/presentation",
          "mask-editor/integration",
          "unclassified"
        ]
      },
      {
        "from": "minimap/domain",
        "allow": ["minimap/domain", "unclassified"]
      },
      {
        "from": "minimap/application",
        "allow": [
          "minimap/domain",
          "minimap/application",
          "minimap/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "minimap/infrastructure",
        "allow": [
          "minimap/domain",
          "minimap/application",
          "minimap/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "minimap/presentation",
        "allow": [
          "minimap/domain",
          "minimap/application",
          "minimap/presentation",
          "unclassified"
        ]
      },
      {
        "from": "painter/application",
        "allow": ["painter/application", "unclassified"]
      },
      {
        "from": "painter/presentation",
        "allow": ["painter/application", "painter/presentation", "unclassified"]
      },
      {
        "from": "painter/integration",
        "allow": [
          "painter/application",
          "painter/presentation",
          "painter/integration",
          "unclassified"
        ]
      },
      {
        "from": "workflow-templates/domain",
        "allow": ["workflow-templates/domain", "unclassified"]
      },
      {
        "from": "workflow-templates/application",
        "allow": [
          "workflow-templates/domain",
          "workflow-templates/application",
          "workflow-templates/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "workflow-templates/infrastructure",
        "allow": [
          "workflow-templates/domain",
          "workflow-templates/application",
          "workflow-templates/infrastructure",
          "unclassified"
        ]
      },
      {
        "from": "workflow-templates/presentation",
        "allow": [
          "workflow-templates/domain",
          "workflow-templates/application",
          "workflow-templates/presentation",
          "unclassified"
        ]
      },
      {
        "from": "unclassified",
        "allow": [
          "extension-manager/domain",
          "extension-manager/application",
          "extension-manager/infrastructure",
          "extension-manager/presentation",
          "glsl-preview/domain",
          "glsl-preview/application",
          "glsl-preview/infrastructure",
          "minimap/domain",
          "minimap/application",
          "minimap/infrastructure",
          "minimap/presentation",
          "workflow-templates/domain",
          "workflow-templates/application",
          "workflow-templates/infrastructure",
          "workflow-templates/presentation",
          "unclassified"
        ]
      }
    ]
  }
}
