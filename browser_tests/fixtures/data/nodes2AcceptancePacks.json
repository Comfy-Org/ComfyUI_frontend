    {
      "directory": "ComfyUI-Custom-Scripts",
      "repo": "https://github.com/pythongosssss/ComfyUI-Custom-Scripts",
      "commit": "609f3afaa74b2f88ef9ce8d939626065e3247469",
      "extraPythonModules": [],
      "initStub": {
        "reason": "The original __init__.py calls install_js(), which writes into the ComfyUI install (web/extensions/pysssss); the stub only loads py/*.py and serves ./web.",
        "source": [
          "import importlib.util",
          "import glob",
          "import os",
          "import sys",
          "",
          "NODE_CLASS_MAPPINGS = {}",
          "NODE_DISPLAY_NAME_MAPPINGS = {}",
          "",
          "_py = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"py\")",
          "for _file in glob.glob(os.path.join(_py, \"*.py\")):",
          "    _name = os.path.splitext(_file)[0]",
          "    _spec = importlib.util.spec_from_file_location(_name, _file)",
          "    _module = importlib.util.module_from_spec(_spec)",
          "    sys.modules[_name] = _module",
          "    _spec.loader.exec_module(_module)",
          "    if getattr(_module, \"NODE_CLASS_MAPPINGS\", None) is not None:",
          "        NODE_CLASS_MAPPINGS.update(_module.NODE_CLASS_MAPPINGS)",
          "        if getattr(_module, \"NODE_DISPLAY_NAME_MAPPINGS\", None) is not None:",
          "            NODE_DISPLAY_NAME_MAPPINGS.update(_module.NODE_DISPLAY_NAME_MAPPINGS)",
          "",
          "WEB_DIRECTORY = \"./web\"",
          "__all__ = [\"NODE_CLASS_MAPPINGS\", \"NODE_DISPLAY_NAME_MAPPINGS\", \"WEB_DIRECTORY\"]"
        ]
      },
      "serverNodeTypes": ["MathExpression|pysssss"],
      "frontendNodeTypes": ["PresetText|pysssss"],
      "extensions": [
        "pysssss.WorkflowImage",
        "pysssss.MathExpression",
        "pysssss.AutoCompleter",
