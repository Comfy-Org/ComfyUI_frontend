# Which backend family this origin talks to: production | staging | test.
# Unset or misspelt resolves to `test`, so a misconfigured deployment can
# never reach production Cloud. It selects the Cloud origin, and the Firebase
# project below has to belong to the same family — a token minted against one
# family is meaningless in another.
VITE_BILLING_ENV=test

# Firebase web-app config for that family's project. All four are required;
# with any of them missing the app still boots and the sign-in page reports
# that sign-in is unavailable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional; carried through to Firebase when set.
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Stripe publishable key for the family above. Optional only in the sense that
# the app boots without it: /v1/checkout then reports that payment is
# unavailable and takes no card, because there is no hosted-page fallback for
# starting a payment. Portal steps (payment methods, invoices) need no key.
VITE_STRIPE_PUBLISHABLE_KEY=
