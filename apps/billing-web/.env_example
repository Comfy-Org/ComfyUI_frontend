# Which backend family this origin talks to: production | staging | test.
# Unset or misspelt resolves to `test`, so a misconfigured deployment can
# never reach production Cloud. It selects the Cloud origin, whose own
# `/api/features` names the Firebase project for that family at runtime —
# there is no build-time Firebase configuration for this app.
VITE_BILLING_ENV=test

# Stripe publishable key for the family above. Optional only in the sense that
# the app boots without it: /v1/checkout then reports that payment is
# unavailable and takes no card, because there is no hosted-page fallback for
# starting a payment. Portal steps (payment methods, invoices) need no key.
VITE_STRIPE_PUBLISHABLE_KEY=
