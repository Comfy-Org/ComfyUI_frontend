{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "astro:env/client": ["./.storybook/astroEnv.ts"]
    }
  },
  "include": [".storybook/**/*.ts", "src/**/*.stories.ts", "vitest.shims.d.ts"]
}
