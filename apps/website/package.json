{
  "name": "@comfyorg/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:no-toolbar": "cross-env NO_TOOLBAR=1 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env PLAYWRIGHT_LOCAL=1 playwright test",
    "test:visual": "playwright test --project visual",
    "test:visual:update": "playwright test --project visual --update-snapshots",
    "ashby:refresh-snapshot": "tsx ./scripts/refresh-ashby-snapshot.ts",
    "cloud-nodes:refresh-snapshot": "tsx ./scripts/refresh-cloud-nodes-snapshot.ts",
    "generate:models": "tsx ./scripts/generate-models.ts",
    "generate:workshop-catalog": "tsx ./scripts/generate-workshop-catalog.ts",
    "i18n:build-source": "tsx ./scripts/i18n/build-content-source.ts",
    "i18n:build-resolved": "tsx ./scripts/i18n/build-resolved.ts",
    "i18n:validate": "tsx ./scripts/i18n/validate-translations.ts",
    "i18n:translate": "tsx ./scripts/i18n/translate-pending.ts",
    "i18n:write-data": "tsx ./scripts/i18n/write-data.ts",
    "i18n:write-faq": "tsx ./scripts/i18n/write-faq.ts",
    "i18n:write-story": "tsx ./scripts/i18n/write-story.ts",
    "i18n:enforce": "tsx ./scripts/i18n/enforce-translations.ts",
    "i18n:review": "tsx ./scripts/i18n/review-translations.ts",
    "i18n:report": "tsx ./scripts/i18n/report-coverage.ts",
    "i18n:check-config": "tsx ./scripts/i18n/check-config.ts",
    "generate:workshop-display": "tsx ./scripts/generate-workshop-display.ts",
    "generate:workshop-router-contracts": "tsx ./scripts/generate-workshop-router-contracts.ts",
    "generate:workshop-router-aliases": "tsx ./scripts/generate-workshop-router-aliases.ts",
    "generate:workshop-router-snapshot": "tsx ./scripts/generate-workshop-router-snapshot.ts",
    "generate:workshop-node-pricing": "tsx ./scripts/generate-workshop-node-pricing.ts",
    "validate:jsonld": "tsx ./scripts/validate-jsonld.ts",
    "check:hreflang": "tsx ./scripts/check-hreflang.ts",
    "check:localized-pages": "tsx ./scripts/check-localized-pages.ts",
    "check:hardcoded-copy": "tsx ./scripts/check-hardcoded-copy.ts",
    "validate:llms-txt-links": "tsx ./scripts/validate-llms-txt-links.ts",
    "workshop:generate": "tsx ./scripts/generate-workshop-models.ts",
    "workshop:generate-versions": "tsx ./scripts/generate-workshop-versions.ts",
    "hub:backfill-media-type": "tsx ./scripts/backfill-template-media-type.ts",
    "hub:generate-join": "tsx ./scripts/generate-template-model-join.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@comfyorg/account": "workspace:*",
    "@comfyorg/design-system": "workspace:*",
    "@comfyorg/ingest-types": "workspace:*",
    "@comfyorg/object-info-parser": "workspace:*",
    "@comfyorg/registry-types": "workspace:*",
    "@comfyorg/shared-frontend-utils": "workspace:*",
    "@comfyorg/tailwind-utils": "workspace:*",
    "@customerio/cdp-analytics-browser": "catalog:",
