{
  "name": "@comfyorg/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:no-toolbar": "cross-env NO_TOOLBAR=1 astro dev",
    "build": "astro build",
    "build-storybook": "pnpm storybook:manifest && storybook build -o dist/storybook",
    "preview": "astro preview",
    "storybook": "pnpm storybook:manifest && storybook dev -p 6008",
    "storybook:manifest": "tsx scripts/generate-storybook-manifest.ts && pnpm exec oxfmt --write .storybook/generated/*.json",
    "typecheck": "astro check",
    "typecheck:storybook": "vue-tsc --noEmit --composite false -p tsconfig.stories.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env PLAYWRIGHT_LOCAL=1 playwright test",
    "test:visual": "playwright test --project visual",
    "test:storybook:visual": "playwright test --config .storybook/playwright.config.ts",
    "test:storybook:visual:update": "playwright test --config .storybook/playwright.config.ts --update-snapshots",
    "test:visual:update": "playwright test --project visual --update-snapshots",
    "ashby:refresh-snapshot": "tsx ./scripts/refresh-ashby-snapshot.ts",
    "cloud-nodes:refresh-snapshot": "tsx ./scripts/refresh-cloud-nodes-snapshot.ts",
    "generate:models": "tsx ./scripts/generate-models.ts",
    "validate:jsonld": "tsx ./scripts/validate-jsonld.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@comfyorg/design-system": "workspace:*",
    "@comfyorg/object-info-parser": "workspace:*",
    "@comfyorg/shared-frontend-utils": "workspace:*",
    "@comfyorg/tailwind-utils": "workspace:*",
    "@customerio/cdp-analytics-browser": "catalog:",
    "@lucide/vue": "catalog:",
    "@vercel/analytics": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "cva": "catalog:",
    "gsap": "catalog:",
    "lenis": "catalog:",
    "posthog-js": "catalog:",
    "reka-ui": "catalog:",
    "three": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@astrojs/vue": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-designs": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/vue": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "astro": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "storybook-addon-tag-badges": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-component-type-helpers": "catalog:",
    "vue-tsc": "catalog:"
  }
}
