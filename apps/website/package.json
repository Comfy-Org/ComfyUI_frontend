{
  "name": "@comfyorg/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:no-toolbar": "cross-env NO_TOOLBAR=1 astro dev",
    "dev:crossview-proxy": "tsx scripts/crossview-dev-proxy.ts",
    "build": "tsx scripts/refresh-model-trends-snapshot.ts && astro build",
    "build:e2e": "cross-env WEBSITE_INDEXABLE=1 WEBSITE_MODEL_TRENDS_PIN_SNAPSHOT_TIME=1 astro build",
    "format": "prettier --write \"src/**/*.astro\"",
    "format:check": "prettier --check \"src/**/*.astro\"",
    "preview": "astro preview",
    "typecheck": "astro check && tsx ../../scripts/vue-tsc-native.ts --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:router-models": "tsx ./scripts/test-router-models.ts",
    "test:router-validation": "vitest run scripts/router-model-validation.test.ts src/config/workshop-input-validation.test.ts src/config/workshop-media-validation.test.ts src/config/workshop-media-metadata.test.ts",
    "test:workflow-pages": "tsx ./scripts/test-workflow-pages.ts",
    "test:workshop-upload": "tsx ./scripts/test-workshop-upload.ts",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env PLAYWRIGHT_LOCAL=1 playwright test",
    "test:visual": "playwright test --project visual",
    "test:visual:update": "playwright test --project visual --update-snapshots",
    "ashby:refresh-snapshot": "tsx ./scripts/refresh-ashby-snapshot.ts",
    "cloud-nodes:refresh-snapshot": "tsx ./scripts/refresh-cloud-nodes-snapshot.ts",
    "feature-flags:refresh-snapshot": "tsx ./scripts/refresh-feature-flags-snapshot.ts",
    "rate-card:generate-types": "openapi-ts -f openapi-ts.rate-card.config.ts && node -e \"const fs=require('fs'); const f='src/types/rate-card/zod.gen.ts'; fs.writeFileSync(f, fs.readFileSync(f,'utf8').replace(\\\"from 'zod/v3'\\\", \\\"from 'zod'\\\"));\" && pnpm exec oxfmt --ignore-path .gitignore --write src/types/rate-card/index.ts src/types/rate-card/types.gen.ts src/types/rate-card/zod.gen.ts",
    "rate-card:refresh-snapshot": "tsx ./scripts/refresh-rate-card-snapshot.ts",
    "generate:model-url-map": "tsx ./scripts/generate-model-url-map.ts",
    "generate:models": "tsx ./scripts/generate-models.ts && tsx ./scripts/sync-vercel-redirects.ts",
    "sync:redirects": "tsx ./scripts/sync-vercel-redirects.ts",
    "generate:workshop-catalog": "tsx ./scripts/generate-workshop-catalog.ts",
    "generate:workshop-display": "tsx ./scripts/generate-workshop-display.ts",
    "generate:workshop-router-contracts": "tsx ./scripts/generate-workshop-router-contracts.ts",
    "generate:workshop-router-aliases": "tsx ./scripts/generate-workshop-router-aliases.ts",
    "generate:workshop-router-snapshot": "tsx ./scripts/generate-workshop-router-snapshot.ts",
    "generate:workshop-node-pricing": "tsx ./scripts/generate-workshop-node-pricing.ts",
    "validate:jsonld": "tsx ./scripts/validate-jsonld.ts",
    "check:hreflang": "tsx ./scripts/check-hreflang.ts",
    "check:models-html": "tsx ./scripts/check-models-html.ts",
    "list:models-pages": "tsx ./scripts/list-models-pages.ts",
    "validate:llms-txt-links": "tsx ./scripts/validate-llms-txt-links.ts",
    "check:link-slashes": "tsx ./scripts/check-internal-link-slashes.ts",
    "workshop:generate": "tsx ./scripts/generate-workshop-models.ts",
    "workshop:generate-versions": "tsx ./scripts/generate-workshop-versions.ts",
    "hub:backfill-media-type": "tsx ./scripts/backfill-template-media-type.ts",
    "hub:generate-join": "tsx ./scripts/generate-template-model-join.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@comfyorg/account-core": "workspace:*",
    "@comfyorg/account-ui": "workspace:*",
    "@comfyorg/design-system": "workspace:*",
    "@comfyorg/ingest-types": "workspace:*",
    "@comfyorg/object-info-parser": "workspace:*",
    "@comfyorg/registry-types": "workspace:*",
    "@comfyorg/shared-frontend-utils": "workspace:*",
    "@comfyorg/tailwind-utils": "workspace:*",
    "@customerio/cdp-analytics-browser": "catalog:",
    "@datadog/browser-logs": "catalog:",
    "@lucide/vue": "catalog:",
    "@vercel/analytics": "catalog:",
    "@vueuse/core": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "class-variance-authority": "catalog:",
    "cva": "catalog:",
    "es-toolkit": "^1.39.9",
    "firebase": "catalog:",
    "gsap": "catalog:",
    "leaflet": "catalog:",
    "lenis": "catalog:",
    "lottie-web": "catalog:",
    "parse5": "catalog:",
    "posthog-js": "catalog:",
    "reka-ui": "catalog:",
    "shaders": "catalog:",
    "shiki": "catalog:",
    "three": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@astrojs/vue": "catalog:",
    "@comfyorg/sdk": "catalog:",
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/vue": "catalog:",
    "@total-typescript/shoehorn": "catalog:",
    "@types/leaflet": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "astro": "catalog:",
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "mime-types": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "vue-component-type-helpers": "catalog:"
  }
}
