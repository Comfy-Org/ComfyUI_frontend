{
  "plugins": ["prettier-plugin-astro"],
  "singleQuote": true,
  "tabWidth": 2,
  "semi": false,
  "trailingComma": "none",
  "printWidth": 80,
  "htmlWhitespaceSensitivity": "css",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "astroCompressHTML": "html"
      }
    }
  ]
}
