{
  "id": "runway/gen4-turbo-image-to-video",
  "slug": "runway--gen4-turbo-image-to-video",
  "displayName": "Runway Gen-4 Turbo Image-to-Video",
  "provider": "runway",
  "modality": "video",
  "description": "Animates a still image into a short video clip from a start frame (Runway Gen 4 Turbo).",
  "tags": ["runway", "gen4", "video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["runway/gen4-turbo-image-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt for the generation. node.py:245-249 widget; validate_string(min_length=1) at execute."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "1280:720",
          "720:1280",
          "1104:832",
          "832:1104",
          "960:960",
          "1584:672"
        ],
        "description": "The resolution (aspect ratio) of the output video."
      },
      "duration": {
        "type": "number",
        "description": "Number of seconds of duration for the output video."
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "description": "Random seed for generation.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["start_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      }
    },
    "required": ["model", "prompt", "aspect_ratio", "duration"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
