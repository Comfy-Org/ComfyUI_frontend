{
  "id": "kling/omni-pro-first-last-frame",
  "slug": "kling--omni-pro-first-last-frame",
  "displayName": "Kling OmniPro First-Last Frame",
  "provider": "kling",
  "modality": "video",
  "description": "Generates a cinematic video from a start frame plus optional end frame or reference images (Kling OmniPro).",
  "tags": ["kling", "video", "omni-pro", "first-last-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/omni-pro-first-last-frame"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2500,
        "description": "Text prompt. Ignored on the wire when storyboards is enabled."
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 15,
        "description": "Video duration in seconds (3..15).",
        "default": 5
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Whether to generate audio. Only supported by kling-v3-omni.",
        "default": false
      },
      "model_name": {
        "type": "string",
        "enum": ["kling-v3-omni", "kling-video-o1"],
        "description": "OmniPro video model name."
      },
      "resolution": {
        "type": "string",
        "enum": ["4k", "1080p", "720p"],
        "description": "Output resolution.",
        "default": "1080p"
      },
      "storyboard_1_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_1_prompt": {
        "type": "string"
      },
      "storyboard_2_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_2_prompt": {
        "type": "string"
      },
      "storyboard_3_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_3_prompt": {
        "type": "string"
      },
      "storyboard_4_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_4_prompt": {
        "type": "string"
      },
      "storyboard_5_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_5_prompt": {
        "type": "string"
      },
      "storyboard_6_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_6_prompt": {
        "type": "string"
      },
      "storyboards": {
        "type": "string",
        "enum": [
          "disabled",
          "1 storyboard",
          "2 storyboards",
          "3 storyboards",
          "4 storyboards",
          "5 storyboards",
          "6 storyboards"
        ],
        "description": "Storyboard count selector (DynamicCombo parent). When set to anything other than \"disabled\", the matching `storyboard_<i>_prompt` + `storyboard_<i>_duration` fields must be supplied for i = 1..count. Sum of per-storyboard durations must equal the global `duration`. Only supported by `kling-v3-omni` (kling-video-o1 rejects storyboards). Defaults to `disabled`.",
        "default": "disabled"
      }
    },
    "required": ["model", "prompt", "model_name"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 6
    },
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
