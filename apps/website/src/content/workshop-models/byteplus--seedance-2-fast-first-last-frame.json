{
  "id": "byteplus/seedance-2-fast-first-last-frame",
  "slug": "byteplus--seedance-2-fast-first-last-frame",
  "displayName": "Seedance 2.0 Fast First-Last Frame",
  "provider": "byteplus",
  "modality": "video",
  "description": "Generates a transition video from start + end frames (Seedance 2.0 Fast).",
  "tags": ["byteplus", "seedance", "seedance-2", "video", "first-last-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedance-2-fast-first-last-frame"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt for video generation."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
        "description": "Aspect ratio of the output video. Default 16:9 deviates from node.py (required combo) — declarative L2 default.",
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 4,
        "maximum": 15,
        "default": 7
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p", "1080p", "4k"],
        "description": "Resolution of the output video. \"Seedance 2.0 Fast\" supports 480p/720p only; 1080p is rejected at parse time. Default 720p deviates from node.py (required combo) — declarative L2 default.",
        "default": "720p"
      },
      "watermark": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
