          "译制片男",
          "撒娇女友",
          "刀片烟嗓",
          "乖巧正太"
        ],
        "description": "Friendly voice name. Decomposed at body assembly into the wire (voice_id, voice_language) pair.",
        "default": "Melody"
      },
      "voice_speed": {
        "type": "number",
        "minimum": 0.8,
        "maximum": 2,
        "description": "Speech Rate. Valid range: 0.8~2.0, accurate to one decimal place.",
        "default": 1
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
