  "id": "heygen/video-translate",
  "slug": "heygen--video-translate",
  "displayName": "HeyGen Video Translate",
  "provider": "heygen",
  "modality": "video",
  "description": "Translates a video's speech and lip movements into one target language.",
  "tags": ["heygen", "video", "translate", "lip-sync"],
