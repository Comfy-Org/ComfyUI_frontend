{
  "id": "ltx/audio-to-video-v2",
  "slug": "ltx--audio-to-video-v2",
  "displayName": "LTX-2.5 Audio-to-Video",
  "provider": "ltx",
  "modality": "video",
  "description": "Generates an asynchronous LTX-2.5 video driven by a 2-20 second audio clip and optional image.",
  "tags": ["ltx", "lightricks", "ltx-2.5", "video", "audio-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["ltx/audio-to-video-v2"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["1920x1080", "1080x1920"],
        "default": "1920x1080"
      },
      "variant": {
        "type": "string",
        "enum": ["LTX-2.5 (Fast)", "LTX-2.5 (Pro)"],
        "default": "LTX-2.5 (Fast)"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
