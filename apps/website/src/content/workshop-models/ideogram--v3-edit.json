{
  "id": "ideogram/v3-edit",
  "slug": "ideogram--v3-edit",
  "displayName": "Ideogram V3 Edit",
  "provider": "ideogram",
  "modality": "image",
  "description": "Regenerates the masked region of an image from a prompt (Ideogram V3 inpainting).",
  "tags": [
    "ideogram",
    "v3",
    "inpaint",
    "edit",
    "mask",
    "text-rendering",
    "image-edit"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["ideogram/v3-edit"]
      },
      "prompt": {
        "type": "string"
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["mask"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "magic_prompt_option": {
        "type": "string",
        "enum": ["AUTO", "ON", "OFF"],
        "default": "AUTO"
      },
      "rendering_speed": {
        "type": "string",
        "enum": ["DEFAULT", "TURBO", "QUALITY"],
        "default": "DEFAULT"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "mask",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
