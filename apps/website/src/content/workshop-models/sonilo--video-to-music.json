    "properties": {
      "model": {
        "type": "string",
        "enum": ["sonilo/video-to-music"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 1000,
        "default": ""
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
