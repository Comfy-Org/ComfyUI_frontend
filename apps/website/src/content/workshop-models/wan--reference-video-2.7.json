{
  "id": "wan/reference-video-2.7",
  "slug": "wan--reference-video-2.7",
  "displayName": "Wan 2.7 Reference-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Generates a video from a mix of reference videos and images (Wan 2.7).",
  "tags": ["wan", "wan2.7", "video", "reference-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/reference-video-2.7"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Prompt; use `character1`/`character2` to refer to reference characters."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"],
        "description": "Aspect ratio."
      },
      "duration": {
        "type": "integer",
        "minimum": 2,
        "maximum": 10,
        "description": "Video duration in seconds (integer 2-10).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative prompt; empty omits from wire.",
        "default": ""
      },
      "resolution": {
        "type": "string",
        "enum": ["720P", "1080P"],
        "description": "Output video resolution tier (720P or 1080P)."
      },
      "watermark": {
        "type": "boolean",
        "description": "Watermark toggle.",
        "default": false
      }
    },
    "required": ["model", "prompt", "aspect_ratio", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 5
    },
    {
      "role": "reference_video",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 3
    }
  ]
}
