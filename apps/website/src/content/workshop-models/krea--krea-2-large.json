{
  "id": "krea/krea-2-large",
  "slug": "krea--krea-2-large",
  "displayName": "Krea 2 Large",
  "provider": "krea",
  "modality": "image",
  "description": "Generates expressive photorealism from text with optional moodboard and up to 10 image style references (Krea 2 Large).",
  "tags": ["krea", "krea-2", "photorealistic", "text-to-image"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["krea/krea-2-large"]
      },
      "prompt": {
        "type": "string",
        "description": "Text prompt for the image."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["1:1", "4:3", "3:2", "16:9", "2.35:1", "4:5", "2:3", "9:16"],
        "default": "1:1"
      },
      "seed": {
        "type": "integer"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "creativity": {
        "type": "string",
        "enum": ["raw", "low", "medium", "high"]
      },
      "moodboard_id": {
        "type": "string",
        "description": "Optional Krea moodboard UUID (copied from the Krea website)."
      },
      "moodboard_strength": {
        "type": "number",
        "description": "Moodboard influence; ignored when moodboard_id is absent."
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0
    }
  ]
}
