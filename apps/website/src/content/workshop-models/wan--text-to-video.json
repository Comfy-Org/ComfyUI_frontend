{
  "id": "wan/text-to-video",
  "slug": "wan--text-to-video",
  "displayName": "Wan 2.6 Text-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Generates a video clip from text with optional driving audio (Wan 2.6).",
  "tags": ["wan", "wan2.5", "wan2.6", "video", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/text-to-video"]
      },
      "prompt": {
        "type": "string",
        "description": "Prompt describing the elements and visual features. Supports English and Chinese.",
        "default": ""
      },
      "duration": {
        "type": "integer",
        "description": "Video duration in seconds. Allowed values: 5, 10, 15 (15s requires wan2.6).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed to use for generation.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["audio"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "If no audio input is provided, generate audio automatically.",
        "default": false
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative prompt describing what to avoid.",
        "default": ""
      },
      "prompt_extend": {
        "type": "boolean",
        "description": "Whether to enhance the prompt with AI assistance.",
        "default": true
      },
      "shot_type": {
        "type": "string",
        "enum": ["single", "multi"],
        "description": "Single continuous shot or multiple shots with cuts.",
        "default": "single"
      },
      "size": {
        "type": "string",
        "enum": [
          "480p: 1:1 (624x624)",
          "480p: 16:9 (832x480)",
          "480p: 9:16 (480x832)",
          "720p: 1:1 (960x960)",
          "720p: 16:9 (1280x720)",
          "720p: 9:16 (720x1280)",
          "720p: 4:3 (1088x832)",
          "720p: 3:4 (832x1088)",
          "1080p: 1:1 (1440x1440)",
          "1080p: 16:9 (1920x1080)",
          "1080p: 9:16 (1080x1920)",
          "1080p: 4:3 (1632x1248)",
          "1080p: 3:4 (1248x1632)"
        ],
        "description": "Output video size (friendly enum; e.g. `720p: 16:9 (1280x720)`).",
        "default": "720p: 1:1 (960x960)"
      },
      "watermark": {
        "type": "boolean",
        "description": "Whether to add an AI-generated watermark to the result.",
        "default": false
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
