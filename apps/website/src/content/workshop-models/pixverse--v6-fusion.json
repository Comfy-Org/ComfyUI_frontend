{
  "id": "pixverse/v6-fusion",
  "slug": "pixverse--v6-fusion",
  "displayName": "PixVerse V6 Fusion (Reference-to-Video)",
  "provider": "pixverse",
  "modality": "video",
  "description": "Composes a video from reference subjects, backgrounds and videos with PixVerse V6, named in the prompt as @Subject1, @Background1, @Video1.",
  "tags": ["pixverse", "pixverse-v6", "video", "reference-to-video", "audio"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["pixverse/v6-fusion"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 5000,
        "description": "Prompt for the video generation."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "2:3",
          "3:2",
          "21:9",
          "auto"
        ],
        "description": "Output aspect ratio. `auto` derives it from a reference video and therefore requires at least one `videos` entry.",
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "description": "Length of the generated video in seconds (1-15).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for video generation (recorded, not reproducible).",
        "default": 42
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["background_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Generate a native audio track together with the video. Audio raises the per-second rate.",
        "default": true
      },
      "negative_prompt": {
        "type": "string",
        "description": "Optional description of undesired elements. Empty is dropped.",
        "default": ""
      },
      "quality": {
        "type": "string",
        "enum": ["360p", "540p", "720p", "1080p"],
        "description": "Output resolution — the long edge: 360p 640px, 540p 1024px, 720p 1280px, 1080p 1920px.",
        "default": "720p"
      },
      "style": {
        "type": "string",
        "enum": [
          "none",
          "anime",
          "3d_animation",
          "clay",
          "comic",
          "cyberpunk",
          "realistic"
        ],
        "description": "Optional visual style. `none` leaves the model unstyled.",
        "default": "none"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "background_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 2
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 8
    },
    {
      "role": "reference_video",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 2
    }
  ]
}
