{
  "id": "byteplus/seed-audio-1.0-multilingual",
  "slug": "byteplus--seed-audio-1.0-multilingual",
  "displayName": "Seed Audio 1.0 Multilingual",
  "provider": "byteplus",
  "modality": "audio",
  "description": "Synthesizes multilingual speech and audio with timing control and optional references.",
  "tags": [
    "byteplus",
    "seed-audio",
    "multilingual",
    "audio",
    "tts",
    "recommended"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seed-audio-1.0-multilingual"]
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "audio_config": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": ["wav", "mp3", "pcm", "ogg_opus"],
            "default": "mp3"
          },
          "sample_rate": {
            "anyOf": [
              {
                "type": "number",
                "enum": [8000]
              },
              {
                "type": "number",
                "enum": [16000]
              },
              {
                "type": "number",
                "enum": [24000]
              },
              {
                "type": "number",
                "enum": [32000]
              },
              {
                "type": "number",
                "enum": [44100]
              },
              {
                "type": "number",
                "enum": [48000]
              }
            ],
            "default": 24000
          },
          "speech_rate": {
            "type": "integer",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          },
          "pitch_rate": {
            "type": "integer",
            "minimum": -12,
            "maximum": 12,
            "default": 0
          },
          "loudness_rate": {
            "type": "integer",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          }
        },
        "additionalProperties": false,
        "default": {}
      },
      "text_prompt": {
        "type": "string"
      }
    },
    "required": ["model", "text_prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 3
    }
  ]
}
