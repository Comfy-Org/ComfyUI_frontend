{
  "id": "wan/text-to-video-2.7",
  "slug": "wan--text-to-video-2.7",
  "displayName": "Wan 2.7 Text-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Generates a video clip from text with optional driving audio (Wan 2.7).",
  "tags": ["wan", "wan2.7", "video", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/text-to-video-2.7"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Prompt describing the video."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"],
        "description": "Aspect ratio."
      },
      "duration": {
        "type": "integer",
        "minimum": 2,
        "maximum": 15,
        "description": "Video duration in seconds (integer 2-15).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["audio"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative prompt; empty omits from wire.",
        "default": ""
      },
      "prompt_extend": {
        "type": "boolean",
        "description": "Prompt-extend toggle.",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["720P", "1080P"],
        "description": "Output video resolution tier (720P or 1080P)."
      },
      "watermark": {
        "type": "boolean",
        "description": "Watermark toggle.",
        "default": false
      }
    },
    "required": ["model", "prompt", "aspect_ratio", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
