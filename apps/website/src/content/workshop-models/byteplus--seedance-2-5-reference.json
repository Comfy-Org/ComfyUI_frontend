{
  "id": "byteplus/seedance-2-5-reference",
  "slug": "byteplus--seedance-2-5-reference",
  "displayName": "Seedance 2.5 Reference",
  "provider": "byteplus",
  "modality": "video",
  "description": "Generates or edits Seedance 2.5 video from image, video, or audio references.",
  "tags": ["byteplus", "seedance", "seedance-2.5", "reference", "multimodal"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedance-2-5-reference"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 4,
        "maximum": 30,
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "default": true
      },
      "output_format": {
        "type": "string",
        "enum": ["mp4"],
        "default": "mp4"
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p", "1080p"],
        "default": "720p"
      },
      "video_editing": {
        "type": "boolean",
        "default": false
      },
      "watermark": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 10
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 30
    },
    {
      "role": "reference_video",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 10
    }
  ]
}
