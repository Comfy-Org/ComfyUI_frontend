{
  "id": "bfl/flux-pro-fill",
  "slug": "bfl--flux-pro-fill",
  "displayName": "FLUX Pro Fill",
  "provider": "bfl",
  "modality": "image",
  "description": "Inpaints an image using a mask region (Flux Pro Fill).",
  "tags": ["bfl", "flux", "fill", "inpaint", "edit", "image-edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["bfl/flux-pro-fill"]
      },
      "prompt": {
        "type": "string"
      },
      "seed": {
        "type": "integer"
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["mask"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "guidance": {
        "type": "number"
      },
      "prompt_upsampling": {
        "type": "boolean"
      },
      "steps": {
        "type": "integer"
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "mask",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
