{
  "id": "xai/grok-imagine-video-reference",
  "slug": "xai--grok-imagine-video-reference",
  "displayName": "Grok Imagine Video Reference",
  "provider": "xai",
  "modality": "video",
  "description": "Generates a video guided by 1..7 reference images plus a text prompt (Grok Imagine reference-to-video).",
  "tags": ["grok", "xai", "video", "reference", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["xai/grok-imagine-video-reference"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text description of the desired video."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "4:3", "3:2", "1:1", "2:3", "3:4", "9:16"],
        "description": "Output video aspect ratio.",
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 2,
        "maximum": 10,
        "description": "Duration of the output video in seconds.",
        "default": 6
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for repeatability (results still nondeterministic).",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p"],
        "description": "Output video resolution.",
        "default": "720p"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "many",
      "minItems": 1
    },
    {
      "role": "reference_image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 7
    }
  ]
}
