{
  "id": "xai/grok-imagine-video-edit",
  "slug": "xai--grok-imagine-video-edit",
  "displayName": "Grok Imagine Video Edit",
  "provider": "xai",
  "modality": "video",
  "description": "Edits an existing video based on a text prompt (Grok Imagine video-to-video). Source must be MP4, ≤8.7s, ≤50MB.",
  "tags": ["grok", "xai", "video", "video-edit", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["xai/grok-imagine-video-edit"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text description of the edit."
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for repeatability (results still nondeterministic).",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
