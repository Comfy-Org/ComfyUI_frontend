{
  "id": "luma/photon-1-image-generation",
  "slug": "luma--photon-1-image-generation",
  "displayName": "Luma Photon-1",
  "provider": "luma",
  "modality": "image",
  "description": "Generates an image with optional style and character references (Photon-1).",
  "tags": ["luma", "photon", "image", "text-to-image"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["luma/photon-1-image-generation"]
      },
      "prompt": {
        "type": "string",
        "minLength": 3,
        "description": "Prompt for the image generation. node.py: `validate_string(prompt, strip_whitespace=True, min_length=3)`."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "21:9", "9:21"],
        "description": "Aspect ratio of the output image (node.py default '16:9').",
        "default": "16:9"
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709552000,
        "description": "Seed for the image generation.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "image_luma_ref": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["image", "weight"],
              "additionalProperties": false
            }
          }
        },
        "required": ["refs"],
        "additionalProperties": false,
        "description": "Optional Luma reference chain (from `lumaReference(...)`); max 4 entries (node.py:264-265 truncation)."
      },
      "style_image_weight": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Weight of style image (0.0-1.0, default 1.0). Ignored if no style_image provided.",
        "default": 1
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 5
    }
  ]
}
