{
  "id": "wan/image-to-video",
  "slug": "wan--image-to-video",
  "displayName": "Wan 2.6 Image-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Animates a still image into a video clip with optional driving audio from a start frame (Wan 2.6).",
  "tags": ["wan", "wan2.5", "wan2.6", "video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/image-to-video"]
      },
      "prompt": {
        "type": "string",
        "description": "Prompt describing the elements and visual features. Supports English and Chinese.",
        "default": ""
      },
      "duration": {
        "type": "integer",
        "description": "Video duration in seconds. Allowed values: 5, 10, 15 (15s requires wan2.6).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed to use for generation.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "If no audio input is provided, generate audio automatically.",
        "default": false
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative prompt describing what to avoid.",
        "default": ""
      },
      "prompt_extend": {
        "type": "boolean",
        "description": "Whether to enhance the prompt with AI assistance.",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["480P", "720P", "1080P"],
        "description": "Output video resolution tier.",
        "default": "720P"
      },
      "shot_type": {
        "type": "string",
        "enum": ["single", "multi"],
        "description": "Single continuous shot or multiple shots with cuts.",
        "default": "single"
      },
      "watermark": {
        "type": "boolean",
        "description": "Watermark toggle.",
        "default": false
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
