{
  "id": "pika/keyframes",
  "slug": "pika--keyframes",
  "displayName": "Pika 2.2 Pikaframes",
  "provider": "pika",
  "modality": "video",
  "description": "Generates a transition video that interpolates between N keyframe images (Pika 2.2 Pikaframes).",
  "tags": ["pika", "video", "keyframes", "first-last-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["pika/keyframes"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "duration": {
        "type": "integer",
        "minimum": 5,
        "maximum": 10,
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "negative_prompt": {
        "type": "string"
      },
      "resolution": {
        "type": "string",
        "enum": ["1080p", "720p"],
        "default": "1080p"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 5
    }
  ]
}
