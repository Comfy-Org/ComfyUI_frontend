{
  "id": "hitpaw/video-enhance-portrait-restore-2x",
  "slug": "hitpaw--video-enhance-portrait-restore-2x",
  "displayName": "HitPaw Video Enhance Portrait Restore 2x",
  "provider": "hitpaw",
  "modality": "video",
  "description": "Upscales a portrait video by 2x (HitPaw Portrait Restore).",
  "tags": ["hitpaw", "video-enhance", "upscale", "portrait"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["hitpaw/video-enhance-portrait-restore-2x"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["original", "720p", "1080p", "2K/QHD", "4K/UHD", "8K"],
        "description": "Target resolution shorter-side (or 'original' to preserve)."
      },
      "src_height": {
        "type": "integer",
        "minimum": 1,
        "description": "Source video height in pixels. Wrapper-only field — L2 has no video probe (criteria §1.1)."
      },
      "src_width": {
        "type": "integer",
        "minimum": 1,
        "description": "Source video width in pixels. Wrapper-only field — L2 has no video probe (criteria §1.1). Mirrors topaz pattern."
      }
    },
    "required": ["model", "resolution", "src_height", "src_width"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
