{
  "id": "minimax/s2v-01",
  "slug": "minimax--s2v-01",
  "displayName": "Hailuo S2V-01",
  "provider": "minimax",
  "modality": "video",
  "description": "Generates a video that preserves a reference subject's identity (Hailuo S2V-01).",
  "tags": [
    "minimax",
    "video",
    "subject-to-video",
    "s2v-01",
    "reference-to-video"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["minimax/s2v-01"]
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "The random seed used for creating the noise.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "prompt_text": {
        "type": "string",
        "description": "Text prompt to guide the video generation."
      }
    },
    "required": ["model", "prompt_text"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
