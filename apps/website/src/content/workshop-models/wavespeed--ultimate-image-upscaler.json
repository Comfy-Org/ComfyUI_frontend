{
  "id": "wavespeed/ultimate-image-upscaler",
  "slug": "wavespeed--ultimate-image-upscaler",
  "displayName": "Ultimate Image Upscaler",
  "provider": "wavespeed",
  "modality": "image",
  "description": "Upscales an image to 2K/4K/8K with sharp, detailed results (Wavespeed Ultimate Image Upscaler).",
  "tags": ["wavespeed", "ultimate", "image", "upscale", "image-upscale"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wavespeed/ultimate-image-upscaler"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "target_resolution": {
        "type": "string",
        "enum": ["2K", "4K", "8K"],
        "description": "Target output resolution (2K / 4K / 8K)."
      }
    },
    "required": ["model", "target_resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
