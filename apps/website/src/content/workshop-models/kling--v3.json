{
  "id": "kling/v3",
  "slug": "kling--v3",
  "displayName": "Kling 3.0",
  "provider": "kling",
  "modality": "video",
  "description": "Generates a cinematic video clip from text or a start frame (Kling 3).",
  "tags": ["kling", "video", "v3", "text-to-video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/v3"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2500,
        "description": "Positive text prompt (used when multi_shot is disabled)."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1"],
        "description": "Video aspect ratio. Ignored in image-to-video mode.",
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 15,
        "description": "Single-shot duration in seconds (used when multi_shot is disabled).",
        "default": 5
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["start_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Whether to generate sound. Maps to wire `sound: on|off`.",
        "default": true
      },
      "multi_shot": {
        "type": "string",
        "enum": [
          "disabled",
          "1 storyboard",
          "2 storyboards",
          "3 storyboards",
          "4 storyboards",
          "5 storyboards",
          "6 storyboards"
        ],
        "description": "Storyboard count. \"disabled\" → single prompt + duration; otherwise per-storyboard prompts/durations.",
        "default": "disabled"
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative text prompt (used when multi_shot is disabled). Empty → dropped from wire.",
        "default": ""
      },
      "resolution": {
        "type": "string",
        "enum": ["4k", "1080p", "720p"],
        "description": "Video resolution. Mapped to wire `mode` via KLING_V3_RESOLUTION_TO_MODE_CODES.",
        "default": "1080p"
      },
      "storyboard_1_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "description": "Storyboard 1 duration in seconds (1..15)."
      },
      "storyboard_1_prompt": {
        "type": "string",
        "description": "Storyboard 1 prompt (used when multi_shot >= 1 storyboard)."
      },
      "storyboard_2_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_2_prompt": {
        "type": "string"
      },
      "storyboard_3_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_3_prompt": {
        "type": "string"
      },
      "storyboard_4_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_4_prompt": {
        "type": "string"
      },
      "storyboard_5_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_5_prompt": {
        "type": "string"
      },
      "storyboard_6_duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "storyboard_6_prompt": {
        "type": "string"
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "start_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
