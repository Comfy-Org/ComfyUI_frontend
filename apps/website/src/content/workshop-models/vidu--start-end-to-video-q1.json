{
  "id": "vidu/start-end-to-video-q1",
  "slug": "vidu--start-end-to-video-q1",
  "displayName": "Vidu Q1 Start-End Frame",
  "provider": "vidu",
  "modality": "video",
  "description": "Generates a five-second 1080p transition video from start + end frames (Vidu Q1).",
  "tags": ["vidu", "viduq1", "video", "start-end-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["vidu/start-end-to-video-q1"]
      },
      "prompt": {
        "type": "string",
        "description": "A textual description for video generation."
      },
      "duration": {
        "type": "integer",
        "minimum": 5,
        "maximum": 5,
        "description": "Duration of the output video in seconds.",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for video generation (0 for random).",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "movement_amplitude": {
        "type": "string",
        "enum": ["auto", "small", "medium", "large"],
        "description": "The movement amplitude of objects in the frame."
      },
      "resolution": {
        "type": "string",
        "enum": ["1080p"],
        "description": "Supported values may vary by model & duration."
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
