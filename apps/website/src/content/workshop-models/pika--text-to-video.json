{
  "id": "pika/text-to-video",
  "slug": "pika--text-to-video",
  "displayName": "Pika 2.2 Text-to-Video",
  "provider": "pika",
  "modality": "video",
  "description": "Generates a 5s or 10s video clip from a prompt (Pika 2.2 text-to-video).",
  "tags": ["pika", "video", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["pika/text-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt describing the video to generate."
      },
      "duration": {
        "anyOf": [
          {
            "type": "number",
            "enum": [5]
          },
          {
            "type": "number",
            "enum": [10]
          }
        ],
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "negative_prompt": {
        "type": "string"
      },
      "resolution": {
        "type": "string",
        "enum": ["1080p", "720p"],
        "default": "1080p"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": []
}
