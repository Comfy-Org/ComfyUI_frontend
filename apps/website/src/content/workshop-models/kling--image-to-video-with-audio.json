{
  "id": "kling/image-to-video-with-audio",
  "slug": "kling--image-to-video-with-audio",
  "displayName": "Kling 2.6 Pro Image-to-Video with Audio",
  "provider": "kling",
  "modality": "video",
  "description": "Animates a still image into a video clip with synced audio from a start frame (Kling 2.6 Pro).",
  "tags": ["kling", "video", "image-to-video", "audio"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/image-to-video-with-audio"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500,
        "description": "Positive text prompt."
      },
      "duration": {
        "type": "number",
        "description": "Video duration in seconds (5 or 10).",
        "default": 5
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["start_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Whether to generate sound. Maps to wire `sound: on|off` (node.py:2735).",
        "default": true
      },
      "mode": {
        "type": "string",
        "enum": ["pro"],
        "description": "Generation mode (only pro supported for audio variants).",
        "default": "pro"
      },
      "model_name": {
        "type": "string",
        "enum": ["kling-v2-6"],
        "description": "Audio-variant model (only kling-v2-6 supported).",
        "default": "kling-v2-6"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
