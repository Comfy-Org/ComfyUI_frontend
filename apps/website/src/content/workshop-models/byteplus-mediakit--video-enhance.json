{
  "id": "byteplus-mediakit/video-enhance",
  "slug": "byteplus-mediakit--video-enhance",
  "displayName": "BytePlus AI MediaKit Video Enhance",
  "provider": "byteplus-mediakit",
  "modality": "video",
  "description": "Restores and upscales a public video to 720p, 1080p, 2K, or 4K with optional frame interpolation.",
  "tags": [
    "byteplus",
    "mediakit",
    "video",
    "enhance",
    "upscale",
    "restoration",
    "frame-interpolation"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus-mediakit/video-enhance"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "bit_depth": {
        "anyOf": [
          {
            "type": "number",
            "enum": [8]
          },
          {
            "type": "number",
            "enum": [10]
          },
          {
            "type": "number",
            "enum": [12]
          }
        ]
      },
      "bitrate": {
        "type": "integer",
        "minimum": 10,
        "maximum": 150000
      },
      "bitrate_level": {
        "type": "string",
        "enum": ["low", "medium", "high"],
        "default": "medium"
      },
      "enhance_style": {
        "type": "string",
        "enum": ["hd", "natural"],
        "default": "hd"
      },
      "fps": {
        "type": "number",
        "minimum": 0,
        "maximum": 120
      },
      "resolution": {
        "type": "string",
        "enum": ["720p", "1080p", "2k", "4k"]
      },
      "resolution_limit": {
        "type": "integer",
        "minimum": 64,
        "maximum": 2160
      },
      "scene": {
        "type": "string",
        "enum": ["aigc", "short_series", "ugc", "old_film"]
      },
      "tool_version": {
        "type": "string",
        "enum": ["standard", "professional"],
        "default": "standard"
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
