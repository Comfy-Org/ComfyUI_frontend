{
  "id": "kling/omni-pro-video-to-video",
  "slug": "kling--omni-pro-video-to-video",
  "displayName": "Kling OmniPro Video-to-Video",
  "provider": "kling",
  "modality": "video",
  "description": "Restyles a reference video guided by a text prompt (Kling OmniPro).",
  "tags": ["kling", "video", "omni-pro", "video-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/omni-pro-video-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500,
        "description": "Text prompt (required, 1..2500 chars)."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1"],
        "description": "Video aspect ratio.",
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 10,
        "description": "Video duration in seconds (3..10). NB narrower range than the other OmniPro video nodes.",
        "default": 3
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "keep_original_sound": {
        "type": "boolean",
        "description": "Whether to keep the reference video's original sound on the output.",
        "default": true
      },
      "model_name": {
        "type": "string",
        "enum": ["kling-v3-omni", "kling-video-o1"],
        "description": "OmniPro video model name."
      },
      "resolution": {
        "type": "string",
        "enum": ["1080p", "720p"],
        "description": "Output resolution (no 4k for video-to-video).",
        "default": "1080p"
      }
    },
    "required": ["model", "prompt", "model_name"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 4
    },
    {
      "role": "reference_video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
