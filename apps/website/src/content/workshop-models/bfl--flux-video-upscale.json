{
  "id": "bfl/flux-video-upscale",
  "slug": "bfl--flux-video-upscale",
  "displayName": "FLUX Video Upscale",
  "provider": "bfl",
  "modality": "video",
  "description": "Upscales a 1-20 second source video by 1.5x to 3x with creative or precise FLUX super-resolution.",
  "tags": [
    "bfl",
    "flux",
    "video",
    "upscale",
    "super-resolution",
    "video-to-video"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["bfl/flux-video-upscale"]
      },
      "prompt": {
        "type": "string",
        "default": ""
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "mode": {
        "type": "string",
        "enum": ["creative", "precise"],
        "default": "creative"
      },
      "safety_tolerance": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4,
        "default": 2
      },
      "upscale_factor": {
        "type": "number",
        "minimum": 1.5,
        "maximum": 3,
        "default": 2
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
