{
  "id": "recraft/v3-text-to-image",
  "slug": "recraft--v3-text-to-image",
  "displayName": "Recraft V3 Text-to-Image",
  "provider": "recraft",
  "modality": "image",
  "description": "Generates a raster image with selectable style and controls (Recraft V3).",
  "tags": ["recraft", "v3", "text-to-image", "raster"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["recraft/v3-text-to-image"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "default": 1
      },
      "negative_prompt": {
        "type": "string"
      },
      "recraft_controls": {
        "type": "object",
        "properties": {
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "r": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "g": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "b": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": ["r", "g", "b"],
              "additionalProperties": false
            }
          },
          "background_color": {
            "type": "object",
            "properties": {
              "r": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "g": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "b": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": ["r", "g", "b"],
            "additionalProperties": false
          },
          "artistic_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "no_text": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "recraft_style": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
