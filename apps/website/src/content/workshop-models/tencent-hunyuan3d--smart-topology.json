{
  "id": "tencent-hunyuan3d/smart-topology",
  "slug": "tencent-hunyuan3d--smart-topology",
  "displayName": "Hunyuan3D Smart Retopology",
  "provider": "tencent-hunyuan3d",
  "modality": "3d",
  "description": "Refines the topology of an existing high-poly 3D mesh (Tencent Hunyuan3D Smart Retopology).",
  "tags": [
    "tencent",
    "hunyuan3d",
    "3d",
    "topology",
    "retopology",
    "model-to-model"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["tencent-hunyuan3d/smart-topology"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["model_3d"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "face_level": {
        "type": "string",
        "enum": ["medium", "high", "low"],
        "description": "Polygon reduction level."
      },
      "model_3d_format": {
        "type": "string",
        "enum": ["glb", "obj"],
        "description": "File format of `model_3d_url`. Supported formats: glb, obj."
      },
      "polygon_type": {
        "type": "string",
        "enum": ["triangle", "quadrilateral"],
        "description": "Surface composition type."
      }
    },
    "required": ["model", "face_level", "model_3d_format", "polygon_type"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "model_3d",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
