{
  "id": "kling/image-generation",
  "slug": "kling--image-generation",
  "displayName": "Kling Image Generation",
  "provider": "kling",
  "modality": "image",
  "description": "Generates an image from a prompt with optional reference image (Kling Image Generation).",
  "tags": ["kling", "image", "text-to-image"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/image-generation"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Positive text prompt."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1", "4:3", "3:4", "3:2", "2:3", "21:9"],
        "description": "Aspect ratio of the generated images.",
        "default": "16:9"
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9,
        "description": "Number of generated images.",
        "default": 1
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "human_fidelity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Subject reference similarity.",
        "default": 0.45
      },
      "image_fidelity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Reference intensity for user-uploaded images.",
        "default": 0.5
      },
      "image_type": {
        "type": "string",
        "enum": ["subject", "face"],
        "description": "Image reference type (subject or face). Sent on the wire as `image_reference` only when `image` is supplied."
      },
      "model_name": {
        "type": "string",
        "enum": ["kling-v3", "kling-v2", "kling-v1-5"],
        "description": "Model name. node.py options: kling-v3, kling-v2, kling-v1-5."
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative text prompt. Empty → dropped from the wire body.",
        "default": ""
      }
    },
    "required": ["model", "prompt", "image_type", "model_name"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
