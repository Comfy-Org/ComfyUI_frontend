        "description": "Curated HeyGen narration voice for a text script."
      },
      "voice_id": {
        "type": "string",
        "description": "Custom HeyGen voice ID. Overrides `voice`."
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
