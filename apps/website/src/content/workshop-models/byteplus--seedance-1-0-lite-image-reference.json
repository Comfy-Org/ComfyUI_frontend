{
  "id": "byteplus/seedance-1-0-lite-image-reference",
  "slug": "byteplus--seedance-1-0-lite-image-reference",
  "displayName": "Seedance 1.0 Lite Image Reference",
  "provider": "byteplus",
  "modality": "video",
  "description": "Generates a video from up to four reference images (Seedance 1.0 Lite).",
  "tags": ["byteplus", "seedance", "video", "image-reference"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedance-1-0-lite-image-reference"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "The text prompt used to generate the video."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16", "21:9"],
        "description": "The aspect ratio of the output video.",
        "default": "adaptive"
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 12,
        "description": "The duration of the output video in seconds.",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed to use for generation.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p"],
        "description": "The resolution of the output video."
      },
      "watermark": {
        "type": "boolean",
        "description": "Whether to add an \"AI generated\" watermark to the video.",
        "default": false
      }
    },
    "required": ["model", "prompt", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 4
    }
  ]
}
