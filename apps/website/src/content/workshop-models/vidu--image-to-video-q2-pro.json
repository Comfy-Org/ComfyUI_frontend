{
  "id": "vidu/image-to-video-q2-pro",
  "slug": "vidu--image-to-video-q2-pro",
  "displayName": "Vidu Q2 Pro Image-to-Video",
  "provider": "vidu",
  "modality": "video",
  "description": "Animates a still image into a video clip from a start frame (Vidu Q2 Pro).",
  "tags": ["vidu", "viduq2", "video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["vidu/image-to-video-q2-pro"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2000,
        "description": "An optional text prompt for video generation (max 2000 characters).",
        "default": ""
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Duration of the output video in seconds.",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for video generation (0 for random).",
        "default": 1
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "movement_amplitude": {
        "type": "string",
        "enum": ["auto", "small", "medium", "large"],
        "description": "The movement amplitude of objects in the frame."
      },
      "resolution": {
        "type": "string",
        "enum": ["720p", "1080p"],
        "description": "Resolution of the output video."
      }
    },
    "required": ["model", "movement_amplitude", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
