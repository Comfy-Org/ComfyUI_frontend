{
  "id": "byteplus/seedream-4",
  "slug": "byteplus--seedream-4",
  "displayName": "Seedream 4.0",
  "provider": "byteplus",
  "modality": "image",
  "description": "Generates or edits an image at up to ~4K with up to 10 reference images (Seedream 4.0).",
  "tags": ["byteplus", "seedream", "text-to-image", "image-to-image", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedream-4"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt for creating or editing an image."
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed to use for generation.",
        "default": 42
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "fail_on_partial": {
        "type": "boolean",
        "description": "If enabled, abort execution if any requested images are missing or return an error.",
        "default": true
      },
      "height": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 4992,
        "description": "Custom height for image. Value is working only if `size_preset` is set to `Custom`",
        "default": 2048
      },
      "max_images": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "description": "Maximum number of images to generate when sequential_image_generation='auto'. Total images (input + generated) cannot exceed 15.",
        "default": 1
      },
      "prompt_optimization": {
        "type": "string",
        "enum": ["standard", "fast"],
        "description": "Seedream 5.0 Pro prompt-optimization mode when reference images are provided.",
        "default": "standard"
      },
      "sequential_image_generation": {
        "type": "string",
        "enum": ["disabled", "auto"]
      },
      "size_preset": {
        "type": "string",
        "enum": [
          "1024x1024 (1:1)",
          "2048x2048 (1:1)",
          "2304x1728 (4:3)",
          "1728x2304 (3:4)",
          "2560x1440 (16:9)",
          "1440x2560 (9:16)",
          "2496x1664 (3:2)",
          "1664x2496 (2:3)",
          "3024x1296 (21:9)",
          "3072x3072 (1:1)",
          "4096x4096 (1:1)",
          "Custom"
        ],
        "default": "2048x2048 (1:1)"
      },
      "thinking": {
        "type": "boolean",
        "description": "Enable prompt-optimization reasoning for text-to-image generation.",
        "default": true
      },
      "watermark": {
        "type": "boolean",
        "description": "Whether to add an \"AI generated\" watermark to the image.",
        "default": false
      },
      "width": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 6240,
        "description": "Custom width for image. Value is working only if `size_preset` is set to `Custom`",
        "default": 2048
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": false,
      "cardinality": "many",
      "minItems": 0
    }
  ]
}
