{
  "id": "pixverse/v6-first-last-frame",
  "slug": "pixverse--v6-first-last-frame",
  "displayName": "PixVerse V6 First-Last-Frame",
  "provider": "pixverse",
  "modality": "video",
  "description": "Generates a video that transitions from a first frame to a last frame with PixVerse V6, optionally with native audio.",
  "tags": [
    "pixverse",
    "pixverse-v6",
    "video",
    "transition",
    "first-last-frame",
    "audio"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["pixverse/v6-first-last-frame"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 5000,
        "description": "Prompt for the video generation."
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "description": "Length of the generated video in seconds (1-15).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for video generation (recorded, not reproducible).",
        "default": 42
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "first_frame_img_id": {
        "type": "string",
        "description": "Pre-existing first-frame handle. Mutually exclusive with `first_frame`."
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Generate a native audio track together with the video. Audio raises the per-second rate.",
        "default": true
      },
      "last_frame_img_id": {
        "type": "string",
        "description": "Pre-existing last-frame handle. Mutually exclusive with `last_frame`."
      },
      "negative_prompt": {
        "type": "string",
        "description": "Optional description of undesired elements. Empty is dropped.",
        "default": ""
      },
      "quality": {
        "type": "string",
        "enum": ["360p", "540p", "720p", "1080p"],
        "description": "Output resolution — the long edge: 360p 640px, 540p 1024px, 720p 1280px, 1080p 1920px.",
        "default": "720p"
      },
      "style": {
        "type": "string",
        "enum": [
          "none",
          "anime",
          "3d_animation",
          "clay",
          "comic",
          "cyberpunk",
          "realistic"
        ],
        "description": "Optional visual style. `none` leaves the model unstyled.",
        "default": "none"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "start_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
