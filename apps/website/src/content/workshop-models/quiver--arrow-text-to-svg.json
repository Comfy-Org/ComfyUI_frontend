{
  "id": "quiver/arrow-text-to-svg",
  "slug": "quiver--arrow-text-to-svg",
  "displayName": "Quiver Arrow Text-to-SVG",
  "provider": "quiver",
  "modality": "svg",
  "description": "Generates an SVG illustration from a text prompt with optional reference images (Quiver Arrow).",
  "tags": ["quiver", "arrow", "svg", "vector", "text-to-svg"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["quiver/arrow-text-to-svg"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "instructions": {
        "type": "string"
      },
      "presence_penalty": {
        "type": "number",
        "minimum": -2,
        "maximum": 2,
        "default": 0
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 1
      },
      "top_p": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 1,
        "default": 1
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0
    }
  ]
}
