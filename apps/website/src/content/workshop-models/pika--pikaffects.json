{
  "id": "pika/pikaffects",
  "slug": "pika--pikaffects",
  "displayName": "Pika Pikaffects",
  "provider": "pika",
  "modality": "video",
  "description": "Applies a named visual effect (Cake-ify, Crush, Inflate, Melt, Explode, …) to a still image (Pika Pikaffects).",
  "tags": ["pika", "video", "image-to-video", "effects"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["pika/pikaffects"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "negative_prompt": {
        "type": "string"
      },
      "pikaffect": {
        "type": "string",
        "enum": [
          "Cake-ify",
          "Crumble",
          "Crush",
          "Decapitate",
          "Deflate",
          "Dissolve",
          "Explode",
          "Eye-pop",
          "Inflate",
          "Levitate",
          "Melt",
          "Peel",
          "Poke",
          "Squish",
          "Ta-da",
          "Tear"
        ]
      }
    },
    "required": ["model", "pikaffect"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
