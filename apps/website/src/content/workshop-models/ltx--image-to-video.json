{
  "id": "ltx/image-to-video",
  "slug": "ltx--image-to-video",
  "displayName": "LTX-2 Image-to-Video",
  "provider": "ltx",
  "modality": "video",
  "description": "Animates a still image into a video clip with optional audio from a start frame (LTX-2).",
  "tags": ["ltx", "lightricks", "video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["ltx/image-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "duration": {
        "anyOf": [
          {
            "type": "number",
            "enum": [6]
          },
          {
            "type": "number",
            "enum": [8]
          },
          {
            "type": "number",
            "enum": [10]
          },
          {
            "type": "number",
            "enum": [12]
          },
          {
            "type": "number",
            "enum": [14]
          },
          {
            "type": "number",
            "enum": [16]
          },
          {
            "type": "number",
            "enum": [18]
          },
          {
            "type": "number",
            "enum": [20]
          }
        ],
        "default": 8
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "fps": {
        "anyOf": [
          {
            "type": "number",
            "enum": [25]
          },
          {
            "type": "number",
            "enum": [50]
          }
        ],
        "default": 25
      },
      "generate_audio": {
        "type": "boolean",
        "description": "When true, the generated video will include AI-generated audio matching the scene.",
        "default": false
      },
      "resolution": {
        "type": "string",
        "enum": ["1920x1080", "2560x1440", "3840x2160"],
        "default": "1920x1080"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
