{
  "id": "elevenlabs/speech-to-speech",
  "slug": "elevenlabs--speech-to-speech",
  "displayName": "ElevenLabs Speech-to-Speech",
  "provider": "elevenlabs",
  "modality": "audio",
  "description": "Transforms speech from one voice into another while preserving the original content and emotion (ElevenLabs).",
  "tags": ["elevenlabs", "audio", "voice", "speech-to-speech", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["elevenlabs/speech-to-speech"]
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "default": 0
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["audio"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "output_format": {
        "type": "string",
        "enum": ["mp3_44100_192", "opus_48000_192"],
        "default": "mp3_44100_192"
      },
      "remove_background_noise": {
        "type": "boolean",
        "default": false
      },
      "similarity_boost": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.75
      },
      "speed": {
        "type": "number",
        "minimum": 0.7,
        "maximum": 1.3,
        "default": 1
      },
      "stability": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5
      },
      "style": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.2,
        "default": 0
      },
      "use_speaker_boost": {
        "type": "boolean",
        "default": false
      },
      "voice": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "Roger (male, american)",
              "Sarah (female, american)",
              "Laura (female, american)",
              "Charlie (male, australian)",
              "George (male, british)",
              "Callum (male, american)",
              "River (neutral, american)",
              "Harry (male, american)",
              "Liam (male, american)",
              "Alice (female, british)",
              "Matilda (female, american)",
              "Will (male, american)",
              "Jessica (female, american)",
              "Eric (male, american)",
              "Bella (female, american)",
              "Chris (male, american)",
              "Brian (male, american)",
              "Daniel (male, british)",
              "Lily (female, british)",
              "Adam (male, american)",
              "Bill (male, american)"
            ]
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "description": "Target voice — friendly name (e.g. 'Sarah') or upstream voice_id. Friendly references are resolved via the same matcher as text-to-speech. Available voices: Roger (male, american); Sarah (female, american); Laura (female, american); Charlie (male, australian); George (male, british); Callum (male, american); River (neutral, american); Harry (male, american); Liam (male, american); Alice (female, british); Matilda (female, american); Will (male, american); Jessica (female, american); Eric (male, american); Bella (female, american); Chris (male, american); Brian (male, american); Daniel (male, british); Lily (female, british); Adam (male, american); Bill (male, american)."
      }
    },
    "required": ["model"],
    "additionalProperties": true
