{
  "id": "tripo/retarget",
  "slug": "tripo--retarget",
  "displayName": "Tripo Retarget",
  "provider": "tripo",
  "modality": "3d",
  "description": "Retargets a rigged Tripo 3D mesh with a preset animation (Tripo Retarget).",
  "tags": ["tripo", "3d", "retarget", "animation", "preset", "model-to-model"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["tripo/retarget"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "animation": {
        "type": "string",
        "enum": [
          "preset:idle",
          "preset:walk",
          "preset:run",
          "preset:dive",
          "preset:climb",
          "preset:jump",
          "preset:slash",
          "preset:shoot",
          "preset:hurt",
          "preset:fall",
          "preset:turn",
          "preset:quadruped:walk",
          "preset:hexapod:walk",
          "preset:octopod:walk",
          "preset:serpentine:march",
          "preset:aquatic:march"
        ],
        "description": "Animation preset (16 options at node.py:623-640)."
      },
      "original_model_task_id": {
        "type": "string",
        "description": "The task_id of the rigged model to retarget."
      }
    },
    "required": ["model", "animation", "original_model_task_id"],
    "additionalProperties": true
  },
  "roles": []
}
