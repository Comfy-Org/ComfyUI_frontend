{
  "id": "tencent-hunyuan3d/image-to-model-3.1",
  "slug": "tencent-hunyuan3d--image-to-model-3.1",
  "displayName": "Hunyuan3D 3.1 Image-to-3D",
  "provider": "tencent-hunyuan3d",
  "modality": "3d",
  "description": "Generates a 3D mesh from a primary image plus optional left/right/back views (Tencent Hunyuan3D 3.1 Image-to-Model).",
  "tags": ["tencent", "hunyuan3d", "3d", "image-to-3d", "multi-view", "3.1"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["tencent-hunyuan3d/image-to-model-3.1"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["view_back"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["view_left"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["view_right"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "face_count": {
        "type": "integer",
        "minimum": 40000,
        "maximum": 500000,
        "default": 40000
      },
      "generate_type": {
        "type": "string",
        "enum": ["Normal", "Geometry"],
        "default": "Normal"
      },
      "pbr": {
        "type": "boolean"
      },
      "polygon_type": {
        "type": "string",
        "enum": ["triangle", "quadrilateral"]
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "view_back",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "view_left",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "view_right",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
