{
  "id": "wan/reference-to-video-3.0",
  "slug": "wan--reference-to-video-3.0",
  "displayName": "Wan 3.0 Reference-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Generates a video from a prompt plus freely combined reference images, videos and audio (Wan 3.0). Refer to the media in the prompt as @Image1, @Video1, @Audio1.",
  "tags": ["wan", "wan3.0", "video", "reference-to-video", "audio"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/reference-to-video-3.0"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 20000,
        "description": "Prompt; refer to the media you pass as @Image1, @Video1, @Audio1 (numbered per type, in the order supplied).",
        "default": ""
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["adaptive", "16:9", "9:16", "1:1", "4:3", "3:4"],
        "description": "Aspect ratio; `adaptive` derives it from the input media.",
        "default": "adaptive"
      },
      "duration": {
        "type": "integer",
        "description": "Output duration in seconds (2-30), or -1 to let the model pick (the default). With reference videos, input + output must stay within 30 seconds.",
        "default": -1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed.",
        "default": 42
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "audio": {
        "type": "boolean",
        "description": "Whether the output video contains an audio track.",
        "default": true
      },
      "prompt_extend": {
        "type": "boolean",
        "description": "Prompt-extend toggle.",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["1080P", "720P", "480P"],
        "description": "Output video resolution tier (1080P, 720P or 480P)."
      },
      "watermark": {
        "type": "boolean",
        "description": "Watermark toggle.",
        "default": false
      }
    },
    "required": ["model", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 5
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 10
    },
    {
      "role": "reference_video",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 5
    }
  ]
}
