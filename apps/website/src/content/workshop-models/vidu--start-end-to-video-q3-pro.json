{
  "id": "vidu/start-end-to-video-q3-pro",
  "slug": "vidu--start-end-to-video-q3-pro",
  "displayName": "Vidu Q3 Pro Start-End Frame",
  "provider": "vidu",
  "modality": "video",
  "description": "Generates a transition video from start + end frames with optional audio (Vidu Q3 Pro).",
  "tags": ["vidu", "viduq3", "video", "start-end-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["vidu/start-end-to-video-q3-pro"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2000,
        "description": "Prompt description (max 2000 characters)."
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "Duration of the output video in seconds.",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for video generation (0 for random).",
        "default": 1
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "audio": {
        "type": "boolean",
        "description": "When enabled, outputs video with sound (including dialogue and sound effects).",
        "default": false
      },
      "resolution": {
        "type": "string",
        "enum": ["720p", "1080p"],
        "description": "Resolution of the output video."
      }
    },
    "required": ["model", "prompt", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
