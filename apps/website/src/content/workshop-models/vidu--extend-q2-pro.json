{
  "id": "vidu/extend-q2-pro",
  "slug": "vidu--extend-q2-pro",
  "displayName": "Vidu Q2 Pro Extend",
  "provider": "vidu",
  "modality": "video",
  "description": "Extends an existing video clip toward an optional end frame (Vidu Q2 Pro).",
  "tags": ["vidu", "viduq2", "video", "extend"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["vidu/extend-q2-pro"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2000,
        "description": "An optional text prompt for the extended video (max 2000 characters).",
        "default": ""
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7,
        "description": "Duration of the extended video in seconds.",
        "default": 4
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["720p", "1080p"],
        "description": "Resolution of the output video."
      },
      "video_creation_id": {
        "type": "string",
        "description": "Existing Vidu video_creation_id (mutually-required pair with video_url per wire spec)."
      }
    },
    "required": ["model", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    },
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
