{
  "id": "byteplus/seedance-2-5-text-to-video",
  "slug": "byteplus--seedance-2-5-text-to-video",
  "displayName": "Seedance 2.5 Text-to-Video",
  "provider": "byteplus",
  "modality": "video",
  "description": "Generates a 4-30 second 480p or 720p MP4 with Seedance 2.5.",
  "tags": ["byteplus", "seedance", "seedance-2.5", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedance-2-5-text-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 4,
        "maximum": 30,
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "generate_audio": {
        "type": "boolean",
        "default": true
      },
      "output_format": {
        "type": "string",
        "enum": ["mp4"],
        "default": "mp4"
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p", "1080p"],
        "default": "720p"
      },
      "watermark": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": []
}
