{
  "id": "byteplus/seedance-2-fast-reference",
  "slug": "byteplus--seedance-2-fast-reference",
  "displayName": "Seedance 2.0 Fast Reference",
  "provider": "byteplus",
  "modality": "video",
  "description": "Generates a video from a mix of reference images, videos, and audio (Seedance 2.0 Fast).",
  "tags": [
    "byteplus",
    "seedance",
    "seedance-2",
    "video",
    "reference",
    "multimodal"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["byteplus/seedance-2-fast-reference"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt for video generation."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 4,
        "maximum": 15,
        "default": 7
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_video"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p", "1080p", "4k"],
        "default": "720p"
      },
      "watermark": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 3
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 9
    },
    {
      "role": "reference_video",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 3
    }
  ]
}
