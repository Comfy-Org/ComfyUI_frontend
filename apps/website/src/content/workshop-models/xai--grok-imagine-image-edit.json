{
  "id": "xai/grok-imagine-image-edit",
  "slug": "xai--grok-imagine-image-edit",
  "displayName": "Grok Imagine Image Edit",
  "provider": "xai",
  "modality": "image",
  "description": "Edits one or more images from a text prompt; standard takes up to 3 inputs, pro exactly 1 (Grok Imagine).",
  "tags": ["grok", "xai", "image-edit", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["xai/grok-imagine-image-edit"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "The text prompt that drives the edit."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "auto",
          "1:1",
          "2:3",
          "3:2",
          "3:4",
          "4:3",
          "9:16",
          "16:9",
          "9:19.5",
          "19.5:9",
          "9:20",
          "20:9",
          "1:2",
          "2:1"
        ],
        "description": "Aspect ratio of the output. Only allowed when multiple input images are connected (otherwise must stay `auto`).",
        "default": "auto"
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Number of edited images to generate.",
        "default": 1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed for repeatability (results still nondeterministic).",
        "default": 0
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["1K", "2K"],
        "description": "Output resolution. Omit to let upstream pick the default."
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 3
    }
  ]
}
