{
  "id": "kling/first-last-frame",
  "slug": "kling--first-last-frame",
  "displayName": "Kling 3.0 First-Last Frame",
  "provider": "kling",
  "modality": "video",
  "description": "Generates a transition video from start + end frames (Kling 3).",
  "tags": ["kling", "video", "v3", "first-last-frame"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/first-last-frame"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500,
        "description": "Positive text prompt (validate_string min=1 max=2500)."
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 15,
        "description": "Video duration in seconds (3..15).",
        "default": 5
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["end_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["start_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "generate_audio": {
        "type": "boolean",
        "description": "Whether to generate sound. Maps to wire `sound: on|off`.",
        "default": true
      },
      "resolution": {
        "type": "string",
        "enum": ["4k", "1080p", "720p"],
        "description": "Video resolution. Mapped to wire `mode` via KLING_V3_RESOLUTION_TO_MODE_CODES.",
        "default": "1080p"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "end_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "start_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
