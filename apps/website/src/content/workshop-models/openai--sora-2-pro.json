{
  "id": "openai/sora-2-pro",
  "slug": "openai--sora-2-pro",
  "displayName": "Sora 2 Pro",
  "provider": "openai",
  "modality": "video",
  "description": "Generates a 1080p video clip from text or a reference image (Sora 2 Pro).",
  "tags": [
    "openai",
    "sora",
    "sora-2-pro",
    "video",
    "premium",
    "text-to-video",
    "image-to-video"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["openai/sora-2-pro"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "duration": {
        "anyOf": [
          {
            "type": "number",
            "enum": [4]
          },
          {
            "type": "number",
            "enum": [8]
          },
          {
            "type": "number",
            "enum": [12]
          }
        ],
        "description": "Clip duration in seconds (4 / 8 / 12)."
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "size": {
        "type": "string",
        "enum": ["720x1280", "1280x720", "1024x1792", "1792x1024"]
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
