{
  "id": "freepik/magnific-upscaler-creative",
  "slug": "freepik--magnific-upscaler-creative",
  "displayName": "Magnific Creative Upscaler",
  "provider": "freepik",
  "modality": "image",
  "description": "Upscales and stylizes an image at 2x/4x/8x/16x with prompt guidance (Magnific Creative Upscaler).",
  "tags": ["freepik", "magnific", "upscaler", "creative", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["freepik/magnific-upscaler-creative"]
      },
      "prompt": {
        "type": "string",
        "description": "Prompt to guide the upscale process.",
        "default": ""
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "auto_downscale": {
        "type": "boolean",
        "description": "Comfyui-side hint to downscale the input if the output would exceed 25.3M pixels. NOT a wire field — applied at L3; ignored at L2 body assembly. Kept here for workflow JSON parity (price_badge depends on it).",
        "default": false
      },
      "creativity": {
        "type": "integer",
        "minimum": -10,
        "maximum": 10,
        "description": "AI creativity level. Range [-10, 10].",
        "default": 0
      },
      "engine": {
        "type": "string",
        "enum": [
          "automatic",
          "magnific_illusio",
          "magnific_sharpy",
          "magnific_sparkle"
        ],
        "description": "Magnific model engine."
      },
      "fractality": {
        "type": "integer",
        "minimum": -10,
        "maximum": 10,
        "description": "The strength of the prompt and intricacy per square pixel. Range [-10, 10].",
        "default": 0
      },
      "hdr": {
        "type": "integer",
        "minimum": -10,
        "maximum": 10,
        "description": "The level of definition and detail. Range [-10, 10].",
        "default": 0
      },
      "optimized_for": {
        "type": "string",
        "enum": [
          "standard",
          "soft_portraits",
          "hard_portraits",
          "art_n_illustration",
          "videogame_assets",
          "nature_n_landscapes",
          "films_n_photography",
          "3d_renders",
          "science_fiction_n_horror"
        ],
        "description": "Style optimization for the upscale process."
      },
      "resemblance": {
        "type": "integer",
        "minimum": -10,
        "maximum": 10,
        "description": "The level of resemblance to the original image. Range [-10, 10].",
        "default": 0
      },
      "scale_factor": {
        "type": "string",
        "enum": ["2x", "4x", "8x", "16x"],
        "description": "Scale factor of the image."
      }
    },
    "required": ["model", "engine", "optimized_for", "scale_factor"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
