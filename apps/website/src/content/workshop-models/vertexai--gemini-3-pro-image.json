        "type": "string",
        "enum": ["vertexai/gemini-3-pro-image"]
      },
      "prompt": {
        "type": "string",
        "default": ""
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "auto",
          "1:1",
          "2:3",
          "3:2",
          "3:4",
          "4:3",
          "4:5",
          "5:4",
          "9:16",
          "16:9",
          "21:9"
        ],
        "default": "auto"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["document"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["1K", "2K", "4K"],
