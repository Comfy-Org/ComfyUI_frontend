{
  "id": "xai/grok-imagine-video",
  "slug": "xai--grok-imagine-video",
  "displayName": "Grok Imagine Video",
  "provider": "xai",
  "modality": "video",
  "description": "Generates a short video clip from text or a start frame (Grok Imagine).",
  "tags": ["grok", "xai", "video", "text-to-video", "image-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["xai/grok-imagine-video"]
      },
      "prompt": {
        "type": "string",
        "description": "Text description of the desired video."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["auto", "16:9", "4:3", "3:2", "1:1", "2:3", "3:4", "9:16"],
        "default": "16:9"
      },
      "duration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "default": 6
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["480p", "720p", "1080p"],
        "default": "720p"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
