{
  "id": "bria/fibo-image-edit",
  "slug": "bria--fibo-image-edit",
  "displayName": "Bria FIBO Image Edit",
  "provider": "bria",
  "modality": "image",
  "description": "Edits an image from a natural-language or structured prompt with optional mask region (FIBO).",
  "tags": ["bria", "fibo", "edit", "image-to-image"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["bria/fibo-image-edit"]
      },
      "prompt": {
        "type": "string",
        "description": "Instruction to edit image.",
        "default": ""
      },
      "seed": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647,
        "default": 1
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["mask"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "guidance_scale": {
        "type": "number",
        "minimum": 3,
        "maximum": 5,
        "description": "Higher value makes the image follow the prompt more closely.",
        "default": 3
      },
      "moderation": {
        "type": "string",
        "enum": ["false", "true"],
        "description": "Moderation settings (DynamicCombo parent — see file header).",
        "default": "false"
      },
      "negative_prompt": {
        "type": "string",
        "default": ""
      },
      "prompt_content_moderation": {
        "type": "boolean"
      },
      "steps": {
        "type": "integer",
        "minimum": 20,
        "maximum": 50,
        "default": 50
      },
      "structured_prompt": {
        "type": "string",
        "description": "A string containing the structured edit prompt in JSON format. Use this instead of usual prompt for precise, programmatic control.",
        "default": ""
      },
      "visual_input_moderation": {
        "type": "boolean"
      },
      "visual_output_moderation": {
        "type": "boolean"
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "mask",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
