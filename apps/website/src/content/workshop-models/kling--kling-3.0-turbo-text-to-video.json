{
  "id": "kling/kling-3.0-turbo-text-to-video",
  "slug": "kling--kling-3.0-turbo-text-to-video",
  "displayName": "Kling 3.0 Turbo Text-to-Video",
  "provider": "kling",
  "modality": "video",
  "description": "Generates a Kling 3.0 Turbo video from text.",
  "tags": ["kling", "3.0", "turbo", "video", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/kling-3.0-turbo-text-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3072
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "settings": {
        "type": "object",
        "properties": {
          "resolution": {
            "type": "string",
            "enum": ["720p", "1080p"],
            "default": "720p"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["16:9", "9:16", "1:1"],
            "default": "16:9"
          },
          "duration": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15,
            "default": 5
          }
        },
        "additionalProperties": false,
        "default": {}
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": []
}
