{
  "id": "freepik/magnific-style-transfer",
  "slug": "freepik--magnific-style-transfer",
  "displayName": "Magnific Style Transfer",
  "provider": "freepik",
  "modality": "image",
  "description": "Transfers a reference image's style onto another image (Magnific Style Transfer).",
  "tags": ["freepik", "magnific", "style-transfer", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["freepik/magnific-style-transfer"]
      },
      "prompt": {
        "type": "string",
        "description": "Prompt for the AI model.",
        "default": ""
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "engine": {
        "type": "string",
        "enum": [
          "balanced",
          "definio",
          "illusio",
          "3d_cartoon",
          "colorful_anime",
          "caricature",
          "real",
          "super_real",
          "softy"
        ],
        "description": "Processing engine selection."
      },
      "fixed_generation": {
        "type": "boolean",
        "description": "When disabled, expect each generation to introduce a degree of randomness.",
        "default": true
      },
      "flavor": {
        "type": "string",
        "enum": [
          "faithful",
          "gen_z",
          "psychedelia",
          "detaily",
          "clear",
          "donotstyle",
          "donotstyle_sharp"
        ],
        "description": "Style transfer flavor."
      },
      "portrait_beautifier": {
        "type": "string",
        "enum": ["none", "beautify_face", "beautify_face_max"],
        "description": "Facial beautification intensity for portraits. Only honored when portrait_mode === 'enabled'."
      },
      "portrait_mode": {
        "type": "string",
        "enum": ["disabled", "enabled"],
        "description": "Portrait mode (DynamicCombo parent — see file header)."
      },
      "portrait_style": {
        "type": "string",
        "enum": ["standard", "pop", "super_pop"],
        "description": "Visual style for portraits. Only honored when portrait_mode === 'enabled'."
      },
      "structure_strength": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Maintains the structure of the original image.",
        "default": 50
      },
      "style_strength": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Percentage of style strength.",
        "default": 100
      }
    },
    "required": ["model", "engine", "flavor", "portrait_mode"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "reference_image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
