{
  "id": "runway/gen4-image",
  "slug": "runway--gen4-image",
  "displayName": "Runway Gen-4 Image",
  "provider": "runway",
  "modality": "image",
  "description": "Generates an image from text at high resolution with optional reference image (Runway Gen-4 Image).",
  "tags": ["runway", "gen4-image", "text-to-image", "high-resolution"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["runway/gen4-image"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Text prompt for the generation. node.py:448-452 widget; validate_string(min_length=1) at execute."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "1920:1080",
          "1080:1920",
          "1024:1024",
          "1360:768",
          "1080:1080",
          "1168:880",
          "1440:1080",
          "1080:1440",
          "1808:768",
          "2112:912"
        ],
        "description": "The resolution (aspect ratio) of the output image."
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      }
    },
    "required": ["model", "prompt", "aspect_ratio"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
