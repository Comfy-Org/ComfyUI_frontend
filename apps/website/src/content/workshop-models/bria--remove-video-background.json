{
  "id": "bria/remove-video-background",
  "slug": "bria--remove-video-background",
  "displayName": "Bria Remove Video Background",
  "provider": "bria",
  "modality": "video",
  "description": "Removes the background from a video onto a chosen color matte (Bria).",
  "tags": ["bria", "background-removal", "video-edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["bria/remove-video-background"]
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed controls whether the node should re-run; results are non-deterministic regardless of seed.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["video"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "background_color": {
        "type": "string",
        "enum": [
          "Black",
          "White",
          "Gray",
          "Red",
          "Green",
          "Blue",
          "Yellow",
          "Cyan",
          "Magenta",
          "Orange"
        ],
        "description": "Background color for the output video."
      }
    },
    "required": ["model", "background_color"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "video",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
