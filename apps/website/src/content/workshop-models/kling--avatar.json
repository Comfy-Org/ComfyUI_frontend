{
  "id": "kling/avatar",
  "slug": "kling--avatar",
  "displayName": "Kling Avatar",
  "provider": "kling",
  "modality": "video",
  "description": "Animates a portrait into a talking-head video from a portrait + audio (Kling Avatar).",
  "tags": ["kling", "video", "avatar", "image-to-video", "audio"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/avatar"]
      },
      "prompt": {
        "type": "string",
        "maxLength": 2500,
        "description": "Optional prompt to define avatar actions, emotions, and camera movements. Empty → dropped from the wire body.",
        "default": ""
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["audio"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "mode": {
        "type": "string",
        "enum": ["std", "pro"],
        "description": "Video generation mode (std or pro)."
      }
    },
    "required": ["model", "mode"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "audio",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
