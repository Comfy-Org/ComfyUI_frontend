{
  "id": "freepik/magnific-relight",
  "slug": "freepik--magnific-relight",
  "displayName": "Magnific Relight",
  "provider": "freepik",
  "modality": "image",
  "description": "Adjusts lighting on an image, optionally transferring light from a reference image (Magnific Relight).",
  "tags": ["freepik", "magnific", "relight", "edit"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["freepik/magnific-relight"]
      },
      "prompt": {
        "type": "string",
        "description": "Descriptive guidance for lighting. Supports emphasis notation (1-1.4).",
        "default": ""
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["reference_image"]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["role", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "advanced_settings": {
        "type": "string",
        "enum": ["disabled", "enabled"],
        "description": "Advanced settings DynamicCombo parent (see file header DEVIATION 2)."
      },
      "blacks": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Adjusts the darkest tones in the image."
      },
      "brightness": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Overall brightness adjustment."
      },
      "change_background": {
        "type": "boolean",
        "description": "Modifies background based on prompt/reference.",
        "default": true
      },
      "contrast": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Contrast adjustment."
      },
      "engine": {
        "type": "string",
        "enum": [
          "automatic",
          "balanced",
          "cool",
          "real",
          "illusio",
          "fairy",
          "colorful_anime",
          "hard_transform",
          "softy"
        ],
        "description": "Processing engine selection (advanced)."
      },
      "fixed_generation": {
        "type": "boolean",
        "description": "Ensures consistent output with the same settings (advanced child)."
      },
      "interpolate_from_original": {
        "type": "boolean",
        "description": "Restricts generation freedom to match original more closely.",
        "default": false
      },
      "light_transfer_strength": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Intensity of light transfer application.",
        "default": 100
      },
      "preserve_details": {
        "type": "boolean",
        "description": "Maintains texture and fine details from original.",
        "default": true
      },
      "saturation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Color saturation adjustment."
      },
      "style": {
        "type": "string",
        "enum": [
          "standard",
          "darker_but_realistic",
          "clean",
          "smooth",
          "brighter",
          "contrasted_n_hdr",
          "just_composition"
        ],
        "description": "Stylistic output preference."
      },
      "transfer_light_a": {
        "type": "string",
        "enum": [
          "automatic",
          "low",
          "medium",
          "normal",
          "high",
          "high_on_faces"
        ],
        "description": "The intensity of light transfer (advanced)."
      },
      "transfer_light_b": {
        "type": "string",
        "enum": [
          "automatic",
          "composition",
          "straight",
          "smooth_in",
          "smooth_out",
          "smooth_both",
          "reverse_both",
          "soft_in",
          "soft_out",
          "soft_mid",
          "style_shift",
          "strong_shift"
        ],
        "description": "Light transfer modulation curve (advanced)."
      },
      "whites": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Adjusts the brightest tones in the image."
      }
    },
    "required": ["model", "advanced_settings", "style"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    },
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "single",
      "minItems": 0,
      "maxItems": 1
    }
  ]
}
