{
  "id": "kling/omni-pro-image",
  "slug": "kling--omni-pro-image",
  "displayName": "Kling OmniPro Image",
  "provider": "kling",
  "modality": "image",
  "description": "Generates an image with selectable 1K/2K/4K resolution and up to 10 reference images (Kling OmniPro Image).",
  "tags": ["kling", "image", "omni-pro", "text-to-image", "reference"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/omni-pro-image"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500,
        "description": "Text prompt (required, 1..2500 chars)."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1", "4:3", "3:4", "3:2", "2:3", "21:9"],
        "description": "Aspect ratio (8 options).",
        "default": "16:9"
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "model_name": {
        "type": "string",
        "enum": ["kling-v3-omni", "kling-image-o1"],
        "description": "OmniPro image model name."
      },
      "resolution": {
        "type": "string",
        "enum": ["1K", "2K", "4K"],
        "description": "Image resolution. Lower-cased at wire (deviation #9)."
      },
      "series_amount": {
        "type": "string",
        "enum": ["disabled", "2", "3", "4", "5", "6", "7", "8", "9"],
        "description": "Series generation count. Not supported for kling-image-o1."
      }
    },
    "required": [
      "model",
      "prompt",
      "model_name",
      "resolution",
      "series_amount"
    ],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": false,
      "cardinality": "many",
      "minItems": 0,
      "maxItems": 10
    }
  ]
}
