{
  "id": "fishaudio/text-to-speech",
  "slug": "fishaudio--text-to-speech",
  "displayName": "Fish Audio Text-to-Speech",
  "provider": "fishaudio",
  "modality": "audio",
  "description": "Synthesizes expressive speech with Fish Audio S2.1 Pro or S1, including up to five speakers.",
  "tags": ["fishaudio", "audio", "tts", "voice", "speech", "multi-speaker"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["fishaudio/text-to-speech"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 42
      },
      "normalize": {
        "type": "boolean",
        "default": true
      },
      "speed": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 2,
        "default": 1
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.7
      },
      "top_p": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 1,
        "default": 0.7
      },
      "variant": {
        "type": "string",
        "enum": ["s2.1-pro", "s1"],
        "default": "s2.1-pro"
      },
      "voice": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "Energetic Male (en)",
              "Friendly Women (en)",
              "Sarah (en)",
              "Verity (en)",
              "Polo (en)",
              "Adrian (en)",
              "E-girl (en)",
              "Narrator (en)",
              "Warm Conversational Voice (en)",
              "Warm Storyteller (en)",
              "Dramatic Character Male (en)",
              "News Narrator (zh)",
              "Lively Female (zh)",
              "Gentle Female (zh)",
              "Energetic Female (ja)",
              "Calm Female (ja)",
              "Calm Male (ja)"
            ]
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "description": "Curated Fish Audio voice or custom voice model ID."
      },
      "voices": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Energetic Male (en)",
                "Friendly Women (en)",
                "Sarah (en)",
                "Verity (en)",
                "Polo (en)",
                "Adrian (en)",
                "E-girl (en)",
                "Narrator (en)",
                "Warm Conversational Voice (en)",
                "Warm Storyteller (en)",
                "Dramatic Character Male (en)",
                "News Narrator (zh)",
                "Lively Female (zh)",
                "Gentle Female (zh)",
                "Energetic Female (ja)",
                "Calm Female (ja)",
                "Calm Male (ja)"
              ]
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "maxItems": 5,
        "default": [],
        "description": "Curated Fish Audio voices or custom voice model IDs."
      },
      "volume": {
        "type": "number",
        "minimum": -10,
        "maximum": 10,
        "default": 0
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": []
}
