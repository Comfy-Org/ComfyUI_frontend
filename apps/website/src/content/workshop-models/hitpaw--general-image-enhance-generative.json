{
  "id": "hitpaw/general-image-enhance-generative",
  "slug": "hitpaw--general-image-enhance-generative",
  "displayName": "HitPaw Image Enhance Generative",
  "provider": "hitpaw",
  "modality": "image",
  "description": "Upscales and enhances an image at 1x/2x/4x (HitPaw Generative).",
  "tags": ["hitpaw", "image-enhance", "upscale", "generative"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["hitpaw/general-image-enhance-generative"]
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "auto_downscale": {
        "type": "boolean",
        "description": "Automatically downscale input image if output would exceed the limit. L2 NO-OP (DEVIATION 1) — preserved for workflow parity; L3 fills in.",
        "default": false
      },
      "upscale_factor": {
        "anyOf": [
          {
            "type": "number",
            "enum": [1]
          },
          {
            "type": "number",
            "enum": [2]
          },
          {
            "type": "number",
            "enum": [4]
          }
        ],
        "description": "Upscale factor (1, 2, or 4)."
      }
    },
    "required": ["model", "upscale_factor"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
