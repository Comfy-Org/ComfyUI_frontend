{
  "id": "kling/text-to-video",
  "slug": "kling--text-to-video",
  "displayName": "Kling 2.5 Turbo Text-to-Video",
  "provider": "kling",
  "modality": "video",
  "description": "Generates a cinematic video clip from text (Kling 2.5 Turbo).",
  "tags": ["kling", "video", "text-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["kling/text-to-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500,
        "description": "Positive text prompt."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1"],
        "description": "Video aspect ratio.",
        "default": "16:9"
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "camera_control": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "simple",
              "down_back",
              "forward_up",
              "right_turn_forward",
              "left_turn_forward"
            ]
          },
          "config": {
            "type": "object",
            "properties": {
              "horizontal": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "vertical": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "pan": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "roll": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "tilt": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "zoom": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "description": "Optional camera-control object (typically built via createKlingCameraControl)."
      },
      "cfg_scale": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Classifier-free guidance scale.",
        "default": 1
      },
      "mode": {
        "type": "string",
        "enum": [
          "standard mode / 5s duration / kling-v1-6",
          "standard mode / 10s duration / kling-v1-6",
          "pro mode / 5s duration / kling-v2-master",
          "pro mode / 10s duration / kling-v2-master",
          "standard mode / 5s duration / kling-v2-master",
          "standard mode / 10s duration / kling-v2-master",
          "pro mode / 5s duration / kling-v2-1-master",
          "pro mode / 10s duration / kling-v2-1-master",
          "pro mode / 5s duration / kling-v2-5-turbo",
          "pro mode / 10s duration / kling-v2-5-turbo"
        ],
        "description": "Friendly configuration string. Decomposed at body assembly into the wire (mode, duration, model_name) triple.",
        "default": "pro mode / 5s duration / kling-v2-5-turbo"
      },
      "negative_prompt": {
        "type": "string",
        "description": "Negative text prompt. Empty string is dropped from the wire body.",
        "default": ""
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": true
  },
  "roles": []
}
