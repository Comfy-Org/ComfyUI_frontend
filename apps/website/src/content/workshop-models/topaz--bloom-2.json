{
  "id": "topaz/bloom-2",
  "slug": "topaz--bloom-2",
  "displayName": "Topaz Bloom 2",
  "provider": "topaz",
  "modality": "image",
  "description": "Creatively enhances and reinterprets an image with controllable grain (Topaz Bloom 2).",
  "tags": [
    "topaz",
    "bloom-2",
    "image-enhance",
    "creative-upscale",
    "image-to-image"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["topaz/bloom-2"]
      },
      "prompt": {
        "type": "string",
        "description": "Leave empty to auto-generate a prompt from the input image.",
        "default": ""
      },
      "seed": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "default": 2
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "color_preservation": {
        "type": "boolean",
        "description": "Preserve the original colors.",
        "default": true
      },
      "creativity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9,
        "default": 3
      },
      "grain": {
        "type": "boolean",
        "description": "Add grain to the output image.",
        "default": false
      },
      "grain_density": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5
      },
      "grain_model": {
        "type": "string",
        "enum": ["silver", "gaussian", "grey"],
        "default": "silver"
      },
      "grain_size": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "default": 1
      },
      "grain_strength": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5
      },
      "output_height": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32000,
        "description": "Zero value means to output in the same height as original or output width.",
        "default": 0
      },
      "output_width": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32000,
        "description": "Zero value means to calculate automatically (usually it will be original size or output_height if specified).",
        "default": 0
      }
    },
    "required": ["model"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "image",
      "required": true,
      "cardinality": "single",
      "minItems": 1,
      "maxItems": 1
    }
  ]
}
