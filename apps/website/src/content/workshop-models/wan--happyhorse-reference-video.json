{
  "id": "wan/happyhorse-reference-video",
  "slug": "wan--happyhorse-reference-video",
  "displayName": "HappyHorse Reference-to-Video",
  "provider": "wan",
  "modality": "video",
  "description": "Generates a video from up to nine reference images (HappyHorse).",
  "tags": ["wan", "happyhorse", "video", "reference-to-video"],
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "enum": ["wan/happyhorse-reference-video"]
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Prompt; use `character1`/`character2`/... to refer to references."
      },
      "aspect_ratio": {
        "type": "string",
        "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"],
        "description": "Aspect ratio."
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 15,
        "description": "Video duration in seconds (integer 3-15).",
        "default": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "description": "Seed.",
        "default": 0
      },
      "dispatch_mode": {
        "type": "string",
        "enum": ["sync", "async"],
        "description": "Dispatch mode. \"sync\" (default) blocks until the job completes. \"async\" submits the job and returns immediately with a job ID; poll completion via `job_get`. Named `dispatch_mode` (not bare `mode`) so it never collides with provider-specific `mode` knobs (freepik DynamicCombo, pixverse motion mode, meshy pose mode, …).",
        "default": "sync"
      },
      "medias": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["reference_image"]
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["role", "value"],
          "additionalProperties": false
        }
      },
      "resolution": {
        "type": "string",
        "enum": ["720P", "1080P"],
        "description": "Output video resolution tier (720P or 1080P)."
      },
      "watermark": {
        "type": "boolean",
        "description": "Watermark toggle.",
        "default": false
      }
    },
    "required": ["model", "prompt", "aspect_ratio", "resolution"],
    "additionalProperties": true
  },
  "roles": [
    {
      "role": "reference_image",
      "required": true,
      "cardinality": "many",
      "minItems": 1,
      "maxItems": 9
    }
  ]
}
