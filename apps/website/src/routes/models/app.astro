---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import CinematicStudioPage from '@/components/workshop/cinematic-studio/CinematicStudioPage.vue'
import { getRouterWorkshopModelDetail } from '@/config/workshop-router-content'
import {
  runnableCinematicModels,
  runnableCinematicVideoModels
} from '@/lib/workshop/cinematic-studio/models'
import { priceCinematicModels } from '@/lib/workshop/cinematic-studio/pricing'
import { appModels, appPagePaths } from '@/config/workshop-app-content'
import type { AppWorkshopModel } from '@/config/models-catalogue'
import { modelOgImage } from './model-page'
import {
  cmsEnabled,
  loadSiteCatalog,
  catalogUnavailable
} from '@/lib/cms/catalog'

export const getStaticPaths: GetStaticPaths = () => appPagePaths()

interface Props {
  readonly model: AppWorkshopModel
}

const catalog = cmsEnabled()
  ? await loadSiteCatalog(Astro.locals.site)
  : undefined
const failure = catalog && !catalog.ok ? catalogUnavailable() : undefined
if (failure) return failure
const liveApps = catalog?.ok
  ? catalog.models.filter((item) => item.type === 'APP')
  : appModels
const model = catalog?.ok
  ? liveApps.find(
      (item) =>
        item.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '')
    )
  : Astro.props.model
if (!model) return new Response('Not found', { status: 404 })
const app = model.appId

// Video models carry no estimate: the pricing rules have none that match a
// studio clip, so the credit gate only asks for a positive balance.
const models = [
  ...(await priceCinematicModels(
    runnableCinematicModels(getRouterWorkshopModelDetail),
    getRouterWorkshopModelDetail
  )),
  ...runnableCinematicVideoModels(getRouterWorkshopModelDetail)
]
if (!models.length) throw new Error('Cinematic Studio has no runnable models')
---

<BaseLayout
  title={`${model.name} - Comfy`}
  description={model.summary ?? Astro.locals.t('cinematic.meta.description')}
  ogImage={modelOgImage(model)}
  noindex
>
  <CinematicStudioPage
    apps={liveApps}
    models={models}
    initialApp={app}
    client:load
  />
  <noscript>
    <p class="p-8 text-center">
      {Astro.locals.t('cinematic.unavailable.title')}
    </p>
  </noscript>
</BaseLayout>
