---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { workshopModels } from '../../config/workshop-browse-content'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import { t } from '../../i18n/translations'
import type { TranslationKey } from '../../i18n/translations'
import type { CatalogueTab } from '../../lib/workshop/catalogue-tabs'
import {
  workshopEyebrowClass,
  workshopHeadingClass
} from '../../components/workshop/workshopHeadingClasses'
import { catalogueHubMeta } from './models-hub-meta'

interface Props {
  tab: CatalogueTab
}

const { tab } = Astro.props

const HEADING_KEYS = {
  models: 'workshop.catalogue.heading',
  workflows: 'workshop.hub.workflows',
  apps: 'workshop.catalogue.apps'
} as const satisfies Record<CatalogueTab, TranslationKey>

const directory = workshopModels.toSorted((a, b) =>
  a.name.localeCompare(b.name, 'en', { numeric: true })
)
const { title, description } = catalogueHubMeta(tab, workshopModels)
---

<BaseLayout {title} {description} preloadFonts={['Medium']}>
  <div
    class="mx-auto max-w-10xl px-6 pt-8 pb-4 max-sm:pt-5 lg:px-8 lg:pt-12 sm:short:pb-3"
  >
    <p class={workshopEyebrowClass}>
      {t('workshop.catalogue.eyebrow')}
    </p>
    <h1 class={workshopHeadingClass}>
      {tab === 'models'
        ? t(HEADING_KEYS[tab])
        : `ComfyUI ${t(HEADING_KEYS[tab])}`}
    </h1>
  </div>
  <ModelsPage catalogueTab={tab} client:load />
  {tab === 'models' && <section
    aria-labelledby="models-directory-heading"
    class="mx-auto max-w-10xl px-6 pb-16 max-sm:pb-10 lg:px-8 lg:pb-24"
    data-testid="models-directory"
  >
    <h2
      id="models-directory-heading"
      class="text-2xl font-medium text-primary-warm-white"
    >
      {t('workshop.catalogue.directory')}
    </h2>
    <ul class="mt-6 gap-x-8 sm:columns-2 lg:columns-3 xl:columns-4">
      {directory.map((entry) => <li class="break-inside-avoid py-1.5 text-sm">
        <a
          href={entry.href}
          class="text-primary-warm-white transition-colors hover:text-primary-comfy-yellow"
        >
          {entry.name}
        </a>
        {entry.provider && <span class="text-primary-warm-gray"
          >· {entry.provider}</span
        >}
      </li>)}
    </ul>
  </section>}
</BaseLayout>
