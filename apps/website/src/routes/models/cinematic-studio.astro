---
import { cinematicEnhancementModel } from '../../lib/workshop/cinematic-studio/enhancement-model'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CinematicStudioPage from '../../components/workshop/cinematic-studio/CinematicStudioPage.vue'
import { getRouterWorkshopModelDetail } from '../../config/workshop-router-content'
import { runnableCinematicEditingModels } from '../../lib/workshop/cinematic-studio/editing'
import { runnableCinematicModels } from '../../lib/workshop/cinematic-studio/models'
import { tc } from '../../lib/workshop/cinematic-studio/copy'

const enhancementModel = cinematicEnhancementModel()
const models = runnableCinematicModels(getRouterWorkshopModelDetail)
const editingModels = runnableCinematicEditingModels(
  getRouterWorkshopModelDetail
)
if (!models.length) throw new Error('Cinematic Studio has no runnable models')
---

<BaseLayout
  title={`${tc('cinematic.title')} - Comfy`}
  description={tc('cinematic.meta.description')}
  noindex
>
  <CinematicStudioPage
    enhancementModel={enhancementModel}
    editingModels={editingModels}
    models={models}
    client:load
  />
  <noscript>
    <p class="p-8 text-center">{tc('cinematic.unavailable.title')}</p>
  </noscript>
</BaseLayout>
