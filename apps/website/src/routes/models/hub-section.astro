---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import type { CatalogueTab } from '../../components/workshop/CatalogueTabs.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { HUB_APPS_PATH, HUB_WORKFLOWS_PATH } from '../../config/hub-models'
import { isIndexableModelPage } from '../../config/indexing'
import { t } from '../../i18n/translations'
import { HUB_SECTION_COPY } from './hub-section-copy'
import {
  workshopEyebrowClass,
  workshopHeadingClass
} from '../../components/workshop/workshopHeadingClasses'

const SECTIONS: Readonly<Record<string, Exclude<CatalogueTab, 'models'>>> = {
  [HUB_WORKFLOWS_PATH]: 'workflows',
  [HUB_APPS_PATH]: 'apps'
}
const section = SECTIONS[Astro.routePattern]
if (!section)
  throw new Error(`No hub section is built at ${Astro.routePattern}`)
const copy = HUB_SECTION_COPY[section]
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  noindex={!isIndexableModelPage(Astro.url.pathname)}
  preloadFonts={['Medium']}
>
  <ModelsPage section={section} client:load>
    <div
      slot="heading"
      class="mx-auto max-w-10xl px-6 pt-8 pb-4 max-sm:pt-5 lg:px-8 lg:pt-12 sm:short:pb-3"
    >
      <p class={workshopEyebrowClass}>
        {t('workshop.catalogue.eyebrow')}
      </p>
      <h1 class={workshopHeadingClass}>
        {copy.heading}
      </h1>
    </div>
    <ModelsShowcase slot="fallback" />
  </ModelsPage>
  <noscript>
    <ModelsShowcase />
  </noscript>
</BaseLayout>
