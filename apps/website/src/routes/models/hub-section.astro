---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { HUB_APPS_PATH } from '../../config/hub-models'
import { isIndexableModelPage } from '../../config/indexing'
import { t } from '../../i18n/translations'
import {
  workshopEyebrowClass,
  workshopHeadingClass
} from '../../components/workshop/workshopHeadingClasses'

const section = Astro.routePattern === HUB_APPS_PATH ? 'apps' : 'workflows'
const copy = {
  workflows: {
    title: t('hub.workflows.meta.title'),
    description: t('hub.workflows.meta.description'),
    heading: t('hub.workflows.heading')
  },
  apps: {
    title: t('hub.apps.meta.title'),
    description: t('hub.apps.meta.description'),
    heading: t('hub.apps.heading')
  }
}[section]
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  noindex={!isIndexableModelPage(Astro.url.pathname)}
  preloadFonts={['Medium']}
>
  <ModelsPage section={section} client:load>
    <div
      slot="heading"
      class="mx-auto max-w-10xl px-6 pt-8 pb-4 max-sm:pt-5 lg:px-8 lg:pt-12 sm:short:pb-3"
    >
      <p class={workshopEyebrowClass}>
        {t('workshop.catalogue.eyebrow')}
      </p>
      <h1 class={workshopHeadingClass}>{copy.heading}</h1>
    </div>
    <ModelsShowcase slot="fallback" />
  </ModelsPage>
  <noscript>
    <ModelsShowcase />
  </noscript>
</BaseLayout>
