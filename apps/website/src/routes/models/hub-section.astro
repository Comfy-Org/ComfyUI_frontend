---
import BaseLayout from '@/layouts/BaseLayout.astro'
import StaffContentActions from '@/components/cms/StaffContentActions.astro'
import { challengeBannerConfig } from '@/config/banner'
import ModelsPage from '@/components/workshop/ModelsPage.vue'
import CccModelsPage from '@/components/workshop/CccModelsPage.vue'
import CatalogNavigation from '@/components/workshop/CatalogNavigation.astro'
import type { CatalogueTab } from '@/components/workshop/CatalogueTabs.vue'
import ModelsShowcase from '@/components/models/ModelsShowcase.astro'
import { HUB_APPS_PATH, HUB_WORKFLOWS_PATH } from '@/config/hub-models'
import { isIndexableHubList } from '@/config/indexing'
import { pageContext } from '@/utils/jsonLd'
import { hubSectionJsonLd } from '@/utils/modelJsonLd'
import { withoutCatalogLocalePrefix } from '@/config/catalog-locales'
import { HUB_SECTION_COPY } from './hub-section-copy'
import { cmsEnabled, catalogUnavailable } from '@/lib/cms/catalog'
import { loadSiteCatalogList } from '@/lib/cms/catalog-list'

const SECTIONS: Readonly<Record<string, Exclude<CatalogueTab, 'models'>>> = {
  [HUB_WORKFLOWS_PATH]: 'workflows',
  [HUB_APPS_PATH]: 'apps'
}
const section = SECTIONS[withoutCatalogLocalePrefix(Astro.routePattern)]
if (!section)
  throw new Error(`No hub section is built at ${Astro.routePattern}`)
const catalog = cmsEnabled()
  ? await loadSiteCatalogList(
      Astro.locals.catalogAuthoring,
      Astro.locals.catalogLocale,
      section,
      Astro.url.searchParams
    )
  : undefined
const failure = catalog && !catalog.ok ? catalogUnavailable() : undefined
if (failure) return failure

const copy = HUB_SECTION_COPY[section]
const { t } = Astro.locals
const records = catalog?.ok
  ? catalog.models.filter((item) =>
      section === 'apps'
        ? item.type === 'APP'
        : item.type === 'CLOUD' || item.type === 'SERVERLESS'
    )
  : []
const { siteUrl, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const jsonLd = catalog?.ok
  ? hubSectionJsonLd({
      name: t(`workshop.hubSection.${section}.name`),
      homeName: t('breadcrumb.home'),
      items: records,
      url,
      siteUrl,
      locale: Astro.locals.catalogLocale ?? 'en',
      search: Astro.url.search
    })
  : undefined
---

<BaseLayout
  title={t(`workshop.hubSection.${section}.title`)}
  description={t(`workshop.hubSection.${section}.description`)}
  noindex={!isIndexableHubList(Astro.url.pathname)}
  {...jsonLd}
  preloadFonts={['Medium']}
  banner={challengeBannerConfig}
>
  {cmsEnabled() && <CatalogNavigation />}
  <StaffContentActions create type={section === 'apps' ? 'app' : 'workflow'} />
  <script>
    import '@/scripts/hubNavigation'
  </script>
  {cmsEnabled() ? (
    <CccModelsPage
      initialModels={catalog?.ok ? catalog.models : undefined}
      initialCatalogAvailable={catalog?.ok === true}
      initialPages={catalog?.ok ? catalog.pages : undefined}
      initialFacets={catalog?.ok ? catalog.facets : undefined}
      initialSearch={Astro.url.search}
      initialHeadings={
        catalog?.ok
          ? {
              models: Astro.locals.t('workshop.catalogue.heading'),
              workflows: HUB_SECTION_COPY.workflows.heading,
              apps: HUB_SECTION_COPY.apps.heading
            }
          : undefined
      }
      locale={Astro.locals.catalogLocale ?? 'en'}
      section={section}
      heading={copy.heading}
      client:load
      transition:persist={`ccc-hub-catalogue-${Astro.locals.catalogLocale ?? 'en'}`}
      transition:name={`ccc-hub-catalogue-${Astro.locals.catalogLocale ?? 'en'}`}
      transition:animate="none"
    >
      <ModelsShowcase slot="fallback" />
    </CccModelsPage>
  ) : (
    <ModelsPage
      locale={Astro.locals.catalogLocale ?? 'en'}
      section={section}
      heading={copy.heading}
      client:load
      transition:persist="hub-catalogue"
    >
      <ModelsShowcase slot="fallback" />
    </ModelsPage>
  )}
  <noscript>
    <ModelsShowcase />
  </noscript>
  {catalog?.ok && <noscript
    ><section class="mx-auto max-w-10xl px-6 pb-16 lg:px-8">
      <ul>
        {records.map((record) => <li>
          <a href={record.href}>{record.name}</a>
        </li>)}
      </ul>
    </section></noscript
  >}
  <section
    aria-labelledby="hub-section-intro-heading"
    class="mx-auto max-w-10xl px-6 pb-16 max-sm:pb-10 lg:px-8 lg:pb-24"
    data-testid="hub-section-intro"
  >
    <h2
      id="hub-section-intro-heading"
      class="text-xl font-medium text-primary-warm-white"
    >
      {t(`workshop.hubSection.${section}.introHeading`)}
    </h2>
    <p class="mt-3 max-w-3xl text-primary-warm-gray">
      {t(`workshop.hubSection.${section}.intro`)}
    </p>
  </section>
</BaseLayout>
