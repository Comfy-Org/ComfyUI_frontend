---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<BaseLayout
  title={t('workshop.credits.openingMetaTitle', locale)}
  description={t('workshop.credits.openingMetaDescription', locale)}
  noindex
>
  <main class="flex min-h-dvh items-center justify-center px-6 py-16">
    <div class="flex max-w-2xl flex-col items-center gap-6 text-center">
      <div
        class="flex size-20 items-center justify-center rounded-full border-2 border-primary-comfy-yellow text-primary-comfy-yellow"
        aria-hidden="true"
      >
        <span class="text-3xl">↗</span>
      </div>
      <p
        class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase"
      >
        {t('workshop.credits.openingLabel', locale)}
      </p>
      <h1 class="text-4xl font-bold text-primary-warm-white">
        {t('workshop.credits.openingTitle', locale)}
      </h1>
      <p class="text-primary-warm-gray">
        {t('workshop.credits.openingBody', locale)}
      </p>
    </div>
  </main>
</BaseLayout>
