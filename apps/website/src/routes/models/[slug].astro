---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import CatalogDetailPage from '@/components/workshop/CatalogDetailPage.vue'
import LegacyDetailPage from '@/components/workshop/LegacyDetailPage.astro'
import {
  HUB_MODELS_PATH,
  hubModelSlugs,
  hubWorkflowName
} from '@/config/hub-models'
import { workshopPagePaths } from '@/config/workshop-page-content'
import { cmsEnabled } from '@/lib/cms/catalog'

interface Props {
  id: string
}

export const getStaticPaths: GetStaticPaths = ({ routePattern }) =>
  routePattern.startsWith(HUB_MODELS_PATH)
    ? Array.from(hubModelSlugs, ([id, slug]) => ({
        params: { slug },
        props: { id }
      }))
    : workshopPagePaths.map((slug) => ({
        params: { slug: hubWorkflowName(slug) },
        props: { id: slug }
      }))

const catalog = cmsEnabled() && process.env.VERCEL_ENV !== 'production'
---

{catalog ? (
  <BaseLayout title="Comfy Hub" canonicalPath={Astro.url.pathname} noindex>
    <CatalogDetailPage
      path={Astro.url.pathname}
      locale={Astro.locals.catalogLocale ?? 'en'}
      client:load
    />
  </BaseLayout>
) : (
  <LegacyDetailPage id={Astro.props.id} />
)}
