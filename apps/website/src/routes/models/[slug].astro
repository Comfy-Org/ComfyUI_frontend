---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { routerWorkshopModelPaths } from '../../config/workshop-browse-content'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'
import { prepareModelPage } from './model-page'

export const getStaticPaths: GetStaticPaths = () =>
  routerWorkshopModelPaths.map((slug) => ({ params: { slug } }))

const page = await prepareModelPage(Astro.params.slug)
// Static output uses an immediate meta refresh, not an HTTP 301 response.
// Pre-launch aliases stay noindex; hosting-level permanent redirects are a
// separate deployment decision, not a reason to switch this site to SSR.
if (page.kind === 'redirect') return Astro.redirect(page.href, 301)
const { model } = page
const { locale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale
)
---

<BaseLayout
  title={`${model.name} · ${t('workshop.title', locale)} - Comfy`}
  description={t('workshop.model.meta.description', locale, {
    name: model.name
  })}
  ogImage={model.thumbnailUrl}
  noindex
>
  <ModelsPage slug={model.slug} locale={locale} client:load>
    <ModelsShowcase locale={locale} slot="fallback" />
  </ModelsPage>
  <noscript>
    <ModelsShowcase locale={locale} />
  </noscript>
</BaseLayout>
