---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelPage from '../../components/workshop/ModelPage.vue'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { HUB_MODELS_PATH, hubModelSlugs } from '../../config/hub-models'
import { workshopPagePaths } from '../../config/workshop-page-content'
import { modelDeveloper } from '../../config/model-vendors'
import { modelMetaDescription } from '../../lib/workshop/model-meta-description'
import { modelTitle } from '../../lib/workshop/model-title'
import { pageContext } from '../../utils/jsonLd'
import { modelPageJsonLd } from '../../utils/modelJsonLd'
import { modelOgImage, prepareModelPage } from './model-page'

interface Props {
  id: string
}

export const getStaticPaths: GetStaticPaths = ({ routePattern }) =>
  routePattern.startsWith(HUB_MODELS_PATH)
    ? Array.from(hubModelSlugs, ([id, slug]) => ({
        params: { slug },
        props: { id }
      }))
    : workshopPagePaths.map((slug) => ({
        params: { slug },
        props: { id: slug }
      }))

const page = await prepareModelPage(Astro.props.id)
// Static output uses an immediate meta refresh, not an HTTP 301 response.
// Pre-launch aliases stay noindex; hosting-level permanent redirects are a
// separate deployment decision, not a reason to switch this site to SSR.
if (page.kind === 'redirect') return Astro.redirect(page.href, 301)
const { model } = page
const { siteUrl, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const jsonLd = modelPageJsonLd({
  model,
  useCaseLabel: page.useCaseLabel,
  url,
  siteUrl,
  developer: modelDeveloper(model.provider)
})
const ogImage = modelOgImage(model)
---

<BaseLayout
  title={modelTitle(model)}
  description={modelMetaDescription(page)}
  ogImage={ogImage}
  ogImageAlt={ogImage && `${model.name} example output`}
  canonicalPath={model.href}
  noindex
  pageType={jsonLd.pageType}
  breadcrumbs={jsonLd.breadcrumbs}
  mainEntityId={jsonLd.mainEntityId}
  extraJsonLd={jsonLd.extraJsonLd}
>
  {model.routerId === undefined ? (
    <>
      <ModelsPage slug={model.slug} workflowId={model.workflowId} client:load>
        <ModelsShowcase slot="fallback" />
      </ModelsPage>
      <noscript>
        <ModelsShowcase />
      </noscript>
    </>
  ) : (
    <ModelPage
      page={{ ...page, model: { ...model, form: undefined } }}
      client:load
    />
  )}
</BaseLayout>
