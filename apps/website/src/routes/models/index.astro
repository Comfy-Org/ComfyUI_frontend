---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale
)
---

<BaseLayout
  title={t('models.meta.title', locale)}
  description={t('models.meta.description', locale)}
>
  <ModelsPage locale={locale} client:load>
    <ModelsShowcase locale={locale} slot="fallback" />
  </ModelsPage>
  <noscript>
    <ModelsShowcase locale={locale} />
  </noscript>
</BaseLayout>
