---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import ModelsShowcase from '../../components/models/ModelsShowcase.astro'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<BaseLayout
  title={t('modelsShowcase.meta.title', locale)}
  description={t('modelsShowcase.meta.description', locale)}
>
  <ModelsPage client:load locale={locale}>
    <ModelsShowcase slot="fallback" locale={locale} />
  </ModelsPage>
  <noscript>
    <ModelsShowcase locale={locale} />
  </noscript>
</BaseLayout>
