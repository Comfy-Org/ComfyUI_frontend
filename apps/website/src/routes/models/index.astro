---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsDirectory from '../../components/workshop/ModelsDirectory.vue'
import ModelsPage from '../../components/workshop/ModelsPage.vue'
import WorkshopHero from '../../components/workshop/WorkshopHero.vue'
import { workshopModels } from '../../config/workshop-browse-content'
---

{/* The catalogue is public content. The server renders every model as a
    plain link under its shelf; the island swaps in the searchable grid once
    it has loaded, and the Workshop flag decides nothing about this page. */}
<BaseLayout
  title="Models - Comfy"
  description="Run the world's leading AI models in ComfyUI. Browse every supported model with community workflow templates ready to run."
>
  <div
    class="mx-auto max-w-10xl px-6 pt-8 pb-16 max-sm:pt-5 max-sm:pb-10 lg:px-8 lg:pt-12 lg:pb-24"
  >
    <ModelsPage client:load>
      <Fragment slot="loading">
        <WorkshopHero subtitleKey="workshop.hero.subtitle" />
        <ModelsDirectory models={workshopModels} />
      </Fragment>
    </ModelsPage>
  </div>
</BaseLayout>
