---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CatalogChangeMedia from '@/components/cms/review/CatalogChangeMedia.vue'
import { loadRecordView } from '@/lib/cms/record-view'
const session = Astro.locals.catalogAuthoring
const data = await loadRecordView(
  session,
  Astro.params.uid,
  Astro.url.searchParams
)
if (!data.ok) return data.response
const t = Astro.locals.t
const canEdit =
  session?.can_edit && ['model', 'workflow', 'app'].includes(data.record.type)
---

<BaseLayout title={data.title} minimal noindex>
  <main class="mx-auto max-w-5xl px-5 py-8 font-admin text-admin-fg">
    <a href="/admin/catalog" class="text-sm underline"
      >{t('cccChangeDetails.back')}</a
    >
    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-2xl font-medium">{data.title}</h1>
      {canEdit && <a
        href={`/admin/content/${data.record.uid}/edit`}
        class="rounded-lg border border-admin-field px-3 py-2 text-sm"
        >{t('cccChangeDetails.edit')}</a
      >}
    </div>
    {data.record.is_deleted && <p class="mt-3 text-sm text-admin-danger-text">
      {t('cccChangeDetails.deleted')}
    </p>}
    <dl class="mt-5 grid gap-2 text-sm text-admin-muted">
      <div>
        <dt class="inline">{t('cccChangeDetails.recordType')}:</dt>
        <dd class="inline">{data.record.type}</dd>
      </div>
      <div>
        <dt class="inline">{t('cccChangeDetails.recordUID')}:</dt>
        <dd class="inline break-all">{data.record.uid}</dd>
      </div>
      <div>
        <dt class="inline">{t('cccChangeDetails.version')}:</dt>
        <dd class="inline break-all">{data.record.revision_uid}</dd>
      </div>
      <div>
        <dt class="inline">{t('cccChangeDetails.author')}:</dt>
        <dd class="inline break-all">{data.record.author_uid}</dd>
      </div>
    </dl>
    {data.preview && <div class="mt-6">
      <CatalogChangeMedia
        preview={data.preview}
        label={t('cccChangeDetails.previewFor', { title: data.title })}
        unavailable={t('cccChangeDetails.unavailable')}
        expanded
        client:load
      />
    </div>}
    {data.record.type === 'media' ? (
      <section class="mt-6">
        <h2 class="text-lg font-medium">{t('cccChangeDetails.usedBy')}</h2>
        {data.presentation?.uses?.length ? (
          <ul class="mt-3 grid gap-3">
            {data.presentation.uses.map((use) => <li>
              <a
                href={`/admin/content/${use.uid}/view`}
                class="text-sm underline"
                >{use.title}</a
              >{use.origin && <span class="ml-2 text-xs text-admin-muted"
                >{t('cccChangeDetails.uploadSource')}</span
              >}<code class="block text-xs break-all text-admin-muted"
                >{use.uid}</code
              >
            </li>)}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-admin-muted">
            {t(
              data.presentation?.uses
                ? 'cccChangeDetails.noUses'
                : 'cccChangeDetails.contextUnavailable'
            )}
          </p>
        )}
      </section>
    ) : (
      <section class="mt-6">
        <h2 class="text-lg font-medium">{t('cccChangeDetails.document')}</h2>
        <pre
          class="mt-3 overflow-x-auto rounded-lg border border-admin-line bg-admin-chrome p-4 text-xs break-all whitespace-pre-wrap"
        >{JSON.stringify(data.document, null, 2)}</pre>
      </section>
    )}
  </main>
</BaseLayout>
