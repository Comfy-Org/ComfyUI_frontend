---
import { adminButtonVariants } from '@/components/cms/ui/adminButton'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { isLocalAccess } from './local-access'
if (!isLocalAccess(Astro)) return new Response('Not found', { status: 404 })
const t = Astro.locals.t
---

<BaseLayout title={t('cmsAdmin.title')} bare noindex>
  <section
    class="grid min-h-screen place-items-center bg-admin-page px-4 font-admin text-admin-fg"
  >
    <div
      class="grid w-full max-w-sm gap-4 rounded-xl border border-admin-line bg-admin-card p-6"
    >
      <div class="grid gap-1">
        <p class="text-xs text-admin-muted">{t('cmsAdmin.localReview')}</p>
        <h1 class="text-admin-title leading-tight">{t('cmsAdmin.title')}</h1>
      </div>
      <p class="text-sm leading-relaxed text-admin-muted">
        {t('cmsAdmin.localHelp')}
      </p>
      <form method="post" action="/admin/local-session" data-astro-reload>
        <button
          class={adminButtonVariants({
            variant: 'primary',
            size: 'lg',
            class: 'w-full'
          })}
        >
          {t('cmsAdmin.openAdmin')}
        </button>
      </form>
      <a
        href="/hub/models/"
        class="text-xs text-admin-muted hover:text-admin-fg"
        >← {t('cmsAdmin.hub')}</a
      >
    </div>
  </section>
</BaseLayout>
