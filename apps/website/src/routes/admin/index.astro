---
import type { SiteSubmission } from '@comfyorg/ingest-types'
import { zSiteSubmission } from '@comfyorg/ingest-types/zod'
import AdminShell from '@/components/cms/AdminShell.astro'
import ContentList from '@/components/cms/ContentList.vue'
import DraftQueue from '@/components/cms/DraftQueue.vue'
import RollbackButton from '@/components/cms/RollbackButton.vue'
import PageHeader from '@/components/cms/ui/PageHeader.vue'
import StatusLabel from '@/components/cms/ui/StatusLabel.vue'
import { resolveLocale } from '@/config/locales'
import { siteAPI } from '@/lib/cms/admin'
import { formatUtc } from '@/lib/cms/format'
import { buildQueue, contentRows } from '@/lib/cms/queue'

const session = Astro.locals.site
if (!session) return new Response('Not found', { status: 404 })
const t = Astro.locals.t
const locale = resolveLocale(Astro.currentLocale)
const page = Astro.params.page?.replace(/\/$/, '') ?? ''
if (!['', 'content', 'history'].includes(page))
  return new Response('Not found', { status: 404 })
const review = session.review

const response = await siteAPI(
  '/admin/api/site/submissions',
  session.credential
)
const parsed = response.ok
  ? zSiteSubmission.array().safeParse(await response.json())
  : undefined
const submissions: SiteSubmission[] = parsed?.success ? parsed.data : []
const queue = buildQueue(review, submissions)
const rows = contentRows(review)
const revertTarget = review.history.find(
  (event) => event.action === 'PUBLISH' || event.action === 'REVERT'
)
---

<AdminShell
  current={page === '' ? 'draft' : (page as 'content' | 'history')}
  draftCount={queue.length}
  contentCount={rows.length}
>
  {!parsed?.success && page === '' && <p
    role="alert"
    class="mb-5 rounded-lg border border-admin-danger/30 bg-admin-danger/10 px-3 py-2 text-xs text-admin-danger-text"
  >
    {t('cmsAdmin.unavailable')}
  </p>}
  {page === '' && (
    <DraftQueue
      client:load
      items={queue}
      csrf={session.csrf}
      canApply={review.can_apply}
      draftId={review.draft.revision_id}
      generation={review.draft.generation}
      locale={locale}
    />
  )}
  {page === 'content' && (
    <ContentList client:load rows={rows} locale={locale} />
  )}
  {page === 'history' && <div class="grid gap-5">
    <PageHeader
      title={t('cmsAdmin.history.title')}
      description={t('cmsAdmin.history.help')}
    />
    {review.history.length === 0 && <p
      class="rounded-lg border border-dashed border-admin-line px-6 py-14 text-center text-xs text-admin-muted"
    >
      {t('cmsAdmin.history.empty')}
    </p>}
    {review.history.length > 0 && <ol
      class="overflow-hidden rounded-lg border border-admin-line"
    >
      {review.history.map((event) => {
        const current = event === revertTarget
        return <li
          class:list={[
            'flex min-h-14 flex-wrap items-center gap-x-4 gap-y-1 border-b border-admin-hover px-4 py-2 text-sm last:border-b-0',
            current && 'bg-admin-hover'
          ]}
        >
          <div class="grid min-w-0 flex-1 gap-1">
            <p class="flex flex-wrap items-center gap-3">
              {t(`cmsAdmin.history.action.${event.action}`)}
              {current && (
                <StatusLabel
                  tone="success"
                  label={t('cmsAdmin.history.liveNow')}
                />
              )}
            </p>
            <p class="text-xs text-admin-muted">
              <time datetime={event.created_at}>
                {formatUtc(event.created_at, locale)}
              </time
              >{' '} · {t('cmsAdmin.history.by', { actor: event.actor_uid })}
              {(event.action === 'PUBLISH' || event.action === 'REVERT') &&
                ` · ${t('cmsAdmin.history.revision', { revision: event.target_id })}`}
            </p>
          </div>
          {current && review.can_apply && review.previous_live_id && (
            <RollbackButton
              client:load
              csrf={session.csrf}
              liveId={review.live.revision_id}
              locale={locale}
            />
          )}
        </li>
      })}
    </ol>}
  </div>}
</AdminShell>
