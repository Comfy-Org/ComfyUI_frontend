---
import WorkflowNodeGraphPage from '@/components/workshop/WorkflowNodeGraphPage.vue'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  nodeGraphWorkflowSample,
  nodeGraphWorkflowWithApiSample
} from '@/lib/hub/node-graph-workflow'

const workflow = Astro.url.pathname.includes('node-graph-workflow-api')
  ? nodeGraphWorkflowWithApiSample
  : nodeGraphWorkflowSample
---

<BaseLayout
  title={`${workflow.name} - Comfy`}
  description={workflow.summary}
  noindex
>
  <p
    class="bg-transparency-white-t8 px-6 py-2 text-center text-xs text-primary-warm-gray"
    data-testid="design-preview-notice"
  >
    {Astro.locals.t('workshop.nodeGraph.previewNotice')}
  </p>
  <WorkflowNodeGraphPage
    workflow={workflow}
    locale={Astro.currentLocale === 'zh-CN' ? 'zh-CN' : 'en'}
    client:load
  />
</BaseLayout>
