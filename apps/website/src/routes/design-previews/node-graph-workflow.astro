---
import NodeGraphWorkflowPreview from '@/components/design-previews/NodeGraphWorkflowPreview.vue'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { nodeGraphSampleInputs } from '@/lib/hub/node-graph-sample-inputs'
import { nodeGraphWorkflowSample as workflow } from '@/lib/hub/node-graph-workflow'

const inputs = await nodeGraphSampleInputs()
---

<BaseLayout
  title={`${workflow.name} - Comfy`}
  description={workflow.summary}
  noindex
>
  <p
    class="bg-transparency-white-t8 px-6 py-2 text-center text-xs text-primary-warm-gray"
    data-testid="design-preview-notice"
  >
    {Astro.locals.t('workshop.nodeGraph.previewNotice')}
  </p>
  <NodeGraphWorkflowPreview
    inputs={inputs}
    locale={Astro.currentLocale === 'zh-CN' ? 'zh-CN' : 'en'}
    client:load
  />
</BaseLayout>
