---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CatalogueBackLink from '../../components/workshop/CatalogueBackLink.vue'
import HubWorkflowCard from '../../components/hub/HubWorkflowCard.vue'
import { workshopModels } from '../../config/workshop-browse-content'
import { partnerModelFor } from '../../lib/hub/template-use-case'
import { tagDisplayName } from '../../lib/hub/tag-aliases'
import { hubWorkflowUrl } from '../../lib/hub/routes'
import {
  getHubWorkflowPage,
  listHubWorkflows,
  templatePath
} from '../../lib/hub/workflow-detail'
import { t } from '../../i18n/translations'

export function getStaticPaths() {
  return listHubWorkflows().map((template) => ({
    params: { name: template.name }
  }))
}

const { name } = Astro.params
const page = name ? getHubWorkflowPage(name) : undefined
if (!page) return Astro.redirect('/templates/')

const { template, mediaType, details, inputs, outputs, related } = page
const runsOn = partnerModelFor(template, workshopModels)
const author = template.username || 'ComfyUI'
const kindLabel = template.isApp
  ? t('workshop.workflow.comfyApp')
  : t('workshop.workflow.nodeGraph')
const mediaLabel: Record<string, string> = {
  image: t('workshop.hub.io.image'),
  video: t('workshop.hub.io.video'),
  audio: t('workshop.hub.io.audio'),
  '3d': t('workshop.hub.io.3d')
}
const downloadUrl = `https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/${encodeURIComponent(template.name)}.json`
const sectionTitleClass =
  'text-xs font-bold tracking-wider text-primary-comfy-canvas uppercase'
const pillClass =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-2xs leading-none font-bold tracking-wider text-primary-warm-white uppercase'
---

<BaseLayout
  title={`${template.title} - Comfy`}
  description={details.description ?? template.title}
  ogImage={template.thumbnails[0]}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 py-10 lg:px-8 lg:py-14">
    <CatalogueBackLink client:load class="mb-8" />

    <header class="mb-12 flex flex-col gap-4" data-testid="workflow-hero">
      <div class="flex flex-wrap items-center gap-3">
        <p
          class="text-sm leading-none font-medium tracking-widest text-primary-comfy-yellow uppercase"
          data-testid="workflow-author"
        >
          {author}
        </p>
        <span class={pillClass}>{kindLabel}</span>
        {mediaLabel[mediaType] && <span class={pillClass}>{mediaLabel[mediaType]}</span>}
      </div>
      <h1 class="max-w-3xl text-3xl font-bold text-primary-comfy-canvas lg:text-4xl">
        {template.title}
      </h1>
      {
        details.description && (
          <p
            class="max-w-3xl text-base leading-relaxed text-primary-comfy-canvas/80"
            data-testid="workflow-summary"
          >
            {details.description}
          </p>
        )
      }
    </header>

    <section class="grid gap-10 lg:grid-cols-12" data-testid="workflow-about">
      <div class="flex flex-col gap-10 lg:col-span-7">
        <div data-testid="workflow-graph">
          <h2 class={sectionTitleClass}>{t('workshop.workflow.graph')}</h2>
          <p class="mt-3 max-w-xl text-sm text-primary-comfy-canvas/80">
            {t('workshop.workflow.graphNote')}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-5">
            <a
              href={hubWorkflowUrl(template.name)}
              target="_blank"
              rel="noopener"
              class="hover:bg-primary-comfy-yellow hover:text-primary-comfy-ink border-primary-comfy-yellow text-primary-comfy-yellow inline-flex h-9 items-center rounded-full border px-4 text-xs font-bold tracking-wider uppercase transition-colors"
              data-testid="workflow-open"
            >
              {t('workshop.workflow.openComfy')}
            </a>
            <a
              href={downloadUrl}
              download
              class="text-xs text-primary-warm-gray transition-colors hover:text-primary-warm-white"
            >
              {t('workshop.workflow.download')}
            </a>
          </div>
        </div>

        {
          (details.requiresCustomNodes?.length ?? 0) > 0 && (
            <div data-testid="workflow-custom-nodes">
              <h2 class={sectionTitleClass}>
                {t('workshop.workflow.customNodes')}
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {details.requiresCustomNodes?.map((node) => (
                  <li class="inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 font-mono text-xs leading-none text-primary-comfy-canvas">
                    {node}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div data-testid="workflow-tags">
          <h2 class={sectionTitleClass}>{t('workshop.filter.label')}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              template.tags.map((tag) => (
                <li>
                  <a
                    href={`/templates/?tag=${encodeURIComponent(tag)}`}
                    class="hover:text-primary-comfy-yellow inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-xs leading-none text-primary-comfy-canvas transition-colors hover:bg-transparency-white-t20"
                  >
                    {tagDisplayName(tag)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-5">
        <div
          class="bg-transparency-white-t4 rounded-2xl border border-transparency-white-t8 p-5"
          data-testid="workflow-runs-on"
        >
          <h2 class={sectionTitleClass}>{t('templates.runsOn')}</h2>
          {
            runsOn ? (
              <Fragment>
                <p class="mt-3 text-sm text-primary-comfy-canvas/80">
                  {t('templates.runsOnNote')}
                </p>
                <a
                  href={runsOn.href}
                  class="focus-visible:ring-primary-comfy-yellow/50 mt-4 inline-flex h-10 items-center rounded-2xl bg-transparency-white-t8 px-5 text-xs font-bold tracking-wider text-primary-comfy-canvas uppercase transition-colors outline-none hover:bg-transparency-white-t20 focus-visible:ring-3"
                  data-testid="workflow-try-model"
                >
                  {t('templates.tryModel').replace('{model}', runsOn.name)}
                </a>
              </Fragment>
            ) : (
              <ul class="mt-3 flex flex-wrap gap-2">
                {template.models.map((model) => (
                  <li class="inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-xs leading-none text-primary-comfy-canvas">
                    {model}
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div
          class="bg-transparency-white-t4 rounded-2xl border border-transparency-white-t8 p-5"
          data-testid="workflow-io"
        >
          <h2 class={sectionTitleClass}>{t('workshop.workflow.io')}</h2>
          <div class="mt-4 flex flex-col gap-6">
            {
              [
                { title: t('workshop.workflow.inputs'), rows: inputs },
                { title: t('workshop.workflow.outputs'), rows: outputs }
              ].map((group) => (
                <div>
                  <h3 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
                    {group.title}
                  </h3>
                  <dl class="mt-2 flex flex-col divide-y divide-transparency-white-t8">
                    {group.rows.map((row) => (
                      <div class="flex items-center justify-between gap-3 py-2 text-xs">
                        <dt class="text-primary-comfy-canvas">{row.name}</dt>
                        <dd class="font-mono text-primary-warm-gray">{row.type}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      related.length > 0 && (
        <section
          class="mt-24 border-t border-transparency-white-t8 pt-12"
          data-testid="workflow-related"
        >
          <h2 class={sectionTitleClass}>{t('workshop.workflow.related')}</h2>
          <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.slice(0, 6).map((other) => (
              <li>
                <HubWorkflowCard
                  template={other}
                  href={templatePath(other.name)}
                  tryNowLabel={t('workshop.hub.tryNow')}
                  client:visible
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
