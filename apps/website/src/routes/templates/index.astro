---
import BaseLayout from '../../layouts/BaseLayout.astro'
import HubBrowse from '../../components/hub/HubBrowse.vue'
import { workshopModels } from '../../config/workshop-browse-content'
import { t } from '../../i18n/translations'
---

<BaseLayout
  title={t('templates.meta.title')}
  description={t('templates.meta.description')}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 pt-8 pb-16 max-sm:pt-5 max-sm:pb-10 lg:px-8 lg:pt-12 lg:pb-24">
    <HubBrowse models={workshopModels} withModels={false} client:load />
  </div>
</BaseLayout>
