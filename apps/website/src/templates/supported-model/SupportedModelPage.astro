---
import type { Crumb } from '@/utils/jsonLd'
import BaseLayout from '@/layouts/BaseLayout.astro'
import FAQSplit01 from '@/components/blocks/FAQSplit01.vue'
import ModelHeroSection from '@/components/models/ModelHeroSection.vue'
import ModelFileTrail from '@/components/workshop/ModelFileTrail.vue'
import ModelFileUsedBy from '@/components/workshop/ModelFileUsedBy.vue'
import type { WorkflowWorkshopModel } from '@/config/models-catalogue'
import type { Model } from '@/config/models'
import { buildModelLlmsLinks } from '@/config/model-llms'
import {
  absoluteUrl,
  jsonLdId,
  pageContext,
  softwareApplicationNode
} from '@/utils/jsonLd'
import { buildModelFaqs, modelFaqJsonLd } from '@/utils/modelFaq'
import { getPageDescription } from '@/utils/modelSeoCopy'

interface Props {
  model: Model
  /** The address search engines should index when it is not this one. */
  canonicalPath?: string
  /** Set at the Hub address: the page joins the Hub's models. */
  hub?: { usedBy: readonly WorkflowWorkshopModel[] }
}

const { model, canonicalPath, hub } = Astro.props

const { displayName } = model

// fal-style LLMs surface: markdown twin + agent handoff links.
const llms = buildModelLlmsLinks(model.slug, displayName, Astro.site)

const pageTitle = `${displayName} in ComfyUI`
const pageDescription = getPageDescription(model)

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  canonicalPath ?? Astro.url.pathname,
  Astro.currentLocale
)
const softwareId = jsonLdId(url, 'software')
const software = softwareApplicationNode({
  siteUrl,
  id: softwareId,
  name: displayName,
  url,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any'
})
const faqs = buildModelFaqs(model, locale)
const whatIsDescription = faqs[0].answer
const faqPage = modelFaqJsonLd(faqs, jsonLdId(url, 'faq'))

// Backlink the leading "{displayName}" in the What-is paragraph to the
// model's own site when configured (e.g. MiniMax -> design.minimax.io),
// without touching the JSON-LD/FAQ-accordion copies of the same string.
const whatIsBacklinkUrl =
  model.whatIsBacklinkUrl && whatIsDescription.startsWith(displayName)
    ? model.whatIsBacklinkUrl
    : undefined
const whatIsRest = whatIsBacklinkUrl
  ? whatIsDescription.slice(displayName.length)
  : whatIsDescription

const breadcrumbs: Crumb[] = hub
  ? [
      {
        name: Astro.locals.t('workshop.catalogue.eyebrow'),
        url: absoluteUrl(Astro.site, '/hub/')
      },
      {
        name: Astro.locals.t('workshop.model.breadcrumb'),
        url: absoluteUrl(Astro.site, '/hub/models/')
      },
      { name: displayName }
    ]
  : [
      {
        name: Astro.locals.t('breadcrumb.home'),
        url: absoluteUrl(Astro.site, '/')
      },
      {
        name: Astro.locals.t('models.breadcrumb.models'),
        url: absoluteUrl(Astro.site, '/p/supported-models/')
      },
      { name: displayName }
    ]
---

<BaseLayout
  title={`${pageTitle} - Comfy`}
  description={pageDescription}
  ogImage={model.thumbnailUrl}
  mainEntityId={softwareId}
  canonicalPath={canonicalPath}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[software, faqPage]}
>
  {hub && <ModelFileTrail name={displayName} client:load />}
  <div class="mx-auto flex max-w-7xl justify-end px-6 pt-6 lg:px-8">
    <div class="relative" id="llms-wrap" data-md={llms.mdPath}>
      <button
        id="llms-btn"
        aria-haspopup="true"
        aria-expanded="false"
        class="cursor-pointer rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-[11px] font-extrabold tracking-widest text-primary-comfy-canvas hover:bg-white/10"
      >
        {Astro.locals.t('models.llms.button')} ▾
      </button>
      <div
        id="llms-menu"
        class="absolute top-full right-0 z-40 mt-1.5 hidden w-60 overflow-hidden rounded-xl border border-white/15 bg-primary-comfy-ink py-1.5 shadow-2xl"
      >
        <button
          id="llms-copy"
          class="block w-full cursor-pointer px-4 py-2.5 text-left text-xs text-primary-comfy-canvas hover:bg-white/5"
        >
          {Astro.locals.t('models.llms.copy')}<span
            id="llms-copied"
            class="hidden pl-2 text-primary-comfy-yellow"
            >✓</span
          >
        </button>
        <a
          href={llms.mdPath}
          class="block px-4 py-2.5 text-xs text-primary-comfy-canvas hover:bg-white/5"
        >
          {Astro.locals.t('models.llms.view')}
        </a>
        <a
          href="/p/supported-models/llms.txt"
          class="block px-4 py-2.5 text-xs text-primary-comfy-canvas hover:bg-white/5"
        >
          {Astro.locals.t('models.llms.catalog')}
        </a>
        <div class="my-1 border-t border-white/10"></div>
        <a
          href={llms.claudeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-2.5 text-xs text-primary-comfy-canvas hover:bg-white/5"
        >
          {Astro.locals.t('models.llms.openClaude')} ↗
        </a>
        <a
          href={llms.chatgptUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-2.5 text-xs text-primary-comfy-canvas hover:bg-white/5"
        >
          {Astro.locals.t('models.llms.openChatgpt')} ↗
        </a>
      </div>
    </div>
  </div>

  <ModelHeroSection
    displayName={displayName}
    huggingFaceUrl={model.huggingFaceUrl}
    docsUrl={model.docsUrl}
    blogUrl={model.blogUrl}
    hubSlug={model.hubSlug}
    workflowCount={model.workflowCount}
    directory={model.directory}
  />

  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <h2 class="text-2xl font-bold text-primary-comfy-canvas lg:text-3xl">
      {Astro.locals.t('models.whatIs.heading', { name: displayName })}
    </h2>
    <p
      class="mt-4 max-w-3xl text-base/relaxed text-primary-comfy-canvas/70 lg:text-lg/relaxed"
    >
      {whatIsBacklinkUrl ? (
        <>
          <a
            href={whatIsBacklinkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-comfy-yellow hover:underline"
          >
            {displayName}
          </a>
          {whatIsRest}
        </>
      ) : (
        whatIsDescription
      )}
    </p>
    {model.docsUrl && <a
      href={model.docsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-block text-primary-comfy-yellow hover:underline"
    >
      {Astro.locals.t('models.whatIs.tutorialLink')}
    </a>}
  </section>

  <section>
    {/* TODO: workflow gallery — pulls from hub API */}
  </section>

  <section>
    {/* TODO: shared HowComfyWorks component */}
  </section>

  {hub && hub.usedBy.length > 0 && (
    <ModelFileUsedBy workflows={hub.usedBy} client:visible />
  )}

  <FAQSplit01
    heading={Astro.locals.t('models.faq.heading')}
    faqs={faqs}
    client:visible
  />
</BaseLayout>

<script>
  // One delegated document listener: it queries elements at event time, so it
  // survives ClientRouter DOM swaps without rebinding and never piles up.
  function setLlmsMenuOpen(open: boolean) {
    const btn = document.getElementById('llms-btn')
    const menu = document.getElementById('llms-menu')
    if (!btn || !menu) return
    menu.classList.toggle('hidden', !open)
    btn.setAttribute('aria-expanded', String(open))
  }

  async function copyLlmsMarkdown() {
    const wrap = document.getElementById('llms-wrap')
    const mdUrl = wrap instanceof HTMLElement ? wrap.dataset.md : undefined
    if (!mdUrl) return
    try {
      const md = await (await fetch(mdUrl)).text()
      await navigator.clipboard.writeText(md)
      const check = document.getElementById('llms-copied')
      check?.classList.remove('hidden')
      window.setTimeout(() => {
        check?.classList.add('hidden')
        setLlmsMenuOpen(false)
      }, 1200)
    } catch {
      /* fetch or clipboard unavailable */
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null
    if (!target) return
    if (target.closest('#llms-btn')) {
      const menu = document.getElementById('llms-menu')
      setLlmsMenuOpen(menu?.classList.contains('hidden') ?? false)
      return
    }
    if (target.closest('#llms-copy')) {
      void copyLlmsMarkdown()
      return
    }
    if (!target.closest('#llms-wrap')) setLlmsMenuOpen(false)
  })
</script>
