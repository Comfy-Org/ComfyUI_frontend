---
import VideoCompareSlider from '@/components/common/VideoCompareSlider.vue'
import CopyTextButton from '@/components/ui/copy-text-button/CopyTextButton.vue'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ModelLaunchHeroSection from './ModelLaunchHeroSection.vue'
import ModelLaunchGallerySection from './ModelLaunchGallerySection.vue'
import ModelLaunchStepsSection from './ModelLaunchStepsSection.vue'
import ModelLaunchFaqSection from './ModelLaunchFaqSection.vue'
import ModelLaunchCtaSection from './ModelLaunchCtaSection.vue'
import { krea3Page } from '@/data/krea3'
import { resolveLocale } from '@/config/locales'

const locale = resolveLocale(Astro.currentLocale)
const { t } = Astro.locals
---

<BaseLayout
  title={t('krea3.meta.title')}
  description={t('krea3.meta.description')}
  noindex
  hideAnnouncementBanner
>
  <ModelLaunchHeroSection client:load hero={krea3Page.hero} locale={locale} />
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-20 lg:py-24">
    <h2
      class="mx-auto mb-12 max-w-3xl text-center text-3xl font-light tracking-tight text-primary-comfy-canvas lg:text-5xl/tight"
    >
      {t(krea3Page.comparison.headingKey)}
    </h2>
    <VideoCompareSlider
      client:visible
      mediaKind="image"
      beforeSrc={krea3Page.comparison.beforeSrc}
      afterSrc={krea3Page.comparison.afterSrc}
      beforeLabel={t('modelLaunch.beforeAfter.before')}
      afterLabel={t('modelLaunch.beforeAfter.after')}
      sliderLabel={t('modelLaunch.beforeAfter.sliderLabel')}
      class="rounded-4.5xl"
    />
    <div
      class="mt-6 flex items-center justify-between gap-4 rounded-2xl border border-transparency-white-t8 p-6"
    >
      <p class="text-sm font-light text-primary-comfy-canvas">
        {krea3Page.comparison.prompt[locale] || krea3Page.comparison.prompt.en}
      </p>
      <CopyTextButton
        client:visible
        value={
          krea3Page.comparison.prompt[locale] || krea3Page.comparison.prompt.en
        }
        label={t('modelLaunch.copyPrompt')}
        copiedLabel={t('ui.copied')}
      />
    </div>
  </section>
  {krea3Page.galleries.map((gallery) => (
    <ModelLaunchGallerySection
      client:visible
      gallery={gallery}
      locale={locale}
    />
  ))}
  <div id="edit-workflow" class="scroll-mt-24">
    <ModelLaunchStepsSection steps={krea3Page.steps} locale={locale} />
  </div>
  <ModelLaunchFaqSection client:visible faq={krea3Page.faq} locale={locale} />
  <ModelLaunchCtaSection cta={krea3Page.closingCta} locale={locale} />
</BaseLayout>
