---
import ProductCard from '../../components/common/ProductCard.vue'
import { productCards } from '../../data/developers'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

{/* The design's 8px gutters and no surface behind the row: the cards sit
    straight on the subbrand page background. The row gap goes to zero at `lg`
    because each card subgrids its three rows onto this grid there, and a
    subgrid inherits the parent's gutters between them. */}
<section class="max-w-9xl mx-auto px-6 py-8 lg:px-20 lg:py-10">
  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4 lg:gap-y-0">
    {
      productCards.map((card) => (
        <ProductCard
          tone="light"
          title={t(`developers.cards.${card.key}.title`, locale)}
          description={t(`developers.cards.${card.key}.description`, locale)}
          cta={t(`developers.cards.${card.key}.cta`, locale)}
          href={card.href}
        />
      ))
    }
  </div>
</section>
