---
import CompareCards01 from '../../components/blocks/CompareCards01.vue'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const cards = (['today', 'platform'] as const).map((key) => ({
  label: t(`developers.problem.${key}.label`, locale),
  body: t(`developers.problem.${key}.body`, locale)
}))
---

<CompareCards01
  heading={t('developers.problem.title', locale)}
  lead={t('developers.problem.lead', locale)}
  cards={cards}
/>
