---
import ReasonsSplit02 from '../../components/blocks/ReasonsSplit02.vue'
import type { SplitReason } from '../../components/blocks/ReasonsSplit02.vue'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const items: SplitReason[] = ([1, 2, 3] as const).map((item) => ({
  id: `item${item}`,
  title: t(`developers.build.item${item}.term`, locale),
  description: t(`developers.build.item${item}.description`, locale)
}))
---

<ReasonsSplit02
  heading={t('developers.build.title', locale)}
  reasons={items}
  headingPosition="top"
/>
