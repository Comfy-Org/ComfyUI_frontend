---
import type { Locale } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BuildAnywhereSection from './BuildAnywhereSection.astro'
import HeroSection from './HeroSection.astro'
import HowItWorksSection from './HowItWorksSection.astro'
import PlaceholderSection from './PlaceholderSection.vue'
import PricingSection from './PricingSection.vue'
import ProblemSection from './ProblemSection.astro'
import ProductCardsSection from './ProductCardsSection.astro'
import ShowcaseSection from './ShowcaseSection.astro'
import { t } from '../../i18n/translations'
import { absoluteUrl } from '../../utils/jsonLd'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<BaseLayout
  title={t('developers.meta.title', locale)}
  description={t('developers.meta.description', locale)}
  theme="subbrand"
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    { name: t('developers.breadcrumb', locale) },
  ]}
>
  <HeroSection locale={locale} />
  <ProductCardsSection locale={locale} />
  <ProblemSection locale={locale} />
  <HowItWorksSection locale={locale} />
  <ShowcaseSection locale={locale} />
  <BuildAnywhereSection locale={locale} />
  {/* Walking skeleton: each placeholder is replaced by its section ticket
      (developers-page issues 08-09). */}
  <PlaceholderSection name="Observe and manage" block="FeatureSplit01" />
  <PlaceholderSection name="Q&As" block="FAQSplit01" />
  <PricingSection locale={locale} client:load />
</BaseLayout>
