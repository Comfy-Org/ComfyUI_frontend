---
import type { Locale } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import HeroSection from './HeroSection.astro'
import PlaceholderSection from './PlaceholderSection.vue'
import ProductCardsSection from './ProductCardsSection.astro'
import PricingSection from './PricingSection.vue'
import { t } from '../../i18n/translations'
import { absoluteUrl } from '../../utils/jsonLd'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

/* Walking skeleton: each placeholder is replaced by its section ticket
   (developers-page issues 03–09). */
const placeholders = [
  { name: 'The problem this solves', block: 'CompareCards01' },
  { name: 'How it works', block: 'ReasonsSplit01 (numbered)' },
  { name: 'Built with SDK showcase', block: 'FeaturedCarousel02 (dark panel)' },
  { name: 'Same build, anywhere', block: 'ReasonsSplit01 (heading top)' },
  { name: 'Observe and manage', block: 'FeatureSplit01' },
  { name: 'Q&As', block: 'FAQSplit01' },
]
---

<BaseLayout
  title={t('developers.meta.title', locale)}
  description={t('developers.meta.description', locale)}
  theme="subbrand"
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    { name: t('developers.breadcrumb', locale) },
  ]}
>
  <HeroSection locale={locale} />
  <ProductCardsSection locale={locale} />
  {placeholders.map((section) => <PlaceholderSection {...section} />)}
  <PricingSection locale={locale} client:load />
</BaseLayout>
