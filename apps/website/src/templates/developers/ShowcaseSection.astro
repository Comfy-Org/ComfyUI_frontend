---
import FeaturedCarousel02 from '../../components/blocks/FeaturedCarousel02.vue'
import type { FeaturedSplitSlide } from '../../components/blocks/FeaturedCarousel02.vue'
import { developersCtas, showcaseSlides } from '../../data/developers'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const slides: FeaturedSplitSlide[] = showcaseSlides.map((slide) => ({
  id: slide.id,
  media: {
    ...slide.media,
    alt: t('developers.showcase.slide1.mediaAlt', locale)
  },
  eyebrow: t('developers.showcase.eyebrow', locale),
  title: t('developers.showcase.slide1.title', locale),
  body: t('developers.showcase.slide1.body', locale),
  primaryCta: {
    label: t('developers.showcase.ctaPrimary', locale),
    href: developersCtas.sdkDocs
  },
  secondaryCta: {
    label: t('developers.showcase.ctaSecondary', locale),
    href: developersCtas.docs
  },
  autoplayMs: slide.autoplayMs
}))
---

{/* The panel stays on the ink palette inside the subbrand light page, so the
    dark background is explicit rather than inherited. The carousel's own slide
    sits on it at 4% white, which is the design's #2a2230; its horizontal
    padding is dropped -- at both breakpoints, since `lg:px-12` survives a bare
    `px-0` -- so the slide fills the panel edge to edge. */}
<section class="max-w-9xl mx-auto px-6 py-16 lg:px-20 lg:py-24">
  <div class="bg-primary-comfy-ink rounded-4xl lg:rounded-5xl">
    <FeaturedCarousel02 client:load locale={locale} slides={slides} class="px-0 lg:px-0" />
  </div>
</section>
