---
import BaseLayout from '@/layouts/BaseLayout.astro'
import VfxConnectedShowcase from '@/templates/campaign/VfxConnectedShowcase.astro'
import VfxHeroPrototype from '@/components/campaign/VfxHeroPrototype.vue'
import VfxProductionPanel from '@/templates/campaign/VfxProductionPanel.astro'
import SocialProofBarSection from '@/components/common/SocialProofBarSection.vue'
import SectionIntro01 from '@/components/blocks/SectionIntro01.vue'
import BenefitsGrid01 from '@/components/blocks/BenefitsGrid01.vue'
import FeaturedWorkflowsSection from '@/components/home/FeaturedWorkflowsSection.vue'
import HubWorkflowCard from '@/components/hub/HubWorkflowCard.vue'
import BrandButton from '@/components/common/BrandButton.vue'
import CallToActionSection from '@/components/common/CallToActionSection.vue'
import { vfxWorkflows } from '@/data/vfxWorkflows'
import { getRoutes, externalLinks } from '@/config/routes'
import { pageContext } from '@/utils/jsonLd'
import { vfxLandingV3 } from './vfxLandingV3'
import { showcaseConfig } from './vfxConnectedShowcase'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const { t } = Astro.locals
const routes = getRoutes(locale)
const prefix = 'vfxV2.comfy'
const hero = showcaseConfig('relight', t)
const { contactHref, benefits, featuredWorkflows, shareImages } = vfxLandingV3(
  locale,
  t
)
---

<BaseLayout
  title={t('vfx.meta.title')}
  description={t(`${prefix}.heroDescription`)}
  ogImage={shareImages[0].url}
  ogImageAlt={shareImages[0].alt}
  ogImages={shareImages}
  hideAnnouncementBanner
>
  <div data-vfx-v3>
    <VfxHeroPrototype
      locale={locale}
      contactHref={contactHref}
      source={hero.source}
      variants={hero.variants}
      client:load
    />
    <SocialProofBarSection />
    {(['relight', 'swap', 'reframe', 'sequence'] as const).map((demo) => (
      <VfxConnectedShowcase locale={locale} demo={demo} />
    ))}
    <div id="workflows" class="scroll-mt-28">
      <SectionIntro01
        heading={t('vfxV2.workflows.heading')}
        subtitle={t('vfxV2.workflows.description')}
        class="pb-0 lg:pb-0"
      />
      <FeaturedWorkflowsSection
        class="lg:px-20"
        locale={locale}
        showAuthors={false}
        alignWithGrid
        strongScrim
        label={t('vfxV2.workflows.featured')}
        items={featuredWorkflows}
        client:visible
      />
      <section class="mx-auto max-w-9xl px-6 pb-12 lg:px-20 lg:pb-16">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {vfxWorkflows.map((workflow) => (
            <HubWorkflowCard
              {...workflow}
              locale={locale}
              tryNowLabel={t('vfx.workflows.tryNow')}
              showTypeBadge={false}
              showAuthor={false}
              showAction={false}
              providerBadgeAtTop
              client:visible
            />
          ))}
        </div>
        <div class="mt-10 flex justify-center">
          <BrandButton
            href="https://comfy.org/workflows/tag/visual-effects/"
            variant="outline"
            class="uppercase"
          >
            {t('vfx.workflows.browse')}
          </BrandButton>
        </div>
      </section>
    </div>
    <div id="approach" class="scroll-mt-28">
      <BenefitsGrid01
        heading={t('vfxV2.pipeline.heading')}
        numbered={false}
        benefits={benefits}
      />
      <div
        class="mx-auto flex max-w-9xl flex-wrap justify-center gap-4 px-6 pb-12"
      >
        <BrandButton
          href={routes.download}
          variant="outline"
          class="w-full uppercase sm:w-auto"
          >{t('vfxV2.pipeline.download')}</BrandButton
        >
        <BrandButton
          href={externalLinks.docsSdk}
          variant="outline"
          class="w-full uppercase sm:w-auto"
          >{t('vfxV2.pipeline.sdk')}</BrandButton
        >
        <BrandButton
          href={routes.platform}
          variant="outline"
          class="w-full uppercase sm:w-auto"
          >{t('vfxV2.pipeline.platform')}</BrandButton
        >
      </div>
      <div class="[&_a]:uppercase">
        <CallToActionSection
          locale={locale}
          headingKey="vfxV2.fdc.heading"
          primaryLabelKey="vfxV2.fdc.cta"
          primaryHref={routes.fdct}
        />
      </div>
    </div>
    <div id="studio" class="scroll-mt-28">
      <VfxProductionPanel
        locale={locale}
        contactHref={contactHref}
        details={['licensing', 'capacity', 'security', 'billing']}
        detailLinks={{
          licensing: {
            label: t('vfxV2.production.licensing'),
            href: routes.minimaxLicense
          },
          billing: {
            label: t('vfxV3.enterprisePlan'),
            href: routes.enterprise
          }
        }}
      />
    </div>
    <div class="[&_a]:w-full [&_a]:uppercase sm:[&_a]:w-auto">
      <CallToActionSection
        locale={locale}
        headingKey="vfxV3.contactHeading"
        primaryLabelKey="vfxV3.sales"
        primaryHref={contactHref}
        secondaryLabelKey="vfxV3.enterprisePlan"
        secondaryHref={routes.enterprise}
      />
    </div>
  </div>
</BaseLayout>

<script>
  import { mountVfxCampaign } from '@/scripts/vfx-campaign'

  let cleanup: (() => void) | undefined
  document.addEventListener('astro:page-load', () => {
    cleanup?.()
    const root = document.querySelector<HTMLElement>('[data-vfx-v3]')
    if (!root) return
    cleanup = mountVfxCampaign(root)
  })
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
