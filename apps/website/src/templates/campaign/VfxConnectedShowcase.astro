---
import { vfxMediaRoot } from '@/data/vfxMedia'
import BrandButton from '@/components/common/BrandButton.vue'
import SectionHeader from '@/components/common/SectionHeader.vue'
import WorkflowNode from '@/components/agent/WorkflowNode.astro'
import VfxSampleStudio from '@/components/campaign/VfxSampleStudio.vue'
import type { WorkflowGraphNode } from '@/components/agent/workflowGraph'
import type { Locale } from '@/i18n/translations'
import { translationsFor } from '@/i18n/translations'
import '@/styles/workflow-canvas.css'
import '@/styles/vfx-connected.css'

interface Props {
  locale: Locale
  demo?: 'relight' | 'swap' | 'reframe' | 'sequence'
}
const { locale, demo = 'relight' } = Astro.props
const sources = {
  relight: 'diner',
  swap: 'backlot',
  reframe: 'forest',
  sequence: 'rain'
}
const source = sources[demo]
const mediaKind = demo === 'reframe' ? 'image' : 'video'
const { t } = translationsFor(locale)
const variantIds = {
  relight: [
    'relight_golden',
    'relight_night',
    'relight_blue',
    'relight_rain',
    'relight_snow',
    'relight_day'
  ],
  swap: ['swap_jp', 'swap_uk', 'swap_it'],
  reframe: ['reframe_wide', 'reframe_vertical'],
  sequence: ['seedance_multishot_rain', 'seedance_push', 'seedance_orbit']
} as const
const variants = variantIds[demo].map((id) => ({
  id,
  label: t(`vfxV3.variants.${id}`)
}))
const makeNode = (
  id: string,
  label: string,
  image?: string,
  still = false
): WorkflowGraphNode => ({
  id,
  label,
  kind: 'landscape',
  x: 0,
  y: 0,
  width: 256,
  height: 144,
  ...(image && mediaKind === 'video' && !still
    ? { video: image.replace('.jpg', '.mp4'), poster: image, loopVideo: true }
    : { image }),
  alt: label
})
const workflowHref =
  demo === 'relight'
    ? 'https://cloud.comfy.org/?share=8b18c850d38a'
    : demo === 'sequence'
      ? 'https://cloud.comfy.org/?share=c2191c018939'
      : undefined
const originalLabel = t('vfxV3.originalFootage')
---

<vfx-workflow-showcase data-vfx-demo={demo} class="vfx-connected">
  <div class="vfx-showcase-view">
    <div class="vfx-section-top">
      <SectionHeader align="start" headingSize="subsection">
        {t(`vfxV3.demos.${demo}.title`)}
        <p slot="subtitle" class="mt-6 text-sm text-primary-comfy-canvas/70">
          {t(`vfxV3.demos.${demo}.description`)}
        </p>
      </SectionHeader>
      <div class="mt-8 flex flex-wrap gap-3">
        <BrandButton
          href={workflowHref}
          target={workflowHref ? '_blank' : undefined}
          disabled={!workflowHref}
          data-try-workflow
          title={!workflowHref ? t('vfxV3.workflowUnavailable') : undefined}
          >{t('vfxV3.tryWorkflow')}</BrandButton
        >
        <BrandButton
          data-open-studio="settings"
          variant="outline"
          aria-expanded="false"
          >{t('vfxV3.openStudio')}</BrandButton
        >
      </div>
    </div>
    <div class="vfx-visual-panel">
      <div
        class="vfx-canvas-window"
        tabindex="0"
        aria-label={t(`vfxV3.demos.${demo}.title`)}
      >
        <div class="vfx-canvas-scale">
          <div class="vfx-scene-stage">
            <svg class="vfx-connections" aria-hidden="true"><g></g></svg>
            <div class="vfx-source-node" data-canvas-step>
              <span class="vfx-port vfx-port-out" aria-hidden="true" />
              <WorkflowNode
                node={makeNode('original', originalLabel, `${source}.jpg`)}
                flow
                imageRoot={vfxMediaRoot}
              />
            </div>
            <div class="vfx-keyframe-node" data-canvas-step>
              <span class="vfx-port vfx-port-out" aria-hidden="true" />
              <WorkflowNode
                node={makeNode(
                  'keyframe',
                  t(
                    demo === 'sequence'
                      ? 'vfxV3.referenceFrame'
                      : 'vfxV3.keyframe'
                  ),
                  `${demo === 'sequence' ? source : variants[0].id}.jpg`,
                  true
                )}
                flow
                imageRoot={vfxMediaRoot}
              >
                <span
                  slot="input"
                  class="vfx-port vfx-port-in"
                  aria-hidden="true"
                />
              </WorkflowNode>
            </div>
            <div class="vfx-main-node" data-canvas-step>
              <WorkflowNode
                node={makeNode(
                  'preview',
                  variants[0].label,
                  `${variants[0].id}.jpg`
                )}
                flow
                imageRoot={vfxMediaRoot}
              >
                <span
                  slot="input"
                  class="vfx-port vfx-port-in"
                  aria-hidden="true"
                />
              </WorkflowNode>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vfx-versions"
        role="group"
        aria-label={t('modelLaunch.beforeAfter.tabsLabel')}
      >
        {variants.map(({ id, label }, i) => <button
          type="button"
          class="vfx-version-node"
          data-workflow-variant={id}
          aria-label={label}
          aria-pressed={i === 0}
        >
          <WorkflowNode
            node={makeNode(id, label, `${id}.jpg`, true)}
            flow
            imageRoot={vfxMediaRoot}
          />
        </button>)}
      </div>
    </div>
  </div>
  <div class="vfx-studio-view" hidden inert>
    <div class="vfx-workspace-toolbar mb-8">
      <BrandButton data-back-workflow variant="outline"
        >← {t('vfxV3.prototype.back').toLocaleUpperCase(locale)}</BrandButton
      >
    </div>
    <VfxSampleStudio
      demo={demo}
      source={source}
      mediaKind={mediaKind}
      variants={variants}
      locale={locale}
      workflowHref={workflowHref}
      client:load
    />
  </div>
</vfx-workflow-showcase>
<script>
  import '@/scripts/vfx-connected'
</script>
