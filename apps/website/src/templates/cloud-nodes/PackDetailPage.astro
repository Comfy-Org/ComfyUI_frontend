---
import PackDetail from '../../components/cloud-nodes/PackDetail.vue'
import { localizeHref } from '../../config/routes'
import type { Pack } from '../../data/cloudNodes'
import { t } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  absoluteUrl,
  jsonLdId,
  pageContext,
  softwareApplicationNode
} from '../../utils/jsonLd'

interface Props {
  pack: Pack
}

const { pack } = Astro.props
const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const fallbackDescription = t('cloudNodes.card.unavailableDescription', locale)
const description = pack.description || fallbackDescription
const title = t('cloudNodes.detail.metaTitle', locale).replace(
  '{pack}',
  pack.displayName
)
const metaDescription = t('cloudNodes.detail.metaDescription', locale)
  .replace('{pack}', pack.displayName)
  .replace('{nodeCount}', String(pack.nodes.length))
  .replace('{description}', description)

const softwareId = jsonLdId(url, 'software')
const software = softwareApplicationNode({
  siteUrl,
  id: softwareId,
  name: pack.displayName,
  url,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'ComfyUI custom-node pack',
  operatingSystem: 'Comfy Cloud (managed)',
  description: pack.description || undefined,
  image: pack.bannerUrl || pack.iconUrl,
  softwareVersion: pack.latestVersion,
  license: pack.license,
  codeRepository: pack.repoUrl,
  authorName: pack.publisher?.name,
  isFree: true
})
---

<BaseLayout
  title={title}
  description={metaDescription}
  ogImage={pack.bannerUrl}
  mainEntityId={softwareId}
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, localizeHref('/', locale))
    },
    {
      name: 'Comfy Cloud',
      url: absoluteUrl(Astro.site, localizeHref('/cloud', locale))
    },
    {
      name: t('breadcrumb.supportedNodes', locale),
      url: absoluteUrl(
        Astro.site,
        localizeHref('/cloud/supported-nodes', locale)
      )
    },
    { name: pack.displayName }
  ]}
  extraJsonLd={[software]}
>
  <PackDetail pack={pack} locale={locale} />
</BaseLayout>
