---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BreadcrumbBar from '../../../components/common/BreadcrumbBar.vue'
import ModelCatalogExplorer from '../../../components/models/explore/ModelCatalogExplorer.vue'
import type { ModelCategoryOption } from '../../../components/models/explore/ModelCategoryFilter.vue'
import { createModelExploreCatalog } from '../../../components/models/explore/modelExploreCatalog'
import {
  dayZeroModelFixtures,
  trendingModelFixtures
} from '../../../components/models/explore/modelExploreFixtures'
import { models } from '../../../config/models'
import { MODEL_FILTER_CATEGORIES } from '../../../config/modelCategories'
import { getRoutes } from '../../../config/routes'
import { t } from '../../../i18n/translations'

const locale = 'en'
const routes = getRoutes(locale)
const title = t('models.all.title', locale)
const catalog = createModelExploreCatalog(models)
const categoryOptions: ModelCategoryOption[] = [
  { value: 'all', label: t('models.explore.categories.all', locale) },
  ...MODEL_FILTER_CATEGORIES.map((value) => ({
    value,
    label: t(`models.explore.categories.${value}`, locale)
  })),
  { value: 'open', label: t('models.explore.filters.openSource', locale) },
  { value: 'partner', label: t('models.explore.filters.partnerNodes', locale) }
]
---

<BaseLayout
  {title}
  description={t('models.all.description', locale)}
  breadcrumbs={[
    { name: t('nav.supportedModels', locale), url: routes.models },
    { name: title }
  ]}
>
  <BreadcrumbBar
    crumbs={[
      { label: t('nav.supportedModels', locale), href: routes.models },
      { label: title }
    ]}
  />
  <section class="mx-auto max-w-10xl px-6 pt-12 pb-4 md:px-10 xl:px-30">
    <h1 class="text-4xl font-light text-primary-comfy-canvas lg:text-5xl">
      {title}
    </h1>
  </section>
  <ModelCatalogExplorer
    client:load
    showCatalogByDefault
    pageSize={24}
    catalogCardVariant="hub"
    catalogCardModels={[...dayZeroModelFixtures, ...trendingModelFixtures]}
    openWeightsBadgeLabel={t('models.explore.openWeightsBadge', locale)}
    {catalog}
    {categoryOptions}
    categoryLabel={t('models.explore.categories.label', locale)}
    searchLabel={t('models.explore.search.label', locale)}
    searchPlaceholder={t('models.explore.search.placeholder', locale)}
    workflowCountOne={t('models.explore.catalog.workflowCountOne', locale)}
    workflowCountMany={t('models.explore.catalog.workflowCountMany', locale)}
    partnerLabel={t('models.explore.catalog.partner', locale)}
    resultCountLabel={t('models.explore.catalog.resultCount', locale)}
    emptyLabel={t('models.explore.catalog.empty', locale)}
    showMoreLabel={t('models.all.loadMore', locale)}
  />
</BaseLayout>
