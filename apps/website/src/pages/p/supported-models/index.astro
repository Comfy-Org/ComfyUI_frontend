---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import FAQSection from '../../../components/common/FAQSection.vue'
import ModelAccessSection from '../../../components/models/explore/ModelAccessSection.astro'
import ModelCategoryFilter from '../../../components/models/explore/ModelCategoryFilter.vue'
import ModelCollectionSection from '../../../components/models/explore/ModelCollectionSection.astro'
import ModelConversionSection from '../../../components/models/explore/ModelConversionSection.astro'
import ModelFamilySection from '../../../components/models/explore/ModelFamilySection.astro'
import ModelTaskSection from '../../../components/models/explore/ModelTaskSection.astro'
import ModelsExploreHero from '../../../components/models/explore/ModelsExploreHero.astro'
import SearchField from '../../../components/ui/search-field/SearchField.vue'
import {
  dayZeroModelFixtures,
  familyVariantFixtures,
  taskFixtures,
  trendingModelFixtures,
} from '../../../components/models/explore/modelExploreFixtures'
import { summarizeModelExploreCatalog } from '../../../components/models/explore/modelExploreCatalog'
import { models } from '../../../config/models'
import { externalLinks, getRoutes } from '../../../config/routes'
import { t } from '../../../i18n/translations'
import {
  absoluteUrl,
  itemListNode,
  jsonLdId,
  pageContext,
} from '../../../utils/jsonLd'

const title = t('models.index.title')
const subtitle = t('models.index.subtitle')

const { url, locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)
const catalogSummary = summarizeModelExploreCatalog(models)
const description = t('models.explore.description', locale).replace(
  '{count}',
  String(catalogSummary.catalogCount),
)
const stats = t('models.explore.stats', locale)
  .replace('{count}', String(catalogSummary.catalogCount))
  .replace('{localCount}', String(catalogSummary.localComponentCount))
  .replace('{partnerCount}', String(catalogSummary.partnerIntegrationCount))
const modelList = itemListNode(
  url,
  title,
  models.map((model) => ({
    name: model.displayName,
    url: absoluteUrl(Astro.site, `/p/supported-models/${model.slug}`),
  })),
)
const categories = t('models.explore.categories', locale).split('|')
const routes = getRoutes(locale)
const accessCards = [
  {
    title: t('models.explore.access.open.title', locale),
    description: t('models.explore.access.open.description', locale),
    cta: t('models.explore.access.open.cta', locale),
    href: externalLinks.workflows,
    bg: 'bg-secondary-deep-plum',
  },
  {
    title: t('models.explore.access.partner.title', locale),
    description: t('models.explore.access.partner.description', locale),
    cta: t('models.explore.access.partner.cta', locale),
    href: externalLinks.workflows,
    bg: 'bg-secondary-cool-gray',
  },
]
const conversionCards = [
  {
    title: t('products.local.title', locale),
    description: t('products.local.description', locale),
    cta: t('products.local.cta', locale),
    href: routes.download,
    bg: 'bg-primary-warm-gray',
  },
  {
    title: t('products.cloud.title', locale),
    description: t('products.cloud.description', locale),
    cta: t('products.cloud.cta', locale),
    href: routes.cloud,
    bg: 'bg-secondary-mauve',
  },
  {
    title: t('products.api.title', locale),
    description: t('products.api.description', locale),
    cta: t('products.api.cta', locale),
    href: routes.api,
    bg: 'bg-primary-comfy-plum',
  },
  {
    title: t('products.enterprise.title', locale),
    description: t('products.enterprise.description', locale),
    cta: t('products.enterprise.cta', locale),
    href: routes.cloudEnterprise,
    bg: 'bg-secondary-cool-gray',
  },
]
---

<BaseLayout
  title={`${title} - Comfy`}
  description={subtitle}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(url, 'itemlist')}
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    { name: title },
  ]}
  extraJsonLd={[modelList]}
>
  <ModelsExploreHero
    eyebrow={t('models.explore.eyebrow', locale)}
    titleFirstLine={t('models.explore.title.first', locale)}
    titleSecondLine={t('models.explore.title.second', locale)}
    {description}
    primaryCta={t('models.explore.primaryCta', locale)}
    secondaryCta={t('models.explore.secondaryCta', locale)}
    {stats}
    featuredBadge={t('models.explore.featuredBadge', locale)}
    featuredTitle={t('models.explore.featuredTitle', locale)}
    featuredHref="https://blog.comfy.org/p/wan26-reference-to-video"
    primaryHref={externalLinks.cloud}
    secondaryHref={externalLinks.workflows}
  />
  <section class="mx-auto max-w-10xl px-6 py-8 md:px-10 xl:px-30">
    <SearchField
      client:load
      label={t('models.explore.search.label', locale)}
      placeholder={t('models.explore.search.placeholder', locale)}
    />
  </section>
  <div class="mx-auto max-w-10xl overflow-x-auto px-6 py-3 md:px-10 xl:px-30">
    <ModelCategoryFilter
      client:load
      label={t('models.explore.categories.label', locale)}
      {categories}
    />
  </div>
  <ModelCollectionSection
    headingId="trending-models-heading"
    label={t('models.explore.trending.label', locale)}
    description={t('models.explore.trending.description', locale)}
    models={trendingModelFixtures}
    dayZeroBadgeLabel={t('models.explore.featuredBadge', locale)}
    openWeightsBadgeLabel={t('models.explore.openWeightsBadge', locale)}
  />
  <ModelCollectionSection
    headingId="day-zero-models-heading"
    label={t('models.explore.dayZero.label', locale)}
    description={t('models.explore.dayZero.description', locale)}
    models={dayZeroModelFixtures}
    dayZeroBadgeLabel={t('models.explore.featuredBadge', locale)}
    openWeightsBadgeLabel={t('models.explore.openWeightsBadge', locale)}
  />
  <ModelTaskSection
    label={t('models.explore.tasks.label', locale)}
    description={t('models.explore.tasks.description', locale)}
    tasks={taskFixtures}
  />
  <ModelAccessSection
    heading={t('models.explore.access.heading', locale)}
    cards={accessCards}
  />
  <ModelFamilySection
    eyebrow={t('models.explore.family.eyebrow', locale)}
    title={t('models.explore.family.title', locale)}
    description={t('models.explore.family.description', locale)}
    variants={familyVariantFixtures}
    viewModelLabel={t('models.explore.family.viewModel', locale)}
  />
  <ModelConversionSection
    heading={t('pricing.banner.title', locale)}
    {locale}
    bannerHref={externalLinks.cloud}
    cards={conversionCards}
  />
  <FAQSection
    client:visible
    {locale}
    labelKey="models.explore.faq.label"
    headingKey="models.explore.faq.heading"
    faqPrefix="models.explore.faq"
    faqCount={5}
  />
</BaseLayout>
