---
import type { GetStaticPaths } from 'astro'
import SupportedModelPage from '@/templates/supported-model/SupportedModelPage.astro'
import { models, getModelBySlug } from '@/config/models'
import { isWorkshopInBuild } from '@/config/workshop-release'
import { modelFileHref } from '@/lib/workshop/model-file-href'

export const getStaticPaths: GetStaticPaths = () => {
  return models
    .filter((model) => !model.canonicalSlug)
    .map((model) => ({ params: { slug: model.slug } }))
}

const { slug } = Astro.params
const model = getModelBySlug(slug as string)!
const hubAddress = isWorkshopInBuild()
  ? modelFileHref(model.slug, true)
  : undefined
---

<SupportedModelPage model={model} canonicalPath={hubAddress} />
