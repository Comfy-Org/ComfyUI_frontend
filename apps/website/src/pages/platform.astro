---
import BaseLayout from '../layouts/BaseLayout.astro'
import BrandBackground from '../templates/brand/BrandBackground.vue'
import ProductCardsSection from '../components/common/ProductCardsSection.vue'
import SocialProofBarSection from '../components/common/SocialProofBarSection.vue'
import ClosingCtaSection from '../templates/platform/ClosingCtaSection.vue'
import HeroSection from '../templates/platform/HeroSection.vue'
import ProductsSection from '../templates/platform/ProductsSection.vue'
import { t } from '../i18n/site'
---

<BaseLayout
  title={t('platform.meta.title', {}, { locale: 'en' })}
  description={t('platform.meta.description', {}, { locale: 'en' })}
>
  <div class="relative isolate">
    <BrandBackground client:idle />
    <HeroSection locale="en" client:load />
    <ProductsSection locale="en" client:visible />
  </div>
  <SocialProofBarSection />
  <ClosingCtaSection
    locale="en"
    heading-after-badge={t(
      'platform.closing.headingAfterBadge',
      {},
      { locale: 'en' }
    )}
    client:visible
  />
  <ProductCardsSection locale="en" label-key="products.labelProducts" />
</BaseLayout>
