---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContentSection from '../../components/common/ContentSection.vue'
import HeroSection from '../../components/legal/HeroSection.vue'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)
---

<BaseLayout
  title={t('desktop_privacy.meta.title', locale)}
  description={t('desktop_privacy.meta.description', locale)}
>
  <HeroSection title={t('desktop_privacy.hero.title', locale)} />
  <ContentSection prefix="desktop_privacy" client:load />
</BaseLayout>
