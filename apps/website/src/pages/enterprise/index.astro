---
import IndustriesSection from '@/components/home/IndustriesSection.vue'
import BenefitsGrid01 from '../../components/blocks/BenefitsGrid01.vue'
import BuildConfiguratorSplit01 from '../../components/blocks/BuildConfiguratorSplit01.vue'
import CardSplitContent02 from '../../components/blocks/CardSplitContent02.vue'
import CtaBands01 from '../../components/blocks/CtaBands01.vue'
import CtaCenter01 from '../../components/blocks/CtaCenter01.vue'
import FAQSplit01 from '../../components/blocks/FAQSplit01.vue'
import FeatureRows02 from '../../components/blocks/FeatureRows02.vue'
import HeroSplit01 from '../../components/blocks/HeroSplit01.vue'
import OfferGrid01 from '../../components/blocks/OfferGrid01.vue'
import SectionIntro01 from '../../components/blocks/SectionIntro01.vue'
import EnterpriseHeroScene from '../../components/product/enterprise/EnterpriseHeroScene.vue'
import { externalLinks, localizeHref } from '../../config/routes'
import { t } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { absoluteUrl, pageContext } from '../../utils/jsonLd'
import { buildFaqPageNode } from './_faqMetadata'

const { canonicalUrl, locale, canonicalLocale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)

const faqs = [
  {
    id: 'what-is-enterprise',
    question: t('enterprise.faq.what-is-enterprise.question', locale),
    answer: t('enterprise.faq.what-is-enterprise.answer', locale),
  },
  {
    id: 'where-runs',
    question: t('enterprise.faq.where-runs.question', locale),
    answer: t('enterprise.faq.where-runs.answer', locale),
  },
  {
    id: 'builds-vs-managed-builds',
    question: t('enterprise.faq.builds-vs-managed-builds.question', locale),
    answer: t('enterprise.faq.builds-vs-managed-builds.answer', locale),
  },
  {
    id: 'commercial-models',
    question: t('enterprise.faq.commercial-models.question', locale),
    answer: t('enterprise.faq.commercial-models.answer', locale),
  },
  {
    id: 'security',
    question: t('enterprise.faq.security.question', locale),
    // One key with a placeholder, not a sentence split around the link. The
    // Chinese puts text after the link where the English ends on it, so any
    // before/after split renders one of the two languages backwards.
    answer: t('enterprise.faq.security.answer', locale).replace(
      '{url}',
      externalLinks.trustCenter,
    ),
  },
  {
    id: 'usage',
    question: t('enterprise.faq.usage.question', locale),
    answer: t('enterprise.faq.usage.answer', locale),
  },
  {
    id: 'team-plan',
    question: t('enterprise.faq.team-plan.question', locale),
    answer: t('enterprise.faq.team-plan.answer', locale),
  },
  {
    id: 'capacity-and-support',
    question: t('enterprise.faq.capacity-and-support.question', locale),
    answer: t('enterprise.faq.capacity-and-support.answer', locale),
  },
] as const

const enterpriseOffers = [
  {
    id: 'commercial-licensing',
    label: t('enterprise.offers.commercial-licensing.label', locale),
    title: t('enterprise.offers.commercial-licensing.title', locale),
    description: t('enterprise.offers.commercial-licensing.description', locale),
    cta: {
      label: t('enterprise.offers.commercial-licensing.cta.label', locale),
      href: localizeHref('/minimax/license/', locale),
    },
  },
  {
    id: 'forward-deployed-creatives',
    label: t('enterprise.offers.forward-deployed-creatives.label', locale),
    title: t('enterprise.offers.forward-deployed-creatives.title', locale),
    description: t(
      'enterprise.offers.forward-deployed-creatives.description',
      locale,
    ),
    cta: {
      label: t('enterprise.offers.forward-deployed-creatives.cta.label', locale),
      href: localizeHref('/forward-deployed-creatives/', locale),
    },
  },
] as const

const governanceRows = [
  {
    id: 'build-policy',
    term: t('enterprise.governance.build-policy.title', locale),
    description: t('enterprise.governance.build-policy.description', locale),
  },
  {
    id: 'model-policy',
    term: t('enterprise.governance.model-policy.title', locale),
    description: t('enterprise.governance.model-policy.description', locale),
  },
  {
    id: 'people-access',
    term: t('enterprise.governance.people-access.title', locale),
    description: t('enterprise.governance.people-access.description', locale),
  },
  {
    id: 'usage-records',
    term: t('enterprise.governance.usage-records.title', locale),
    description: t('enterprise.governance.usage-records.description', locale),
  },
] as const

const productionRows = [
  {
    id: 'dedicated-capacity',
    term: t('enterprise.production.dedicated-capacity.title', locale),
    description: t(
      'enterprise.production.dedicated-capacity.description',
      locale,
    ),
  },
  {
    id: 'priority-queueing',
    term: t('enterprise.production.priority-queueing.title', locale),
    description: t(
      'enterprise.production.priority-queueing.description',
      locale,
    ),
  },
  {
    id: 'deployment',
    term: t('enterprise.production.deployment.title', locale),
    description: t('enterprise.production.deployment.description', locale),
  },
  {
    id: 'support',
    term: t('enterprise.production.support.title', locale),
    description: t('enterprise.production.support.description', locale),
  },
] as const

const requestDemo = {
  label: t('enterprise.cta.requestDemo', locale),
  href: localizeHref('/contact/', locale),
}
const trustCenter = {
  label: t('enterprise.cta.viewTrustCenter', locale),
  href: externalLinks.trustCenter,
  target: '_blank' as const,
}

const faqPage = buildFaqPageNode(canonicalUrl, faqs)
---

<BaseLayout
  title={t('enterprise.meta.title', locale)}
  description={t('enterprise.meta.description', locale)}
  pageType="WebPage"
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, localizeHref('/', canonicalLocale)),
    },
    { name: 'Enterprise' },
  ]}
  extraJsonLd={[faqPage]}
>
  <HeroSplit01
    badgeText="ENTERPRISE"
    title={t('enterprise.hero.title', locale)}
    subtitle={t('enterprise.hero.subtitle', locale)}
    features={[
      t('enterprise.hero.feature1', locale),
      t('enterprise.hero.feature2', locale),
      t('enterprise.hero.feature3', locale),
    ]}
    primaryCta={requestDemo}
    secondaryCta={trustCenter}
    mediaWrapperClass="hidden lg:block"
  >
    <EnterpriseHeroScene slot="media" client:load />
  </HeroSplit01>

  <SectionIntro01
    eyebrow={t('enterprise.intro.eyebrow', locale)}
    heading={t('enterprise.intro.heading', locale)}
    subtitle={t('enterprise.intro.subtitle', locale)}
    maxWidth="xl"
  />

  <BuildConfiguratorSplit01
    eyebrow="MANAGED BUILDS"
    heading={t('enterprise.configurator.heading', locale)}
    body={t('enterprise.configurator.body', locale)}
    features={[
      t('enterprise.configurator.feature1', locale),
      t('enterprise.configurator.feature2', locale),
      t('enterprise.configurator.feature3', locale),
    ]}
    releasesLabel={t('enterprise.configurator.releasesLabel', locale)}
    releases={['v0.3.41', 'v0.3.40', 'v0.3.38']}
    environmentsLabel="PYTHON · PYTORCH · CUDA"
    environments={[
      { id: 'env-current', python: '3.12', torch: '2.6', cuda: '12.8' },
      { id: 'env-previous', python: '3.12', torch: '2.5', cuda: '12.4' },
      { id: 'env-legacy', python: '3.11', torch: '2.5', cuda: '12.4' },
    ]}
    nodesLabel={t('enterprise.configurator.nodesLabel', locale)}
    nodes={[
      { id: 'manager', label: 'ComfyUI-Manager', selected: true },
      { id: 'ipadapter', label: 'IPAdapter Plus', selected: true },
      { id: 'controlnet', label: 'ControlNet Aux' },
      { id: 'videohelper', label: 'VideoHelperSuite', selected: true },
      {
        id: 'studio-nodes',
        label: t('enterprise.configurator.privateNodes', locale),
        selected: true,
      },
    ]}
    modelsLabel={t('enterprise.configurator.modelsLabel', locale)}
    models={[
      { id: 'flux', label: 'FLUX 3', selected: true },
      { id: 'wan', label: 'Wan 3.0' },
      { id: 'sdxl', label: 'SDXL Base', selected: true },
      { id: 'ltx', label: 'LTX-2.5' },
      {
        id: 'brand-lora',
        label: t('enterprise.configurator.privateModel', locale),
        selected: true,
      },
    ]}
    nodesUnit={t('enterprise.configurator.nodesUnit', locale)}
    modelsUnit={t('enterprise.configurator.modelsUnit', locale)}
    pinnedLabel={t('enterprise.configurator.pinned', locale)}
    moreOptionsLabel={t('enterprise.configurator.moreOptions', locale)}
    cta={requestDemo}
    client:visible
  />

  <OfferGrid01 offers={enterpriseOffers} />

  <CardSplitContent02
    title={t('enterprise.governance.heading', locale)}
    imageSrc="https://media.comfy.org/website/enterprise/enterprise-featured.png"
  />
  <FeatureRows02
    class="pt-0 lg:pt-0"
    rows={governanceRows}
    footnote={t('enterprise.governance.footnote', locale)}
  />

  <CardSplitContent02
    title={t('enterprise.production.heading', locale)}
    imageSrc="/assets/enterprise/capacity-checker-falls.webp"
    reverse
  />
  <FeatureRows02
    class="pt-0 lg:pt-0"
    rows={productionRows}
    footnote={t('enterprise.production.footnote', locale)}
  />

  <IndustriesSection
    locale={locale}
    heading={t('enterprise.industries.heading', locale)}
    client:visible
  />

  <BenefitsGrid01
    heading={t('enterprise.security.heading', locale)}
    numbered={false}
    benefits={[
      {
        id: 'soc2',
        title: 'SOC 2',
        description: t('enterprise.security.soc2.description', locale),
      },
      {
        id: 'sso',
        title: t('enterprise.security.sso.title', locale),
        description: t('enterprise.security.sso.description', locale),
      },
      {
        id: 'data',
        title: t('enterprise.security.data.title', locale),
        description: t('enterprise.security.data.description', locale),
      },
      {
        id: 'dpa',
        title: t('enterprise.security.dpa.title', locale),
        description: t('enterprise.security.dpa.description', locale),
      },
    ]}
    footnote={t('enterprise.security.footnote', locale)}
    primaryCta={trustCenter}
  />

  <FAQSplit01
    id="faq"
    heading={t('enterprise.faq.heading', locale)}
    faqs={faqs}
    client:visible
  />
  <CtaCenter01
    heading={t('enterprise.closing.heading', locale)}
    subtitle={t('enterprise.closing.subtitle', locale)}
    primaryCta={requestDemo}
  />
  <CtaBands01
    variant="highlight"
    bands={[
      {
        id: 'team-plans',
        label: t('enterprise.teamBand.label', locale),
        text: t('enterprise.teamBand.text', locale),
        cta: {
          label: t('enterprise.teamBand.cta', locale),
          href: localizeHref('/pricing', locale),
        },
      },
    ]}
  />
</BaseLayout>
