---
import BenefitsGrid01 from '../../components/blocks/BenefitsGrid01.vue'
import BuildManifestSplit01 from '../../components/blocks/BuildManifestSplit01.vue'
import CtaBands01 from '../../components/blocks/CtaBands01.vue'
import CtaCenter01 from '../../components/blocks/CtaCenter01.vue'
import FAQSplit01 from '../../components/blocks/FAQSplit01.vue'
import HeroSplit01 from '../../components/blocks/HeroSplit01.vue'
import OfferGrid01 from '../../components/blocks/OfferGrid01.vue'
import ReasonsSplit01 from '../../components/blocks/ReasonsSplit01.vue'
import EnterpriseHeroScene from '../../components/product/enterprise/EnterpriseHeroScene.vue'
import { externalLinks, localizeHref } from '../../config/routes'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { absoluteUrl, pageContext } from '../../utils/jsonLd'
import { buildFaqPageNode } from './_faqMetadata'
import { t } from '../../i18n/translations'

const { locale, canonicalUrl, canonicalLocale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)

const faqs = [
  {
    id: 'what-is-enterprise',
    question: t('enterprise.faq.what-is-enterprise.question', locale),
    answer:
      t('enterprise.faq.what-is-enterprise.answer', locale),
  },
  {
    id: 'where-runs',
    question: t('enterprise.faq.where-runs.question', locale),
    answer:
      t('enterprise.faq.where-runs.answer', locale),
  },
  {
    id: 'builds-vs-managed-builds',
    question: t('enterprise.faq.builds-vs-managed-builds.question', locale),
    answer:
      t('enterprise.faq.builds-vs-managed-builds.answer', locale),
  },
  {
    id: 'commercial-models',
    question: t('enterprise.faq.commercial-models.question', locale),
    answer:
      t('enterprise.faq.commercial-models.answer', locale),
  },
  {
    id: 'security',
    question: t('enterprise.faq.security.question', locale),
    answer: `SSO and a DPA are available. Comfy does not train on customer data, and our SOC 2 Type II audit is in progress. Review current controls in the [Comfy Trust Center](${externalLinks.trustCenter}).`,
  },
  {
    id: 'usage',
    question: t('enterprise.faq.usage.question', locale),
    answer:
      t('enterprise.faq.usage.answer', locale),
  },
  {
    id: 'team-plan',
    question: t('enterprise.faq.team-plan.question', locale),
    answer:
      t('enterprise.faq.team-plan.answer', locale),
  },
  {
    id: 'capacity-and-support',
    question: t('enterprise.faq.capacity-and-support.question', locale),
    answer:
      t('enterprise.faq.capacity-and-support.answer', locale),
  },
] as const

const enterpriseOffers = [
  {
    id: 'team-plans',
    label: t('enterprise.offers.team-plans.label', locale),
    title: t('enterprise.offers.team-plans.title', locale),
    description:
      t('enterprise.offers.team-plans.description', locale),
    cta: { label: 'SUBSCRIBE NOW', href: '/pricing' },
  },
  {
    id: 'commercial-licensing',
    label: t('enterprise.offers.commercial-licensing.label', locale),
    title: t('enterprise.offers.commercial-licensing.title', locale),
    description:
      t('enterprise.offers.commercial-licensing.description', locale),
    cta: {
      label: t('enterprise.offers.commercial-licensing.cta.label', locale),
      href: '/minimax/license/',
    },
  },
  {
    id: 'forward-deployed-creatives',
    label: t('enterprise.offers.forward-deployed-creatives.label', locale),
    title: t('enterprise.offers.forward-deployed-creatives.title', locale),
    description:
      t('enterprise.offers.forward-deployed-creatives.description', locale),
    cta: {
      label: t('enterprise.offers.forward-deployed-creatives.cta.label', locale),
      href: '/forward-deployed-creatives/',
    },
  },
] as const

const governanceBenefits = [
  {
    id: 'build-policy',
    title: t('enterprise.governance.build-policy.title', locale),
    description:
      t('enterprise.governance.build-policy.description', locale),
  },
  {
    id: 'model-policy',
    title: t('enterprise.governance.model-policy.title', locale),
    description:
      t('enterprise.governance.model-policy.description', locale),
  },
  {
    id: 'people-access',
    title: t('enterprise.governance.people-access.title', locale),
    description:
      t('enterprise.governance.people-access.description', locale),
  },
  {
    id: 'usage-records',
    title: t('enterprise.governance.usage-records.title', locale),
    description:
      t('enterprise.governance.usage-records.description', locale),
  },
] as const

const productionBenefits = [
  {
    id: 'dedicated-capacity',
    title: t('enterprise.production.dedicated-capacity.title', locale),
    description:
      t('enterprise.production.dedicated-capacity.description', locale),
  },
  {
    id: 'priority-queueing',
    title: t('enterprise.production.priority-queueing.title', locale),
    description:
      t('enterprise.production.priority-queueing.description', locale),
  },
  {
    id: 'deployment',
    title: t('enterprise.production.deployment.title', locale),
    description:
      t('enterprise.production.deployment.description', locale),
  },
  {
    id: 'support',
    title: t('enterprise.production.support.title', locale),
    description:
      t('enterprise.production.support.description', locale),
  },
] as const

const industries = [
  {
    id: 'games',
    title: t('enterprise.industries.games.title', locale),
    description:
      t('enterprise.industries.games.description', locale),
  },
  {
    id: 'vfx',
    title: t('enterprise.industries.vfx.title', locale),
    description:
      t('enterprise.industries.vfx.description', locale),
  },
  {
    id: 'onboarding',
    title: t('enterprise.industries.onboarding.title', locale),
    description:
      t('enterprise.industries.onboarding.description', locale),
  },
] as const

const faqPage = buildFaqPageNode(canonicalUrl, faqs)---

<BaseLayout
  title={t('enterprise.meta.title', locale)}
  description={t('enterprise.meta.description', locale)}
  pageType="WebPage"
  breadcrumbs={[
    { name: 'Home', url: absoluteUrl(Astro.site, localizeHref('/', canonicalLocale)) },
    { name: 'Enterprise' },
  ]}
  extraJsonLd={[faqPage]}
>
  <HeroSplit01 locale={locale}
    badgeText="ENTERPRISE"
    title={'Govern ComfyUI across\nevery team and runtime.'}
    subtitle="Standardize how teams build, run, and deploy visual AI with ComfyUI Managed Builds, production capacity, commercial licensing, and hands-on implementation support."
    features={[
      'Approved, reproducible ComfyUI Managed Builds',
      'Dedicated GPU capacity, priority queueing, and enterprise SLAs',
      'Commercial licensing, security review, and hands-on delivery',
    ]}
    primaryCta={{ label: 'REQUEST DEMO', href: '/contact/' }}
    secondaryCta={{
      label: 'VIEW TRUST CENTER',
      href: externalLinks.trustCenter,
      target: '_blank',
    }}
  >
    <EnterpriseHeroScene slot="media" client:load />
  </HeroSplit01>

  <OfferGrid01
    eyebrow="WAYS TO SCALE WITH COMFY"
    heading="The open standard for visual AI, ready for your organization."
    description="Keep your team focused on the Comfy Workflows that differentiate your business. Comfy provides the governed environments, production runtimes, commercial terms, and hands-on builders you would otherwise assemble yourself."
    featuredOffer={{
      id: 'managed-builds',
      title: 'ComfyUI Managed Builds',
      description:
        'Self-serve Builds package a reproducible environment. ComfyUI Managed Builds add team distribution, model and custom-node governance, controlled rollout, enterprise terms, and support across the fleet.',
      cta: {
        label: 'VIEW MANAGED BUILDS',
        href: '/enterprise/managed-builds/',
      },
    }}
    offers={enterpriseOffers}
  />

  <BuildManifestSplit01
    eyebrow="COMFYUI MANAGED BUILDS"
    heading={'One approved build\nacross the fleet.'}
    body="Keep ComfyUI. Let Comfy manage the versioned distribution, governance, and release layer around it. Replace machine-by-machine setup with deliberate assignment, rollout, and updates."
    features={[
      'Pin and approve the nodes each build needs across ComfyUI’s 5,000+ extensions and 60,000+ community nodes',
      'Use supported provider keys and existing contracts',
      'Run on workstations, GPU servers, or customer infrastructure',
    ]}
    primaryCta={{
      label: 'VIEW MANAGED BUILDS',
      href: '/enterprise/managed-builds/',
    }}
    secondaryCta={{
      label: 'SEE THE DEVELOPER PLATFORM',
      href: '/api/',
    }}
    manifestLabel="APPROVED BUILD"
    manifestName="Production environment"
    manifestVersion="CURRENT"
    manifestItems={[
      {
        id: 'dependencies',
        label: 'ComfyUI and dependencies',
        value: 'Pinned',
      },
      { id: 'nodes', label: 'Custom nodes', value: 'Allowlisted' },
      { id: 'models', label: 'Models', value: 'Approved and private' },
      { id: 'providers', label: 'Provider access', value: 'BYOK' },
    ]}
    releaseLabels={[
      { id: 'previous', label: 'Previous release' },
      { id: 'current', label: 'Current release', current: true },
    ]}
    deploymentTargets={[
      { id: 'workstations', label: 'Workstations' },
      { id: 'servers', label: 'GPU servers' },
      { id: 'infrastructure', label: 'Customer infrastructure' },
    ]}
  />

  <BenefitsGrid01
    heading="Govern the build, models, people, and usage."
    benefits={governanceBenefits}
    footnote="The graph stays flexible. The environment around it becomes an approved, reviewable operating model for the organization."
  />

  <CtaBands01
    bands={[
      {
        id: 'team-plans',
        label: 'TEAM PLANS',
        text: 'Invite members, run workflows concurrently, share one credit pool with centralized billing, and manage role-based permissions in a self-serve Comfy Cloud plan.',
        cta: { label: 'SUBSCRIBE NOW', href: '/pricing' },
      },
      {
        id: 'commercial-rights',
        label: 'COMMERCIAL RIGHTS',
        text: 'Every model on Cloud is licensed for commercial use. Local terms vary by provider, and Comfy is an official reseller for MiniMax commercial-use licenses.',
        cta: {
          label: 'VIEW MINIMAX LICENSING',
          href: '/minimax/license/',
        },
      },
      {
        id: 'fdc',
        label: 'FORWARD DEPLOYED CREATIVES',
        text: 'Builders, not advisors. Work directly with Comfy specialists to design, validate, and operationalize production Comfy Workflows your team owns and extends.',
        cta: {
          label: 'VIEW THE OFFERING',
          href: '/forward-deployed-creatives/',
        },
      },
    ]}
  />

  <BenefitsGrid01
    heading="Capacity and support for production."
    benefits={productionBenefits}
    footnote="Enterprise includes a 99.5% workflow-execution uptime SLA. Dedicated capacity, response commitments, and custom SLA terms are defined in your agreement."
    primaryCta={{ label: 'REQUEST DEMO', href: '/contact/' }}
  />

  <ReasonsSplit01
    heading={'Built with studios\n'}
    headingHighlight="in the room."
    highlightClass="text-primary-comfy-yellow"
    subtitle="For teams that need ComfyUI to move between people, productions, and partners without changing underneath them."
    reasons={industries}
  />

  <BenefitsGrid01
    heading="A clearer path through security review."
    benefits={[
      {
        id: 'soc2',
        title: 'SOC 2',
        description: 'Type II audit in progress.',
      },
      {
        id: 'sso',
        title: 'Identity',
        description: 'Single Sign-On is available for enterprise teams.',
      },
      {
        id: 'data',
        title: 'Data control',
        description:
          'For local deployments, Comfy Workflows and outputs stay where they run. Comfy does not train on customer data.',
      },
      {
        id: 'dpa',
        title: 'Procurement',
        description: 'A DPA and enterprise agreement are available.',
      },
    ]}
    footnote="Processing is in the United States on Google Cloud. Enterprise includes a 99.5% workflow-execution uptime SLA."
    primaryCta={{
      label: 'VIEW TRUST CENTER',
      href: externalLinks.trustCenter,
      target: '_blank',
    }}
  />

  <FAQSplit01
    id="faq"
    heading="Enterprise, answered."
    faqs={faqs}
    client:visible
  />
  <CtaCenter01
    heading={'Bring the open standard for visual AI\nto your organization.'}
    subtitle="Bring one known-good environment or the production requirement your team needs to scale. We will map deployment, governance, capacity, commercial terms, and the right implementation path."
    primaryCta={{ label: 'REQUEST DEMO', href: '/contact/' }}
  />
</BaseLayout>
