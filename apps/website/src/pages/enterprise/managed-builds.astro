---
import BenefitsGrid01 from '../../components/blocks/BenefitsGrid01.vue'
import BuildConfiguratorSplit01 from '../../components/blocks/BuildConfiguratorSplit01.vue'
import CardSplitContent02 from '../../components/blocks/CardSplitContent02.vue'
import CompareTable01 from '../../components/blocks/CompareTable01.vue'
import CtaBands01 from '../../components/blocks/CtaBands01.vue'
import FAQSplit01 from '../../components/blocks/FAQSplit01.vue'
import FeatureRows02 from '../../components/blocks/FeatureRows02.vue'
import HeroProduct01 from '../../components/blocks/HeroProduct01.vue'
import StepsCards01 from '../../components/blocks/StepsCards01.vue'
import IndustriesSection from '../../components/home/IndustriesSection.vue'
import DistributionsScene from '../../components/product/enterprise/DistributionsScene.vue'
import Button from '../../components/ui/button/Button.vue'
import { localizeHref } from '../../config/routes'
import { t } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ClosingCtaSection from '../../templates/platform/ClosingCtaSection.vue'
import { absoluteUrl, pageContext } from '../../utils/jsonLd'
import { buildFaqPageNode } from './_faqMetadata'

const { url, locale, canonicalLocale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)

// Keys are written out rather than built from an id. `t()` takes a literal
// union, so a typo is a compile error; a template string defeats that and the
// missing key surfaces as blank text on the page instead.
const faqs = [
  {
    id: 'what',
    question: t('enterprise.managedBuilds.faq.what.question', locale),
    answer: t('enterprise.managedBuilds.faq.what.answer', locale),
  },
  {
    id: 'where',
    question: t('enterprise.managedBuilds.faq.where.question', locale),
    answer: t('enterprise.managedBuilds.faq.where.answer', locale),
  },
  {
    id: 'models',
    question: t('enterprise.managedBuilds.faq.models.question', locale),
    answer: t('enterprise.managedBuilds.faq.models.answer', locale),
  },
  {
    id: 'nodes',
    question: t('enterprise.managedBuilds.faq.nodes.question', locale),
    answer: t('enterprise.managedBuilds.faq.nodes.answer', locale),
  },
  {
    id: 'access',
    question: t('enterprise.managedBuilds.faq.access.question', locale),
    answer: t('enterprise.managedBuilds.faq.access.answer', locale),
  },
  {
    id: 'usage',
    question: t('enterprise.managedBuilds.faq.usage.question', locale),
    answer: t('enterprise.managedBuilds.faq.usage.answer', locale),
  },
  {
    id: 'start',
    question: t('enterprise.managedBuilds.faq.start.question', locale),
    answer: t('enterprise.managedBuilds.faq.start.answer', locale),
  },
] as const

const governanceRows = [
  {
    id: 'build-policy',
    term: t('enterprise.managedBuilds.governance.build-policy.title', locale),
    description: t(
      'enterprise.managedBuilds.governance.build-policy.description',
      locale,
    ),
  },
  {
    id: 'model-policy',
    term: t('enterprise.managedBuilds.governance.model-policy.title', locale),
    description: t(
      'enterprise.managedBuilds.governance.model-policy.description',
      locale,
    ),
  },
  {
    id: 'people-access',
    term: t('enterprise.managedBuilds.governance.people-access.title', locale),
    description: t(
      'enterprise.managedBuilds.governance.people-access.description',
      locale,
    ),
  },
  {
    id: 'usage-records',
    term: t('enterprise.managedBuilds.governance.usage-records.title', locale),
    description: t(
      'enterprise.managedBuilds.governance.usage-records.description',
      locale,
    ),
  },
] as const

const included = t('enterprise.managedBuilds.compare.included', locale)
const notIncluded = t('enterprise.managedBuilds.compare.notIncluded', locale)
const enterpriseOnly = t(
  'enterprise.managedBuilds.compare.enterpriseOnly',
  locale,
)

const compareRows = [
  {
    id: 'packaging',
    feature: t('enterprise.managedBuilds.compare.packaging.feature', locale),
    cells: [included, included],
  },
  {
    id: 'sharing',
    feature: t('enterprise.managedBuilds.compare.sharing.feature', locale),
    cells: [notIncluded, enterpriseOnly],
  },
  {
    id: 'governance',
    feature: t('enterprise.managedBuilds.compare.governance.feature', locale),
    cells: [notIncluded, enterpriseOnly],
  },
  {
    id: 'python',
    feature: t('enterprise.managedBuilds.compare.python.feature', locale),
    cells: [included, included],
  },
] as const

const requestDemo = {
  label: t('enterprise.cta.requestDemo', locale),
  href: localizeHref('/contact/', locale),
}

const faqPage = buildFaqPageNode(url, faqs)
---

<BaseLayout
  title={t('enterprise.managedBuilds.meta.title', locale)}
  description={t('enterprise.managedBuilds.meta.description', locale)}
  pageType="WebPage"
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, localizeHref('/', canonicalLocale)),
    },
    {
      name: 'Enterprise',
      url: absoluteUrl(
        Astro.site,
        localizeHref('/enterprise/', canonicalLocale),
      ),
    },
    { name: 'ComfyUI Managed Builds' },
  ]}
  extraJsonLd={[faqPage]}
>
  <HeroProduct01
    headingTag="h1"
    title="MANAGED BUILDS"
    tag="BETA"
    body={t('enterprise.managedBuilds.hero.body', locale)}
    primaryCta={requestDemo}
  >
    <DistributionsScene slot="media" client:load />
  </HeroProduct01>

  <BuildConfiguratorSplit01
    eyebrow="MANAGED BUILDS"
    heading={t('enterprise.configurator.heading', locale)}
    body={t('enterprise.configurator.body', locale)}
    features={[
      t('enterprise.configurator.feature1', locale),
      t('enterprise.configurator.feature2', locale),
      t('enterprise.configurator.feature3', locale),
    ]}
    releasesLabel={t('enterprise.configurator.releasesLabel', locale)}
    releases={['v0.3.41', 'v0.3.40', 'v0.3.38']}
    environmentsLabel="PYTHON · PYTORCH · CUDA"
    environments={[
      { id: 'env-current', python: '3.12', torch: '2.6', cuda: '12.8' },
      { id: 'env-previous', python: '3.12', torch: '2.5', cuda: '12.4' },
      { id: 'env-legacy', python: '3.11', torch: '2.5', cuda: '12.4' },
    ]}
    nodesLabel={t('enterprise.configurator.nodesLabel', locale)}
    nodes={[
      { id: 'manager', label: 'ComfyUI-Manager', selected: true },
      { id: 'ipadapter', label: 'IPAdapter Plus', selected: true },
      { id: 'controlnet', label: 'ControlNet Aux' },
      { id: 'videohelper', label: 'VideoHelperSuite', selected: true },
      {
        id: 'studio-nodes',
        label: t('enterprise.configurator.privateNodes', locale),
        selected: true,
      },
    ]}
    modelsLabel={t('enterprise.configurator.modelsLabel', locale)}
    models={[
      { id: 'flux', label: 'FLUX 3', selected: true },
      { id: 'wan', label: 'Wan 3.0' },
      { id: 'sdxl', label: 'SDXL Base', selected: true },
      { id: 'ltx', label: 'LTX-2.5' },
      {
        id: 'brand-lora',
        label: t('enterprise.configurator.privateModel', locale),
        selected: true,
      },
    ]}
    nodesUnit={t('enterprise.configurator.nodesUnit', locale)}
    modelsUnit={t('enterprise.configurator.modelsUnit', locale)}
    pinnedLabel={t('enterprise.configurator.pinned', locale)}
    moreOptionsLabel={t('enterprise.configurator.moreOptions', locale)}
    cta={requestDemo}
    client:visible
  />

  <FeatureRows02
    heading={t('enterprise.managedBuilds.build.heading', locale)}
    rows={[
      {
        id: 'packaging',
        term: t('enterprise.managedBuilds.build.packaging.title', locale),
        description: t(
          'enterprise.managedBuilds.build.packaging.description',
          locale,
        ),
      },
      {
        id: 'governance',
        term: t('enterprise.managedBuilds.build.governance.title', locale),
        description: t(
          'enterprise.managedBuilds.build.governance.description',
          locale,
        ),
      },
      {
        id: 'rollout',
        term: t('enterprise.managedBuilds.build.rollout.title', locale),
        description: t(
          'enterprise.managedBuilds.build.rollout.description',
          locale,
        ),
      },
    ]}
  />

  <div id="how-it-works" class="scroll-mt-24">
    <StepsCards01
      heading={t('enterprise.managedBuilds.steps.heading', locale)}
      steps={[
        {
          id: 'define',
          title: t('enterprise.managedBuilds.steps.define.title', locale),
          description: t(
            'enterprise.managedBuilds.steps.define.description',
            locale,
          ),
        },
        {
          id: 'build',
          title: t('enterprise.managedBuilds.steps.build.title', locale),
          description: t(
            'enterprise.managedBuilds.steps.build.description',
            locale,
          ),
        },
        {
          id: 'update',
          title: t('enterprise.managedBuilds.steps.update.title', locale),
          description: t(
            'enterprise.managedBuilds.steps.update.description',
            locale,
          ),
        },
        {
          id: 'deploy',
          title: t('enterprise.managedBuilds.steps.deploy.title', locale),
          description: t(
            'enterprise.managedBuilds.steps.deploy.description',
            locale,
          ),
        },
      ]}
    />
  </div>

  <CardSplitContent02
    title={t('enterprise.governance.heading', locale)}
    imageSrc="/assets/enterprise/govern-matrix-city.webp"
  />
  <FeatureRows02
    class="pt-0 lg:pt-0"
    rows={governanceRows}
    footnote={t('enterprise.governance.footnote', locale)}
  />

  <BenefitsGrid01
    heading={t('enterprise.managedBuilds.security.heading', locale)}
    columns={2}
    numbered={false}
    contained={false}
    benefits={[
      {
        id: 'local',
        title: t('enterprise.managedBuilds.security.local.title', locale),
        description: t(
          'enterprise.managedBuilds.security.local.description',
          locale,
        ),
      },
      {
        id: 'private-assets',
        title: t(
          'enterprise.managedBuilds.security.private-assets.title',
          locale,
        ),
        description: t(
          'enterprise.managedBuilds.security.private-assets.description',
          locale,
        ),
      },
      {
        id: 'access',
        title: t('enterprise.managedBuilds.security.access.title', locale),
        description: t(
          'enterprise.managedBuilds.security.access.description',
          locale,
        ),
      },
      {
        id: 'usage',
        title: t('enterprise.managedBuilds.security.usage.title', locale),
        description: t(
          'enterprise.managedBuilds.security.usage.description',
          locale,
        ),
      },
    ]}
    footnote={t('enterprise.managedBuilds.security.footnote', locale)}
  />

  <CompareTable01
    heading={t('enterprise.managedBuilds.compare.heading', locale)}
    subtitle={t('enterprise.managedBuilds.compare.subtitle', locale)}
    columns={[
      t('enterprise.managedBuilds.compare.columnBuilds', locale),
      t('enterprise.managedBuilds.compare.columnManaged', locale),
    ]}
    rows={compareRows}
  />

  <div class="max-w-9xl mx-auto flex justify-center px-6 pb-16 lg:pb-24">
    <Button
      as="a"
      href={localizeHref('/platform/builder', locale)}
      variant="outline"
      size="lg"
      class="h-12 rounded-full text-sm"
    >
      {t('enterprise.managedBuilds.compare.exploreBuilds', locale)}
    </Button>
  </div>

  <FAQSplit01
    id="faq"
    heading={t('enterprise.managedBuilds.faq.heading', locale)}
    faqs={faqs}
    client:visible
  />

  <IndustriesSection
    locale={locale}
    heading={t('enterprise.industries.heading', locale)}
    client:visible
  />

  <ClosingCtaSection
    locale={locale}
    heading-after-badge={t(
      'enterprise.managedBuilds.closing.headingAfterBadge',
      locale,
    )}
    client:visible
  />

  <CtaBands01
    variant="highlight"
    bands={[
      {
        id: 'fdc',
        label: t('enterprise.offers.forward-deployed-creatives.title', locale),
        text: t('enterprise.managedBuilds.fdcBand.text', locale),
        cta: {
          label: t(
            'enterprise.offers.forward-deployed-creatives.cta.label',
            locale,
          ),
          href: localizeHref('/forward-deployed-creatives/', locale),
        },
      },
    ]}
  />
</BaseLayout>
