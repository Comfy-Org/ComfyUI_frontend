---
import CtaCenter01 from '../../components/blocks/CtaCenter01.vue'
import FAQSplit01 from '../../components/blocks/FAQSplit01.vue'
import HeroSplit01 from '../../components/blocks/HeroSplit01.vue'
import EnterpriseGovernance from '../../components/product/enterprise/EnterpriseGovernance.astro'
import ManagedBuildsIndustries from '../../components/product/enterprise/ManagedBuildsIndustries.astro'
import ManagedBuildsLifecycle from '../../components/product/enterprise/ManagedBuildsLifecycle.astro'
import ManagedBuildsMedia from '../../components/product/enterprise/ManagedBuildsMedia.astro'
import ManagedBuildsProblems from '../../components/product/enterprise/ManagedBuildsProblems.astro'
import ManagedBuildsSecurity from '../../components/product/enterprise/ManagedBuildsSecurity.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { faqAnswerPlainText } from '../../utils/faqAnswer'
import { absoluteUrl, faqPageNode, pageContext } from '../../utils/jsonLd'

const faqs = [
  { id: 'what', question: 'What is a ComfyUI Managed Build?', answer: 'A Managed Build is an approved, reproducible ComfyUI environment. It pins the ComfyUI version, custom nodes, models, and dependencies your team needs so the same setup can be assigned and updated across machines.' },
  { id: 'where', question: 'Where do Managed Builds run?', answer: 'Managed Builds run on your workstations, studio GPU servers, or customer cloud infrastructure. Your Comfy Workflows stay on the machines where they run.' },
  { id: 'models', question: 'Can we use private models and our own provider keys?', answer: 'Yes. Teams can include private fine-tuned models, govern which models and partner providers are available in a build, and use supported provider keys with their existing contracts.' },
  { id: 'nodes', question: 'How are custom nodes governed?', answer: 'Administrators choose which custom nodes belong in each build. Nodes can be sourced from GitHub or a ZIP, then pinned with the rest of the environment for controlled rollout.' },
  { id: 'access', question: 'How are users and teams assigned?', answer: 'Company identity and SSO can gate access to approved builds. Teams receive the environments assigned to them instead of configuring every machine independently.' },
  { id: 'usage', question: 'What usage and audit information is available?', answer: 'Usage visibility is available by model and partner. If you need specific authentication, build-assignment, release, retention, or export events, include them in the security review so the audit scope is explicit.' },
  { id: 'start', question: 'How do we get started?', answer: 'Request a demo and bring the environments your teams rely on today. We will map the current setup, deployment targets, governance requirements, and a path to the first approved build.' },
] as const

const { url } = pageContext(Astro.site, Astro.url.pathname, Astro.currentLocale)
const faqPage = faqPageNode(url, faqs.map((faq) => ({ question: faq.question, answer: faqAnswerPlainText(faq.answer) })))
---

<BaseLayout
  title="ComfyUI Managed Builds | Govern ComfyUI across your fleet"
  description="Create approved, reproducible ComfyUI environments and deploy them across workstations, studios, and customer infrastructure."
  pageType="WebPage"
  breadcrumbs={[
    { name: 'Home', url: absoluteUrl(Astro.site, '/') },
    { name: 'Enterprise', url: absoluteUrl(Astro.site, '/enterprise/') },
    { name: 'ComfyUI Managed Builds' },
  ]}
  extraJsonLd={[faqPage]}
>
  <HeroSplit01
    badgeText="COMFYUI MANAGED BUILDS"
    title={'One approved ComfyUI environment.\nEvery team, every machine.'}
    subtitle="Define the ComfyUI release, custom nodes, models, and dependencies your team is approved to run. Ship the same versioned build wherever the work happens."
    features={['Private custom nodes and models', 'Use supported provider keys and existing contracts', 'Assign approved builds through company identity']}
    primaryCta={{ label: 'REQUEST DEMO', href: '/contact/' }}
    secondaryCta={{ label: 'SEE HOW IT WORKS', href: '#how-it-works' }}
    mediaFirstOnMobile={false}
  >
    <!-- Pass videoSrc when the final H.264 export lands. The build manifest remains the no-JS poster fallback. -->
    <ManagedBuildsMedia slot="media" />
  </HeroSplit01>

  <ManagedBuildsProblems />
  <ManagedBuildsLifecycle />
  <EnterpriseGovernance />
  <ManagedBuildsSecurity />
  <ManagedBuildsIndustries />

  <section class="max-w-9xl mx-auto px-6 py-16 lg:px-20 lg:py-24">
    <div class="grid items-center gap-10 rounded-[2.5rem] bg-primary-comfy-yellow p-8 text-primary-comfy-ink lg:grid-cols-[1fr_auto] lg:p-14">
      <div><p class="text-xs font-bold tracking-[0.2em]">HANDS-ON DELIVERY</p><h2 class="mt-4 text-3xl font-light tracking-tight lg:text-5xl">Need the production workflow, too?</h2><p class="mt-5 max-w-2xl text-base/relaxed text-primary-comfy-ink/70">Forward Deployed Creatives work alongside your team to build the Comfy Workflows that run inside your approved environments.</p></div>
      <a href="/forward-deployed-creatives/" class="inline-flex rounded-full bg-primary-comfy-ink px-7 py-4 text-sm font-bold text-primary-comfy-canvas">VIEW THE OFFERING</a>
    </div>
  </section>

  <FAQSplit01 id="faq" heading="Managed Builds, answered." faqs={faqs} client:visible />
  <CtaCenter01 heading={'Your best ComfyUI setup,\nready for the whole team.'} subtitle="Bring us the environment that works today. We will show you how to govern and reproduce it across the fleet." primaryCta={{ label: 'REQUEST DEMO', href: '/contact/' }} />
</BaseLayout>
