---
import CatalogueCard from '../../../components/hub/CatalogueCard.vue'
import WorkflowAside from '../../../components/hub/WorkflowAside.vue'
import WorkflowPorts from '../../../components/hub/WorkflowPorts.vue'
import WorkflowRunsOn from '../../../components/hub/WorkflowRunsOn.vue'
import { workshopModels } from '../../../config/workshop-browse-content'
import hubTemplateDetails from '../../../data/hubTemplateDetails.json'
import {
  customNodeNames,
  relatedCardViews
} from '../../../lib/hub/page-data'
import { tagDisplayName } from '../../../lib/hub/tag-aliases'
import { hubTemplateDetailsSchema } from '../../../lib/hub/types'
import {
  formatWeights,
  getHubWorkflowPage,
  listHubWorkflows
} from '../../../lib/hub/workflow-detail'
import { t } from '../../../i18n/translations'
import BaseLayout from '../../../layouts/BaseLayout.astro'

export function getStaticPaths() {
  return listHubWorkflows().map((template) => ({
    params: { name: template.name }
  }))
}

const { name } = Astro.params
const page = name ? getHubWorkflowPage(name) : undefined
if (!page) return Astro.redirect('/models-v2/')

const { template, mediaType, details, runsOn, related } = page

const author = template.username || 'ComfyUI'
const mediaLabels: Record<string, string> = {
  image: t('workshop.hub.io.image'),
  video: t('workshop.hub.io.video'),
  audio: t('workshop.hub.io.audio'),
  '3d': t('workshop.hub.io.3d')
}
const pills = [
  template.isApp ? t('workshop.v2.kind.app') : t('workshop.v2.kind.workflow'),
  mediaLabels[mediaType],
  details.openSource ? t('workshop.v2.workflow.openWeights') : undefined
].filter((label): label is string => Boolean(label))

// An app is a graph someone wrapped in a form, so its inputs are the thing it
// is; a node graph's inputs are what its loader nodes read off disk.
const inputsHeading = template.isApp
  ? t('workshop.v2.workflow.form')
  : t('workshop.v2.workflow.loads')

const relatedViews = relatedCardViews(
  related.slice(0, 4),
  workshopModels,
  customNodeNames(hubTemplateDetailsSchema.parse(hubTemplateDetails))
)

const pill =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-2xs/none font-bold tracking-wider text-primary-warm-white uppercase'
const tagClass =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-xs text-primary-comfy-canvas transition-colors hover:bg-transparency-white-t20 hover:text-primary-comfy-yellow'
---

<BaseLayout
  title={`${template.title} - Comfy`}
  description={details.description ?? template.title}
  ogImage={template.thumbnails[0]}
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-10 lg:px-8 lg:py-16">
    <a
      href="/models-v2/"
      class="mb-8 inline-flex items-center gap-2 text-sm text-content-muted transition-colors hover:text-content-bright"
    >
      {t('workshop.v2.workflow.back')}
    </a>

    <header class="mb-10 flex flex-col gap-4">
      <ul class="flex flex-wrap items-center gap-2" data-testid="workflow-kind">
        {pills.map((label) => <li><span class={pill}>{label}</span></li>)}
      </ul>
      <h1
        class="max-w-3xl text-3xl font-bold text-primary-comfy-canvas lg:text-5xl"
      >
        {template.title}
      </h1>
      <p class="text-sm text-content-secondary" data-testid="workflow-author">
        {t('workshop.workflow.by').replace('{author}', author)}
      </p>
    </header>

    <div class="grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col gap-10 lg:col-span-7">
        {
          template.thumbnails[0] && (
            <img
              src={template.thumbnails[0]}
              alt={template.title}
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full rounded-3xl bg-hub-surface object-cover"
              data-testid="workflow-media"
            />
          )
        }

        {
          details.description && (
            <p
              class="max-w-2xl text-base/relaxed text-primary-comfy-canvas/80"
              data-testid="workflow-summary"
            >
              {details.description}
            </p>
          )
        }

        <WorkflowRunsOn models={runsOn} />

        <section class="grid gap-6 sm:grid-cols-2">
          {
            page.inputs.length > 0 && (
              <div data-testid="workflow-inputs">
                <WorkflowPorts heading={inputsHeading} rows={page.inputs} />
              </div>
            )
          }
          <div data-testid="workflow-outputs">
            <WorkflowPorts
              heading={t('workshop.v2.workflow.produces')}
              rows={page.outputs}
            />
          </div>
        </section>

        <ul class="flex flex-wrap gap-2" data-testid="workflow-tags">
          {
            template.tags.map((tag) => (
              <li>
                <a
                  href={`/models-v2/?q=${encodeURIComponent(tagDisplayName(tag))}`}
                  class={tagClass}
                >
                  {tagDisplayName(tag)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-5">
        <WorkflowAside
          downloadUrl={page.downloadUrl}
          tutorialUrl={details.tutorialUrl}
          weights={formatWeights(page.weightsBytes)}
          customNodes={page.customNodes}
          callsPartnerModel={page.callsPartnerModel}
          destination={page.destination}
        />
      </div>
    </div>

    {
      relatedViews.length > 0 && (
        <section class="mt-24 border-t border-transparency-white-t8 pt-12">
          <h2 class="mb-6 text-xl font-bold text-primary-comfy-canvas">
            {template.isApp
              ? t('workshop.v2.workflow.relatedApps')
              : t('workshop.v2.workflow.related')}
          </h2>
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {relatedViews.map((view) => (
              <li>
                <CatalogueCard view={view} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>
