---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductCardsSection from '../components/common/ProductCardsSection.vue'
import HeroSection from '../templates/mcp/HeroSection.vue'
import SetupSection from '../templates/mcp/SetupSection.vue'
import WhySection from '../templates/mcp/WhySection.vue'
import ToolsSection from '../templates/mcp/ToolsSection.vue'
import UseCasesSection from '../templates/mcp/UseCasesSection.vue'
import HowItWorksSection from '../templates/mcp/HowItWorksSection.vue'
import FAQSection from '../templates/mcp/FAQSection.vue'
import AnnouncementBanner from '../templates/drops/AnnouncementBanner.vue'
import type { BannerData } from '../config/banner'
import { createBannerVersion } from '../utils/banner'
import { t } from '../i18n/translations'
import { pageContext } from '../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)




// One-off page banner (not the sitewide `bannerConfig`): points the MCP page
// at the Comfy Agent beta waitlist. Not dismissible, so no pre-hydration
// hide script is needed the way BaseLayout wires one up for the sitewide banner.
const agentBannerData: BannerData = {
  id: 'mcp-agent-waitlist',
  title: 'The Comfy Agent is in beta. Get early access.',
  link: {
    href: '/agent',
    title: 'Join the waitlist',
    buttonVariant: 'underlineLink'
  }
}
const agentBannerVersion = createBannerVersion(agentBannerData, locale)
---

<BaseLayout
  title={t('mcp.meta.title', locale)}
  description={t('mcp.meta.description', locale)}
>
  <AnnouncementBanner
    data={agentBannerData}
    version={agentBannerVersion}
    locale={locale}
    background="var(--color-primary-comfy-ink-light)"
    centered
    dismissible={false}
    client:load
  />
  <HeroSection locale={locale} client:load />
  <SetupSection locale={locale} client:visible />
  <ToolsSection locale={locale} client:visible />
  <UseCasesSection locale={locale} client:visible />
  <WhySection locale={locale} />
  <HowItWorksSection locale={locale} />
  <ProductCardsSection locale={locale} label-key="products.labelProducts" />
  <FAQSection client:visible locale={locale} />
</BaseLayout>
