---
import BreadcrumbBar from '../../components/common/BreadcrumbBar.vue'
import CustomerArticle from '../../components/customers/CustomerArticle.astro'
import DetailHeroSection from '../../components/customers/DetailHeroSection.vue'
import WhatsNextSection from '../../components/customers/WhatsNextSection.vue'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { customerVideoForStory } from '../../data/customerVideos'
import { t } from '../../i18n/translations'
import { nextStory, storySlug } from '../../utils/customers'
import { loadStories } from '../../utils/loadStories'
import {
  absoluteUrl,
  articleNode,
  jsonLdId,
  pageContext
} from '../../utils/jsonLd'
import { localizeHref } from '../../config/routes'

const { siteUrl, locale, canonicalUrl, canonicalLocale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale
)

export async function getStaticPaths() {
  const stories = await loadStories('en')
  return stories.map((entry) => ({
    params: { slug: storySlug(entry.id) },
    props: { entry, next: nextStory(stories, storySlug(entry.id)) }
  }))
}

/**
 * Re-resolved for THIS page's locale.
 *
 * `getStaticPaths` runs before any page renders and cannot see a locale, so it
 * necessarily loads the English stories. Once the i18n fallback serves
 * /zh-CN/customers/<slug> from this same file, those English props would be
 * rendered at a Chinese URL — the Chinese customer stories came out entirely in
 * English. The slug is locale-invariant, so the story is looked up again here,
 * where `Astro.currentLocale` is known, and falls back to the English entry when
 * a locale has no translation of it.
 */
const { entry: englishEntry, next: englishNext } = Astro.props
const slug = storySlug(englishEntry.id)
const localeStories = await loadStories(locale)
const localeEntry = localeStories.find((story) => storySlug(story.id) === slug)
// `nextStory` throws on an unknown slug on purpose, so it is only asked about a
// locale that actually has this story. Japanese has no customer stories at all.
const entry = localeEntry ?? englishEntry
const next = localeEntry ? nextStory(localeStories, slug) : englishNext


const article = articleNode({
  siteUrl,
  pageUrl: canonicalUrl,
  title: entry.data.title,
  description: entry.data.description,
  imageUrl: entry.data.cover,
  locale
})

const homeLabel = t('breadcrumb.home', locale)
const collectionLabel = t('nav.customerStories', locale)
const relatedVideo = customerVideoForStory(storySlug(entry.id))
---

<BaseLayout
  title={`${entry.data.title} - Comfy`}
  description={entry.data.description}
  ogImage={entry.data.cover}
  mainEntityId={jsonLdId(canonicalUrl, 'article')}
  breadcrumbs={[
    { name: homeLabel, url: absoluteUrl(Astro.site, localizeHref('/', canonicalLocale)) },
    {
      name: collectionLabel,
      url: absoluteUrl(Astro.site, localizeHref('/customers', canonicalLocale))
    },
    { name: entry.data.title }
  ]}
  extraJsonLd={[article]}
>
  <BreadcrumbBar
    crumbs={[
      { label: homeLabel, href: localizeHref('/', locale) },
      { label: collectionLabel, href: localizeHref('/customers', locale) },
      { label: entry.data.title }
    ]}
    label={t('ui.breadcrumb', locale)}
  />
  <DetailHeroSection
    label={entry.data.category}
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.cover}
  />
  <CustomerArticle locale={locale} entry={entry} />
  {
    relatedVideo && (
      <div class="max-w-9xl mx-auto px-6 pb-10 lg:px-16">
        <a
          href={localizeHref(`/customers/videos/${relatedVideo.slug}`, locale)}
          class="text-sm font-semibold tracking-wide text-primary-comfy-yellow uppercase hover:underline"
        >
          {t('customers.article.watchVideo', locale)}
        </a>
      </div>
    )
  }
  <WhatsNextSection
    locale={locale}
    title={next.data.title}
    image={next.data.cover}
    href={localizeHref(`/customers/${storySlug(next.id)}`, locale)}
  />
</BaseLayout>
