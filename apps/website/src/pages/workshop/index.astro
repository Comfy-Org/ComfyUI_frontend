---
import { getCollection } from 'astro:content'

import WorkshopCatalog from '../../components/workshop/WorkshopCatalog.vue'
import { toBrowseModel } from '../../config/workshop'
import { t } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  absoluteUrl,
  itemListNode,
  jsonLdId,
  pageContext
} from '../../utils/jsonLd'

// Projected at build time so the island receives card-sized records. The
// models' input schemas are the bulk of each entry and the browse page has
// no use for them, so they never reach the browser.
const models = (await getCollection('workshopModels'))
  .map((entry) => toBrowseModel(entry.data))
  .sort((a, b) => a.id.localeCompare(b.id))

const { locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const title = t('workshop.meta.title', locale)
const modelList = itemListNode(
  url,
  title,
  models.map((model) => ({
    url: absoluteUrl(Astro.site, model.href),
    name: model.name
  }))
)
---

<BaseLayout
  title={title}
  description={t('workshop.meta.description', locale)}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(url, 'itemlist')}
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    { name: title }
  ]}
  extraJsonLd={[modelList]}
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-16 lg:px-8 lg:py-24">
    <WorkshopCatalog models={models} client:load />
  </main>
</BaseLayout>
