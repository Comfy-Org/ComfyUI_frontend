---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WorkshopHero from '../../components/workshop/WorkshopHero.astro'
import WorkshopModelsGrid from '../../components/workshop/WorkshopModelsGrid.vue'
import WorkshopTabs from '../../components/workshop/WorkshopTabs.astro'
import { workshopModels } from '../../config/workshop'
import { t } from '../../i18n/translations'
---

<BaseLayout
  title={t('workshop.meta.title')}
  description={t('workshop.meta.description')}
  noindex
>
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
    <WorkshopHero />
    <WorkshopTabs active="models" />
    <WorkshopModelsGrid models={workshopModels} client:load />
  </div>
</BaseLayout>
