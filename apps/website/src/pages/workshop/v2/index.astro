---
import CatalogueBrowse from '../../../components/hub/CatalogueBrowse.vue'
import { useCaseFor } from '../../../config/models-catalogue'
import { estimateWorkshopNodePrice } from '../../../config/workshop-node-pricing'
import { workshopModels } from '../../../config/workshop-browse-content'
import { t } from '../../../i18n/translations'
import BaseLayout from '../../../layouts/BaseLayout.astro'

// A V2 proposal, not a shipped route: the live catalogue stays at /workshop
// while this one is argued over.

// Resolved here rather than in the island, so a grid of 122 models does not
// open on 122 asynchronous price lookups.
const priced = await Promise.all(
  workshopModels.map(
    async (model) =>
      [
        model.slug,
        await estimateWorkshopNodePrice(model, useCaseFor(model))
      ] as const
  )
)
const prices = Object.fromEntries(
  priced.filter((entry): entry is readonly [string, string] =>
    Boolean(entry[1])
  )
)
---

<BaseLayout
  title={t('workshop.v2.meta.title')}
  description={t('workshop.v2.meta.description')}
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-16 lg:px-8 lg:py-24">
    <CatalogueBrowse prices={prices} client:only="vue" />
  </main>
</BaseLayout>
