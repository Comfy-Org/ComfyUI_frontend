---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ModelDetail from '../../../components/workshop/ModelDetail.vue'
import ModelStatus from '../../../components/workshop/ModelStatus.vue'
import PrototypeTweaks from '../../../components/workshop/PrototypeTweaks.vue'
import StaticFrame from '../../../components/workshop/StaticFrame.vue'
import WorkshopModelCard from '../../../components/workshop/WorkshopModelCard.vue'
import { getRoutes } from '../../../config/routes'
import {
  catalogSearch,
  formatRuns,
  getWorkshopModel,
  getWorkshopModelDetail,
  workshopModels
} from '../../../config/workshop'
import { familyOf } from '../../../config/model-family'
import { relatedModels } from '../../../config/workshop-related'
import { t } from '../../../i18n/translations'

export const getStaticPaths: GetStaticPaths = () =>
  workshopModels.map((model) => ({ params: { slug: model.slug } }))

const { slug } = Astro.params
const model = getWorkshopModelDetail(slug as string)!
const family = familyOf(workshopModels, model.slug)
const versions = family && family.versions.length > 1 ? family.versions : []
// The releases of this model are on the switcher, so they stay out of "more".
const related = relatedModels(
  model,
  workshopModels.filter(
    (other) => !versions.some((version) => version.slug === other.slug)
  )
)
const relatedHeading =
  model.provider && related.some((other) => other.provider === model.provider)
    ? t('workshop.model.relatedProvider').replace('{provider}', model.provider)
    : t('workshop.model.related')
const successor = model.successorSlug
  ? getWorkshopModel(model.successorSlug)
  : undefined
const routes = getRoutes()

const modalityLabel = {
  image: t('workshop.filter.image'),
  video: t('workshop.filter.video'),
  audio: t('workshop.filter.audio'),
  '3d': t('workshop.filter.3d'),
  text: t('workshop.filter.text')
} as const

const price =
  model.creditsPerRun !== undefined
    ? `${model.creditsPerRun} ${t('nav.credits')}`
    : undefined

const pillClass =
  'inline-flex h-6 items-center rounded-2xl bg-transparency-white-t8 px-3 text-[11px] leading-none font-bold tracking-wider text-primary-warm-white uppercase'

const tags = [
  ...(model.provider
    ? [{ label: model.provider, search: catalogSearch({ providers: [model.provider] }) }]
    : []),
  ...model.capabilities.map((capability) => ({
    label: capability,
    search: catalogSearch({ capabilities: [capability] })
  }))
]
---

<BaseLayout
  title={`${model.name} · ${t('workshop.title')} - Comfy`}
  description={t('workshop.model.meta.description').replace('{name}', model.name)}
  ogImage={model.thumbnailUrl}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 py-12 lg:px-8 lg:py-16">
    <nav aria-label="Breadcrumb" class="mb-8 px-8 text-xs text-primary-warm-gray lg:px-10">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={routes.home} class="hover:text-primary-warm-white">
            {t('breadcrumb.home')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href={routes.workshop} class="hover:text-primary-warm-white">
            {t('workshop.models.heading')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-primary-warm-white" aria-current="page">{model.name}</li>
      </ol>
    </nav>
    <header
      class="relative mb-12 overflow-hidden rounded-4.5xl bg-primary-comfy-ink-light"
      data-testid="model-hero"
    >
      {
        model.thumbnailUrl && (
          <StaticFrame
            src={model.thumbnailUrl}
            class="absolute inset-0 size-full object-cover opacity-40"
            client:load
          />
        )
      }
      <div
        class="absolute inset-0 bg-linear-to-r from-primary-comfy-ink via-primary-comfy-ink/75 to-primary-comfy-ink/10"
      />

      <div
        class="relative flex min-h-52 flex-col justify-center gap-6 p-8 lg:min-h-60 lg:p-10"
      >
        <div class="flex max-w-2xl flex-col gap-3">
        <p
          class="text-sm leading-none font-medium tracking-widest text-primary-comfy-yellow uppercase"
        >
          {model.provider ?? t('workshop.card.partnerNode')}
        </p>

        <h1 class="text-3xl font-bold text-primary-comfy-canvas lg:text-5xl">
          {model.name}
        </h1>

        {
          versions.length > 0 && (
            <nav
              class="flex flex-wrap items-center gap-2"
              aria-label={t('workshop.model.versionsLabel')}
              data-testid="model-versions"
            >
              {versions.map((version) => (
                <a
                  href={version.href}
                  aria-current={version.name === model.name ? 'page' : undefined}
                  class={`inline-flex h-8 items-center gap-2 rounded-2xl border px-3 text-xs transition-colors ${
                    version.name === model.name
                      ? 'border-primary-comfy-yellow text-primary-comfy-yellow'
                      : 'border-transparency-white-t20 text-primary-comfy-canvas hover:border-primary-comfy-yellow hover:text-primary-comfy-yellow'
                  }`}
                >
                  {version.name}
                  {version.slug === family?.latest.slug && (
                    <span class="text-[10px] font-bold tracking-wider text-primary-warm-gray uppercase">
                      {t('workshop.model.latest')}
                    </span>
                  )}
                </a>
              ))}
            </nav>
          )
        }

        <p
          class="flex items-baseline gap-1.5 text-sm text-primary-comfy-canvas/70"
          data-testid="model-price"
        >
          {
            price ? (
              <>
                <span class="text-lg font-bold text-primary-comfy-yellow">{price}</span>
                {t('workshop.model.perRun')}
                <span class="text-primary-comfy-canvas/40">·</span>
                <span data-testid="model-runs">
                  {t('workshop.card.runs').replace('{n}', formatRuns(model.runs, 'en'))}
                </span>
              </>
            ) : (
              t('workshop.card.priceOnPage')
            )
          }
        </p>

        <ModelStatus
          status={model.status}
          variant="banner"
          successor={successor ? { name: successor.name, href: successor.href } : undefined}
          client:load
        />

        <ul class="mt-2 flex flex-wrap items-center gap-2" data-testid="model-tags">
          {model.modality && (
            <li>
              <span class={pillClass}>{modalityLabel[model.modality]}</span>
            </li>
          )}
          {tags.map((tag) => (
            <li>
              <a
                href={`${routes.workshop}${tag.search}`}
                class="inline-flex h-6 items-center rounded-2xl border border-transparency-white-t20 px-3 text-xs text-primary-comfy-canvas transition-colors hover:border-primary-comfy-yellow hover:text-primary-comfy-yellow"
              >
                {tag.label}
              </a>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </header>

    <div class="px-8 lg:px-10">
    <ModelDetail model={model} client:load />

    <section
      class="mt-24 border-t border-transparency-white-t8 pt-12"
      data-testid="related-models"
    >
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-primary-comfy-canvas">
          {relatedHeading}
        </h2>
        <a
          href={routes.workshop}
          class="text-sm font-bold tracking-wider text-primary-comfy-yellow uppercase hover:underline"
        >
          {t('workshop.model.browseAll')}
        </a>
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          related.map((other) => (
            <li>
              <WorkshopModelCard model={other} />
            </li>
          ))
        }
      </ul>
    </section>
    </div>
  </div>
  <PrototypeTweaks show-run-controls client:load />
</BaseLayout>
