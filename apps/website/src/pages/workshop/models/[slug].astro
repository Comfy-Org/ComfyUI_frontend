---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ModelDetail from '../../../components/workshop/ModelDetail.vue'
import ModelStatus from '../../../components/workshop/ModelStatus.vue'
import PrototypeTweaks from '../../../components/workshop/PrototypeTweaks.vue'
import StaticFrame from '../../../components/workshop/StaticFrame.vue'
import WorkshopModelCard from '../../../components/workshop/WorkshopModelCard.vue'
import { getRoutes } from '../../../config/routes'
import {
  getWorkshopModel,
  getWorkshopModelDetail,
  workshopModels
} from '../../../config/workshop'
import { relatedModels } from '../../../config/workshop-related'
import { t } from '../../../i18n/translations'

export const getStaticPaths: GetStaticPaths = () =>
  workshopModels.map((model) => ({ params: { slug: model.slug } }))

const { slug } = Astro.params
const model = getWorkshopModelDetail(slug as string)!
const related = relatedModels(model, workshopModels)
const successor = model.successorSlug
  ? getWorkshopModel(model.successorSlug)
  : undefined
const routes = getRoutes()

const modalityLabel = {
  image: t('workshop.filter.image'),
  video: t('workshop.filter.video'),
  audio: t('workshop.filter.audio'),
  '3d': t('workshop.filter.3d'),
  text: t('workshop.filter.text')
} as const

const price =
  model.priceUsdFrom !== undefined
    ? new Intl.NumberFormat('en', {
        style: 'currency',
        currency: 'USD'
      }).format(model.priceUsdFrom)
    : model.creditsPerRun !== undefined
      ? `${model.creditsPerRun} ${t('nav.credits')}`
      : undefined

const pillClass =
  'rounded-2xl bg-transparency-white-t8 px-3 py-1 text-[11px] font-bold tracking-wider text-primary-warm-white uppercase'
---

<BaseLayout
  title={`${model.name} · ${t('workshop.title')} - Comfy`}
  description={t('workshop.model.meta.description').replace('{name}', model.name)}
  ogImage={model.thumbnailUrl}
  noindex
>
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <header
      class="relative mb-12 overflow-hidden rounded-4.5xl bg-primary-comfy-ink-light"
      data-testid="model-hero"
    >
      {
        model.thumbnailUrl && (
          <StaticFrame
            src={model.thumbnailUrl}
            class="absolute inset-0 size-full object-cover opacity-60"
            client:load
          />
        )
      }
      <div
        class="absolute inset-0 bg-linear-to-r from-primary-comfy-ink via-primary-comfy-ink/75 to-primary-comfy-ink/10"
      />

      <div
        class="relative flex min-h-52 flex-col justify-between gap-6 p-8 lg:min-h-60 lg:p-10"
      >
        <nav aria-label="Breadcrumb" class="text-xs text-primary-warm-gray">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href={routes.workshop} class="hover:text-primary-warm-white">
                {t('workshop.title')}
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-primary-warm-white" aria-current="page">{model.name}</li>
          </ol>
        </nav>

        <div class="flex max-w-2xl flex-col gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <p
            class="text-sm font-medium uppercase tracking-widest text-primary-comfy-yellow"
          >
            {model.provider ?? t('workshop.card.partnerNode')}
          </p>
          {model.modality && <span class={pillClass}>{modalityLabel[model.modality]}</span>}
          <ModelStatus status={model.status} variant="pill" client:load />
        </div>

        <h1 class="text-3xl font-bold text-primary-comfy-canvas lg:text-5xl">
          {model.name}
        </h1>

        <p
          class="flex items-baseline gap-1.5 text-sm text-primary-comfy-canvas/70"
          data-testid="model-price"
        >
          {
            price ? (
              <>
                <span class="text-[11px] tracking-wider uppercase">
                  {t('workshop.card.from')}
                </span>
                <span class="text-lg font-bold text-primary-comfy-yellow">{price}</span>
                {t('workshop.model.perRun')}
              </>
            ) : (
              t('workshop.card.priceOnPage')
            )
          }
        </p>

        <ModelStatus
          status={model.status}
          variant="banner"
          successor={successor ? { name: successor.name, href: successor.href } : undefined}
          client:load
        />
        </div>
      </div>
    </header>

    <div class="px-8 lg:px-10">
    <ModelDetail model={model} client:load />

    <section
      class="mt-24 border-t border-transparency-white-t8 pt-12"
      data-testid="related-models"
    >
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-primary-comfy-canvas">
          {t('workshop.model.related')}
        </h2>
        <a
          href={routes.workshop}
          class="text-sm font-bold tracking-wider text-primary-comfy-yellow uppercase hover:underline"
        >
          {t('workshop.model.browseAll')}
        </a>
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          related.map((other) => (
            <li>
              <WorkshopModelCard model={other} />
            </li>
          ))
        }
      </ul>
    </section>
    </div>
  </div>
  <PrototypeTweaks show-run-controls client:load />
</BaseLayout>
