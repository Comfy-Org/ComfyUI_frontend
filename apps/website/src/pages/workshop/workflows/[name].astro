---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import RelatedWorkflows from '../../../components/hub/RelatedWorkflows.vue'
import ModelDetail from '../../../components/workshop/ModelDetail.vue'
import PrototypeTweaks from '../../../components/workshop/PrototypeTweaks.vue'
import { getRoutes } from '../../../config/routes'
import { hubWorkflowUrl } from '../../../lib/hub/routes'
import { tagDisplayName } from '../../../lib/hub/tag-aliases'
import {
  getHubWorkflowPage,
  listHubWorkflows
} from '../../../lib/hub/workflow-detail'
import { t } from '../../../i18n/translations'

export function getStaticPaths() {
  return listHubWorkflows().map((template) => ({
    params: { name: template.name }
  }))
}

const { name } = Astro.params
const page = name ? getHubWorkflowPage(name) : undefined
if (!page) return Astro.redirect('/workshop/')

const { template, mediaType, details, model, stats, inputs, outputs, related } =
  page
const routes = getRoutes()
const author = template.username || 'ComfyUI'
const isPartner = template.tags.includes('API')
const kindLabel = template.isApp
  ? t('workshop.workflow.comfyApp')
  : t('workshop.workflow.nodeGraph')
const mediaLabel: Record<string, string> = {
  image: t('workshop.hub.io.image'),
  video: t('workshop.hub.io.video'),
  audio: t('workshop.hub.io.audio'),
  '3d': t('workshop.hub.io.3d')
}
const hasCustomNodes = (details.requiresCustomNodes?.length ?? 0) > 0
const sectionTitleClass =
  'text-xs font-bold tracking-wider text-primary-comfy-canvas uppercase'
const pillClass =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-[10px] leading-none font-bold tracking-wider text-primary-warm-white uppercase'
const downloadUrl = `https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/${encodeURIComponent(template.name)}.json`
const clone = { href: downloadUrl }
const comments = [
  { author: '@midframe', stars: 5, text: t('workshop.workflow.comment1') },
  { author: '@rui.v', stars: 4, text: t('workshop.workflow.comment2') }
]
---

<BaseLayout
  title={`${template.title} · ${t('workshop.title')} - Comfy`}
  description={details.description ?? template.title}
  ogImage={template.thumbnails[0]}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 py-10 lg:px-8 lg:py-14">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs text-primary-warm-gray sm:px-8 lg:px-10">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={routes.home} class="hover:text-primary-warm-white">
            {t('breadcrumb.home')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href={`${routes.workshop}?tab=nodeGraphs`} class="hover:text-primary-warm-white">
            {t('workshop.title')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-primary-warm-white" aria-current="page">{template.title}</li>
      </ol>
    </nav>

    <header class="mb-12 sm:mx-8 lg:mx-10" data-testid="workflow-hero">
      <div class="flex flex-col gap-6 pr-8 lg:flex-row lg:items-end lg:justify-between lg:pr-10">
        <div class="flex min-w-0 max-w-2xl flex-col gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <p
              class="text-sm leading-none font-medium tracking-widest text-primary-comfy-yellow uppercase"
              data-testid="workflow-author"
            >
              {author}
            </p>
            <ul class="flex flex-wrap items-center gap-2" data-testid="workflow-kinds">
              <li><span class={pillClass}>{kindLabel}</span></li>
              {mediaLabel[mediaType] && <li><span class={pillClass}>{mediaLabel[mediaType]}</span></li>}
              {isPartner && <li><span class={pillClass} data-testid="workflow-serverless">{t('workshop.workflow.serverless')}</span></li>}
            </ul>
          </div>

          <h1 class="text-3xl font-bold text-primary-comfy-canvas lg:text-4xl">
            {template.title}
          </h1>
        </div>

        <div class="flex flex-col gap-4 lg:items-end">
          <p
            class="flex items-baseline gap-2 text-sm text-primary-comfy-canvas/60"
            data-testid="workflow-price"
          >
            <span class="text-lg font-bold text-primary-warm-white">
              {stats.creditsPerRun} {t('nav.credits')}
            </span>
            {t('workshop.model.perRun')}
          </p>

          <ul
            class="flex scrollbar-hide items-center gap-2 max-sm:overflow-x-auto sm:flex-wrap lg:justify-end"
            data-testid="workflow-tags"
          >
            {
              [
                ...template.tags.map((tag) => ({
                  label: tagDisplayName(tag),
                  href: `${routes.workshop}?tag=${encodeURIComponent(tag)}`
                })),
                ...template.models.map((modelName) => ({
                  label: modelName,
                  href: `${routes.workshop}?model=${encodeURIComponent(modelName)}`
                }))
              ].map((tag) => (
                <li>
                  <a
                    href={tag.href}
                    class="inline-flex h-7 shrink-0 items-center rounded-full bg-transparency-white-t8 px-3 text-xs leading-none whitespace-nowrap text-primary-comfy-canvas transition-colors hover:bg-transparency-white-t20 hover:text-primary-comfy-yellow"
                  >
                    {tag.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </header>

    <div class="sm:px-8 lg:px-10">
      <ModelDetail model={model} clone={clone} client:load>
        <div slot="details" class="flex flex-col gap-8">
          {
            details.description && (
              <p
                class="max-w-3xl text-base leading-relaxed text-primary-comfy-canvas/80"
                data-testid="workflow-summary"
              >
                {details.description}
              </p>
            )
          }

          <section class="grid gap-10 lg:grid-cols-12" data-testid="workflow-about">
            <div class="flex flex-col gap-8 lg:col-span-7">
              {
                hasCustomNodes && (
                  <div>
                    <h2 class={sectionTitleClass}>
                      {t('workshop.workflow.customNodes')}
                    </h2>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {details.requiresCustomNodes?.map((node) => (
                        <li class="inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 font-mono text-xs leading-none text-primary-comfy-canvas">
                          {node}
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }

              <div data-testid="workflow-graph">
                <h2 class={sectionTitleClass}>{t('workshop.workflow.graph')}</h2>
                <p class="mt-3 max-w-xl text-sm text-primary-comfy-canvas/80">
                  {t('workshop.workflow.graphNote')}
                </p>
                <div class="mt-4 flex flex-wrap items-center gap-5">
                  <a
                    href={hubWorkflowUrl(template.name)}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex h-9 items-center rounded-full border border-primary-comfy-yellow px-4 text-xs font-bold tracking-wider text-primary-comfy-yellow uppercase transition-colors hover:bg-primary-comfy-yellow hover:text-primary-comfy-ink"
                  >
                    {t('workshop.workflow.openComfy')}
                  </a>
                  <a
                    href={downloadUrl}
                    download
                    class="text-xs text-primary-warm-gray transition-colors hover:text-primary-warm-white"
                  >
                    {t('workshop.workflow.download')}
                  </a>
                </div>
              </div>
            </div>

            <div
              class="bg-transparency-white-t4 rounded-2xl border border-transparency-white-t8 p-5 lg:col-span-5"
              data-testid="workflow-io"
            >
              <h2 class={sectionTitleClass}>{t('workshop.workflow.io')}</h2>
              <div class="mt-4 flex flex-col gap-6">
                {
                  [
                    { title: t('workshop.workflow.inputs'), rows: inputs },
                    { title: t('workshop.workflow.outputs'), rows: outputs }
                  ].map((group) => (
                    <div>
                      <h3 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
                        {group.title}
                      </h3>
                      <dl class="mt-2 flex flex-col divide-y divide-transparency-white-t8">
                        {group.rows.map((row) => (
                          <div class="flex items-center justify-between gap-3 py-2 text-xs">
                            <dt class="text-primary-comfy-canvas">{row.name}</dt>
                            <dd class="font-mono text-primary-warm-gray">{row.type}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>

          <section data-testid="workflow-comments">
            <div class="flex flex-wrap items-baseline gap-3">
              <h2 class={sectionTitleClass}>{t('workshop.workflow.ratings')}</h2>
              <p class="text-sm text-primary-comfy-canvas">
                <span class="text-primary-comfy-yellow">{'★'.repeat(Math.round(Number(stats.rating)))}</span>
                <span class="ml-2 text-primary-warm-gray">
                  {stats.rating} · {stats.ratings}
                </span>
              </p>
            </div>
            <ul class="mt-4 flex flex-col divide-y divide-transparency-white-t8">
              {
                comments.map((comment) => (
                  <li class="flex gap-3 py-4">
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-primary-comfy-plum text-xs font-bold text-white">
                      {comment.author.charAt(1).toUpperCase()}
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-primary-warm-white">
                        {comment.author}
                        <span class="ml-2 text-primary-comfy-yellow">{'★'.repeat(comment.stars)}</span>
                      </p>
                      <p class="mt-1 text-sm text-primary-comfy-canvas/80">{comment.text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </ModelDetail>

      <div class="mt-24 border-t border-transparency-white-t8 pt-12">
        <RelatedWorkflows
          templates={related}
          allHref={`${routes.workshop}?version=v2&tab=nodeGraphs`}
          client:load
        />
      </div>
    </div>
  </div>
  <PrototypeTweaks show-run-controls client:load />
</BaseLayout>
