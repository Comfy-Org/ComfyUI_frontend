---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import HubBrowse from '../../../components/hub/HubBrowse.vue'
import ModelDetail from '../../../components/workshop/ModelDetail.vue'
import PrototypeTweaks from '../../../components/workshop/PrototypeTweaks.vue'
import StaticFrame from '../../../components/workshop/StaticFrame.vue'
import { getRoutes } from '../../../config/routes'
import { formatRuns } from '../../../config/workshop'
import { hubWorkflowUrl } from '../../../lib/hub/routes'
import { tagDisplayName } from '../../../lib/hub/tag-aliases'
import {
  getHubWorkflowPage,
  listHubWorkflows
} from '../../../lib/hub/workflow-detail'
import { t } from '../../../i18n/translations'

export function getStaticPaths() {
  return listHubWorkflows().map((template) => ({
    params: { name: template.name }
  }))
}

const { name } = Astro.params
const page = name ? getHubWorkflowPage(name) : undefined
if (!page) return Astro.redirect('/workshop/')

const { template, mediaType, details, model, stats, inputs, outputs } = page
const routes = getRoutes()
const author = template.username || 'ComfyUI'
const isPartner = template.tags.includes('API')
const kindLabel = template.isApp
  ? t('workshop.workflow.comfyApp')
  : t('workshop.workflow.nodeGraph')
const mediaLabel: Record<string, string> = {
  image: t('workshop.hub.io.image'),
  video: t('workshop.hub.io.video'),
  audio: t('workshop.hub.io.audio'),
  '3d': t('workshop.hub.io.3d')
}
const pillClass =
  'inline-flex h-6 items-center rounded-2xl bg-transparency-white-t8 px-3 text-[11px] leading-none font-bold tracking-wider text-primary-warm-white uppercase'
const ratingLine = t('workshop.workflow.ratingLine')
  .replace('{rating}', stats.rating)
  .replace('{ratings}', String(stats.ratings))
  .replace('{runs}', formatRuns(template.usage, 'en'))
const statsLine = t('workshop.workflow.stats')
  .replace('{avg}', String(stats.avgSeconds))
  .replace('{credits}', String(stats.creditsPerRun))
  .replace('{clone}', stats.cloneCredits.toLocaleString('en-US'))
const downloadUrl = `https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/${template.name}.json`
const clone = { credits: stats.cloneCredits, href: downloadUrl, author: `@${author}` }
const comments = [
  { author: '@midframe', stars: 5, text: t('workshop.workflow.comment1') },
  { author: '@rui.v', stars: 4, text: t('workshop.workflow.comment2') }
]
---

<BaseLayout
  title={`${template.title} · ${t('workshop.title')} - Comfy`}
  description={details.description ?? template.title}
  ogImage={template.thumbnails[0]}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 py-12 lg:px-8 lg:py-16">
    <nav aria-label="Breadcrumb" class="mb-8 px-8 text-xs text-primary-warm-gray lg:px-10">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={routes.home} class="hover:text-primary-warm-white">
            {t('breadcrumb.home')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href={routes.workshop} class="hover:text-primary-warm-white">
            {t('workshop.workflow.crumb')}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-primary-warm-white" aria-current="page">{template.title}</li>
      </ol>
    </nav>

    <header
      class="relative mb-12 overflow-hidden rounded-4.5xl bg-primary-comfy-ink-light"
      data-testid="workflow-hero"
    >
      {
        template.thumbnails[0] && (
          <StaticFrame
            src={template.thumbnails[0]}
            class="absolute inset-0 size-full object-cover opacity-40"
            client:load
          />
        )
      }
      <div
        class="absolute inset-0 bg-linear-to-r from-primary-comfy-ink via-primary-comfy-ink/75 to-primary-comfy-ink/10"
      />
      <div
        class="relative flex min-h-52 flex-col justify-center gap-6 p-8 lg:min-h-60 lg:p-10"
      >
        <div class="flex max-w-2xl flex-col gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-sm leading-none font-medium tracking-widest text-primary-comfy-yellow uppercase">
              {t('workshop.workflow.by').replace('{author}', author)}
            </p>
            <span class={pillClass}>{kindLabel}</span>
            {mediaLabel[mediaType] && <span class={pillClass}>{mediaLabel[mediaType]}</span>}
            {isPartner && <span class={pillClass} data-testid="workflow-serverless">{t('workshop.workflow.serverless')}</span>}
          </div>

          <h1 class="text-3xl font-bold text-primary-comfy-canvas lg:text-5xl">
            {template.title}
          </h1>

          <p class="text-sm text-primary-comfy-canvas/70" data-testid="workflow-rating">
            <span class="text-primary-comfy-yellow">★</span> {ratingLine}
          </p>
          <p class="text-xs text-primary-comfy-canvas/60" data-testid="workflow-stats">
            {statsLine}
          </p>

          <ul class="mt-2 flex flex-wrap gap-2" data-testid="workflow-tags">
            {
              template.tags.map((tag) => (
                <li>
                  <a
                    href={`${routes.workshop}?tag=${encodeURIComponent(tag)}`}
                    class="rounded-2xl border border-transparency-white-t20 px-3 py-1 text-xs text-primary-comfy-canvas transition-colors hover:border-primary-comfy-yellow hover:text-primary-comfy-yellow"
                  >
                    {tagDisplayName(tag)}
                  </a>
                </li>
              ))
            }
            {
              template.models.map((modelName) => (
                <li>
                  <a
                    href={`${routes.workshop}?model=${encodeURIComponent(modelName)}`}
                    class="rounded-2xl border border-transparency-white-t20 px-3 py-1 text-xs text-primary-comfy-canvas transition-colors hover:border-primary-comfy-yellow hover:text-primary-comfy-yellow"
                  >
                    {modelName}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </header>

    <div class="px-8 lg:px-10">
      <ModelDetail model={model} clone={clone} client:load>
        <div slot="details" class="flex flex-col gap-8">
          <section class="grid gap-8 lg:grid-cols-12" data-testid="workflow-about">
            <div class="lg:col-span-7">
              <h2 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
                {t('workshop.workflow.about')}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-primary-comfy-canvas/80">
                {details.description ?? ''}
              </p>
              {
                details.requiresCustomNodes && details.requiresCustomNodes.length > 0 && (
                  <p class="mt-4 text-sm text-primary-warm-gray">
                    {t('workshop.workflow.customNodes')}: {details.requiresCustomNodes.join(', ')}
                  </p>
                )
              }
            </div>
            <div
              class="bg-transparency-white-t4 rounded-2xl border border-transparency-white-t8 p-5 lg:col-span-5"
              data-testid="workflow-io"
            >
              <h2 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
                {t('workshop.workflow.io')}
              </h2>
              <div class="mt-4 grid gap-6 sm:grid-cols-2">
                {
                  [
                    { title: t('workshop.workflow.inputs'), rows: inputs },
                    { title: t('workshop.workflow.outputs'), rows: outputs }
                  ].map((group) => (
                    <div>
                      <h3 class="text-sm font-semibold text-primary-warm-white">{group.title}</h3>
                      <dl class="mt-2 flex flex-col">
                        {group.rows.map((row) => (
                          <div class="flex items-center justify-between gap-3 border-b border-dashed border-transparency-white-t8 py-1.5 text-xs">
                            <dt class="text-primary-comfy-canvas">{row.name}</dt>
                            <dd class="font-mono text-primary-comfy-yellow">{row.type}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>

          <section
            class="bg-transparency-white-t4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-transparency-white-t8 p-5"
            data-testid="workflow-graph"
          >
            <div>
              <h2 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
                {t('workshop.workflow.graph')}
              </h2>
              <p class="mt-2 max-w-xl text-sm text-primary-comfy-canvas/70">
                {t('workshop.workflow.graphNote')}
              </p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a
                href={hubWorkflowUrl(template.name)}
                target="_blank"
                rel="noopener"
                class="inline-flex h-10 items-center rounded-2xl border border-primary-comfy-yellow px-5 text-sm font-semibold tracking-wider text-primary-comfy-yellow uppercase transition-colors hover:bg-primary-comfy-yellow hover:text-primary-comfy-ink"
              >
                {t('workshop.workflow.openComfy')}
              </a>
              <a
                href={downloadUrl}
                download
                class="inline-flex h-10 items-center rounded-2xl bg-primary-comfy-yellow px-5 text-sm font-semibold tracking-wider text-primary-comfy-ink uppercase transition-opacity hover:opacity-90"
              >
                {t('workshop.workflow.download')}
              </a>
            </div>
          </section>

          <section data-testid="workflow-comments">
            <h2 class="text-xs font-bold tracking-wider text-primary-warm-gray uppercase">
              {t('workshop.workflow.ratings')}
            </h2>
            <ul class="mt-4 flex flex-col divide-y divide-transparency-white-t8">
              {
                comments.map((comment) => (
                  <li class="flex gap-3 py-4">
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-primary-comfy-plum text-xs font-bold text-white">
                      {comment.author.charAt(1).toUpperCase()}
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-primary-warm-white">
                        {comment.author}
                        <span class="ml-2 text-primary-comfy-yellow">{'★'.repeat(comment.stars)}</span>
                      </p>
                      <p class="mt-1 text-sm text-primary-comfy-canvas/80">{comment.text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </ModelDetail>

      <section class="mt-24 border-t border-transparency-white-t8 pt-12" data-testid="related-workflows">
        <h2 class="mb-8 text-3xl font-medium tracking-tight text-primary-comfy-canvas">
          {t('workshop.workflow.related')}
        </h2>
        <HubBrowse embedded client:only="vue" />
      </section>
    </div>
  </div>
  <PrototypeTweaks show-run-controls client:load />
</BaseLayout>
