---
import BaseLayout from '../layouts/BaseLayout.astro'
import FormSection from '../components/contact/FormSection.vue'
import FAQSplit01 from '../components/blocks/FAQSplit01.vue'
import { contactFaqs } from '../data/contactFaq'
import { faqAnswerPlainText } from '../utils/faqAnswer'
import {
  absoluteUrl,
  faqPageNode,
  organizationId,
  pageContext
} from '../utils/jsonLd'

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)

const faqs = contactFaqs(locale)
const faqPage = faqPageNode(
  url,
  faqs.map((faq) => ({
    question: faq.question,
    answer: faqAnswerPlainText(faq.answer)
  }))
)
---

<BaseLayout
  title="Contact - Comfy"
  description="Reach Comfy about Enterprise, Forward Deployed Creatives, MiniMax commercial licenses, or partnerships. Common questions answered, including SOC 2 status."
  pageType="ContactPage"
  mainEntityId={organizationId(siteUrl)}
  breadcrumbs={[
    {
      name: Astro.locals.t('breadcrumb.home'),
      url: absoluteUrl(Astro.site, '/')
    },
    { name: Astro.locals.t('breadcrumb.contact') }
  ]}
  extraJsonLd={[faqPage]}
>
  <FormSection client:load />
  <FAQSplit01
    client:visible
    heading={Astro.locals.t('contact.faq.heading')}
    faqs={faqs}
  />
</BaseLayout>
