---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroBackdrop01 from '@/components/blocks/HeroBackdrop01.vue'
import BrandButton from '@/components/common/BrandButton.vue'
import VideoPlayer from '@/components/common/VideoPlayer.vue'
import FeatureRows01 from '@/components/blocks/FeatureRows01.vue'
import CardWorkflowGallery01 from '@/components/blocks/CardWorkflowGallery01.vue'
import FAQSplit01 from '@/components/blocks/FAQSplit01.vue'
import CallToActionSection from '@/components/common/CallToActionSection.vue'
import SectionHeader from '@/components/common/SectionHeader.vue'
import { getRoutes } from '@/config/routes'
import { vfxContent, vfxFaqPageNode } from '@/data/vfx'
import { getCustomerVideoStory } from '@/data/customerVideos'
import { pageContext } from '@/utils/jsonLd'

const { locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const { t } = Astro.locals
const routes = getRoutes(locale)
const { examples, workflows, faqs } = vfxContent(locale)
const story = getCustomerVideoStory('black-math')
const faqPage = vfxFaqPageNode(url, faqs)
---

<BaseLayout
  title={t('vfx.meta.title')}
  description={t('vfx.meta.description')}
  ogImage="/images/vfx-cleanplate-hero.webp"
  minimal
  hideAnnouncementBanner
  extraJsonLd={[faqPage]}
>
  <HeroBackdrop01
    badgeText="VFX"
    title={t('vfx.hero.heading')}
    subtitle={t('vfx.hero.subtitle')}
    class="[&_.backdrop-blur-md]:hidden [&_h1]:lg:text-primary-comfy-canvas [&_p]:lg:text-primary-comfy-canvas"
    client:load
  >
    <div
      slot="backdrop"
      class="relative aspect-3/2 lg:absolute lg:inset-0 lg:aspect-auto"
    >
      <VideoPlayer
        locale={locale}
        src="https://comfy-hub-assets.comfy.org/uploads/8a3a846f-5017-428e-b2a2-24025c55e884.mp4"
        poster="/images/vfx-cleanplate-hero.webp"
        ariaLabel={t('vfx.examples.clean')}
        noCors
        autoplay
        loop
        hideControls
        class="h-full rounded-none border-0"
        client:load
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-primary-comfy-ink via-primary-comfy-ink/80 via-40% to-transparent lg:block"
      />
    </div>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <BrandButton href="#workflows" size="lg" class="uppercase">
        {t('vfx.hero.explore')}
      </BrandButton>
      <BrandButton
        href={`${routes.contact}?interest=vfx`}
        variant="outline"
        size="lg"
        class="uppercase"
      >
        {t('vfx.hero.contact')}
      </BrandButton>
    </div>
  </HeroBackdrop01>
  <FeatureRows01
    locale={locale}
    heading={t('vfx.proof.heading')}
    rows={[
      {
        id: story.slug,
        title: t('vfx.proof.title'),
        description: t('vfx.proof.description'),
        media: {
          type: 'video',
          src: story.videoSrc,
          poster: story.poster,
          tracks: story.captions,
          alt: t('vfx.proof.title')
        }
      }
    ]}
    client:visible
  />
  <div id="workflows" class="scroll-mt-28">
    <section class="mx-auto max-w-9xl px-6 pt-16 lg:pt-24">
      <SectionHeader>
        {t('vfx.workflows.heading')}
        <p slot="subtitle" class="mt-6 text-base text-primary-comfy-canvas/70">
          {t('vfx.workflows.description')}
        </p>
      </SectionHeader>
    </section>
    <CardWorkflowGallery01 items={workflows} />
  </div>
  <FeatureRows01
    locale={locale}
    heading={t('vfx.examples.heading')}
    eyebrow={t('vfx.examples.eyebrow')}
    rows={examples}
    client:visible
  />
  <CallToActionSection
    locale={locale}
    headingKey="vfx.contact.heading"
    primaryLabelKey="vfx.contact.button"
    primaryHref={`${routes.contact}?interest=vfx`}
    secondaryLabelKey="vfx.contact.models"
    secondaryHref={routes.models}
  />
  <FAQSplit01 heading={t('vfx.faq.heading')} faqs={faqs} client:visible />
</BaseLayout>
