---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroSplit01 from '@/components/blocks/HeroSplit01.vue'
import FeatureRows01 from '@/components/blocks/FeatureRows01.vue'
import CardWorkflowGallery01 from '@/components/blocks/CardWorkflowGallery01.vue'
import ReasonsSplit01 from '@/components/blocks/ReasonsSplit01.vue'
import FAQSplit01 from '@/components/blocks/FAQSplit01.vue'
import CallToActionSection from '@/components/common/CallToActionSection.vue'
import SectionHeader from '@/components/common/SectionHeader.vue'
import { getRoutes } from '@/config/routes'
import { vfxContent } from '@/data/vfx'
import { getCustomerVideoStory } from '@/data/customerVideos'
import { faqAnswerPlainText } from '@/utils/faqAnswer'
import { faqPageNode, pageContext } from '@/utils/jsonLd'

const { locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const { t } = Astro.locals
const routes = getRoutes(locale)
const { hero, examples, workflows, reasons, faqs } = vfxContent(locale)
const story = getCustomerVideoStory('black-math')
const faqPage = faqPageNode(
  url,
  faqs.map((faq) => ({
    question: faq.question,
    answer: faqAnswerPlainText(faq.answer)
  }))
)
---

<BaseLayout
  title={t('vfx.meta.title')}
  description={t('vfx.meta.description')}
  ogImage={hero.poster}
  hideAnnouncementBanner
  extraJsonLd={[faqPage]}
>
  <HeroSplit01
    locale={locale}
    badgeText="VFX"
    title={t('vfx.hero.heading')}
    subtitle={t('vfx.hero.subtitle')}
    primaryCta={{ label: t('vfx.hero.explore'), href: '#workflows' }}
    secondaryCta={{
      label: t('vfx.hero.contact'),
      href: `${routes.contact}?interest=vfx`
    }}
    videoSrc={hero.videoSrc}
    videoPoster={hero.poster}
    videoTracks={hero.caption ? [...hero.caption] : []}
    videoAriaLabel={hero.title[locale] || hero.title.en}
    client:load
  />
  <FeatureRows01
    locale={locale}
    heading={t('vfx.examples.heading')}
    eyebrow={t('vfx.examples.eyebrow')}
    rows={examples}
    client:visible
  />
  <div id="workflows" class="scroll-mt-28">
    <section class="mx-auto max-w-9xl px-6 pt-16 lg:pt-24">
      <SectionHeader>
        {t('vfx.workflows.heading')}
        <p slot="subtitle" class="mt-6 text-base text-primary-comfy-canvas/70">
          {t('vfx.workflows.description')}
        </p>
      </SectionHeader>
    </section>
    <CardWorkflowGallery01 items={workflows} />
  </div>
  <ReasonsSplit01
    heading={t('vfx.why.heading')}
    subtitle={t('vfx.why.subtitle')}
    reasons={reasons}
  />
  <FeatureRows01
    locale={locale}
    heading={t('vfx.proof.heading')}
    rows={[
      {
        id: story.slug,
        title: t('vfx.proof.title'),
        description: t('vfx.proof.description'),
        media: {
          type: 'video',
          src: story.videoSrc,
          poster: story.poster,
          tracks: story.captions,
          alt: t('vfx.proof.title')
        }
      }
    ]}
    client:visible
  />
  <CallToActionSection
    locale={locale}
    headingKey="vfx.contact.heading"
    primaryLabelKey="vfx.contact.button"
    primaryHref={`${routes.contact}?interest=vfx`}
    secondaryLabelKey="vfx.contact.models"
    secondaryHref={routes.models}
  />
  <FAQSplit01 heading={t('vfx.faq.heading')} faqs={faqs} client:visible />
</BaseLayout>
