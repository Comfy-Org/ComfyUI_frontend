---
import AuthForgotPassword from '../components/auth/AuthForgotPassword.vue'
import { t } from '../i18n/translations'
import AuthLayout from '../layouts/AuthLayout.astro'
import { pageContext } from '../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<AuthLayout
  title={t('auth.forgot.meta.title', locale)}
  description={t('auth.forgot.meta.description', locale)}
  {locale}
>
  <AuthForgotPassword {locale} client:load />
</AuthLayout>
