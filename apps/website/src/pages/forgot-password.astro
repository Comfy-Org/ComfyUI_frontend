---
import AuthForgotPassword from '../components/auth/AuthForgotPassword.vue'
import AuthLayout from '../layouts/AuthLayout.astro'
import { pageContext } from '../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<AuthLayout
  title={Astro.locals.t('auth.forgot.meta.title')}
  description={Astro.locals.t('auth.forgot.meta.description')}
  {locale}
>
  <AuthForgotPassword {locale} client:load />
</AuthLayout>
