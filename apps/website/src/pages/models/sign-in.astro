---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PrototypeTweaks from '../../components/workshop/PrototypeTweaks.vue'
import WorkshopSignIn from '../../components/workshop/WorkshopSignIn.vue'
import { workshopModels } from '../../config/workshop'
import { t } from '../../i18n/translations'

const visual = workshopModels.find((model) => model.thumbnailUrl)
---

<BaseLayout
  title={t('workshop.signIn.meta.title')}
  description={t('workshop.meta.description')}
  noindex
  minimal
>
  <div
    class="mx-auto grid min-h-[calc(100svh-6.5rem)] max-w-7xl items-center gap-8 px-6 pb-16 lg:grid-cols-2 lg:px-8"
  >
    <div class="hidden overflow-hidden rounded-4xl lg:block">
      {
        visual?.thumbnailUrl && (
          <img
            src={visual.thumbnailUrl}
            alt={visual.name}
            class="h-full max-h-[70svh] w-full rounded-4xl object-cover"
            loading="lazy"
          />
        )
      }
    </div>
    <WorkshopSignIn client:load />
  </div>
  <PrototypeTweaks client:load />
</BaseLayout>
