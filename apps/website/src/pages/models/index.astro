---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelsCatalogue from '../../components/workshop/ModelsCatalogue.vue'
import { workshopModels } from '../../config/models-catalogue'
import { t } from '../../i18n/translations'

// Which layout the listing shows is stored in the browser, so the server cannot
// render it. The model and workflow pages stay prerendered; this one goes back
// to client:load when the prototype's version switch goes away.
---

<BaseLayout
  title={t('workshop.meta.title')}
  description={t('workshop.meta.description')}
  noindex
>
  <div class="mx-auto max-w-10xl px-6 py-16 max-sm:py-10 lg:px-8 lg:py-24">
    <ModelsCatalogue models={workshopModels} client:only="vue" />
  </div>
</BaseLayout>
