---
import type { GetStaticPaths } from 'astro'

import type { Pack } from '../../../data/cloudNodes'

import PackDetailPage from '../../../templates/cloud-nodes/PackDetailPage.astro'
import { loadPacksForBuild } from '../../../utils/cloudNodes.build'

interface Props {
  pack: Pack
}

export const getStaticPaths: GetStaticPaths = async () => {
  const packs = await loadPacksForBuild()
  return packs.map((pack) => ({
    params: { pack: pack.id },
    props: { pack }
  }))
}

const { pack } = Astro.props
---

<PackDetailPage pack={pack} />
