---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CloudPricingSection from '../../components/pricing/CloudPricingSection.vue'
import WhatsIncludedSection from '../../components/pricing/WhatsIncludedSection.vue'
import PricingFaq from '../../components/pricing/PricingFaq.astro'
import ResourceCostsSection from '../../templates/platform/PricingSection.vue'
import LookingForElseSection from '../../components/pricing/LookingForElseSection.vue'
import MinimaxLicensePricingSection from '../../components/pricing/MinimaxLicensePricingSection.vue'
import MinimaxLicenseHeroSection from '../../components/common/MinimaxLicenseHeroSection.vue'
import { pricingOffers } from '../../config/pricing'
import { t } from '../../i18n/translations'
import {
  absoluteUrl,
  jsonLdId,
  pageContext,
  productNode,
} from '../../utils/jsonLd'
import { localizeHref } from '../../config/routes'

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)


const productId = jsonLdId(url, 'product')
---

<BaseLayout
  title={t('pricing.meta.title', locale)}
  description={t('pricing.meta.description', locale)}
  mainEntityId={productId}
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, localizeHref('/', locale)),
    },
    { name: 'Comfy Cloud', url: absoluteUrl(Astro.site, localizeHref('/cloud', locale)) },
    { name: t('breadcrumb.pricing', locale) },
  ]}
  extraJsonLd={[
    productNode({
      siteUrl,
      id: productId,
      name: 'Comfy Cloud',
      url,
      offers: pricingOffers(locale),
    }),
  ]}
>
  <CloudPricingSection locale={locale} client:load />
  <WhatsIncludedSection locale={locale} />
  <ResourceCostsSection
    locale={locale}
    heading={t('pricing.resourceCosts.heading', locale)}
    note={t('pricing.resourceCosts.note', locale)}
  />
  <MinimaxLicenseHeroSection locale={locale} client:visible />
  <MinimaxLicensePricingSection locale={locale} />
  <LookingForElseSection locale={locale} />
  <PricingFaq locale={locale} />
</BaseLayout>
