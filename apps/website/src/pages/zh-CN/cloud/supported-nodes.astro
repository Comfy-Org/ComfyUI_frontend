---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import HeroSection from '../../../components/cloud-nodes/HeroSection.vue'
import PackGridSection from '../../../components/cloud-nodes/PackGridSection.vue'
import { toGridPack } from '../../../data/cloudNodes'
import { loadPacksForBuild } from '../../../utils/cloudNodes.build'
import {
  absoluteUrl,
  itemListNode,
  jsonLdId,
  pageContext
} from '../../../utils/jsonLd'

const packs = await loadPacksForBuild()
const gridPacks = packs.map(toGridPack)

const title = Astro.locals.t('cloudNodes.meta.title')
const description = Astro.locals.t('cloudNodes.meta.description')
const { url } = pageContext(Astro.site, Astro.url.pathname, Astro.currentLocale)
const packList = itemListNode(
  url,
  title,
  packs.map((pack) => ({
    name: pack.displayName,
    url: absoluteUrl(Astro.site, `/zh-CN/cloud/supported-nodes/${pack.id}`)
  }))
)
---

<BaseLayout
  title={title}
  description={description}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(url, 'itemlist')}
  breadcrumbs={[
    {
      name: Astro.locals.t('breadcrumb.home'),
      url: absoluteUrl(Astro.site, '/zh-CN')
    },
    { name: 'Comfy Cloud', url: absoluteUrl(Astro.site, '/zh-CN/cloud') },
    { name: Astro.locals.t('breadcrumb.supportedNodes') }
  ]}
  extraJsonLd={[packList]}
>
  <HeroSection locale="zh-CN" client:visible />
  <PackGridSection locale="zh-CN" packs={gridPacks} client:visible />
</BaseLayout>
