---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import HeroSection from '../../../components/cloud-nodes/HeroSection.vue'
import PackGridSection from '../../../components/cloud-nodes/PackGridSection.vue'
import { t } from '../../../i18n/translations'
import { toGridPack } from '../../../data/cloudNodes'
import { loadPacksForBuild } from '../../../utils/cloudNodes.build'
import {
  absoluteUrl,
  itemListNode,
  jsonLdId,
  pageContext,
} from '../../../utils/jsonLd'
import { localizeHref } from '../../../config/routes'

const { url, locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)

const packs = await loadPacksForBuild()
const gridPacks = packs.map(toGridPack)

const title = t('cloudNodes.meta.title', locale)
const description = t('cloudNodes.meta.description', locale)

const packList = itemListNode(
  url,
  title,
  packs.map((pack) => ({
    name: pack.displayName,
    url: absoluteUrl(Astro.site, localizeHref(`/cloud/supported-nodes/${pack.id}`, locale)),
  })),
)
---

<BaseLayout
  title={title}
  description={description}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(url, 'itemlist')}
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, localizeHref('/', locale)),
    },
    { name: 'Comfy Cloud', url: absoluteUrl(Astro.site, localizeHref('/cloud', locale)) },
    { name: t('breadcrumb.supportedNodes', locale) },
  ]}
  extraJsonLd={[packList]}
>
  <HeroSection locale={locale} client:visible />
  <PackGridSection locale={locale} packs={gridPacks} client:visible />
</BaseLayout>
