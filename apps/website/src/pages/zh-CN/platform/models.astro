---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../../components/common/ProductCardsSection.vue'
import ClosingCtaSection from '../../../templates/platform/ClosingCtaSection.vue'
import ModelsApiFeaturesSection from '../../../templates/platform/ModelsApiFeaturesSection.vue'
import ModelsApiHero from '../../../templates/platform/ModelsApiHero.vue'
import { t } from '../../../i18n/translations'
import { pageContext } from '../../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)



---

<BaseLayout
  title={`${t('platform.products.models.title', locale)} · ${t('platform.meta.title', locale)}`}
  description={t('platform.products.models.description', locale)}
>
  <ModelsApiHero locale={locale} client:load />
  <ModelsApiFeaturesSection locale={locale} />
  <ClosingCtaSection
    locale={locale}
    heading-after-badge={t('platform.closing.headingAfterBadge', locale)}
    client:visible
  />
  <ProductCardsSection locale={locale} label-key="products.labelProducts" />
</BaseLayout>
