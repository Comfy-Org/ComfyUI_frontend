---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../../components/common/ProductCardsSection.vue'
import FAQSection from '../../../components/common/FAQSection.vue'
import ClosingCtaSection from '../../../templates/platform/ClosingCtaSection.vue'
import ModelsApiHero from '../../../templates/platform/ModelsApiHero.vue'
import RouterCapabilitiesSection from '../../../templates/platform/RouterCapabilitiesSection.vue'
import RouterCodeSection from '../../../templates/platform/RouterCodeSection.vue'
import RouterProofStripSection from '../../../templates/platform/RouterProofStripSection.vue'
import RouterRoadmapSection from '../../../templates/platform/RouterRoadmapSection.vue'
import { externalLinks, getRoutes } from '../../../config/routes'
import { t } from '../../../i18n/translations'

const routes = getRoutes('zh-CN')
---

<BaseLayout
  title={`${t('platform.products.models.title', 'zh-CN')} · ${t('platform.meta.title', 'zh-CN')}`}
  description={t('platform.products.models.description', 'zh-CN')}
>
  <ModelsApiHero locale="zh-CN" client:load />
  <RouterProofStripSection locale="zh-CN" />
  <RouterCodeSection locale="zh-CN" client:visible />
  <RouterCapabilitiesSection locale="zh-CN" />
  <RouterRoadmapSection locale="zh-CN" />
  <FAQSection
    locale="zh-CN"
    headingKey="platform.router.faq.heading"
    faqPrefix="platform.router.faq"
    faqCount={11}
  />
  <ClosingCtaSection
    locale="zh-CN"
    heading-after-badge={t('platform.router.closing.headingAfterBadge', 'zh-CN')}
    subtitle={t('platform.router.closing.subtitle', 'zh-CN')}
    primary-href={externalLinks.apiKeys}
    primary-label={t('platform.router.cta.getApiKey', 'zh-CN')}
    secondary-cta={{
      label: t('platform.router.cta.browseModels', 'zh-CN'),
      href: routes.models
    }}
    client:visible
  />
  <ProductCardsSection locale="zh-CN" label-key="products.labelProducts" />
</BaseLayout>
