---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PlansPricingCta from '../../components/individual-submission/PlansPricingCta.vue'
import HeroSection from '../../components/legal/HeroSection.vue'
import { getRoutes } from '../../config/routes'
import { segments } from '../../i18n/segments'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)

const routes = getRoutes(locale)

/**
 * Plan names are product names, identical in every language, so they are slots
 * the page fills rather than words the sentence has to carry. That leaves the
 * translated sentence free to put them wherever its own grammar wants.
 */
const PLAN_LABELS: Record<string, string> = {
  standard: 'Standard',
  creator: 'Creator',
  pro: 'Pro',
  teams: 'Teams'
}

const SUPPORT_EMAILS: Record<string, string> = {
  enterprise: 'gtm-team@comfy.org',
  support: 'support@comfy.org'
}


---

<BaseLayout
  title={t('individualSubmission.meta.title', locale)}
  description={t('individualSubmission.meta.description', locale)}
  noindex
>
  <HeroSection
    title={t('individualSubmission.hero.title', locale)}
    class="text-center"
  />

  <section class="-mt-8 px-6 pb-24 lg:-mt-12 lg:pb-40">
    <div
      class="text-primary-comfy-canvas mx-auto flex max-w-2xl flex-col gap-6 text-center text-base font-light lg:text-lg"
    >
      <p>
        {
          segments(t('individualSubmission.plans', locale)).map((segment) =>
            segment.type === 'text' ? (
              segment.value
            ) : (
              <strong class="text-primary-comfy-yellow font-semibold italic">
                {PLAN_LABELS[segment.name]}
              </strong>
            )
          )
        }
      </p>

      <PlansPricingCta
        href={routes.pricing}
        label={t('individualSubmission.cta.label', locale)}
      />

      <p class="text-primary-warm-gray mt-8 text-sm">
        {
          segments(t('individualSubmission.enterpriseNeed', locale)).map(
            (segment) =>
              segment.type === 'text' ? (
                segment.value
              ) : segment.name === 'break' ? (
                <br />
              ) : (
                <a
                  href={`mailto:${SUPPORT_EMAILS.enterprise}`}
                  class="text-primary-comfy-yellow whitespace-nowrap underline underline-offset-4 hover:no-underline"
                >
                  {SUPPORT_EMAILS.enterprise}
                </a>
              )
          )
        }
      </p>

      <p class="text-primary-warm-gray text-sm">
        {
          segments(t('individualSubmission.otherHelp', locale)).map((segment) =>
            segment.type === 'text' ? (
              segment.value
            ) : (
              <a
                href={`mailto:${SUPPORT_EMAILS.support}`}
                class="text-primary-comfy-yellow whitespace-nowrap underline underline-offset-4 hover:no-underline"
              >
                {SUPPORT_EMAILS.support}
              </a>
            )
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>
