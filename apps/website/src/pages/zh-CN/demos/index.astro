---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="演示 - Comfy" description="ComfyUI 的互动演示和教程。">
  <section class="flex min-h-[60vh] items-center justify-center px-6">
    <div class="text-center">
      <h1 class="text-4xl font-light text-primary-comfy-canvas">
        {Astro.locals.t('demos.comingSoon.title')}
      </h1>
      <p class="mt-4 text-sm text-primary-warm-gray">
        {Astro.locals.t('demos.comingSoon.body')}
      </p>
    </div>
  </section>
</BaseLayout>
