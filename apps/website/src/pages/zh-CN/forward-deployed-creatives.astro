---
import SocialProofBarSection from '../../components/common/SocialProofBarSection.vue'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { fdctFaqs } from '../../data/fdct'
import { t } from '../../i18n/translations'
import BuildersSection from '../../templates/fdct/BuildersSection.vue'
import ClosingCtaSection from '../../templates/fdct/ClosingCtaSection.vue'
import CtaBandsSection from '../../templates/fdct/CtaBandsSection.vue'
import FAQSection from '../../templates/fdct/FAQSection.vue'
import HeroSection from '../../templates/fdct/HeroSection.vue'
import HowItWorksSection from '../../templates/fdct/HowItWorksSection.vue'
import PastProjectsSection from '../../templates/fdct/PastProjectsSection.vue'
import TechnologistsSection from '../../templates/fdct/TechnologistsSection.vue'
import WhatYouGetSection from '../../templates/fdct/WhatYouGetSection.vue'
import { faqAnswerPlainText } from '../../utils/faqAnswer'
import { absoluteUrl, faqPageNode, pageContext } from '../../utils/jsonLd'

const { locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)
const faqPage = faqPageNode(
  url,
  fdctFaqs(locale).map((faq) => ({
    question: faq.question,
    answer: faqAnswerPlainText(faq.answer),
  })),
)
---

<BaseLayout
  title={t('fdct.meta.title', locale)}
  description={t('fdct.meta.description', locale)}
  pageType="WebPage"
  breadcrumbs={[
    {
      name: t('breadcrumb.home', locale),
      url: absoluteUrl(Astro.site, '/zh-CN'),
    },
    { name: t('breadcrumb.fdct', locale) },
  ]}
  extraJsonLd={[faqPage]}
>
  <HeroSection client:load locale="zh-CN" />
  <BuildersSection client:load locale="zh-CN" />
  <SocialProofBarSection />
  <HowItWorksSection locale="zh-CN" />
  <WhatYouGetSection locale="zh-CN" />
  <TechnologistsSection client:load locale="zh-CN" />
  <PastProjectsSection locale="zh-CN" />
  <ClosingCtaSection locale="zh-CN" />
  <FAQSection client:load locale="zh-CN" />
  <CtaBandsSection locale="zh-CN" />
</BaseLayout>

<script>
  // Respect reduced-motion: stop the page's decorative autoplaying videos.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('video[autoplay]').forEach((el) => {
      const video = el as HTMLVideoElement
      video.removeAttribute('autoplay')
      video.pause()
    })
  }
</script>
