---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../components/common/ProductCardsSection.vue'
import HeroSection from '../../templates/cli/HeroSection.vue'
import SetupSection from '../../templates/cli/SetupSection.vue'
import SessionSection from '../../templates/cli/SessionSection.vue'
import SkillsSection from '../../templates/cli/SkillsSection.vue'
import AgentsSection from '../../templates/cli/AgentsSection.vue'
import WhySection from '../../templates/cli/WhySection.vue'
import HowItWorksSection from '../../templates/cli/HowItWorksSection.vue'
import FAQSection from '../../templates/cli/FAQSection.vue'
import { cliFaqs } from '../../templates/cli/faqs'
import { externalLinks } from '../../config/routes'
import { t } from '../../i18n/translations'
import {
  absoluteUrl,
  faqPageNode,
  jsonLdId,
  pageContext,
  softwareApplicationNode,
} from '../../utils/jsonLd'

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)
const softwareId = jsonLdId(url, 'software')
---

<BaseLayout
  title={t('cli.meta.title', 'zh-CN')}
  description={t('cli.meta.description', 'zh-CN')}
  mainEntityId={softwareId}
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    { name: t('breadcrumb.cli', locale) },
  ]}
  extraJsonLd={[
    softwareApplicationNode({
      siteUrl,
      id: softwareId,
      name: 'Comfy CLI',
      url,
      applicationCategory: 'DeveloperApplication',
      firstParty: true,
      description: t('cli.meta.description', 'zh-CN'),
      operatingSystem: 'macOS, Windows, Linux',
      codeRepository: externalLinks.comfyCliRepo,
      isFree: true,
    }),
    faqPageNode(url, cliFaqs(locale)),
  ]}
  ogImage="https://media.comfy.org/website/cli/og.jpg"
>
  <HeroSection locale="zh-CN" client:load />
  <SetupSection locale="zh-CN" client:visible />
  <SessionSection locale="zh-CN" client:visible />
  <SkillsSection locale="zh-CN" client:visible />
  <AgentsSection locale="zh-CN" />
  <WhySection locale="zh-CN" />
  <HowItWorksSection locale="zh-CN" />
  <ProductCardsSection locale="zh-CN" label-key="products.labelProducts" />
  <FAQSection client:visible locale="zh-CN" />
</BaseLayout>
