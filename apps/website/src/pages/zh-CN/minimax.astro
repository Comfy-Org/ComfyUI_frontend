---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BreadcrumbBar from '../../components/common/BreadcrumbBar.vue'
import MiniMaxCtaSection from '../../templates/minimax/MiniMaxCtaSection.vue'
import MiniMaxFaqSection from '../../templates/minimax/MiniMaxFaqSection.vue'
import MiniMaxHeroSection from '../../templates/minimax/MiniMaxHeroSection.vue'
import MiniMaxModelsSection from '../../templates/minimax/MiniMaxModelsSection.vue'
import MiniMaxPricingSection from '../../templates/minimax/MiniMaxPricingSection.vue'
import MiniMaxReviewsSection from '../../templates/minimax/MiniMaxReviewsSection.vue'
import MiniMaxRunOptionsSection from '../../templates/minimax/MiniMaxRunOptionsSection.vue'
import MiniMaxShowcaseSection from '../../templates/minimax/MiniMaxShowcaseSection.vue'
import MiniMaxStepsSection from '../../templates/minimax/MiniMaxStepsSection.vue'
import { getRoutes } from '../../config/routes'
import { minimaxFaqs } from '../../data/minimax'
import { t } from '../../i18n/translations'
import type { JsonLdNode } from '../../utils/jsonLd'
import { absoluteUrl, jsonLdId, pageContext } from '../../utils/jsonLd'

const { locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)
const routes = getRoutes(locale)

// Both sections still run on stand-in media, so they stay hidden until the
// final showcase and step art lands.
const showPlaceholderMediaSections: boolean = false

const crumbs = [
  { label: t('breadcrumb.home', locale), href: routes.home },
  { label: t('models.breadcrumb.models', locale), href: routes.models },
  { label: t('minimax.breadcrumb.model', locale) },
]

const breadcrumbs = crumbs.map((crumb) =>
  crumb.href
    ? { name: crumb.label, url: absoluteUrl(Astro.site, crumb.href) }
    : { name: crumb.label },
)

// MiniMax H3 is a third-party model, so the page intentionally emits no
// Product / AggregateRating / Review JSON-LD (same as the Seedance page). The
// only page-specific node is the FAQPage; Organization / WebSite / WebPage /
// BreadcrumbList come from BaseLayout.
const faqPage: JsonLdNode = {
  '@type': 'FAQPage',
  '@id': jsonLdId(url, 'faq'),
  mainEntity: minimaxFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question[locale],
    acceptedAnswer: { '@type': 'Answer', text: faq.answer[locale] },
  })),
}
---

<BaseLayout
  title={t('minimax.meta.title', locale)}
  description={t('minimax.meta.description', locale)}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[faqPage]}
>
  <BreadcrumbBar
    crumbs={crumbs}
    updated={t('minimax.breadcrumb.updated', locale)}
  />
  <MiniMaxHeroSection client:load locale="zh-CN" />
  {showPlaceholderMediaSections && (
    <MiniMaxShowcaseSection client:visible locale="zh-CN" />
  )}
  {showPlaceholderMediaSections && <MiniMaxStepsSection locale="zh-CN" />}
  <MiniMaxModelsSection client:visible locale="zh-CN" />
  <MiniMaxPricingSection client:load locale="zh-CN" />
  <MiniMaxFaqSection client:visible locale="zh-CN" />
  <MiniMaxCtaSection locale="zh-CN" />
  <MiniMaxRunOptionsSection locale="zh-CN" />
  <MiniMaxReviewsSection client:visible locale="zh-CN" />
</BaseLayout>
