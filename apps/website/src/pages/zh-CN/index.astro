---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProductCardsSection from '@/components/home/ProductCardsSection.vue'
import HeroGraphSection from '@/components/hero/HeroGraphSection.vue'
import SocialProofBarSection from '@/components/common/SocialProofBarSection.vue'
import MinimaxLicenseHeroSection from '@/components/common/MinimaxLicenseHeroSection.vue'
import ComfyAgentSection from '@/components/home/ComfyAgentSection.astro'
import DeveloperPlatformSection from '@/components/home/DeveloperPlatformSection.vue'
import IndustriesSection from '@/components/home/IndustriesSection.vue'
import ModelReleaseSection from '@/components/home/ModelReleaseSection.vue'
import HubBannerSection from '@/components/home/HubBannerSection.vue'
import PreviewControls from '@/components/workshop/PreviewControls.vue'
import ProductShowcaseSection from '@/components/home/ProductShowcaseSection.vue'
import FeaturedWorkflowsSection from '@/components/home/FeaturedWorkflowsSection.vue'
import CaseStudySpotlightSection from '@/components/home/CaseStudySpotlightSection.vue'
import GetStartedSection from '@/components/home/GetStartedSection.vue'
import { isWorkshopInBuild } from '@/config/workshop-release'
import { modelReleaseLinks } from '@/config/model-release-links'
import { resolveHubBannerContent } from '@/components/home/hubBannerContent'
import { isProductionBuild } from '@/config/build-env'
import {
  comfyUiApplicationNode,
  comfyUiSoftwareId,
  comfyUiSourceCodeNode,
  pageContext
} from '@/utils/jsonLd'

const { siteUrl } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)

const hubBannerContent = await resolveHubBannerContent(isWorkshopInBuild())
---

<BaseLayout
  title="Comfy - 视觉 AI 的最强可控性"
  pageName="视觉 AI 的最强可控性"
  description={Astro.locals.t('hero.subtitle')}
  mainEntityId={comfyUiSoftwareId(siteUrl)}
  extraJsonLd={[
    comfyUiApplicationNode(siteUrl),
    comfyUiSourceCodeNode(siteUrl)
  ]}
  keywords={[
    'comfyui app',
    'comfyui web app',
    'comfyui application',
    'ComfyUI 应用',
    'ComfyUI 网页版',
    'ComfyUI 桌面应用',
    'ComfyUI 下载',
    '可视化 AI',
    '节点式 AI',
    '生成式 AI 工作流'
  ]}
>
  <HeroGraphSection locale="zh-CN" client:load />
  <SocialProofBarSection />
  <DeveloperPlatformSection locale="zh-CN" client:visible />
  <ComfyAgentSection locale="zh-CN" />
  <MinimaxLicenseHeroSection locale="zh-CN" fitCtas client:visible />
  <ModelReleaseSection
    locale="zh-CN"
    modelLinks={await modelReleaseLinks(isWorkshopInBuild())}
    client:visible
  />
  {isWorkshopInBuild() && (
    <HubBannerSection locale="zh-CN" content={hubBannerContent} client:load />
  )}
  <FeaturedWorkflowsSection locale="zh-CN" client:load />
  <ProductShowcaseSection locale="zh-CN" client:load />
  <IndustriesSection locale="zh-CN" client:load />
  <GetStartedSection locale="zh-CN" />
  <ProductCardsSection locale="zh-CN" />
  <CaseStudySpotlightSection locale="zh-CN" client:load />
  <PreviewControls locale="zh-CN" enabled={!isProductionBuild()} client:idle />
</BaseLayout>
