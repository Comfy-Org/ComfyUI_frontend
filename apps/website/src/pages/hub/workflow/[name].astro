---
import CatalogueCard from '../../../components/hub/CatalogueCard.vue'
import CatalogueBackLink from '../../../components/workshop/CatalogueBackLink.vue'
import ModelRun from '../../../components/hub/ModelRun.vue'
import WorkflowActions from '../../../components/hub/WorkflowActions.vue'
import WorkflowDetails from '../../../components/hub/WorkflowDetails.vue'
import WorkflowGraph from '../../../components/hub/WorkflowGraph.vue'
import WorkflowHowItWorks from '../../../components/hub/WorkflowHowItWorks.vue'
import { useCaseFor } from '../../../config/models-catalogue'
import { workshopModels } from '../../../config/workshop-browse-content'
import { WORKSHOP_CLOUD_BASE_URL } from '../../../config/workshop-env'
import { estimateWorkshopNodePrice } from '../../../config/workshop-node-pricing'
import { getRouterWorkshopModelDetail } from '../../../config/workshop-router-content'
import hubTemplateDetails from '../../../data/hubTemplateDetails.json'
import {
  customNodeNamesFrom,
  pricedOperations,
  relatedCardViews
} from '../../../lib/hub/page-data'
import { tagDisplayName } from '../../../lib/hub/tag-aliases'
import {
  getHubWorkflowPage,
  listHubWorkflows,
  summarisePorts
} from '../../../lib/hub/workflow-detail'
import { workflowDisplayTitle } from '../../../lib/hub/workflow-title'
import { t } from '../../../i18n/translations'
import BaseLayout from '../../../layouts/BaseLayout.astro'

export function getStaticPaths() {
  return listHubWorkflows().map((template) => ({
    params: { name: template.name }
  }))
}

const { name } = Astro.params
const page = name ? getHubWorkflowPage(name) : undefined
if (!page) return Astro.redirect('/hub/')

const { template, mediaType, details, runsOn, related } = page

const author = template.username || 'ComfyUI'
const mediaLabels: Record<string, string> = {
  image: t('workshop.hub.io.image'),
  video: t('workshop.hub.io.video'),
  audio: t('workshop.hub.io.audio'),
  '3d': t('workshop.hub.io.3d')
}
// A workflow that is one call to a model we carry is that model with a graph
// around it, so the page hands the reader the playground rather than a file to
// take elsewhere. Everything the graph adds stays below it.
const runnable = page.destination
  ? getRouterWorkshopModelDetail(page.destination.slug)
  : undefined
const operations = runnable
  ? (
      await pricedOperations([runnable], (model) =>
        estimateWorkshopNodePrice(model, useCaseFor(model))
      )
    ).map((row) => ({
      slug: row.model.slug,
      task: row.task,
      price: row.price,
      detail: runnable
    }))
  : []

const pills = [
  t('workshop.v2.kind.workflow'),
  mediaLabels[mediaType],
  operations.length > 0 ? t('workshop.v2.workflow.runsHere') : undefined,
  details.openSource ? t('workshop.v2.workflow.openWeights') : undefined
].filter((label): label is string => Boolean(label))

const title = workflowDisplayTitle(template)

const cloudUrl = `${WORKSHOP_CLOUD_BASE_URL}/?template=${encodeURIComponent(template.name)}`

// A page that runs a model has to say what a run costs, on either page.
const price = operations.find((operation) => operation.price)?.price

const relatedViews = relatedCardViews(
  related.slice(0, 4),
  workshopModels,
  customNodeNamesFrom(hubTemplateDetails)
)

const sectionTitle =
  'text-xs font-bold tracking-wider text-primary-comfy-canvas uppercase'
const tab =
  'cursor-pointer border-b-2 border-transparent pb-3 text-sm font-bold tracking-wider text-primary-warm-gray uppercase transition-colors hover:text-primary-warm-white aria-selected:border-primary-comfy-yellow aria-selected:text-primary-warm-white'
const pill =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-2xs/none font-bold tracking-wider text-primary-warm-white uppercase'
const tagClass =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-xs text-primary-comfy-canvas transition-colors hover:bg-transparency-white-t20 hover:text-primary-comfy-yellow'
---

<BaseLayout
  inHub
  title={`${title} - Comfy`}
  description={details.description ?? title}
  ogImage={template.thumbnails[0]}
  ownsPrimaryAction
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-10 lg:px-8 lg:py-16">
    <CatalogueBackLink
      catalogue="/hub/"
      fallback-key="workshop.v2.workflow.back"
      class="mb-8"
      client:load
    />

    <header class="mb-10 flex flex-col gap-4">
      <ul class="flex flex-wrap items-center gap-2" data-testid="workflow-kind">
        {pills.map((label) => <li><span class={pill}>{label}</span></li>)}
        {price && <li>
          <span class={pill} data-testid="workflow-price">
            {price}
          </span>
        </li>}
      </ul>
      <h1
        class="max-w-3xl text-3xl font-bold text-primary-comfy-canvas lg:text-5xl"
      >
        {title}
      </h1>
      <p class="text-sm text-content-secondary" data-testid="workflow-author">
        {t('workshop.workflow.by').replace('{author}', author)}
      </p>
      {details.description && <details
        class="group max-w-2xl"
        data-testid="workflow-summary"
      >
        <summary class="cursor-pointer list-none sm:cursor-auto">
          <span
            class="line-clamp-3 text-base/relaxed text-primary-comfy-canvas/80 group-open:line-clamp-none sm:line-clamp-none"
          >
            {details.description}
          </span>
          <span
            class="mt-1 inline-block text-sm text-primary-comfy-yellow group-open:hidden sm:hidden"
          >
            {t('ui.readMore')}
          </span>
        </summary>
      </details>}
    </header>

    <div
      class="mb-10 flex items-center gap-8 border-b border-transparency-white-t8 max-sm:gap-5"
    >
      <div
        role="tablist"
        aria-label={t('workshop.v2.workflow.tabs')}
        class="flex min-w-0 gap-8 max-sm:gap-5"
        data-workflow-tabs
      >
        <button
          id="tab-run"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="panel-run"
          tabindex="0"
          class={tab}
          data-testid="workflow-tab-run"
        >
          {t('workshop.v2.workflow.tabRun')}
        </button>
        <button
          id="tab-about"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-about"
          tabindex="-1"
          class={tab}
          data-testid="workflow-tab-about"
        >
          {t('workshop.v2.workflow.tabAbout')}
        </button>
      </div>
    </div>

    <div
      id="panel-run"
      role="tabpanel"
      aria-labelledby="tab-run"
      data-testid="workflow-panel-run"
    >
      {operations.length > 0 && page.destination ? (
        <section id="api" data-testid="workflow-run">
          <ModelRun operations={operations} client:load />
        </section>
      ) : (
        <div class="grid gap-10 lg:grid-cols-12">
          {template.thumbnails[0] && (
            <img
              src={template.thumbnails[0]}
              alt={title}
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full rounded-2xl bg-hub-surface object-cover lg:col-span-7"
              data-testid="workflow-media"
            />
          )}
          <p
            class="text-sm text-content-muted lg:col-span-5"
            data-testid="workflow-no-run"
          >
            {t('workshop.v2.model.noRun')}
          </p>
        </div>
      )}
    </div>

    <div
      id="panel-about"
      role="tabpanel"
      aria-labelledby="tab-about"
      hidden
      data-testid="workflow-panel-about"
    >
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="flex flex-col gap-12 lg:col-span-8">
          <section data-testid="workflow-graph-section">
            <h2 class={sectionTitle}>{t('workshop.v2.workflow.graph')}</h2>
            <p class="mt-2 mb-4 text-sm text-content-muted">
              {t('workshop.v2.workflow.graphNote')}
            </p>
            <WorkflowGraph source={page.downloadUrl} client:visible />
          </section>

          <section>
            <h2 class={sectionTitle}>{t('workshop.v2.workflow.takeaways')}</h2>
            <div class="mt-4">
              <WorkflowActions
                cloudUrl={cloudUrl}
                runsHere={operations.length > 0}
                downloadUrl={page.downloadUrl}
                tutorialUrl={details.tutorialUrl}
                client:load
              />
            </div>
          </section>
        </div>

        <div class="lg:col-span-4">
          <div class="flex flex-col gap-10 lg:sticky lg:top-28">
            <WorkflowHowItWorks models={runsOn} />

            <WorkflowDetails
              author={author}
              usage={template.usage}
              produces={summarisePorts(page.outputs)}
              runsHere={operations.length > 0}
              added={template.date}
            />

            <section>
              <h2 class={sectionTitle}>{t('workshop.v2.workflow.tags')}</h2>
              <ul class="mt-3 flex flex-wrap gap-2" data-testid="workflow-tags">
                {template.tags.map((tag) => <li>
                  <a
                    href={`/hub/?q=${encodeURIComponent(tagDisplayName(tag))}`}
                    class={tagClass}
                  >
                    {tagDisplayName(tag)}
                  </a>
                </li>)}
              </ul>
            </section>
          </div>
        </div>
      </div>
    </div>

    {relatedViews.length > 0 && <section
      class="mt-24 border-t border-transparency-white-t8 pt-12"
    >
      <h2 class={sectionTitle}>{t('workshop.v2.workflow.related')}</h2>
      <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {relatedViews.map((view) => <li>
          <CatalogueCard view={view} />
        </li>)}
      </ul>
    </section>}
  </main>

  <script>
    // Two panels, one at a time. The endpoint route lives on the details tab
    // and points into the playground, so a link into a hidden panel opens the
    // tab that holds it before the browser jumps.
    const tabs = document.querySelector('[data-workflow-tabs]')
    if (tabs) {
      const buttons = [
        ...tabs.querySelectorAll<HTMLButtonElement>('[role=tab]')
      ]
      const panelOf = (button: HTMLButtonElement) =>
        document.getElementById(button.getAttribute('aria-controls') ?? '')

      const show = (chosen: HTMLButtonElement) => {
        for (const button of buttons) {
          const selected = button === chosen
          button.setAttribute('aria-selected', String(selected))
          button.tabIndex = selected ? 0 : -1
          panelOf(button)?.toggleAttribute('hidden', !selected)
        }
      }

      for (const button of buttons)
        button.addEventListener('click', () => show(button))

      tabs.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1 }
        const step = keys[(event as KeyboardEvent).key]
        if (!step) return
        event.preventDefault()
        const at = buttons.findIndex(
          (button) => button.getAttribute('aria-selected') === 'true'
        )
        const next = buttons[(at + step + buttons.length) % buttons.length]
        show(next)
        next.focus()
      })

      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement | null)?.closest?.(
          'a[href^="#"]'
        )
        if (!(link instanceof HTMLAnchorElement)) return
        const target = document.getElementById(link.hash.slice(1))
        const owner = buttons.find((button) =>
          panelOf(button)?.contains(target ?? null)
        )
        if (owner) show(owner)
      })
    }
  </script></BaseLayout>
