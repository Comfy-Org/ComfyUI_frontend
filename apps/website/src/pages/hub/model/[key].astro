---
import CatalogueCard from '../../../components/hub/CatalogueCard.vue'
import CatalogueBackLink from '../../../components/workshop/CatalogueBackLink.vue'
import ModelRun from '../../../components/hub/ModelRun.vue'
import { useCaseFor } from '../../../config/models-catalogue'
import { workshopModels } from '../../../config/workshop-browse-content'
import { estimateWorkshopNodePrice } from '../../../config/workshop-node-pricing'
import { getRouterWorkshopModelDetail } from '../../../config/workshop-router-content'
import hubTemplateDetails from '../../../data/hubTemplateDetails.json'
import { getModelGroupPage, listModelGroups } from '../../../lib/hub/model-page'
import {
  customNodeNamesFrom,
  pricedOperations,
  relatedCardViews
} from '../../../lib/hub/page-data'
import { t } from '../../../i18n/translations'
import BaseLayout from '../../../layouts/BaseLayout.astro'

export function getStaticPaths() {
  return listModelGroups().map((entry) => ({ params: { key: entry.key } }))
}

const { key } = Astro.params
const page = key ? getModelGroupPage(key) : undefined
if (!page) return Astro.redirect('/hub/')

const {
  name,
  displayName,
  provider,
  operations,
  uses,
  operationsFromWorkflows
} = page

const operationRows = await pricedOperations(operations, (model) =>
  estimateWorkshopNodePrice(model, useCaseFor(model))
)

// The playground itself, not a link to it: a model page that cannot run the
// model is a page about a capability rather than the capability.
const runnable = operationRows.flatMap((row) => {
  const detail = getRouterWorkshopModelDetail(row.model.slug)
  return detail
    ? [{ slug: row.model.slug, task: row.task, price: row.price, detail }]
    : []
})

const needsCustomNodes = customNodeNamesFrom(hubTemplateDetails)
const madeWith = [...operationsFromWorkflows, ...uses]
const madeWithViews = relatedCardViews(
  madeWith.slice(0, 8),
  workshopModels,
  needsCustomNodes
)

const price = runnable.find((operation) => operation.price)?.price

const pill =
  'inline-flex h-7 items-center rounded-full bg-transparency-white-t8 px-3 text-2xs/none font-bold tracking-wider text-primary-warm-white uppercase'
const sectionTitle =
  'text-xs font-bold tracking-wider text-primary-comfy-canvas uppercase'
---

<BaseLayout
  inHub
  title={`${displayName} - Comfy`}
  description={`${displayName} and the workflows built on it.`}
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-10 lg:px-8 lg:py-16">
    <CatalogueBackLink
      catalogue="/hub/"
      fallback-key="workshop.v2.workflow.back"
      class="mb-8"
      client:load
    />

    <header class="mb-12 flex flex-col gap-3">
      <h1 class="text-3xl font-bold text-primary-comfy-canvas lg:text-5xl">
        {displayName}
      </h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <ul class="flex flex-wrap items-center gap-2" data-testid="model-kind">
          <li><span class={pill}>{t('workshop.v2.kind.model')}</span></li>
          {price && <li>
            <span class={pill} data-testid="model-price">
              {price}
            </span>
          </li>}
        </ul>
        {provider && <p
          class="text-sm text-content-secondary"
          data-testid="model-provider"
        >
          {t('workshop.workflow.by').replace('{author}', provider)}
        </p>}
      </div>
    </header>

    {runnable.length > 0 ? (
      <section class="mb-16">
        <ModelRun operations={runnable} client:load />
      </section>
    ) : (
      <section class="mb-16" data-testid="model-unrunnable">
        <p class="text-sm text-content-muted">
          {t('workshop.v2.model.noRun')}
        </p>
      </section>
    )}

    {madeWith.length > 0 && <section data-testid="model-workflows">
      <h2 class={sectionTitle}>{t('workshop.v2.model.workflows')}</h2>
      <p class="mt-2 max-w-xl text-sm text-content-muted">
        {t('workshop.v2.model.workflowsNote')}
      </p>
      <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {madeWithViews.map((view) => <li>
          <CatalogueCard view={view} />
        </li>)}
      </ul>
      {madeWith.length > 8 && <a
        href={`/hub/?model=${encodeURIComponent(name)}`}
        class="mt-6 inline-flex text-sm text-primary-comfy-yellow underline underline-offset-4"
      >
        {t('workshop.v2.loadMore')}
      </a>}
    </section>}
  </main>
</BaseLayout>
