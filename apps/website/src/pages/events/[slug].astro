---
import type { GetStaticPaths } from 'astro'
import PastEventPage from '../../templates/events/PastEventPage.astro'
import UpcomingEventPage from '../../templates/events/UpcomingEventPage.astro'
import {
  getPastEventBySlug,
  getUpcomingEventBySlug,
  watchablePastEvents,
  watchableUpcomingEvents
} from '../../data/events'

export const getStaticPaths: GetStaticPaths = () =>
  [...watchablePastEvents, ...watchableUpcomingEvents].map((event) => ({
    params: { slug: event.id }
  }))

const slug = Astro.params.slug as string
const pastEvent = getPastEventBySlug(slug)
const upcomingEvent = getUpcomingEventBySlug(slug)
---

{
  pastEvent ? (
    <PastEventPage event={pastEvent} />
  ) : (
    <UpcomingEventPage event={upcomingEvent!} />
  )
}
