---
import AuthSignIn from '@/components/auth/AuthSignIn.vue'
import AuthLayout from '@/layouts/AuthLayout.astro'
import { pageContext } from '@/utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<AuthLayout
  title={Astro.locals.t('auth.signUp.meta.title')}
  description={Astro.locals.t('auth.signUp.meta.description')}
  {locale}
  showTermsNotice
>
  <AuthSignIn mode="signUp" {locale} client:load />
</AuthLayout>
