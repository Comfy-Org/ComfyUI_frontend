---
import AuthSignIn from '../components/auth/AuthSignIn.vue'
import { t } from '../i18n/translations'
import BaseLayout from '../layouts/BaseLayout.astro'
import { pageContext } from '../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<BaseLayout
  title={t('auth.signUp.meta.title', locale)}
  description={t('auth.signUp.meta.description', locale)}
  noindex
>
  <main class="mx-auto max-w-10xl px-6 py-16 lg:px-8 lg:py-24">
    <AuthSignIn mode="signUp" {locale} client:load />
  </main>
</BaseLayout>
