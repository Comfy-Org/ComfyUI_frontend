---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../components/common/ProductCardsSection.vue'
import BuilderEnterpriseSection from '../../templates/platform/BuilderEnterpriseSection.vue'
import BuilderHero from '../../templates/platform/BuilderHero.vue'
import BuilderPillarsSection from '../../templates/platform/BuilderPillarsSection.vue'
import BuilderProblemSection from '../../templates/platform/BuilderProblemSection.vue'
import ClosingCtaSection from '../../templates/platform/ClosingCtaSection.vue'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)



---

<BaseLayout
  title={`${t('platform.products.builder.title', locale)} · ${t('platform.meta.title', locale)}`}
  description={t('platform.products.builder.description', locale)}
>
  <BuilderHero locale={locale} client:load />
  <BuilderProblemSection locale={locale} />
  <BuilderPillarsSection locale={locale} />
  <BuilderEnterpriseSection locale={locale} />
  <ClosingCtaSection
    locale={locale}
    heading-after-badge={t('platform.closing.headingAfterBadge', locale)}
    client:visible
  />
  <ProductCardsSection locale={locale} label-key="products.labelProducts" />
</BaseLayout>
