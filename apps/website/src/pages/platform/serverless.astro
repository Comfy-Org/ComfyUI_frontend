---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../components/common/ProductCardsSection.vue'
import ClosingCtaSection from '../../templates/platform/ClosingCtaSection.vue'
import EndpointCodeSection from '../../templates/platform/EndpointCodeSection.vue'
import PricingSection from '../../templates/platform/PricingSection.vue'
import ServerlessFeaturesSection from '../../templates/platform/ServerlessFeaturesSection.vue'
import ServerlessHero from '../../templates/platform/ServerlessHero.vue'
import { t } from '../../i18n/translations'
---

<BaseLayout
  title={`${t('platform.products.serverless.title', 'en')} · ${t('platform.meta.title', 'en')}`}
  description={t('platform.products.serverless.description', 'en')}
>
  <ServerlessHero locale="en" client:load />
  <EndpointCodeSection locale="en" client:visible />
  <ServerlessFeaturesSection locale="en" />
  <PricingSection locale="en" />
  <ClosingCtaSection locale="en" />
  <ProductCardsSection locale="en" label-key="products.labelProducts" />
</BaseLayout>
