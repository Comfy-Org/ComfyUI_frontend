---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCardsSection from '../../components/common/ProductCardsSection.vue'
import ClosingCtaSection from '../../templates/platform/ClosingCtaSection.vue'
import ServerlessDeploySection from '../../templates/platform/ServerlessDeploySection.vue'
import ServerlessHero from '../../templates/platform/ServerlessHero.vue'
import ServerlessHowItWorksSection from '../../templates/platform/ServerlessHowItWorksSection.vue'
import ServerlessScaleSection from '../../templates/platform/ServerlessScaleSection.vue'
import { t } from '../../i18n/translations'
import { pageContext } from '../../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale,
)



---

<BaseLayout
  title={`${t('platform.products.serverless.title', locale)} · ${t('platform.meta.title', locale)}`}
  description={t('platform.products.serverless.description', locale)}
>
  <ServerlessHero locale={locale} client:load />
  <ServerlessHowItWorksSection locale={locale} client:visible />
  <ServerlessDeploySection locale={locale} client:visible />
  <ServerlessScaleSection locale={locale} client:visible />
  <ClosingCtaSection
    locale={locale}
    heading-after-badge={t('platform.closing.headingAfterBadge', locale)}
    client:visible
  />
  <ProductCardsSection
    locale={locale}
    label-key="products.labelProducts"
  />
</BaseLayout>
