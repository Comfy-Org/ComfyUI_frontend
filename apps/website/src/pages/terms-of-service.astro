---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContentSection from '../components/common/ContentSection.vue'
import HeroSection from '../components/legal/HeroSection.vue'
import { t } from '../i18n/translations'
import { pageContext } from '../utils/jsonLd'

const { locale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)


---

<BaseLayout
  title={t('tos.meta.title', locale)}
  description={t('tos.meta.description', locale)}
  noindex
>
  <HeroSection title="Terms of Service" />
  <p class="text-primary-warm-gray mt-2 text-center text-sm">
    {t('tos.effectiveDateLabel', locale)}: {t('tos.effectiveDate', locale)}
  </p>
  <ContentSection locale={locale} prefix="tos" client:load />
</BaseLayout>
