---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CloudPricingSection from '@/components/pricing/CloudPricingSection.vue'
import WhatsIncludedSection from '@/components/pricing/WhatsIncludedSection.vue'
import PricingFaq from '@/components/pricing/PricingFaq.astro'
import ComfyApiPricingSection from '@/components/pricing/ComfyApiPricingSection.vue'
import MinimaxLicensePricingSection from '@/components/pricing/MinimaxLicensePricingSection.vue'
import MinimaxLicenseHeroSection from '@/components/common/MinimaxLicenseHeroSection.vue'
import { pricingOffers } from '@/config/pricing'
import { getRoutes } from '@/config/routes'
import { localeStaticPaths } from '@/i18n/localeStaticPaths'
import {
  DEFAULT_OG_IMAGE,
  absoluteUrl,
  jsonLdId,
  pageContext,
  productNode
} from '@/utils/jsonLd'

export const getStaticPaths = localeStaticPaths

const { t } = Astro.locals
const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const routes = getRoutes(locale)
const productId = jsonLdId(url, 'product')
const description = t('pricing.meta.description')
---

<BaseLayout
  title={t('pricing.meta.title')}
  description={description}
  mainEntityId={productId}
  breadcrumbs={[
    {
      name: t('breadcrumb.home'),
      url: absoluteUrl(Astro.site, routes.home)
    },
    { name: 'Comfy Cloud', url: absoluteUrl(Astro.site, routes.cloud) },
    { name: t('breadcrumb.pricing') }
  ]}
  extraJsonLd={[
    productNode({
      siteUrl,
      id: productId,
      name: 'Comfy Cloud',
      url,
      image: DEFAULT_OG_IMAGE,
      description,
      offers: pricingOffers(locale)
    })
  ]}
>
  <CloudPricingSection locale={locale} client:load />
  <WhatsIncludedSection locale={locale} />
  <ComfyApiPricingSection locale={locale} show-learn-more-cta />
  <MinimaxLicenseHeroSection locale={locale} client:visible />
  <MinimaxLicensePricingSection locale={locale} />
  <PricingFaq locale={locale} />
</BaseLayout>
