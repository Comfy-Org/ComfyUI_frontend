---
// /events in every locale from one source file (ADR 0001). CollectionPage +
// ItemList of the event detail pages, plus an Event node per dated upcoming
// event. getStaticPaths returns route params only; the locale is read from the
// URL so the file behaves identically in the static and preview-server builds.
import BaseLayout from '../../layouts/BaseLayout.astro'
import EventsHeroSection from '../../templates/events/EventsHeroSection.vue'
import PastEventsSection from '../../templates/events/PastEventsSection.vue'
import UpcomingEventsSection from '../../templates/events/UpcomingEventsSection.vue'
import { localizeHref } from '../../config/routes'
import { localePaths } from '../../i18n/routing'
import { t } from '../../i18n/translations'
import { loadList } from '../../utils/cmsContent'
import { eventsCollection } from '../../utils/eventsCms'
import {
  deriveUpcomingEvents,
  derivePastEvents,
  eventJsonLdNode,
  eventPath,
  eventVideoId
} from '../../utils/events'
import type { JsonLdNode } from '../../utils/jsonLd'
import { absoluteUrl, itemListNode, jsonLdId, pageContext } from '../../utils/jsonLd'

export const getStaticPaths = localePaths

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)

const events = await loadList(eventsCollection, { locale })

// The build-time clock: the client sections reconcile against it on mount, and
// the build-time JSON-LD (which search engines classify from) is derived from it.
const buildNow = new Date()
const now = buildNow.toISOString()

const eventList = itemListNode(
  url,
  t('events.past.title', locale),
  derivePastEvents(events, buildNow)
    .filter((event) => eventVideoId(event))
    .map((event) => ({
      name: event.title,
      url: absoluteUrl(Astro.site, localizeHref(eventPath(event), locale))
    }))
)

const upcomingEventNodes: JsonLdNode[] = deriveUpcomingEvents(
  events,
  buildNow
).map((event) =>
  eventJsonLdNode(event, { siteUrl, site: Astro.site, pageUrl: url, locale })
)

const breadcrumbs = [
  {
    name: t('breadcrumb.home', locale),
    url: absoluteUrl(Astro.site, localizeHref('/', locale))
  },
  { name: t('breadcrumb.events', locale) }
]
---

<BaseLayout
  title={t('events.page.title', locale)}
  description={t('events.page.description', locale)}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(url, 'itemlist')}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[eventList, ...upcomingEventNodes]}
>
  <EventsHeroSection events={events} now={now} locale={locale} client:load />
  <UpcomingEventsSection
    events={events}
    now={now}
    locale={locale}
    client:visible
  />
  <PastEventsSection events={events} now={now} locale={locale} client:visible />
</BaseLayout>
