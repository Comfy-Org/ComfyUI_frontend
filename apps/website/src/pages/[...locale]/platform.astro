---
import { challengeBannerConfig } from '@/config/banner'
import { resolveLocale } from '@/config/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BrandBackground from '@/templates/brand/BrandBackground.vue'
import ProductCardsSection from '@/components/common/ProductCardsSection.vue'
import SocialProofBarSection from '@/components/common/SocialProofBarSection.vue'
import ClosingCtaSection from '@/templates/platform/ClosingCtaSection.vue'
import HeroSection from '@/templates/platform/HeroSection.vue'
import ProductsSection from '@/templates/platform/ProductsSection.vue'
import { localeStaticPaths } from '@/i18n/localeStaticPaths'

export const getStaticPaths = localeStaticPaths

const { t } = Astro.locals
const locale = resolveLocale(Astro.currentLocale)
---

<BaseLayout
  title={t('platform.meta.title')}
  description={t('platform.meta.description')}
  banner={challengeBannerConfig}
>
  <div class="relative isolate">
    <BrandBackground client:idle />
    <HeroSection locale={locale} client:load />
    <ProductsSection locale={locale} client:visible />
  </div>
  <SocialProofBarSection />
  <ClosingCtaSection
    locale={locale}
    heading-after-badge={t('platform.closing.headingAfterBadge')}
    client:visible
  />
  <ProductCardsSection locale={locale} label-key="products.labelProducts" />
</BaseLayout>
