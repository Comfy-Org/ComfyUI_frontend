---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroCentered01 from '@/components/blocks/HeroCentered01.vue'
import { PRIZE_PATH, PRIZE_VIEWBOX } from '@/assets/events/prize-amount'
import LaunchesHeroLogo from '@/templates/drops/LaunchesHeroLogo.vue'
import VideoPlayer from '@/components/common/VideoPlayer.vue'
import PrizeTiers01 from '@/components/blocks/PrizeTiers01.vue'
import FeatureRows02 from '@/components/blocks/FeatureRows02.vue'
import FeatureGrid02 from '@/components/blocks/FeatureGrid02.vue'
import StepsGrid01 from '@/components/blocks/StepsGrid01.vue'
import CardWorkflow01 from '@/components/blocks/CardWorkflow01.vue'
import FAQSplit01 from '@/components/blocks/FAQSplit01.vue'
import CtaCenter01 from '@/components/blocks/CtaCenter01.vue'
import NodeBadge from '@/components/common/NodeBadge.vue'
import SectionHeader from '@/components/common/SectionHeader.vue'
import Button from '@/components/ui/button/Button.vue'
import EventsDirectoryRow from '@/templates/events/EventsDirectoryRow.vue'
import { translationsFor } from '@/i18n/translations'
import type { Locale, LocalizedText } from '@/i18n/translations'
import type { ComfyEvent } from '@/data/events'
import { eventsDerivedAt } from '@/data/events'
import { directoryRows } from '@/utils/eventsDirectory'
import { appModels } from '@/config/workshop-app-content'
import { ac } from '@/lib/workshop/catalogue-apps'
import { challengeStaticPaths } from './_challengePaths'

export const getStaticPaths = challengeStaticPaths

interface Props {
  locale: Locale
}

const { locale }: Props = Astro.props
const { t } = translationsFor(locale)
const base = `${locale === 'en' ? '' : '/zh-CN'}/open-source-higgsfield/`
const entry = {
  label: t('eventChallenge.submit'),
  href: 'https://form.typeform.com/to/V1dSQrkS'
}
const rules = 'https://blog.comfy.org/p/open-call-comfy-dev-platform-challenge'
const entrySteps = ['Repo', 'Demo', 'Link', 'Social'] as const
const requirements = [1, 2, 3, 4, 5, 6] as const
const hubApps = [
  { appId: 'studio', name: 'studioName', task: 'studioTask' },
  { appId: 'reshoot', name: 'reshootName', task: 'reshootTask' }
] as const
const examples = [
  {
    id: 'genjutsu',
    title: t('eventChallenge.genjutsu'),
    description: t('eventChallenge.genjutsuBody'),
    tags: [t('eventChallenge.comingSoon')],
    media: { type: 'image' as const, src: '/icons/logomark.svg', alt: '' }
  },
  ...hubApps.flatMap(({ appId, name, task }) => {
    const app = appModels.find((model) => model.appId === appId)
    if (!app?.thumbnail) return []
    return [
      {
        id: app.slug,
        title: ac(name, locale),
        description: ac(task, locale),
        href: app.href,
        media: {
          type:
            app.thumbnail.kind === 'video'
              ? ('video' as const)
              : ('image' as const),
          src: app.thumbnail.url,
          poster: app.thumbnail.poster,
          alt: ac(name, locale)
        }
      }
    ]
  })
]
const categoryPrizes = ['Innovative', 'Viral', 'OpenWeights'] as const
const bonusPrizes = ['Ltx', 'Flux'] as const
const milestones = ['Signup', 'Window', 'Nights', 'Winner'] as const
const tabs = ['general', 'timeline'] as const
const localizedText = (key: string): LocalizedText => ({
  en: translationsFor('en').t(key),
  'zh-CN': translationsFor('zh-CN').t(key)
})
const buildNightRegistration = 'https://luma.com/5mydmvu6'
const meetups = [
  { id: 'Sf', startDateTime: '2026-10-28T18:00:00-07:00' },
  { id: 'La', startDateTime: '2026-10-29T18:00:00-07:00' },
  { id: 'Nyc', startDateTime: '2026-11-03T18:00:00-05:00' }
] as const
const meetupEvents: ComfyEvent[] = meetups.map(({ id, startDateTime }) => ({
  id: `challenge-meetup-${id.toLowerCase()}`,
  category: 'meetup',
  title: localizedText(`eventChallenge.meetup${id}Title`),
  description: localizedText(`eventChallenge.meetup${id}Body`),
  location: localizedText(`eventChallenge.meetup${id}Location`),
  dateLabel: localizedText(`eventChallenge.meetup${id}Date`),
  startDateTime,
  link: {
    href: {
      en: buildNightRegistration,
      'zh-CN': buildNightRegistration
    },
    newTab: true
  },
  ctaLabel: localizedText('eventChallenge.meetupCta')
}))
const meetupRows = directoryRows(meetupEvents, locale, eventsDerivedAt).map(
  (row) => ({ ...row, calendar: undefined })
)
const faqs = ['Demo', 'Event', 'License', 'Bonus'] as const
---

<BaseLayout
  title={`${t('eventChallenge.name')} · Comfy`}
  description={t('eventChallenge.description')}
  hideAnnouncementBanner
  smoothScroll
>
  <div>
    <nav
      aria-label={t('eventChallenge.details')}
      class="sticky top-20 z-40 flex w-full justify-center gap-2 border-y border-primary-comfy-canvas/10 bg-primary-comfy-ink px-4 py-3 lg:top-26"
    >
      {tabs.map((tab) => <Button
        href={`#${tab === 'general' ? 'challenge-content' : tab}`}
        variant="ghost"
      >
        {t(`eventChallenge.${tab}`)}
      </Button>)}
    </nav>
    <div class="mx-auto max-w-9xl px-6 pt-8">
      <VideoPlayer
        locale={locale}
        src="/media/dev-platform-challenge-hero.mp4"
        ariaLabel={t('eventChallenge.name')}
        fit="contain"
        autoplay
        controlsOnHover
        class="aspect-video overflow-hidden rounded-3xl"
        client:load
      />
    </div>
    <div
      class="mx-auto mt-12 flex max-w-9xl flex-col items-center px-6 text-center"
    >
      <NodeBadge
        segments={[{ text: t('eventChallenge.name') }]}
        sizeClass="h-9 lg:h-12"
        textClass="text-2xl uppercase lg:text-3xl"
      />
      <LaunchesHeroLogo
        label={t('eventChallenge.totalPrize')}
        path={PRIZE_PATH}
        viewBox={PRIZE_VIEWBOX}
        extrudeDepth={200}
        client:visible
      />
      <p class="text-sm text-primary-comfy-yellow uppercase">
        {t('eventChallenge.totalPrizeCaption')}
      </p>
    </div>
    <HeroCentered01
      title={t('eventChallenge.heading')}
      subtitle={t('eventChallenge.description')}
      class="pt-6 pb-12 lg:pt-8 lg:pb-16"
    >
      <p class="mt-8 text-xl text-primary-comfy-yellow lg:text-2xl">
        {t('eventChallenge.prizeTeaser')}
        <span class="block">{t('eventChallenge.prizeTeaserBonus')}</span>
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <Button href={entry.href} size="lg">{entry.label}</Button>
        <Button href={`${base}#how-to-enter`} variant="outline" size="lg"
          >{t('eventChallenge.how')}</Button
        >
      </div>
      <p
        class="mt-6 text-base font-light text-balance text-primary-comfy-canvas lg:text-lg"
      >
        {t('eventChallenge.winnersFeatured')}
      </p>
    </HeroCentered01>
    <PrizeTiers01
      heading={t('eventChallenge.prizes')}
      mainLabel={t('eventChallenge.prizeMainLabel')}
      grand={{
        id: 'overall',
        title: t('eventChallenge.prizeOverall'),
        award: t('eventChallenge.prizeOverallAward'),
        description: t('eventChallenge.prizeOverallBody')
      }}
      categories={categoryPrizes.map((prize) => ({
        id: prize,
        title: t(`eventChallenge.prize${prize}`),
        award: t('eventChallenge.gpu'),
        description: t(`eventChallenge.prize${prize}Body`)
      }))}
      runnerUp={{
        id: 'runner-up',
        title: t('eventChallenge.prizeRunnerUp'),
        award: t('eventChallenge.prizeRunnerUpAward')
      }}
      bonusLabel={t('eventChallenge.prizeBonusLabel')}
      bonuses={bonusPrizes.map((prize) => ({
        id: prize,
        title: t(`eventChallenge.prize${prize}`),
        award: t(`eventChallenge.prize${prize}Award`),
        description: t(`eventChallenge.prize${prize}Body`)
      }))}
    >
      <Button href={entry.href}>{entry.label}</Button>
      <Button href={rules} variant="outline">
        {t('eventChallenge.termsTab')}
      </Button>
    </PrizeTiers01>
    <section class="mx-auto max-w-9xl px-6 py-16 lg:py-24">
      <div
        class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start lg:gap-20"
      >
        <div class="lg:pt-5">
          <h2
            class="text-3xl font-light text-balance text-primary-comfy-canvas lg:text-5xl/tight"
          >
            {t('eventChallenge.meetupHeading')}
          </h2>
          <p
            class="mt-6 max-w-xl text-base text-primary-comfy-canvas/70 lg:text-lg"
          >
            {t('eventChallenge.meetupBody')}
          </p>
        </div>
        <ul
          class="divide-y divide-white/10 border-y border-white/10"
          aria-label={t('eventChallenge.meetupHeading')}
        >
          {meetupRows.map((row) => (
            <EventsDirectoryRow row={row} locale={locale} />
          ))}
        </ul>
      </div>
    </section>
    <div id="timeline" class="scroll-mt-40">
      <StepsGrid01
        heading={t('eventChallenge.timeline')}
        layout="timeline"
        highlightedId="Window"
        steps={milestones.map((milestone) => ({
          id: milestone,
          title: t(`eventChallenge.timeline${milestone}Title`),
          label: t(`eventChallenge.timeline${milestone}Date`),
          description: t(`eventChallenge.timeline${milestone}Body`)
        }))}
      />
    </div>
    <div id="challenge-content" class="scroll-mt-40">
      <FeatureRows02
        heading={t('eventChallenge.glance')}
        rows={[
          {
            id: 'what',
            term: t('eventChallenge.what'),
            description: t('eventChallenge.whatBody')
          },
          {
            id: 'deadline',
            term: t('eventChallenge.deadline'),
            description: t('eventChallenge.closeDate')
          },
          {
            id: 'platform',
            term: t('eventChallenge.platform'),
            description: t('eventChallenge.buildBody')
          },
          {
            id: 'repo',
            term: t('eventChallenge.repoHeading'),
            description: t('eventChallenge.publishBody')
          }
        ]}
      />
      <div id="how-to-enter" class="scroll-mt-40">
        <FeatureGrid02
          heading={t('eventChallenge.enter')}
          subtitle={t('eventChallenge.enterIntro')}
          steps={entrySteps.map((step, index) => ({
            id: step,
            number: String(index + 1).padStart(2, '0'),
            title: t(`eventChallenge.enter${step}`),
            description: t(`eventChallenge.enter${step}Body`)
          }))}
        >
          <div class="mx-auto mt-10 max-w-3xl lg:mt-12">
            <details open class="group border-y border-primary-comfy-canvas/20">
              <summary
                class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-8 py-5 text-xl font-medium text-primary-comfy-canvas group-open:text-primary-comfy-yellow hover:text-primary-comfy-yellow [&::-webkit-details-marker]:hidden"
              >
                {t('eventChallenge.requirementsHeading')}
                <img
                  src="/icons/plus.svg"
                  alt=""
                  width="20"
                  height="20"
                  class="size-5 shrink-0 transition-transform group-open:rotate-45"
                />
              </summary>
              <ul
                class="list-disc space-y-3 pb-6 pl-5 text-sm/relaxed text-primary-comfy-canvas marker:text-primary-comfy-yellow"
              >
                {requirements.map((item) => <li>
                  {t(`eventChallenge.requirement${item}`)}
                </li>)}
              </ul>
            </details>
            <p class="mt-6 text-sm font-light text-primary-comfy-canvas/70">
              {t('eventChallenge.enterNote')}
            </p>
          </div>
        </FeatureGrid02>
      </div>
      <section class="mx-auto max-w-9xl px-6 py-16 lg:py-24">
        <SectionHeader
          >{t('eventChallenge.examples')}
          <p
            slot="subtitle"
            class="mx-auto mt-6 max-w-2xl text-base text-primary-comfy-canvas/70"
          >
            {t('eventChallenge.examplesBody')}
          </p></SectionHeader
        >
        <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
          {examples.map((example) => (
            <CardWorkflow01 item={example} />
          ))}
        </div>
      </section>
    </div>
  </div>
  <FAQSplit01
    heading={t('eventChallenge.questions')}
    faqs={faqs.map((faq) => ({
      id: `challenge-${faq}`,
      question: t(`eventChallenge.faq${faq}`),
      answer: t(`eventChallenge.faq${faq}Body`)
    }))}
    client:visible
  />
  <CtaCenter01
    heading={t('eventChallenge.closing')}
    subtitle={t('eventChallenge.closingBody')}
    primaryCta={entry}
    termsLink={{ label: t('eventChallenge.rulesLink'), href: rules }}
  />
</BaseLayout>
