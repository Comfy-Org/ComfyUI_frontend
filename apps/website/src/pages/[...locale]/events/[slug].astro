---
// /events/[slug] in every locale from one source file (ADR 0001). The events
// directory renders behind the SSR'd-open video dialog; past events carry
// VideoObject JSON-LD for the recording, upcoming ones an Event node and an
// add-to-calendar action. getStaticPaths returns the locale × watchable-slug
// product (params only); the locale is read from the URL.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EventVideoDialog from '../../../templates/events/EventVideoDialog.vue'
import PastEventsSection from '../../../templates/events/PastEventsSection.vue'
import UpcomingEventsSection from '../../../templates/events/UpcomingEventsSection.vue'
import { localizeHref } from '../../../config/routes'
import { eventsForLocale, getEventBySlug, watchableEvents } from '../../../data/events'
import { DEFAULT_LOCALE } from '../../../i18n/locales'
import { localeSlugPaths } from '../../../i18n/routing'
import { t } from '../../../i18n/translations'
import {
  eventJsonLdNode,
  eventStatus,
  eventVideoId,
  toCalendarEvent,
  youtubeWatchHref
} from '../../../utils/events'
import type { JsonLdNode } from '../../../utils/jsonLd'
import {
  absoluteUrl,
  jsonLdId,
  pageContext,
  videoObjectNode
} from '../../../utils/jsonLd'

// The watchable id set is locale-invariant, so enumerate slugs once.
export const getStaticPaths: GetStaticPaths = () =>
  localeSlugPaths(watchableEvents(DEFAULT_LOCALE).map((event) => event.id))

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)

const event = getEventBySlug(Astro.params.slug as string, locale)!
const title = event.title
const description = event.description

const events = eventsForLocale(locale)
// The directory renders behind the dialog; the split reconciles client-side,
// while this page's JSON-LD stays build-time (search engines classify from the
// event's own dates, not our UI split).
const buildNow = new Date()
const now = buildNow.toISOString()
const isPast = eventStatus(event, buildNow) === 'past'

const videoJsonLd: JsonLdNode | undefined =
  isPast && event.recordingVideoId && event.media
    ? videoObjectNode({
        siteUrl,
        id: jsonLdId(url, 'video'),
        pageUrl: url,
        name: title,
        description,
        thumbnailUrl: event.media.src,
        contentUrl: youtubeWatchHref(event.recordingVideoId),
        embedUrl: `https://www.youtube-nocookie.com/embed/${event.recordingVideoId}`,
        uploadDate: event.startDateTime,
        locale
      })
    : undefined

const eventJsonLd: JsonLdNode | undefined = isPast
  ? undefined
  : eventJsonLdNode(event, { siteUrl, site: Astro.site, pageUrl: url, locale })

const mainEntityId = videoJsonLd?.['@id'] ?? eventJsonLd?.['@id']

const breadcrumbs = [
  {
    name: t('breadcrumb.home', locale),
    url: absoluteUrl(Astro.site, localizeHref('/', locale))
  },
  {
    name: t('breadcrumb.events', locale),
    url: absoluteUrl(Astro.site, localizeHref('/events', locale))
  },
  { name: title }
]
---

<BaseLayout
  title={`${title} - Comfy`}
  description={description}
  ogImage={event.media?.src}
  mainEntityId={typeof mainEntityId === 'string' ? mainEntityId : undefined}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[videoJsonLd, eventJsonLd]}
>
  {
    isPast ? (
      <PastEventsSection events={events} now={now} locale={locale} />
    ) : (
      <UpcomingEventsSection
        events={events}
        now={now}
        locale={locale}
        client:visible
      />
    )
  }
  <EventVideoDialog
    title={title}
    description={description}
    youtubeVideoId={eventVideoId(event)!}
    calendarEvent={isPast ? undefined : toCalendarEvent(event, locale)}
    locale={locale}
    client:load
  />
</BaseLayout>
