---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroCentered01 from '@/components/blocks/HeroCentered01.vue'
import { PRIZE_PATH, PRIZE_VIEWBOX } from '@/assets/events/prize-amount'
import LaunchesHeroLogo from '@/templates/drops/LaunchesHeroLogo.vue'
import VideoPlayer from '@/components/common/VideoPlayer.vue'
import ProductShowcaseSection from '@/components/home/ProductShowcaseSection.vue'
import FeatureGrid02 from '@/components/blocks/FeatureGrid02.vue'
import FeatureRows02 from '@/components/blocks/FeatureRows02.vue'
import StepsCards01 from '@/components/blocks/StepsCards01.vue'
import StepsGrid01 from '@/components/blocks/StepsGrid01.vue'
import CardWorkflow01 from '@/components/blocks/CardWorkflow01.vue'
import FAQSplit01 from '@/components/blocks/FAQSplit01.vue'
import CtaCenter01 from '@/components/blocks/CtaCenter01.vue'
import SectionHeader from '@/components/common/SectionHeader.vue'
import Button from '@/components/ui/button/Button.vue'
import ServerlessDeploySection from '@/templates/platform/ServerlessDeploySection.vue'
import ServerlessSkipSetupBanner from '@/templates/platform/ServerlessSkipSetupBanner.vue'
import { translationsFor } from '@/i18n/translations'
import type { Locale } from '@/i18n/translations'
import { isProductionBuild } from '@/config/build-env'

export function getStaticPaths() {
  if (isProductionBuild()) return []
  return (['en', 'zh-CN'] as const).map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale, view: undefined },
    props: { locale }
  }))
}

interface Props {
  locale: Locale
}

const { locale }: Props = Astro.props
const { t } = translationsFor(locale)
const base = `${locale === 'en' ? '' : '/zh-CN'}/events/dev-platform-challenge/`
const entry = {
  label: t('eventChallenge.submit'),
  href: 'https://form.typeform.com/to/V1dSQrkS'
}
const rules = 'https://blog.comfy.org/p/open-call-comfy-dev-platform-challenge'
const steps = ['pick', 'build', 'publish', 'demo'] as const
const examples = ['genjutsu', 'cinema', 'wavo'] as const
const awards = ['practical', 'entertaining', 'oss'] as const
const milestones = ['open', 'close', 'event', 'winner'] as const
const tabs = ['general', 'timeline', 'terms'] as const
const faqs = ['Demo', 'Event', 'License', 'Bonus'] as const
---

<BaseLayout
  title={`${t('eventChallenge.name')} · Comfy`}
  description={t('eventChallenge.description')}
  hideAnnouncementBanner
  smoothScroll
>
  <nav
    aria-label={t('eventChallenge.details')}
    class="sticky top-20 z-40 flex w-full justify-center gap-2 border-y border-primary-comfy-canvas/10 bg-primary-comfy-ink px-4 py-3 lg:top-26"
  >
    {tabs.map((tab) => <Button
      href={`#${tab === 'general' ? 'challenge-content' : tab}`}
      class="uppercase"
      variant="ghost"
    >
      {t(tab === 'terms' ? 'eventChallenge.termsTab' : `eventChallenge.${tab}`)}
    </Button>)}
  </nav>
  <div class="mx-auto max-w-9xl px-6 pt-8">
    <VideoPlayer
      locale={locale}
      src="/media/dev-platform-challenge-hero.mp4"
      ariaLabel={t('eventChallenge.name')}
      fit="contain"
      autoplay
      controlsOnHover
      class="aspect-video overflow-hidden rounded-3xl"
      client:load
    />
  </div>
  <div class="mx-auto mt-12 max-w-9xl px-6 text-center">
    <LaunchesHeroLogo
      label={t('eventChallenge.grandValue')}
      path={PRIZE_PATH}
      viewBox={PRIZE_VIEWBOX}
      extrudeDepth={200}
      client:visible
    />
    <p class="mt-6 text-xl font-extrabold text-primary-comfy-yellow uppercase">
      {t('eventChallenge.grand')}
    </p>
  </div>
  <HeroCentered01
    eyebrow={t('eventChallenge.name')}
    title={t('eventChallenge.heading')}
    subtitle={t('eventChallenge.description')}
    class="py-12 lg:py-16"
  >
    <p class="mt-8 text-xl text-primary-comfy-yellow lg:text-2xl">
      {t('eventChallenge.prizeTeaser')}
    </p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <Button href={entry.href} size="lg">{entry.label}</Button>
      <Button href={`${base}#how-to-enter`} variant="outline" size="lg"
        >{t('eventChallenge.how')}</Button
      >
    </div>
  </HeroCentered01>
  <ProductShowcaseSection
    locale={locale}
    heading={t('eventChallenge.prizes')}
    features={awards.map((award) => ({
      title: t(`eventChallenge.${award}`),
      description: t(
        `eventChallenge.${award === 'practical' ? 'useful' : award === 'entertaining' ? 'delight' : 'open'}Body`
      )
    }))}
    client:load
  >
    <div
      slot="media"
      class="relative isolate flex h-full min-h-96 flex-col justify-between gap-12 overflow-hidden p-8 lg:p-12"
    >
      <img
        src="/images/events/geforce-rtx-5090.jpg"
        alt={t('eventChallenge.gpu')}
        width="1920"
        height="1080"
        class="absolute inset-0 -z-20 size-full object-cover"
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-black/70 via-black/20 to-black/90"
      ></div>
      <div>
        <p class="mt-4 text-base text-primary-comfy-canvas/70">
          {t('eventChallenge.gpuPrizeBody')}
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href={entry.href}>{entry.label}</Button>
        <Button href={`${base}#terms`} variant="outline"
          >{t('eventChallenge.termsTab')}</Button
        >
      </div>
    </div>
  </ProductShowcaseSection>
  <div id="challenge-content" class="scroll-mt-40">
    <section class="mx-auto max-w-9xl px-6 py-16 lg:py-24">
      <SectionHeader
        >{t('eventChallenge.examples')}
        <p
          slot="subtitle"
          class="mx-auto mt-6 max-w-2xl text-base text-primary-comfy-canvas/70"
        >
          {t('eventChallenge.examplesBody')}
        </p></SectionHeader
      >
      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
        {examples.map((example) => (
          <CardWorkflow01
            item={{
              id: example,
              title: t(`eventChallenge.${example}`),
              description: t(`eventChallenge.${example}Body`),
              tags: [t('eventChallenge.clip')],
              media: {
                type: 'image',
                src: '/icons/logomark.svg',
                alt: t('eventChallenge.clip')
              }
            }}
          />
        ))}
      </div>
    </section>
    <FeatureRows02
      heading={t('eventChallenge.bonus')}
      rows={[
        { id: 'ltx', term: 'LTX', description: t('eventChallenge.ltx') },
        {
          id: 'flux',
          term: 'Black Forest Labs',
          description: t('eventChallenge.flux')
        }
      ]}
    />
    <FeatureGrid02
      heading={t('eventChallenge.judgingHeading')}
      steps={(['useful', 'delight', 'open'] as const).map((item) => ({
        id: item,
        title: t(`eventChallenge.${item}`),
        description: t(`eventChallenge.${item}Body`)
      }))}
    />
    <FeatureRows02
      heading={t('eventChallenge.glance')}
      rows={[
        {
          id: 'what',
          term: t('eventChallenge.what'),
          description: t('eventChallenge.whatBody')
        },
        {
          id: 'deadline',
          term: t('eventChallenge.deadline'),
          description: t('eventChallenge.closeDate')
        },
        {
          id: 'platform',
          term: t('eventChallenge.platform'),
          description: t('eventChallenge.buildBody')
        },
        {
          id: 'repo',
          term: t('eventChallenge.repoHeading'),
          description: t('eventChallenge.publishBody')
        }
      ]}
      footnote={t('eventChallenge.dateNote')}
    />
    <div id="how-to-enter" class="scroll-mt-40">
      <StepsCards01
        heading={t('eventChallenge.enter')}
        steps={steps.map((step) => ({
          id: step,
          title: t(`eventChallenge.${step}`),
          description: t(`eventChallenge.${step}Body`)
        }))}
      />
    </div>
    <ServerlessDeploySection locale={locale} client:visible />
    <ServerlessSkipSetupBanner locale={locale} client:visible />
    <CtaCenter01
      heading={t('eventChallenge.start')}
      primaryCta={{
        label: t('eventChallenge.apiDocs'),
        href: 'https://docs.comfy.org/development/serverless/quickstart'
      }}
      secondaryCta={{
        label: t('eventChallenge.sdkDocs'),
        href: 'https://docs.comfy.org/development/api-development/sdks'
      }}
      compact
    />
    <CtaCenter01
      heading={t('eventChallenge.eventHeading')}
      subtitle={t('eventChallenge.eventDescription')}
      primaryCta={{
        label: t('eventChallenge.eventCta'),
        href: 'https://luma.com/5mydmvu6'
      }}
      compact
    />
    <div id="timeline" class="scroll-mt-40">
      <StepsGrid01
        heading={t('eventChallenge.timeline')}
        layout="timeline"
        highlightedId="event"
        steps={milestones.map((milestone) => ({
          id: milestone,
          title: t(
            milestone === 'close'
              ? 'eventChallenge.buildLabel'
              : `eventChallenge.${milestone}Title`
          ),
          label: t(
            milestone === 'close'
              ? 'eventChallenge.buildDates'
              : `eventChallenge.${milestone}Date`
          ),
          description:
            milestone === 'close'
              ? `${t('eventChallenge.closeBody')} ${t('eventChallenge.closeDate')}`
              : t(`eventChallenge.${milestone}Body`)
        }))}
      />
      <p
        class="mx-auto max-w-3xl px-6 text-center text-sm text-primary-comfy-canvas/60"
      >
        {t('eventChallenge.dateNote')}
      </p>
    </div>
    <div id="terms" class="scroll-mt-40">
      <FeatureRows02
        heading={t('eventChallenge.terms')}
        rows={[
          {
            id: 'platform',
            term: t('eventChallenge.platform'),
            description: t('eventChallenge.rule1')
          },
          {
            id: 'repo',
            term: t('eventChallenge.repoHeading'),
            description: t('eventChallenge.rule2')
          },
          {
            id: 'requirements',
            term: t('eventChallenge.requirements'),
            description: t('eventChallenge.rule3')
          },
          {
            id: 'publicity',
            term: t('eventChallenge.publicity'),
            description: t('eventChallenge.rule4')
          },
          {
            id: 'judging',
            term: t('eventChallenge.judging'),
            description: t('eventChallenge.judgingBody')
          }
        ]}
      />
    </div>
  </div>
  <FAQSplit01
    heading={t('eventChallenge.questions')}
    faqs={faqs.map((faq) => ({
      id: `challenge-${faq}`,
      question: t(`eventChallenge.faq${faq}`),
      answer: t(`eventChallenge.faq${faq}Body`)
    }))}
    client:visible
  />
  <CtaCenter01
    heading={t('eventChallenge.closing')}
    subtitle={t('eventChallenge.closingBody')}
    primaryCta={entry}
    termsLink={{ label: t('eventChallenge.rulesLink'), href: rules }}
  />
</BaseLayout>
