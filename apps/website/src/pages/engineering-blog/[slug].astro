---
import { getCollection } from 'astro:content'

import PostBody from '../../components/engineering-blog/PostBody.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { t } from '../../i18n/translations'
import { postSlug } from '../../utils/engineeringBlog'
import {
  absoluteUrl,
  articleNode,
  jsonLdId,
  pageContext
} from '../../utils/jsonLd'

export async function getStaticPaths() {
  const posts = await getCollection('engineeringBlog', ({ id }) =>
    id.startsWith('en/')
  )
  return posts.map((entry) => ({
    params: { slug: postSlug(entry.id) },
    props: { entry }
  }))
}

const { entry } = Astro.props

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const article = articleNode({
  siteUrl,
  pageUrl: url,
  title: entry.data.title,
  description: entry.data.description,
  locale
})

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<BaseLayout
  title={`${entry.data.title} - Comfy Engineering Blog`}
  description={entry.data.description}
  mainEntityId={jsonLdId(url, 'article')}
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, '/') },
    {
      name: 'Engineering Blog',
      url: absoluteUrl(Astro.site, '/engineering-blog')
    },
    { name: entry.data.title }
  ]}
  extraJsonLd={[article]}
>
  <article class="max-w-3xl mx-auto px-4 pt-16 pb-24 lg:pt-24 lg:pb-32">
    <a
      href="/engineering-blog/"
      class="text-primary-comfy-yellow text-xs font-bold tracking-widest uppercase"
    >
      ← Engineering Blog
    </a>
    <h1
      class="text-primary-warm-white mt-4 text-3xl font-semibold lg:text-4xl"
    >
      {entry.data.title}
    </h1>
    <p class="text-primary-warm-gray mt-4 text-sm">
      {entry.data.author} · {dateFormatter.format(entry.data.date)}
    </p>
    <PostBody entry={entry} />
  </article>
</BaseLayout>
