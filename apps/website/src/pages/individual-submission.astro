---
import BaseLayout from '../layouts/BaseLayout.astro'
import PlansPricingCta from '../components/individual-submission/PlansPricingCta.vue'
import { PLAN_LABELS } from '../components/individual-submission/planLabels'
import HeroSection from '../components/legal/HeroSection.vue'
import { getRoutes } from '../config/routes'
import { segments } from '../i18n/segments'
import type { TranslationKey } from '../i18n/translations'
import { t } from '../i18n/translations'
import { pageContext } from '../utils/jsonLd'
import { requirePlaceholder } from '../utils/placeholders'

const { locale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)

const routes = getRoutes(locale)

const SUPPORT_EMAILS: Record<string, string> = {
  enterprise: 'gtm-team@comfy.org',
  support: 'support@comfy.org'
}

/**
 * Each sentence's segments, with every placeholder name checked against the set
 * that sentence is allowed to carry.
 *
 * The loops below used to end in a wildcard, so an unexpected name rendered the
 * enterprise address, or an empty plan name, rather than failing. Checked here
 * so the templates stay declarative and one unknown name stops the build.
 */
function checkedSegments(key: TranslationKey, allowed: readonly string[]) {
  const parts = segments(t(key, locale))
  for (const part of parts) {
    if (part.type !== 'text') requirePlaceholder(part.name, allowed, key)
  }
  return parts
}

const planSegments = checkedSegments(
  'individualSubmission.plans',
  Object.keys(PLAN_LABELS),
)
const enterpriseSegments = checkedSegments('individualSubmission.enterpriseNeed', [
  'break',
  'email',
])
const otherHelpSegments = checkedSegments('individualSubmission.otherHelp', [
  'email',
])


---

<BaseLayout
  title={t('individualSubmission.meta.title', locale)}
  description={t('individualSubmission.meta.description', locale)}
  noindex
>
  <HeroSection
    title={t('individualSubmission.hero.title', locale)}
    class="text-center"
  />

  <section class="-mt-8 px-6 pb-24 lg:-mt-12 lg:pb-40">
    <div
      class="text-primary-comfy-canvas mx-auto flex max-w-2xl flex-col gap-6 text-center text-base font-light lg:text-lg"
    >
      <p>
        {
          planSegments.map((segment) =>
            segment.type === 'text' ? (
              segment.value
            ) : (
              <strong class="text-primary-comfy-yellow font-semibold italic">
                {PLAN_LABELS[segment.name]}
              </strong>
            )
          )
        }
      </p>

      <PlansPricingCta
        href={routes.pricing}
        label={t('individualSubmission.cta.label', locale)}
      />

      <p class="text-primary-warm-gray mt-8 text-sm">
        {
          enterpriseSegments.map(
            (segment) =>
              segment.type === 'text' ? (
                segment.value
              ) : segment.name === 'break' ? (
                <br />
              ) : (
                <a
                  href={`mailto:${SUPPORT_EMAILS.enterprise}`}
                  class="text-primary-comfy-yellow whitespace-nowrap underline underline-offset-4 hover:no-underline"
                >
                  {SUPPORT_EMAILS.enterprise}
                </a>
              )
          )
        }
      </p>

      <p class="text-primary-warm-gray text-sm">
        {
          otherHelpSegments.map((segment) =>
            segment.type === 'text' ? (
              segment.value
            ) : (
              <a
                href={`mailto:${SUPPORT_EMAILS.support}`}
                class="text-primary-comfy-yellow whitespace-nowrap underline underline-offset-4 hover:no-underline"
              >
                {SUPPORT_EMAILS.support}
              </a>
            )
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>
