---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactSection from '../components/customers/ContactSection.vue'
import FeedbackSection from '../components/customers/FeedbackSection.vue'
import HeroSection from '../components/customers/HeroSection.vue'
import StorySection from '../components/customers/StorySection.vue'
import VideoSection from '../components/customers/VideoSection.vue'
import { t } from '../i18n/translations'
import { toCardProps } from '../utils/customers'
import { loadStories } from '../utils/loadStories'
import { absoluteUrl, itemListNode, jsonLdId, pageContext } from '../utils/jsonLd'
import { localizeHref } from '../config/routes'

const { locale, canonicalUrl, canonicalLocale } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale
)

const stories = (await loadStories(locale)).map(toCardProps)


const collectionLabel = t('nav.customerStories', locale)
const storyList = itemListNode(
  canonicalUrl,
  collectionLabel,
  stories.map((story) => ({
    url: absoluteUrl(Astro.site, localizeHref(`/customers/${story.slug}`, canonicalLocale)),
    name: story.title
  }))
)
---

<BaseLayout
  title={t('customers.meta.title', locale)}
  description={t('customers.meta.description', locale)}
  pageType="CollectionPage"
  mainEntityId={jsonLdId(canonicalUrl, 'itemlist')}
  breadcrumbs={[
    { name: t('breadcrumb.home', locale), url: absoluteUrl(Astro.site, localizeHref('/', canonicalLocale)) },
    { name: collectionLabel }
  ]}
  extraJsonLd={[storyList]}
>
  <HeroSection locale={locale} client:load />
  <StorySection locale={locale} stories={stories} />
  <FeedbackSection locale={locale} client:load />
  <VideoSection locale={locale} client:load />
  <ContactSection locale={locale} />
</BaseLayout>
