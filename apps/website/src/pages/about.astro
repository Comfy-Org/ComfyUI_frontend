---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroSection from '@/components/about/HeroSection.vue'
import StorySection from '@/components/about/StorySection.vue'
import OurValuesSection from '@/components/about/OurValuesSection.vue'
import ValuesSection from '@/components/about/ValuesSection.vue'
import CareersSection from '@/components/about/CareersSection.vue'
import { absoluteUrl, organizationId, pageContext } from '@/utils/jsonLd'

const { siteUrl } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
---

<BaseLayout
  title="About Us - Comfy"
  description="Comfy builds ComfyUI, the open-source engine for visual AI, and the desktop, cloud, API, and enterprise products around it. Meet the team and the mission."
  pageType="AboutPage"
  mainEntityId={organizationId(siteUrl)}
  breadcrumbs={[
    {
      name: Astro.locals.t('breadcrumb.home'),
      url: absoluteUrl(Astro.site, '/')
    },
    { name: Astro.locals.t('breadcrumb.about') }
  ]}
>
  <HeroSection client:load />
  <StorySection />
  <OurValuesSection />
  <ValuesSection client:visible />
  <CareersSection />
</BaseLayout>
