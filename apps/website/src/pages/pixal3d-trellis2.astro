  <script>
    type Pixal3dImage = {
      name: string
      source: File | string
    }

    function initModelTabs() {
      const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'))
      const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'))
      if (!tabs.length || tabs[0].dataset.bound === '1') return
      tabs.forEach((t) => (t.dataset.bound = '1'))

      const names = tabs.map((t) => t.dataset.tab)
      const show = (name: string | undefined) => {
        const active = name && names.includes(name) ? name : 'playground'
        tabs.forEach((t) => {
          const selected = t.dataset.tab === active
          t.setAttribute('aria-selected', String(selected))
          t.dataset.state = selected ? 'on' : 'off'
        })
        panels.forEach((p) => (p.hidden = p.dataset.panel !== active))
      }

      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          show(t.dataset.tab)
          history.replaceState(null, '', t.dataset.tab === 'playground' ? location.pathname : `#${t.dataset.tab}`)
        })
      )

      const toTop = () => window.scrollTo(0, 0)

      const showFromHash = () => {
        show(location.hash.slice(1))
        if (!location.hash) return
        toTop()
        requestAnimationFrame(toTop)
        window.addEventListener('load', toTop, { once: true })
      }

      showFromHash()
      window.addEventListener('hashchange', showFromHash)
    }

    function initCodeCopy() {
      const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-copy]'))
      if (!buttons.length || buttons[0].dataset.bound === '1') return
      buttons.forEach((b) => (b.dataset.bound = '1'))

      buttons.forEach((b) =>
        b.addEventListener('click', async () => {
          const text = document.getElementById(b.dataset.copy!)?.textContent
          if (!text) return
          try {
            await navigator.clipboard.writeText(text)
            b.dataset.copied = ''
            window.setTimeout(() => delete b.dataset.copied, 1200)
          } catch { /* clipboard unavailable */ }
        })
      )

      document.querySelectorAll<HTMLElement>('[data-download]').forEach((button) =>
        button.addEventListener('click', () => {
          const text = document.getElementById(button.dataset.download!)?.textContent
          if (!text) return
          const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }))
          const link = document.createElement('a')
          link.href = url
          link.download = button.dataset.filename ?? 'result.json'
          link.click()
          URL.revokeObjectURL(url)
        })
      )
    }

    function initSdkTabs() {
      const root = document.getElementById('sdk-examples')
      if (!root || root.dataset.bound === '1') return
      root.dataset.bound = '1'

      const tabs = root.querySelectorAll<HTMLElement>('[data-sdk-tab]')
      const panels = root.querySelectorAll<HTMLElement>('[data-sdk-panel]')
      const copy = document.getElementById('sdk-copy')
      for (const tab of tabs) {
        tab.addEventListener('click', () => {
          const selected = tab.dataset.sdkTab
          if (!selected) return
          for (const candidate of tabs) {
            const active = candidate === tab
            candidate.dataset.state = active ? 'on' : 'off'
            candidate.setAttribute('aria-selected', String(active))
            candidate.classList.toggle('bg-transparency-white-t8', active)
            candidate.classList.toggle('text-primary-comfy-canvas', active)
            candidate.classList.toggle('text-primary-warm-gray', !active)
          }
          for (const panel of panels) {
            panel.classList.toggle('hidden', panel.dataset.sdkPanel !== selected)
          }
          if (copy) copy.dataset.copy = `sdk-${selected}`
        })
      }
    }

    async function initModelViewer() {
      const canvas = document.getElementById(
        'result-model-canvas'
      ) as HTMLCanvasElement | null
      if (!canvas || canvas.dataset.bound === '1') return
      canvas.dataset.bound = '1'

      const status = document.getElementById('model-viewer-status')
      const modelUrl = canvas.dataset.modelUrl
      if (!modelUrl) return

      try {
        const [THREE, { OrbitControls }, { GLTFLoader }] = await Promise.all([
          import('three'),
          import('three/examples/jsm/controls/OrbitControls.js'),
          import('three/examples/jsm/loaders/GLTFLoader.js')
        ])
        if (!canvas.isConnected) return

        const renderer = new THREE.WebGLRenderer({
          alpha: true,
          antialias: true,
          canvas
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
        renderer.outputColorSpace = THREE.SRGBColorSpace
        renderer.toneMapping = THREE.ACESFilmicToneMapping
        renderer.toneMappingExposure = 1.35

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(35, 1, 0.01, 1000)
        const controls = new OrbitControls(camera, canvas)
        controls.enableDamping = true
        controls.autoRotate = true
        controls.autoRotateSpeed = 1

        scene.add(new THREE.HemisphereLight(0xffffff, 0x555555, 3.5))
        const keyLight = new THREE.DirectionalLight(0xffffff, 4.5)
        keyLight.position.set(4, 6, 5)
        scene.add(keyLight)
        const fillLight = new THREE.DirectionalLight(0xffffff, 2)
        fillLight.position.set(-4, 2, -3)
        scene.add(fillLight)

        let model: import('three').Object3D | null = null
        let loadVersion = 0

        const disposeModel = () => {
          if (!model) return
          scene.remove(model)
          model.traverse((object) => {
            if (!(object instanceof THREE.Mesh)) return
            object.geometry.dispose()
            const materials = Array.isArray(object.material)
              ? object.material
              : [object.material]
            materials.forEach((material) => material.dispose())
          })
          model = null
        }

        const loadModel = async (url: string) => {
          const version = ++loadVersion
          status?.classList.remove('hidden')
          if (status) status.textContent = 'Loading 3D preview…'
          const { scene: nextModel } = await new GLTFLoader().loadAsync(url)
          if (version !== loadVersion || !canvas.isConnected) return

          disposeModel()
          model = nextModel
          const bounds = new THREE.Box3().setFromObject(model)
          const size = bounds.getSize(new THREE.Vector3())
          const center = bounds.getCenter(new THREE.Vector3())
          const diameter = Math.max(size.x, size.y, size.z)
          model.position.sub(center)
          scene.add(model)

          camera.near = diameter / 100
          camera.far = diameter * 100
          camera.position.set(
            diameter * 1.15,
            diameter * 0.75,
            diameter * 1.35
          )
          camera.updateProjectionMatrix()
          controls.target.set(0, 0, 0)
          controls.update()
          status?.classList.add('hidden')
        }

        const onModelUrlChange = (event: Event) => {
          const { url } = (event as CustomEvent<{ url: string }>).detail
          void loadModel(url)
        }
        canvas.addEventListener('model-url-change', onModelUrlChange)
        await loadModel(modelUrl)

        const resize = () => {
          const width = canvas.clientWidth
          const height = canvas.clientHeight
          if (!width || !height) return
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }
        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(canvas)
        resize()

        let frame = 0
        const render = () => {
          controls.update()
          renderer.render(scene, camera)
          frame = requestAnimationFrame(render)
        }
        render()

        document.addEventListener(
          'astro:before-swap',
          () => {
            cancelAnimationFrame(frame)
            resizeObserver.disconnect()
            controls.dispose()
            canvas.removeEventListener('model-url-change', onModelUrlChange)
            disposeModel()
            renderer.dispose()
          },
          { once: true }
        )
      } catch {
        if (status) status.textContent = '3D preview unavailable'
      }
    }

    function initPlaygroundDemo() {
      const runMobile = document.getElementById('pg-run-mobile')
      if (!runMobile || runMobile.dataset.bound === '1') return
      runMobile.dataset.bound = '1'

      const $ = (id: string) => document.getElementById(id)

      // Text lands first so the block is never blank; the tokenized markup
      // replaces it once Shiki resolves. A newer paint wins on late arrivals.
      const paintJson = (el: HTMLElement, code: string) => {
        el.textContent = code
        const stamp = String(Number(el.dataset.paint ?? '0') + 1)
        el.dataset.paint = stamp
        void import('../lib/highlight').then(({ highlightInline }) =>
          highlightInline(code, 'json').then((html) => {
            if (html && el.dataset.paint === stamp) el.innerHTML = html
          })
        )
      }
      const modal = $('auth-modal')!
      const strip = $('signed-in-strip')!
      const meter = $('free-meter')!
      const overlay = $('running-overlay')!
      const upgrade = $('upgrade-overlay')!
      const fill = $('progress-fill')!
      const resultPreview = $('result-preview')!
      const resultSeed = $('result-seed')
      const prompt = $('pg-prompt') as HTMLTextAreaElement | null
      const selDur = $('sel-duration') as HTMLSelectElement | null
      const selRes = $('sel-resolution') as HTMLSelectElement | null
      const selAspect = $('sel-aspect') as HTMLSelectElement | null
      const inputJson = $('input-json')!
      const resultJson = $('result-json')!
      const costLine = $('cost-line')
      const modalCredits = $('modal-credits')!
      const varBlock = $('var-block')
      const varStrip = $('var-strip')
      const varCost = $('var-cost')
      const base = Number(runMobile.dataset.baseCredits ?? '6')
      const slug = runMobile.dataset.slug ?? 'model'
      const isImageTo3d = runMobile.dataset.workflowKind === 'image-to-3d'
      const defaultImageName = runMobile.dataset.defaultImageName ?? null
      const defaultImageUrl = runMobile.dataset.defaultImageUrl ?? null
      const defaultImageAlt = runMobile.dataset.defaultImageAlt ?? ''
      const defaultModelUrl = runMobile.dataset.defaultModelUrl ?? null
      const workflowUrl = runMobile.dataset.workflowUrl ?? null
      const runDesktop = $('pg-run-desktop')

      // BrandButton wraps labels in a centering span — writing to the button
      // itself would strip it.
      const label = (el: HTMLElement) => el.querySelector('span') ?? el
      const runMobileLabel = label(runMobile)
      const runDesktopLabel = runDesktop ? label(runDesktop) : null

      const seedInput = $('pg-seed') as HTMLInputElement | null
      const defaultSeed = seedInput?.defaultValue ?? '0'
      const seedNow = () => Number(seedInput?.value) || 0

      let authed = false
      let runsLeft = 5
      let running = false
      let refImage: Pixal3dImage | null =
        defaultImageName && defaultImageUrl
          ? { name: defaultImageName, source: defaultImageUrl }
          : null
      let lastRun: Record<string, unknown> | null = null

      const mult = (sel: HTMLSelectElement | null) =>
        Number(sel?.selectedOptions[0]?.dataset.mult ?? '1')
      const creditsNow = () => base * mult(selDur) * mult(selRes)

      const renderInputJson = () => {
        const inputs = isImageTo3d
          ? { image: refImage?.name ?? null, output_format: 'glb' }
          : {
              prompt: prompt?.value.trim() ?? '',
              aspect_ratio: selAspect?.value ?? '16:9',
              duration_s: mult(selDur) * 5,
              resolution: selRes?.value ?? '720p',
              seed: seedNow(),
              ...(refImage ? { reference_image: refImage.name } : {})
            }
        const payload: Record<string, unknown> = {
          workflow: slug,
          inputs,
          estimate: { credits: creditsNow(), charged_on: 'success only' }
        }
        paintJson(inputJson, JSON.stringify(payload, null, 2))
      }

      const renderResultJson = () => {
        const receipt = lastRun ?? {
          status: 'example',
          note: 'This is a curated example. Run it to get your own receipt.',
          model: slug,
          ...(isImageTo3d
            ? { output: { type: 'model/gltf-binary', format: 'glb' } }
            : { seed: seedNow() })
        }
        paintJson(resultJson, JSON.stringify(receipt, null, 2))
      }

      const setRunLabels = () => {
        const c = creditsNow()
        if (costLine) {
          costLine.textContent = `${c} credits ≈ $${(c * 0.0084).toFixed(2)}`
        }
        modalCredits.textContent = String(c)
        if (varCost) varCost.textContent = String(c * 4)
        const text = workflowUrl
          ? 'TRY WORKFLOW'
          : running
            ? 'Running…'
            : !authed
              ? 'Sign in to run — 5 free'
              : runsLeft > 0
                ? `Run — ${runsLeft} free left`
                : 'Go Creator — from $20/mo'
        runMobileLabel.textContent = text
        if (runDesktopLabel) runDesktopLabel.textContent = text
      }

      const setRunning = (value: boolean) => {
        running = value
        runMobile.toggleAttribute('disabled', value)
        runDesktop?.toggleAttribute('disabled', value)
        setRunLabels()
      }

      const renderAll = () => { renderInputJson(); renderResultJson(); setRunLabels() }

      // input view toggle (APP | JSON)
      const iPanels: Record<string, HTMLElement> = {
        app: $('panel-app')!, json: $('panel-json')!
      }
      const inputViewToggle = $('iview-toggle')
      inputViewToggle?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-iview]')
        if (!btn) return
        const view = btn.dataset.iview!
        for (const [k, panel] of Object.entries(iPanels)) panel.classList.toggle('hidden', k !== view)
        for (const b of inputViewToggle.querySelectorAll<HTMLElement>('[data-iview]')) {
          const active = b === btn
          b.classList.toggle('bg-transparency-white-t8', active)
          b.classList.toggle('text-primary-comfy-canvas', active)
          b.classList.toggle('text-primary-warm-gray', !active)
          b.classList.toggle('hover:bg-transparency-white-t4', !active)
          b.classList.toggle('hover:text-primary-comfy-canvas', !active)
        }
        renderAll()
      })

      // result view toggle (Preview | JSON)
      $('rview-toggle')!.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-rview]')
        if (!btn) return
        const json = btn.dataset.rview === 'json'
        $('result-json-box')!.classList.toggle('hidden', !json)
        resultPreview.classList.toggle('hidden', json)
        $('result-meta')!.classList.toggle('hidden', json)
        $('result-download')!.classList.toggle('hidden', json)
        for (const b of $('rview-toggle')!.querySelectorAll<HTMLElement>('[data-rview]')) {
          const active = b === btn
          b.classList.toggle('bg-transparency-white-t8', active)
          b.classList.toggle('text-primary-comfy-canvas', active)
          b.classList.toggle('text-primary-warm-gray', !active)
          b.classList.toggle('hover:bg-transparency-white-t4', !active)
          b.classList.toggle('hover:text-primary-comfy-canvas', !active)
        }
        renderResultJson()
      })

      // live bindings
      prompt?.addEventListener('input', renderAll)
      seedInput?.addEventListener('input', renderAll)
      for (const sel of [selAspect, selDur, selRes]) {
        sel?.addEventListener('change', renderAll)
      }

      $('seed-shuffle')?.addEventListener('click', () => {
        if (seedInput) {
          seedInput.value = String(Math.floor(Math.random() * 1_000_000_000))
        }
        renderAll()
      })

      // reference image demo
      const refFile = $('ref-file') as HTMLInputElement | null
      const refPreview = $('ref-preview') as HTMLImageElement | null
      const dropzone = $('dropzone')
      const exampleButtons = [
        ...document.querySelectorAll<HTMLElement>('[data-example-image]')
      ]
      let previewUrl: string | null = null

      const fileSize = (bytes: number) =>
        bytes >= 1024 * 1024
          ? `${(bytes / (1024 * 1024)).toFixed(1)} MB`
          : `${Math.max(1, Math.round(bytes / 1024))} KB`

      const fileKind = (file: File) =>
        (file.type.split('/')[1] || file.name.split('.').pop() || 'image').toUpperCase()

      const setExampleSelection = (name: string | null) => {
        for (const button of exampleButtons) {
          const selected = button.dataset.exampleName === name
          if (selected) button.dataset.selected = ''
          else delete button.dataset.selected
          button.setAttribute('aria-pressed', String(selected))
        }
      }

      const selectExample = (
        name: string,
        url: string,
        alt: string,
        modelUrl?: string | null
      ) => {
        if (previewUrl) URL.revokeObjectURL(previewUrl)
        previewUrl = null
        if (refFile) refFile.value = ''
        refImage = { name, source: url }
        if (refPreview) {
          refPreview.style.display = ''
          refPreview.src = url
          refPreview.alt = alt
        }
        const refName = $('ref-name')
        const refMeta = $('ref-meta')
        if (refName) refName.textContent = name
        if (refMeta) refMeta.textContent = 'PNG · Example input'
        $('ref-attachment')?.classList.remove('hidden')
        $('image-error')?.classList.add('hidden')
        setExampleSelection(name)
        if (modelUrl) {
          $('result-model-canvas')?.dispatchEvent(
            new CustomEvent('model-url-change', { detail: { url: modelUrl } })
          )
          const download = $('result-model-download') as HTMLAnchorElement | null
          if (download) download.href = modelUrl
          const outputName = $('result-output-name')
          if (outputName) outputName.textContent = modelUrl.split('/').at(-1) ?? name
        }
        renderAll()
      }

      const clearImage = () => {
        if (previewUrl) URL.revokeObjectURL(previewUrl)
        previewUrl = null
        refImage = null
        if (refFile) refFile.value = ''
        refPreview?.removeAttribute('src')
        if (refPreview) refPreview.alt = ''
        $('ref-attachment')?.classList.add('hidden')
        setExampleSelection(null)
        renderAll()
      }

      const resetImage = () => {
        if (defaultImageName && defaultImageUrl) {
          selectExample(
            defaultImageName,
            defaultImageUrl,
            defaultImageAlt,
            defaultModelUrl
          )
        } else {
          if (previewUrl) URL.revokeObjectURL(previewUrl)
          previewUrl = null
          if (refFile) refFile.value = ''
          refImage = null
          refPreview?.removeAttribute('src')
          if (refPreview) refPreview.alt = ''
          $('ref-attachment')?.classList.add('hidden')
          setExampleSelection(null)
          renderAll()
        }
      }

      const acceptImage = (file: File | undefined) => {
        if (!file || !file.type.startsWith('image/') || !refPreview) return
        if (previewUrl) URL.revokeObjectURL(previewUrl)
        previewUrl = URL.createObjectURL(file)
        refPreview.style.display = ''
        refPreview.src = previewUrl
        refPreview.alt = `Uploaded preview of ${file.name}`
        const refName = $('ref-name')
        const refMeta = $('ref-meta')
        if (refName) refName.textContent = file.name
        if (refMeta) refMeta.textContent = `${fileKind(file)} · ${fileSize(file.size)}`
        refImage = { name: file.name, source: file }
        $('ref-attachment')?.classList.remove('hidden')
        $('image-error')?.classList.add('hidden')
        setExampleSelection(null)
        renderAll()
      }

      for (const button of exampleButtons) {
        button.addEventListener('click', () => {
          const exampleName = button.dataset.exampleName
          const exampleUrl = button.dataset.exampleUrl
          if (!exampleName || !exampleUrl) return
          selectExample(
            exampleName,
            exampleUrl,
            button.dataset.exampleAlt ?? '',
            button.dataset.exampleModelUrl
          )
        })
      }

      $('add-image-btn')?.addEventListener('click', () => refFile?.click())
      dropzone?.addEventListener('click', (event) => {
        if (!(event.target as HTMLElement).closest('button')) refFile?.click()
      })
      dropzone?.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return
        event.preventDefault()
        refFile?.click()
      })
      refFile?.addEventListener('change', () => acceptImage(refFile.files?.[0]))
      $('ref-remove')?.addEventListener('click', clearImage)
      $('pg-reset')?.addEventListener('click', resetImage)

      // The drop zone lights up while a file is over it, not on plain hover.
      for (const type of ['dragenter', 'dragover']) {
        dropzone?.addEventListener(type, (e) => {
          e.preventDefault()
          dropzone.dataset.dragging = ''
        })
      }
      dropzone?.addEventListener('dragleave', (e) => {
        if (!dropzone.contains(e.relatedTarget as Node)) delete dropzone.dataset.dragging
      })
      dropzone?.addEventListener('drop', (e) => {
        e.preventDefault()
        delete dropzone.dataset.dragging
        acceptImage(e.dataTransfer?.files?.[0])
      })

      // split button menus
      const splitMenus = [
        { wrap: '#llms-wrap', trigger: 'llms-btn', menu: 'llms-menu' },
        { wrap: '#graph-wrap', trigger: 'graph-btn', menu: 'graph-menu' }
      ]
      const setMenuOpen = (trigger: string, menu: string, open: boolean) => {
        $(menu)?.classList.toggle('hidden', !open)
        $(trigger)?.setAttribute('aria-expanded', String(open))
      }
      for (const { trigger, menu } of splitMenus) {
        $(trigger)?.addEventListener('click', (e) => {
          e.stopPropagation()
          const open = $(menu)?.classList.contains('hidden') ?? false
          for (const other of splitMenus) setMenuOpen(other.trigger, other.menu, false)
          setMenuOpen(trigger, menu, open)
        })
      }
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        for (const { wrap, trigger, menu } of splitMenus) {
          if (!target.closest(wrap)) setMenuOpen(trigger, menu, false)
        }
      })
      $('llms-copy')?.addEventListener('click', async () => {
        try {
          const md = await (await fetch(window.location.pathname + '.md')).text()
          await navigator.clipboard.writeText(md)
          $('llms-copied')?.classList.remove('hidden')
          window.setTimeout(() => $('llms-copied')?.classList.add('hidden'), 1200)
        } catch { /* fetch or clipboard unavailable */ }
      })

      // gallery → prompt warm start
      document.querySelectorAll<HTMLElement>('[data-use-prompt]').forEach((b) =>
        b.addEventListener('click', () => {
          if (!prompt) return
          prompt.value = b.dataset.usePrompt ?? prompt.value
          renderAll()
          document.querySelector<HTMLElement>('[data-tab="playground"]')?.click()
          document.getElementById('pg-prompt')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        })
      )

      let progressAnimation: Animation | null = null
      function stopProgressAnimation() {
        progressAnimation?.cancel()
        progressAnimation = null
        fill.style.transform = ''
      }

      const startRun = () => {
        if (running) return
        if (runsLeft <= 0) {
          upgrade.classList.remove('hidden'); upgrade.classList.add('flex')
          return
        }
        setRunning(true)
        strip.classList.remove('hidden'); strip.classList.add('flex')
        overlay.classList.remove('hidden'); overlay.classList.add('flex')
        $('result-json-box')!.classList.add('hidden'); resultPreview.classList.remove('hidden')
        $('result-meta')!.classList.remove('hidden')
        $('result-download')!.classList.remove('hidden')
        stopProgressAnimation()
        fill.style.width = '0%'
        $('run-error')?.classList.add('hidden')
        requestAnimationFrame(() => requestAnimationFrame(() => (fill.style.width = '92%')))
        window.setTimeout(() => {
          overlay.classList.add('hidden'); overlay.classList.remove('flex')
          resultPreview.style.opacity = '0.4'
          window.setTimeout(() => (resultPreview.style.opacity = '1'), 350)
          runsLeft -= 1
          const runSeed = seedNow()
          lastRun = {
            job_id: 'j_' + runSeed.toString(16),
            status: 'succeeded',
            model: slug,
            ...(isImageTo3d ? {} : { seed: runSeed }),
            credits_charged: creditsNow(),
            charged_on: 'success only',
            duration_s: isImageTo3d ? 18.6 : 4.2,
            nodes_executed: isImageTo3d ? 66 : 24,
            output: isImageTo3d
              ? { type: 'model/gltf-binary', format: 'glb', saved_to_history: true }
              : { type: 'video/webp', watermark: false, saved_to_history: true }
          }
          if (resultSeed) resultSeed.textContent = `Seed ${runSeed}`
          meter.textContent = runsLeft > 0 ? `Free runs: ${runsLeft} left` : 'Free runs used'
          varBlock?.classList.remove('hidden')
          renderAll()
          setRunning(false)
          if (runsLeft <= 0) {
            window.setTimeout(() => { upgrade.classList.remove('hidden'); upgrade.classList.add('flex') }, 900)
          }
        }, 2400)
      }

      // variations queue demo — each variation is a run and spends the meter
      $('queue-vars')?.addEventListener('click', () => {
        if (!varStrip) return
        if (runsLeft <= 0) {
          upgrade.classList.remove('hidden'); upgrade.classList.add('flex')
          return
        }
        varStrip.classList.remove('hidden'); varStrip.classList.add('grid')
        $('var-note')?.classList.remove('hidden')
        const slots = [...varStrip.querySelectorAll<HTMLElement>('.var-slot')]
        slots.forEach((slot, i) => {
          window.setTimeout(() => {
            const im = slot.querySelector('img') as HTMLImageElement
            im.src = im.dataset.varImg ?? ''
            im.classList.remove('hidden')
            slot.querySelector('.var-shimmer')?.classList.add('hidden')
            slot.querySelector('span')?.classList.remove('hidden')
            if (runsLeft > 0) runsLeft -= 1
            meter.textContent = runsLeft > 0 ? `Free runs: ${runsLeft} left` : 'Free runs used'
            setRunLabels()
            if (runsLeft <= 0 && i === slots.length - 1) {
              window.setTimeout(() => { upgrade.classList.remove('hidden'); upgrade.classList.add('flex') }, 900)
            }
          }, 700 + i * 650)
        })
      })

      const onRun = () => {
        if (workflowUrl) {
          window.open(workflowUrl, '_blank', 'noopener,noreferrer')
          return
        }
        if (isImageTo3d && !refImage) {
          $('image-error')?.classList.remove('hidden')
          dropzone?.focus()
          return
        }
        if (!authed) { modal.classList.remove('hidden'); modal.classList.add('flex') }
        else startRun()
      }
      runMobile.addEventListener('click', onRun)
      runDesktop?.addEventListener('click', onRun)
      $('free-run-cta')?.addEventListener('click', onRun)

      modal.querySelectorAll('[data-auth]').forEach((button) =>
        button.addEventListener('click', () => {
          modal.classList.add('hidden'); modal.classList.remove('flex')
          authed = true
          setRunLabels()
          startRun()
        })
      )
      $('auth-close')!.addEventListener('click', () => {
        modal.classList.add('hidden'); modal.classList.remove('flex')
      })
      $('demo-reset')!.addEventListener('click', () => {
        runsLeft = 5; lastRun = null
        resetImage()
        if (seedInput) seedInput.value = defaultSeed
        upgrade.classList.add('hidden'); upgrade.classList.remove('flex')
        strip.classList.add('hidden'); strip.classList.remove('flex')
        varBlock?.classList.add('hidden')
        varStrip?.classList.add('hidden'); varStrip?.classList.remove('grid')
        if (resultSeed) resultSeed.textContent = `Seed ${defaultSeed}`
        meter.textContent = 'Free runs: 5 left'
        renderAll()
      })

      renderAll()
    }

    const initAll = () => {
      initModelTabs()
      initSdkTabs()
      initCodeCopy()
      void initModelViewer()
      initPlaygroundDemo()
    }

    initAll()
    document.addEventListener('astro:page-load', initAll)
  </script>
</BaseLayout>
