---
import { t } from '../../i18n/translations'

const categories = [
  t('workshop.workflows.categories.create'),
  t('workshop.workflows.categories.edit'),
  t('workshop.workflows.categories.specialized')
]
---

<section
  class="rounded-2xl border border-dashed border-transparency-white-t8 px-6 py-16 text-center"
  data-testid="workshop-workflows-placeholder"
>
  <p
    class="mb-2 text-sm font-medium uppercase tracking-widest text-primary-comfy-yellow"
  >
    {t('workshop.workflows.eyebrow')}
  </p>
  <h2 class="text-2xl font-bold text-primary-comfy-canvas lg:text-3xl">
    {t('workshop.workflows.heading')}
  </h2>
  <p class="mx-auto mt-4 max-w-2xl text-base text-primary-comfy-canvas/70">
    {t('workshop.workflows.body')}
  </p>
  <ul class="mt-8 flex flex-wrap justify-center gap-2">
    {
      categories.map((category) => (
        <li class="rounded-full bg-transparency-white-t4 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-comfy-canvas">
          {category}
        </li>
      ))
    }
  </ul>
</section>
