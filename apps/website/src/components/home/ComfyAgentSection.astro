---
import type { Locale } from '@/i18n/translations'
import { externalLinks } from '@/config/routes'
import { tAgent } from '@/components/agent/agentTranslations'
import AgentWorkflow from '@/components/agent/AgentWorkflow.astro'
import BrandButton from '@/components/common/BrandButton.vue'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
---

<section
  class="home-agent-workflow pt-12 pb-24 lg:pt-20 lg:pb-32"
  aria-labelledby="home-agent-heading"
>
  <div
    class="mx-auto w-full max-w-10xl px-6 pt-12 text-center lg:px-20 lg:pt-16"
  >
    <h2
      id="home-agent-heading"
      class="text-4xl/[1.3] font-light tracking-[-0.03em] text-primary-warm-white lg:text-5xl/[1.3]"
    >
      {tAgent('agentPage.hero.titleLine1', locale)}
      <span class="block text-primary-comfy-canvas">
        {tAgent('agentPage.hero.titleLine2', locale)}
      </span>
    </h2>
    <p
      class="mx-auto mt-6 max-w-2xl text-[17px]/[1.6] font-light text-primary-comfy-canvas lg:mt-8"
    >
      {tAgent('agentPage.hero.subtitle', locale)}
    </p>
    <div
      class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
    >
      <BrandButton
        href={externalLinks.cloud}
        size="lg"
        class="min-h-12 w-full rounded-2xl px-6 text-sm tracking-normal uppercase sm:w-auto"
      >
        {tAgent('agentPage.cta', locale)}
      </BrandButton>
    </div>
  </div>
  <AgentWorkflow locale={locale} />
</section>
