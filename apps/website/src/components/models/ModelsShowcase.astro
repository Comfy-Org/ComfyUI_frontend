---
import ModelsHeroSection from './ModelsHeroSection.vue'
import ModelCreationsSection from './ModelCreationsSection.vue'
import AIModelsSection from '../product/shared/AIModelsSection.vue'
import ProductShowcaseSection from '../home/ProductShowcaseSection.vue'
import { localizeHref } from '../../config/routes'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<ModelsHeroSection
  locale={locale}
  modelName="Grok Imagine"
  ctaHref={localizeHref('/p/supported-models/grok-imagine', locale)}
  videoSrc="https://media.comfy.org/website/models/video_ComfdyUI_00001_.mp4"
  videoAriaLabel={t('models.grokImagine.videoAriaLabel', locale)}
/>
<ModelCreationsSection locale={locale} client:load />
<AIModelsSection locale={locale} client:load />
<ProductShowcaseSection locale={locale} client:load />
