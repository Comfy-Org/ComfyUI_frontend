---
import FeaturedCarousel02 from '../../blocks/FeaturedCarousel02.vue'
import type { FeaturedSplitSlide } from '../../blocks/FeaturedCarousel02.vue'
import SectionLabel from '../../common/SectionLabel.vue'
import type { Locale } from '../../../i18n/translations'
import { t } from '../../../i18n/translations'

import type { ExploreModelFamilyFixture } from './modelExploreFixtures'

interface Props {
  eyebrow: string
  title: string
  description: string
  families: ExploreModelFamilyFixture[]
  exploreFamilyLabel: string
  locale: Locale
}

const { eyebrow, title, description, families, exploreFamilyLabel, locale } =
  Astro.props

const slides: FeaturedSplitSlide[] = families.map((family) => {
  const familyTitle = t(family.titleKey, locale)

  return {
    id: family.id,
    media: {
      type: 'image',
      src: family.mediaSrc,
      alt: t('models.explore.family.mediaAlt', locale).replace(
        '{name}',
        familyTitle,
      ),
    },
    eyebrow,
    title: familyTitle,
    body: t(family.descriptionKey, locale),
    primaryCta: {
      label: exploreFamilyLabel.replace('{name}', familyTitle),
      href: family.href,
    },
    tags: [...family.variants],
  }
})
---

<section
  aria-labelledby="model-family-heading"
  class="py-16"
>
  <div class="mx-auto max-w-9xl px-6 lg:px-12">
    <SectionLabel>{eyebrow}</SectionLabel>
    <h2
      id="model-family-heading"
      class="mt-4 text-4xl font-light text-primary-comfy-canvas lg:text-5xl"
    >
      {title}
    </h2>
    <p
      class="mt-5 max-w-3xl text-base/relaxed font-light text-primary-comfy-canvas"
    >
      {description}
    </p>
  </div>
  <FeaturedCarousel02 client:visible {locale} {slides} class="mt-10" />
</section>
