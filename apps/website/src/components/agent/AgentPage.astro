---
import WorkflowCanvas from './WorkflowCanvas.astro'
import BrandButton from '../common/BrandButton.vue'
import BreadcrumbBar from '../common/BreadcrumbBar.vue'
import ProductCardsSection from '../common/ProductCardsSection.vue'
import VideoPlayer from '../common/VideoPlayer.vue'
import type { Locale } from '../../i18n/translations'
import { t } from '../../i18n/translations'
import { externalLinks, getRoutes } from '../../config/routes'
import BaseLayout from '../../layouts/BaseLayout.astro'

interface Props {
  noindex?: boolean
  locale?: Locale
}

const { noindex = false, locale = 'en' } = Astro.props

const routes = getRoutes(locale)
const imageRoot = 'https://media.comfy.org/website/comfy-agent'
const capabilities = [
  {
    title: t('agentPage.capabilities.1.title', locale),
    image: `${imageRoot}/knowledge.png`,
    alt: 'A collection of creative images and community workflows',
    bullets: [
      t('agentPage.capabilities.1.bullet.1', locale),
      t('agentPage.capabilities.1.bullet.2', locale),
      t('agentPage.capabilities.1.bullet.3', locale)
    ]
  },
  {
    title: t('agentPage.capabilities.2.title', locale),
    image: `${imageRoot}/multiplayer.png`,
    alt: 'A user and Comfy Agent editing a shared node workflow',
    bullets: [
      t('agentPage.capabilities.2.bullet.1', locale),
      t('agentPage.capabilities.2.bullet.2', locale),
      t('agentPage.capabilities.2.bullet.3', locale)
    ]
  },
  {
    title: t('agentPage.capabilities.3.title', locale),
    image: '/images/comfy-agent/vibe-crafting-workflow.webp',
    alt: 'Headphone workflow with connected 3D camera and color controls',
    bullets: [
      t('agentPage.capabilities.3.bullet.1', locale),
      t('agentPage.capabilities.3.bullet.2', locale),
      t('agentPage.capabilities.3.bullet.3', locale)
    ]
  }
]
const comparisons = [
  {
    label: t('agentPage.comparison.1.label', locale),
    agent: [
      t('agentPage.comparison.1.agent.1', locale),
      t('agentPage.comparison.1.agent.2', locale),
      t('agentPage.comparison.1.agent.3', locale)
    ],
    mcp: [t('agentPage.comparison.1.mcp.1', locale)]
  },
  {
    label: t('agentPage.comparison.2.label', locale),
    agent: [
      t('agentPage.comparison.2.agent.1', locale),
      t('agentPage.comparison.2.agent.2', locale),
      t('agentPage.comparison.2.agent.3', locale)
    ],
    mcp: [t('agentPage.comparison.2.mcp.1', locale)]
  },
  {
    label: t('agentPage.comparison.3.label', locale),
    agent: [
      t('agentPage.comparison.3.agent.1', locale),
      t('agentPage.comparison.3.agent.2', locale)
    ],
    mcp: [
      t('agentPage.comparison.3.mcp.1', locale),
      t('agentPage.comparison.3.mcp.2', locale)
    ]
  },
  {
    label: t('agentPage.comparison.4.label', locale),
    agent: [t('agentPage.comparison.4.agent.1', locale)],
    mcp: [t('agentPage.comparison.4.mcp.1', locale)]
  },
  {
    label: t('agentPage.comparison.5.label', locale),
    agent: [
      t('agentPage.comparison.5.agent.1', locale),
      t('agentPage.comparison.5.agent.2', locale)
    ],
    mcp: [
      t('agentPage.comparison.5.mcp.1', locale),
      t('agentPage.comparison.5.mcp.2', locale)
    ]
  }
]
const faqs = [
  {
    question: t('agentPage.faq.1.q', locale),
    answer: t('agentPage.faq.1.a', locale)
  },
  {
    question: t('agentPage.faq.2.q', locale),
    answer: t('agentPage.faq.2.a', locale)
  },
  {
    question: t('agentPage.faq.3.q', locale),
    answer: t('agentPage.faq.3.a', locale)
  },
  {
    question: t('agentPage.faq.4.q', locale),
    answer: t('agentPage.faq.4.a', locale)
  },
  {
    question: t('agentPage.faq.5.q', locale),
    answer: t('agentPage.faq.5.a', locale)
  },
  {
    question: t('agentPage.faq.6.q', locale),
    answer: t('agentPage.faq.6.a', locale),
    link: {
      label: t('agentPage.faq.6.linkLabel', locale),
      href: externalLinks.docsInAppAgent
    }
  },
  {
    question: t('agentPage.faq.7.q', locale),
    answer: t('agentPage.faq.7.a', locale)
  },
  {
    question: t('agentPage.faq.8.q', locale),
    answer: t('agentPage.faq.8.a', locale)
  },
  {
    question: t('agentPage.faq.9.q', locale),
    answer: t('agentPage.faq.9.a', locale)
  }
]
const briefs = [
  {
    creator: 'Doug Hogan',
    ariaLabel: t('agentPage.usecases.brief.1.ariaLabel', locale),
    byline: t('agentPage.usecases.brief.1.byline', locale),
    title: t('agentPage.usecases.brief.1.title', locale),
    description: t('agentPage.usecases.brief.1.description', locale),
    video: `${imageRoot}/bigfoot-vfx.mp4`,
    poster: `${imageRoot}/bigfoot-vfx-poster.webp`,
    tag: t('agentPage.usecases.brief.1.tag', locale)
  },
  {
    creator: 'shanef3d',
    ariaLabel: t('agentPage.usecases.brief.2.ariaLabel', locale),
    byline: t('agentPage.usecases.brief.2.byline', locale),
    title: t('agentPage.usecases.brief.2.title', locale),
    description: t('agentPage.usecases.brief.2.description', locale),
    video: `${imageRoot}/product-imagery-demo.mp4`,
    poster: `${imageRoot}/product-imagery-demo-poster.webp`,
    tag: t('agentPage.usecases.brief.2.tag', locale)
  }
]
---

<BaseLayout
  title={t('agentPage.meta.title', locale)}
  description={t('agentPage.meta.description', locale)}
  noindex={noindex}
  hideAnnouncementBanner
>
  <BreadcrumbBar
    crumbs={[
      { label: t('breadcrumb.home', locale), href: routes.home },
      { label: t('nav.products', locale), href: '#products' },
      { label: t('breadcrumb.agent', locale) }
    ]}
  />

  <section
    class="mx-auto w-full max-w-10xl px-6 pt-12 text-center lg:px-20 lg:pt-16"
    aria-labelledby="agent-title"
  >
    <div class="mx-auto w-fit max-w-full sm:max-w-[83.333333%]">
      <h1
        id="agent-title"
        class="text-4xl/[1.3] font-light tracking-[-0.03em] text-primary-warm-white lg:text-5xl/[1.3]"
      >
        {t('agentPage.hero.titleLine1', locale)}
        <span class="block text-primary-comfy-canvas"
          >{t('agentPage.hero.titleLine2', locale)}</span
        >
      </h1>
      <p
        class="mt-6 w-0 min-w-full text-[17px]/[1.6] font-light text-primary-comfy-canvas sm:ml-[-10%] sm:min-w-[120%] lg:mt-8"
      >
        {t('agentPage.hero.subtitle', locale)}
      </p>
    </div>
    <div
      class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
    >
      <BrandButton
        href={externalLinks.cloud}
        size="lg"
        class="min-h-12 w-full rounded-2xl px-6 text-sm tracking-normal uppercase sm:w-auto"
        >{t('agentPage.cta', locale)}</BrandButton
      >
    </div>
  </section>

  <WorkflowCanvas />

  <section
    class="mx-auto max-w-10xl px-6 pt-[4.2rem] sm:pt-14 lg:px-20 lg:pt-15"
    aria-labelledby="capabilities-title"
  >
    <div class="text-center">
      <p
        class="text-sm font-extrabold tracking-wider text-primary-comfy-yellow uppercase"
      >
        {t('agentPage.capabilities.eyebrow', locale)}
      </p>
      <h2
        id="capabilities-title"
        class="mt-4 text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas lg:text-5xl"
      >
        {t('agentPage.capabilities.heading', locale)}
      </h2>
    </div>
    <div class="mt-7 grid gap-4 sm:mt-14 md:grid-cols-3">
      {capabilities.map((card) => <article
        class="overflow-hidden rounded-[40px] bg-transparency-white-t4 p-2"
      >
        <img
          src={card.image}
          alt={card.alt}
          width="454"
          height="324"
          loading="lazy"
          class="aspect-454/324 w-full rounded-[36px] object-cover"
        />
        <div class="px-6 pt-7 pb-6">
          <h3
            class="text-lg/[1.4] font-medium text-primary-warm-white uppercase xl:text-[22px]"
          >
            {card.title}
          </h3>
          <ul
            class="mt-6 space-y-2 text-[15.5px]/[1.6] font-light text-primary-comfy-canvas"
          >
            {card.bullets.map((item) => <li class="flex gap-2">
              <span aria-hidden="true">-</span>
              <span>{item}</span>
            </li>)}
          </ul>
        </div>
      </article>)}
    </div>
    <div
      class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
    >
      <BrandButton
        href={externalLinks.cloud}
        size="lg"
        class="min-h-12 w-full rounded-2xl px-6 text-sm uppercase sm:min-h-16 sm:w-auto sm:rounded-3xl"
        >{t('agentPage.cta', locale)}</BrandButton
      >
    </div>
  </section>

  <section
    id="usecase-videos"
    class="mx-auto max-w-10xl px-6 pt-28 lg:px-20 lg:pt-44"
    aria-labelledby="briefs-title"
  >
    <div class="text-center">
      <p
        class="mb-6 text-sm font-extrabold tracking-wider text-primary-comfy-yellow uppercase"
      >
        {t('agentPage.usecases.eyebrow', locale)}
      </p>
      <h2
        id="briefs-title"
        class="scroll-mt-40 text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas lg:text-5xl"
      >
        {t('agentPage.usecases.heading', locale)}
      </h2>
      <p
        class="mx-auto mt-6 max-w-160 text-[17px]/[1.6] font-light text-primary-comfy-canvas"
      >
        {t('agentPage.usecases.subheading', locale)}
      </p>
    </div>
    <article
      class="mt-8 grid gap-4 rounded-[40px] bg-transparency-white-t4 p-2 sm:mt-16 lg:grid-cols-[1008fr_400fr]"
    >
      <div class="relative self-start overflow-hidden rounded-[36px]">
        <VideoPlayer
          client:visible
          src="https://media.comfy.org/website/comfy-agent/andidea-animation-ensub-1080p.mp4"
          poster="https://media.comfy.org/website/comfy-agent/andidea-animation-poster.webp"
          autoplay
          lazyAutoplay
          loop
          persistentControls
          fit="contain"
          ariaLabel={t('agentPage.usecases.featured.ariaLabel', locale)}
          class="w-full rounded-[36px] border-0"
        />
      </div>
      <div class="flex min-w-0 flex-col items-start px-6 py-8 lg:px-8 lg:py-12">
        <p
          class="text-xs font-extrabold tracking-wider text-primary-comfy-yellow uppercase"
        >
          {t('agentPage.usecases.featured.byline', locale)}
        </p>
        <h3 class="mt-3 text-2xl/[1.2] font-medium text-primary-comfy-canvas">
          {t('agentPage.usecases.featured.title', locale)}
        </h3>
        <p class="mt-4 text-sm/normal font-light text-primary-warm-gray">
          {t('agentPage.usecases.featured.description', locale)}
        </p>
        <p class="mt-8">
          <span
            class="rounded-full bg-transparency-white-t4 px-5 py-2 text-xs font-light text-primary-warm-gray uppercase"
            >{t('agentPage.usecases.featured.tag', locale)}</span
          >
        </p>
      </div>
    </article>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {briefs.map((brief) => <article
        class="rounded-[40px] bg-transparency-white-t4 p-2"
      >
        <div class="relative overflow-hidden rounded-[36px]">
          <VideoPlayer
            client:visible
            src={brief.video}
            poster={brief.poster}
            autoplay
            lazyAutoplay
            loop
            persistentControls
            fit="contain"
            ariaLabel={brief.ariaLabel}
            class="w-full rounded-[36px] border-0"
          />
        </div>
        <div class="px-6 pt-6 pb-7 lg:px-8">
          <p
            class="text-xs font-extrabold tracking-wider text-primary-comfy-yellow uppercase"
          >
            {brief.byline}
          </p>
          <h3 class="mt-3 text-2xl/[1.2] font-medium text-primary-comfy-canvas">
            {brief.title}
          </h3>
          <p class="mt-3 text-sm/normal font-light text-primary-warm-gray">
            {brief.description}
          </p>
          <p class="mt-6">
            <span
              class="rounded-full bg-transparency-white-t4 px-5 py-2 text-xs font-light text-primary-warm-gray uppercase"
              >{brief.tag}</span
            >
          </p>
        </div>
      </article>)}
    </div>
  </section>

  <section class="pt-16 lg:pt-20" aria-labelledby="difference-title">
    <div class="mx-auto max-w-10xl px-6 text-center lg:px-20">
      <h2
        id="difference-title"
        class="mx-auto max-w-220 text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas lg:text-5xl"
      >
        {t('agentPage.difference.headingLine1', locale)}
        <br class="hidden sm:block" />
        {t('agentPage.difference.headingLine2', locale)}
      </h2>
      <p
        class="mx-auto mt-8 max-w-[337.5px] text-[17px]/[1.6] font-light text-primary-comfy-canvas sm:max-w-[405px] lg:mt-10 lg:max-w-135"
      >
        {t('agentPage.difference.body', locale)}
      </p>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-10xl gap-12 px-6 pt-[4.76rem] lg:grid-cols-[440fr_880fr] lg:gap-30 lg:px-20 lg:pt-[8.16rem]"
    aria-labelledby="start-title"
  >
    <div class="max-sm:text-center">
      <h2
        id="start-title"
        class="max-w-100 text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas max-sm:mx-auto lg:text-5xl"
      >
        {t('agentPage.start.heading', locale)}
      </h2>
      <p
        class="mt-12 hidden text-[17px]/[1.6] font-light text-primary-warm-white sm:block"
      >
        {t('agentPage.start.subheading', locale)}
      </p>
    </div>
    <div class="space-y-16">
      <div
        class="grid gap-6 border-b border-primary-comfy-canvas/40 pb-16 md:grid-cols-[280fr_568fr] md:gap-8"
      >
        <h3 class="text-2xl/[1.4] font-medium text-primary-comfy-canvas">
          {t('agentPage.start.cloud.heading', locale)}
        </h3>
        <div class="text-[17px]/[1.6] font-light text-primary-comfy-canvas">
          <p>
            {t('agentPage.start.cloud.body', locale)}
          </p>
          <p class="mt-6">
            {t('agentPage.start.cloud.noAccount', locale)}
            <a
              href={externalLinks.cloud}
              class="text-primary-comfy-yellow underline underline-offset-4 hover:opacity-80"
              >{t('agentPage.start.cloud.cta', locale)}</a
            >
          </p>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-[280fr_568fr] md:gap-8">
        <h3 class="text-2xl/[1.4] font-medium text-primary-comfy-canvas">
          {t('agentPage.start.local.heading', locale)}
        </h3>
        <div class="text-[17px]/[1.6] font-light text-primary-comfy-canvas">
          <p>
            {t('agentPage.start.local.body', locale)}
          </p>
          <p class="mt-6">
            <a
              href="https://form.typeform.com/to/UqL3PpAM"
              class="text-primary-comfy-yellow underline underline-offset-4 hover:opacity-80"
              >{t('agentPage.start.local.cta', locale)}</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-10xl px-6 pt-28 lg:px-20 lg:pt-44"
    aria-labelledby="comparison-title"
  >
    <h2
      id="comparison-title"
      class="text-center text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas lg:text-5xl"
    >
      {t('agentPage.comparison.heading', locale)}
    </h2>
    <div
      class="mt-16 overflow-x-auto rounded-[40px] bg-transparency-white-t4 p-3 md:p-4 lg:px-10 lg:py-6"
      role="region"
      aria-labelledby="comparison-title"
      tabindex="0"
    >
      <table
        class="w-full table-fixed border-collapse text-left text-[13px]/[1.5] font-light wrap-break-word text-primary-comfy-canvas/80 sm:text-sm lg:text-base"
      >
        <thead>
          <tr>
            <td class="w-[24%] md:w-1/5">
              <span class="sr-only"
                >{t('agentPage.comparison.featureSr', locale)}</span
              >
            </td>
            <th
              scope="col"
              class="w-[38%] px-2 pb-3 text-[11px] font-bold tracking-wider text-primary-comfy-yellow uppercase sm:px-3 sm:text-xs md:w-2/5 md:px-6 md:pb-4"
            >
              {t('agentPage.comparison.colAgent', locale)}
            </th>
            <th
              scope="col"
              class="w-[38%] px-2 pb-3 text-[11px] font-bold tracking-wider text-primary-comfy-yellow uppercase sm:px-3 sm:text-xs md:w-2/5 md:px-6 md:pb-4"
            >
              {t('agentPage.comparison.colMcp', locale)}
            </th>
          </tr>
        </thead>
        <tbody>
          {comparisons.map((row) => <tr
            class="border-b border-white/10 last:border-0"
          >
            <th
              scope="row"
              class="py-3 pr-2 align-top font-normal text-primary-warm-white md:py-4 md:pr-4"
            >
              {row.label}
            </th>
            <td class="px-2 py-3 align-top sm:px-3 md:px-6 md:py-4">
              {row.agent.map((line) => <p class="mb-1">{line}</p>)}
            </td>
            <td class="px-2 py-3 align-top sm:px-3 md:px-6 md:py-4">
              {row.mcp.map((line) => <p class="mb-1">{line}</p>)}
            </td>
          </tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-10xl gap-12 px-6 pt-28 pb-20 lg:grid-cols-[440fr_880fr] lg:gap-30 lg:px-20 lg:pt-44 lg:pb-28"
    aria-labelledby="faq-title"
  >
    <h2
      id="faq-title"
      class="text-4xl/tight font-light tracking-[-0.03em] text-primary-comfy-canvas lg:text-5xl"
    >
      {t('agentPage.faq.heading', locale)}
    </h2>
    <div class="space-y-12">
      {faqs.map((faq, index) => <details
        open={index === 0}
        data-faq
        data-question={faq.question}
        class="group border-b border-primary-comfy-canvas/40 pb-8"
      >
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-8 text-xl/[1.4] font-medium text-primary-comfy-canvas group-open:text-primary-comfy-yellow hover:text-primary-comfy-yellow lg:text-2xl [&::-webkit-details-marker]:hidden"
        >
          {faq.question}<span class="size-6 shrink-0"
            ><img
              src={`${imageRoot}/plus.svg`}
              alt=""
              width="24"
              height="24"
              class="size-6 group-open:hidden"
            /><img
              src={`${imageRoot}/minus.svg`}
              alt=""
              width="24"
              height="24"
              class="hidden size-6 group-open:block"
          /></span>
        </summary>
        <p
          class="mt-10 text-sm/[1.6] font-light whitespace-pre-line text-primary-comfy-canvas"
        >
          {faq.answer}{faq.link && <a
            href={faq.link.href}
            class="ml-1 text-primary-comfy-yellow underline underline-offset-4 hover:opacity-80"
            >{faq.link.label}</a
          >}
        </p>
      </details>)}
    </div>
  </section>
  <div id="products">
    <ProductCardsSection
      locale={locale}
      labelKey="products.labelProducts"
      ctaKey="products.ctaShort"
    />
  </div>
</BaseLayout>

<script>
  import {
    captureAgentFaqExpanded,
    captureAgentUsecaseVideoPlayed
  } from '../../scripts/posthog'

  document.querySelectorAll('[data-faq]').forEach((details) => {
    details.addEventListener('toggle', () => {
      if (!(details instanceof HTMLDetailsElement) || !details.open) return
      const question = details.dataset.question
      if (question) captureAgentFaqExpanded(question)
    })
  })

  document
    .querySelector('#usecase-videos')
    ?.querySelectorAll('video')
    .forEach((video) => {
      video.addEventListener('play', () => {
        captureAgentUsecaseVideoPlayed(
          video.getAttribute('aria-label') ?? 'unknown'
        )
      })
    })
</script>
