---
import WorkflowNode from './WorkflowNode.astro'
import { productWorkflow } from './productWorkflow'
import { createWorkflowMotion } from './workflowMotion'
import type { Locale } from '@/i18n/translations'
import { tAgent } from './agentTranslations'

interface Props {
  userCursorLabel: string
  locale: Locale
}

const { userCursorLabel, locale } = Astro.props
const workflow = productWorkflow
const { nodes, width, height, agentRest, userRest } = workflow
const unit = width / 100
const imageRoot = 'https://media.comfy.org/website/comfy-agent'
const motion = createWorkflowMotion(workflow, { fadeNodes: true })
const { scene } = motion
---

<style is:inline set:html={motion.css}></style>
<div
  style={`--wf-duration:${motion.duration}s;--wf-aspect:${width} / ${height}`}
  class="wf-example"
  data-example={workflow.id}
>
  <div class="wf-scroll">
    <div class="wf-stage">
      <div
        class="wf-scene"
        id={`workflow-${workflow.id}`}
        style={`--wf-animation:wf-scene-${workflow.id}`}
      >
        <svg
          class="wf-connections"
          viewBox={`0 0 ${width} ${height}`}
          aria-hidden="true"
        >
          {scene.wires.map((wire) => (
            <path
              d={wire.path}
              pathLength="1"
              style={`--wf-animation:${wire.name}`}
            />
          ))}
        </svg>
        {nodes.map((node, index) => (
          <WorkflowNode
            node={node}
            motion={scene.nodes[index]}
            unit={unit}
            imageRoot={imageRoot}
          />
        ))}
        <div
          style={`--wf-animation:${scene.userCursor.name};left:${userRest.x / unit}cqw;top:${userRest.y / unit}cqw`}
          class="wf-user"
          role="img"
          aria-label={userCursorLabel}
        >
          <img
            class="wf-user-pointer"
            src={`${imageRoot}/user-pointer.svg`}
            alt=""
            width="23"
            height="26"
          />
          <span class="wf-user-badge wf-cursor-badge">
            <span>{tAgent('agentPage.workflow.userTab', locale)}</span>
          </span>
        </div>
        <div
          style={`--wf-animation:${scene.agentCursor.name};left:${agentRest.x / unit}cqw;top:${agentRest.y / unit}cqw`}
          class="wf-agent"
          role="img"
          aria-label="Comfy Agent"
        >
          <img
            class="wf-agent-pointer"
            src="/images/comfy-agent/agent-pointer.svg"
            alt=""
            width="90"
            height="100"
          />
          <span class="wf-agent-badge wf-cursor-badge">
            <img
              src="/images/comfy-agent/agent-logo.svg"
              alt=""
              width="76"
              height="87"
            />
            <span>{tAgent('agentPage.workflow.agentTab', locale)}</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
