---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CreatorProfileHeader from '@/components/hub/CreatorProfileHeader.vue'
import CreatorWorkflowGrid from '@/components/hub/CreatorWorkflowGrid.vue'
import { catalogLocalePrefix } from '@/config/catalog-locales'
import { HUB_MODELS_PATH } from '@/config/hub-models'
import { HUB_CREATORS_PATH, creatorEntityId } from '@/lib/hub/creator-path'
import type { WorkshopModel } from '@/config/models-catalogue'
import type { Locale } from '@/i18n/translations'
import type { HubCreator } from '@/lib/hub/creators'
import { creatorEntityNode, creatorMetaDescription } from '@/lib/hub/creators'
import { absoluteUrl, itemListNode, pageContext } from '@/utils/jsonLd'

interface Props {
  creator: HubCreator
  workflows: readonly WorkshopModel[]
  nextCursor?: string
  locale: Locale
}

const { creator, workflows, nextCursor, locale } = Astro.props
const { t } = Astro.locals
const { url, siteUrl } = pageContext(
  Astro.site,
  Astro.url.pathname,
  Astro.currentLocale
)
const name = creator.displayName
const description = creatorMetaDescription(
  t('workshop.hub.creators.profileSummary', { name }),
  creator.description
)
const workflowsHeading = t('workshop.hub.creators.workflowsHeading', { name })
const directoryPath = `${catalogLocalePrefix(locale)}${HUB_CREATORS_PATH}/`
---

<BaseLayout
  title={t('workshop.hub.creators.profileTitle', {
    name,
    username: creator.username
  })}
  description={description}
  noindex={workflows.length === 0}
  ogImage={creator.avatarUrl}
  ogImageAlt={name}
  pageType="ProfilePage"
  mainEntityId={creatorEntityId(siteUrl, creator.username)}
  breadcrumbs={[
    {
      name: t('workshop.hub.creators.hub'),
      url: absoluteUrl(
        Astro.site,
        `${catalogLocalePrefix(locale)}${HUB_MODELS_PATH}`
      )
    },
    {
      name: t('workshop.hub.creators.title'),
      url: absoluteUrl(Astro.site, directoryPath)
    },
    { name }
  ]}
  extraJsonLd={[
    creatorEntityNode(creator, url, siteUrl),
    itemListNode(
      url,
      workflowsHeading,
      workflows.flatMap(({ href, name }) =>
        href ? [{ url: absoluteUrl(Astro.site, href), name }] : []
      )
    )
  ]}
>
  <div class="mx-auto max-w-10xl px-6 pt-8 pb-24 max-sm:pt-5 lg:px-8 lg:pt-12">
    <a
      href={directoryPath}
      class="text-sm text-content-secondary hover:text-content"
    >
      ← {t('workshop.hub.creators.title')}
    </a>
    <CreatorProfileHeader creator={creator} locale={locale} />
    <h2 class="mt-16 mb-6 text-2xl font-light text-content">
      {workflowsHeading}
    </h2>
    {workflows.length > 0 ? (
      <CreatorWorkflowGrid
        initialModels={workflows}
        nextCursor={nextCursor}
        author={creator.username}
        locale={locale}
        client:visible
      />
    ) : (
      <p class="text-content-secondary">
        {t('workshop.hub.creators.noWorkflows', { name })}
      </p>
    )}
  </div>
</BaseLayout>
