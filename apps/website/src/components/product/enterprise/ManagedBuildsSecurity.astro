---
import { externalLinks } from '../../../config/routes'

const controls = [
  {
    title: 'Workflows stay local',
    description: 'For local deployments, only the environment definition reaches Comfy. Your graphs and outputs stay where they run.',
  },
  {
    title: 'Private nodes, private models',
    description: 'Include internal node packs and fine-tuned models inside a team-controlled build.',
  },
  {
    title: 'Company identity and SSO',
    description: 'Gate installation and build assignment through company identity. SSO is available for enterprise teams.',
  },
  {
    title: 'Bring your own keys',
    description: 'Use supported provider keys with the contracts and pricing your organization already has.',
  },
  {
    title: 'Usage visibility, explicit audit scope',
    description: 'Review model and partner usage. Scope any additional authentication, release, retention, or export events during security review.',
  },
  {
    title: 'Procurement-ready terms',
    description: 'A DPA and enterprise agreement are available. Comfy does not train on customer data.',
  },
] as const
---

<section class="max-w-9xl mx-auto px-6 py-16 lg:px-20 lg:py-24">
  <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
    <div>
      <p class="text-xs font-bold tracking-[0.2em] text-primary-comfy-yellow">ENTERPRISE CONTROLS</p>
      <h2 class="mt-4 text-4xl font-light tracking-tight text-primary-comfy-canvas lg:text-6xl">Ready for your security review.</h2>
      <p class="mt-6 max-w-xl text-base/relaxed text-primary-comfy-canvas/70">
        Specific claims, current controls, and a direct path to the documents your security and procurement teams need.
      </p>
      <a
        href={externalLinks.trustCenter}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-full border border-primary-comfy-canvas/25 px-7 py-4 text-sm font-bold text-primary-comfy-canvas"
      >
        VIEW TRUST CENTER
      </a>
    </div>
    <div class="grid gap-px overflow-hidden rounded-[2.5rem] bg-primary-comfy-canvas/15 sm:grid-cols-2">
      {
        controls.map((control) => (
          <article class="min-h-52 bg-primary-comfy-ink p-7">
            <h3 class="text-xl font-light text-primary-comfy-canvas">{control.title}</h3>
            <p class="mt-4 text-sm/relaxed text-primary-comfy-canvas/65">{control.description}</p>
          </article>
        ))
      }
    </div>
  </div>
  <p class="mt-8 text-sm/relaxed text-primary-comfy-canvas/55">
    For Comfy services, processing is in the United States on Google Cloud. Enterprise includes a 99.5% workflow-execution uptime SLA. SOC 2 Type II audit in progress.
  </p>
</section>
