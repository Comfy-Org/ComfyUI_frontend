---
import DiagramFrame from './DiagramFrame.astro'

interface Props {
  variant?: 'full' | 'card'
}

const { variant = 'full' } = Astro.props
const label =
  "Diagram: Ann's operation and the agent's operation carry the same base_version, so the comparison falls through to op_id, which the agent's operation wins — and two replicas that received the two operations in opposite orders, Sydney and Berlin, both land on that same winner without coordinating."
---

{
  variant === 'card' ? (
    <DiagramFrame viewBox="0 0 320 200" label={label} variant="card">
      <defs>
        <marker
          id="arrow-stamp-card"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead" />
        </marker>
      </defs>
      <rect x="16" y="20" width="120" height="50" rx="10" class="eb-diagram-box" />
      <text x="76" y="41" text-anchor="middle" class="eb-diagram-sublabel">
        Ann's op
      </text>
      <text x="76" y="58" text-anchor="middle" class="eb-diagram-mono">
        base_version 4
      </text>

      <rect x="184" y="20" width="120" height="50" rx="10" class="eb-diagram-box" />
      <text x="244" y="41" text-anchor="middle" class="eb-diagram-sublabel">
        Agent's op
      </text>
      <text x="244" y="58" text-anchor="middle" class="eb-diagram-mono">
        base_version 4
      </text>

      <line
        x1="76"
        y1="70"
        x2="150"
        y2="118"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-stamp-card)"
      />
      <line
        x1="244"
        y1="70"
        x2="170"
        y2="118"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-stamp-card)"
      />

      <rect
        x="80"
        y="122"
        width="160"
        height="56"
        rx="10"
        class="eb-diagram-box-accent"
      />
      <text x="160" y="146" text-anchor="middle" class="eb-diagram-label-accent">
        op_id decides
      </text>
      <text x="160" y="164" text-anchor="middle" class="eb-diagram-sublabel">
        same answer, everywhere
      </text>
    </DiagramFrame>
  ) : (
    <DiagramFrame viewBox="0 0 700 620" label={label}>
      <defs>
        <marker
          id="arrow-stamp"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead" />
        </marker>
        <marker
          id="arrow-stamp-accent"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead-accent" />
        </marker>
      </defs>

      <rect x="40" y="20" width="270" height="120" rx="12" class="eb-diagram-box" />
      <text x="60" y="48" class="eb-diagram-label">
        Ann's operation
      </text>
      <text x="60" y="76" class="eb-diagram-mono">
        base_version: 4
      </text>
      <text x="60" y="98" class="eb-diagram-mono">
        actor: human:ann
      </text>
      <text x="60" y="120" class="eb-diagram-mono">
        op_id: a1b2c3
      </text>

      <rect x="390" y="20" width="270" height="120" rx="12" class="eb-diagram-box" />
      <text x="410" y="48" class="eb-diagram-label">
        The agent's operation
      </text>
      <text x="410" y="76" class="eb-diagram-mono">
        base_version: 4
      </text>
      <text x="410" y="98" class="eb-diagram-mono">
        actor: agent:turn-99
      </text>
      <text x="410" y="120" class="eb-diagram-mono-accent">
        op_id: d4e5f6
      </text>

      <line
        x1="200"
        y1="140"
        x2="300"
        y2="196"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-stamp)"
      />
      <line
        x1="500"
        y1="140"
        x2="400"
        y2="196"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-stamp)"
      />

      <rect
        x="210"
        y="200"
        width="280"
        height="90"
        rx="12"
        class="eb-diagram-box-accent"
      />
      <text x="350" y="228" text-anchor="middle" class="eb-diagram-label-accent">
        Compare, field by field
      </text>
      <text x="350" y="250" text-anchor="middle" class="eb-diagram-sublabel">
        base_version tied → actor tied →
      </text>
      <text x="350" y="270" text-anchor="middle" class="eb-diagram-sublabel">
        op_id breaks the tie
      </text>

      <line
        x1="350"
        y1="290"
        x2="350"
        y2="322"
        class="eb-diagram-arrow-accent"
        marker-end="url(#arrow-stamp-accent)"
      />

      <rect x="230" y="326" width="240" height="60" rx="12" class="eb-diagram-box" />
      <text x="350" y="352" text-anchor="middle" class="eb-diagram-label">
        d4e5f6 wins — width = 768
      </text>
      <text x="350" y="372" text-anchor="middle" class="eb-diagram-sublabel">
        a real conflict, resolved without asking anyone
      </text>

      <line
        x1="290"
        y1="386"
        x2="170"
        y2="440"
        class="eb-diagram-arrow-dashed"
        marker-end="url(#arrow-stamp)"
      />
      <line
        x1="410"
        y1="386"
        x2="530"
        y2="440"
        class="eb-diagram-arrow-dashed"
        marker-end="url(#arrow-stamp)"
      />

      <rect x="50" y="444" width="240" height="90" rx="12" class="eb-diagram-box" />
      <text x="170" y="472" text-anchor="middle" class="eb-diagram-label">
        Sydney
      </text>
      <text x="170" y="492" text-anchor="middle" class="eb-diagram-sublabel">
        sees Ann's op, then the agent's
      </text>
      <text x="170" y="512" text-anchor="middle" class="eb-diagram-mono-accent">
        result: 768
      </text>

      <rect x="410" y="444" width="240" height="90" rx="12" class="eb-diagram-box" />
      <text x="530" y="472" text-anchor="middle" class="eb-diagram-label">
        Berlin
      </text>
      <text x="530" y="492" text-anchor="middle" class="eb-diagram-sublabel">
        sees the agent's op, then Ann's
      </text>
      <text x="530" y="512" text-anchor="middle" class="eb-diagram-mono-accent">
        result: 768
      </text>

      <text x="350" y="580" text-anchor="middle" class="eb-diagram-caption">
        Different arrival order. Identical answer. No coordination.
      </text>
    </DiagramFrame>
  )
}
