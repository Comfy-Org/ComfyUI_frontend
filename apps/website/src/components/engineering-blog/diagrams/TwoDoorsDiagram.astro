---
import DiagramFrame from './DiagramFrame.astro'

interface Props {
  variant?: 'full' | 'card'
}

const { variant = 'full' } = Astro.props
const label =
  "Diagram: external agents reach Comfy's platform through the MCP server, an open protocol Comfy doesn't control the other end of, while Comfy's own in-app agent reaches the same platform through comfy-cli, a single binary that targets cloud or local with one flag and is backed by CQL, a query engine that type-checks the live node graph."
---

{
  variant === 'card' ? (
    <DiagramFrame viewBox="0 0 320 200" label={label} variant="card">
      <defs>
        <marker
          id="arrow-doors-card"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead" />
        </marker>
      </defs>
      <rect x="16" y="20" width="120" height="44" rx="9" class="eb-diagram-box" />
      <text x="76" y="46" text-anchor="middle" class="eb-diagram-sublabel">
        MCP
      </text>
      <rect x="184" y="20" width="120" height="44" rx="9" class="eb-diagram-box" />
      <text x="244" y="46" text-anchor="middle" class="eb-diagram-sublabel">
        comfy-cli
      </text>
      <line
        x1="76"
        y1="64"
        x2="130"
        y2="118"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors-card)"
      />
      <line
        x1="244"
        y1="64"
        x2="190"
        y2="118"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors-card)"
      />
      <rect
        x="90"
        y="122"
        width="140"
        height="56"
        rx="10"
        class="eb-diagram-box-accent"
      />
      <text x="160" y="155" text-anchor="middle" class="eb-diagram-label-accent">
        ComfyUI
      </text>
    </DiagramFrame>
  ) : (
    <DiagramFrame viewBox="0 0 700 620" label={label}>
      <defs>
        <marker
          id="arrow-doors"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead" />
        </marker>
        <marker
          id="arrow-doors-accent"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="eb-diagram-arrowhead-accent" />
        </marker>
      </defs>

      <rect x="40" y="20" width="280" height="70" rx="12" class="eb-diagram-box" />
      <text x="180" y="52" text-anchor="middle" class="eb-diagram-label">
        External agent
      </text>
      <text x="180" y="74" text-anchor="middle" class="eb-diagram-sublabel">
        Claude Code, Cursor, others
      </text>

      <rect x="380" y="20" width="280" height="70" rx="12" class="eb-diagram-box" />
      <text x="520" y="52" text-anchor="middle" class="eb-diagram-label">
        Comfy's in-app agent
      </text>
      <text x="520" y="74" text-anchor="middle" class="eb-diagram-sublabel">
        the one we control
      </text>

      <line
        x1="180"
        y1="90"
        x2="180"
        y2="132"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors)"
      />
      <line
        x1="520"
        y1="90"
        x2="520"
        y2="132"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors)"
      />

      <rect x="40" y="136" width="280" height="80" rx="12" class="eb-diagram-box" />
      <text x="180" y="168" text-anchor="middle" class="eb-diagram-label">
        MCP server
      </text>
      <text x="180" y="190" text-anchor="middle" class="eb-diagram-sublabel">
        cloud.comfy.org/mcp
      </text>
      <text x="180" y="206" text-anchor="middle" class="eb-diagram-sublabel">
        open protocol, no assumptions baked in
      </text>

      <rect
        x="380"
        y="136"
        width="280"
        height="80"
        rx="12"
        class="eb-diagram-box-accent"
      />
      <text x="520" y="168" text-anchor="middle" class="eb-diagram-label-accent">
        comfy-cli
      </text>
      <text x="520" y="190" text-anchor="middle" class="eb-diagram-sublabel">
        one binary, --where cloud | local
      </text>
      <text x="520" y="206" text-anchor="middle" class="eb-diagram-sublabel">
        three CI-enforced contracts
      </text>

      <line
        x1="520"
        y1="216"
        x2="520"
        y2="248"
        class="eb-diagram-arrow-accent"
        marker-end="url(#arrow-doors-accent)"
      />

      <rect x="420" y="252" width="200" height="60" rx="12" class="eb-diagram-box" />
      <text x="520" y="278" text-anchor="middle" class="eb-diagram-label">
        CQL
      </text>
      <text x="520" y="298" text-anchor="middle" class="eb-diagram-sublabel">
        type-checks the live node graph
      </text>

      <path
        d="M 180 216 C 180 280, 250 340, 340 370"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors)"
      />
      <path
        d="M 520 312 C 520 340, 460 355, 400 370"
        class="eb-diagram-arrow"
        marker-end="url(#arrow-doors)"
      />

      <rect
        x="200"
        y="374"
        width="300"
        height="80"
        rx="12"
        class="eb-diagram-box"
      />
      <text x="350" y="406" text-anchor="middle" class="eb-diagram-label">
        ComfyUI — cloud or local
      </text>
      <text x="350" y="428" text-anchor="middle" class="eb-diagram-sublabel">
        one platform, two doors, tested separately
      </text>

      <text x="350" y="510" text-anchor="middle" class="eb-diagram-caption">
        Neither door is the "real" one. They're built for different jobs.
      </text>
    </DiagramFrame>
  )
}
