---
import VideoPlayer from '../../common/VideoPlayer.vue'
import { DEFAULT_LOCALE, isLocale } from '../../../config/locales'

interface Props {
  src: string
  poster?: string
  caption?: string
}

const { src, poster, caption } = Astro.props
const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE
---

<figure class="my-8">
  <VideoPlayer src={src} poster={poster} locale={locale} client:visible />
  {caption && <figcaption class="mt-3 text-xs text-primary-comfy-canvas">
    {caption}
  </figcaption>}
</figure>
