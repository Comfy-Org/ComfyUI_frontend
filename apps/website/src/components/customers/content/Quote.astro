---
interface Props {
  name?: string
}

const { name } = Astro.props
---

<blockquote
  class="my-8 rounded-2xl border-l-4 border-primary-comfy-yellow bg-site-bg-soft p-8"
>
  <p class="text-lg/relaxed font-light text-primary-comfy-canvas italic">
    "<slot />"
  </p>
  {name && <p class="mt-4 text-sm font-semibold text-primary-comfy-yellow">
    {name}
  </p>}
</blockquote>
