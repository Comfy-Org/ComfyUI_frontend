---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

<ol class="mt-4 space-y-1 pl-1 text-sm [counter-reset:step]">
  {
    items.map((item) => (
      <li class="step-counter flex items-start gap-3 text-primary-comfy-canvas before:shrink-0 before:font-semibold before:text-primary-comfy-yellow before:tabular-nums">
        {item}
      </li>
    ))
  }
</ol>

<style>
  .step-counter {
    counter-increment: step;
  }

  .step-counter::before {
    content: counter(step, decimal-leading-zero);
  }
</style>
