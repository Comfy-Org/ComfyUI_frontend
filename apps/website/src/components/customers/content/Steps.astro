---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

<ol class="mt-4 space-y-1 pl-1 text-sm">
  {
    items.map((item, index) => (
      <li class="flex items-start gap-3 text-primary-comfy-canvas">
        <span
          aria-hidden="true"
          class="shrink-0 font-semibold text-primary-comfy-yellow tabular-nums"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
        {item}
      </li>
    ))
  }
</ol>
