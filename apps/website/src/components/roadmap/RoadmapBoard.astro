---
import { getCollection, render } from 'astro:content'

import { ROADMAP_AREA_ORDER } from '@/content/roadmap.schema'
import type { Locale } from '@/i18n/translations'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const { t } = Astro.locals

const entries = await getCollection('roadmap', (entry) =>
  entry.id.startsWith(`${locale}/`)
)

const sections = await Promise.all(
  ROADMAP_AREA_ORDER.map(async (area) => ({
    area,
    items: await Promise.all(
      entries
        .filter((entry) => entry.data.area === area)
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (entry) => ({
          id: entry.id,
          title: entry.data.title,
          stage: entry.data.stage,
          date: entry.data.date,
          Content: (await render(entry)).Content
        }))
    )
  }))
)

const populated = sections.filter(({ items }) => items.length > 0)

const chip =
  'rounded-full border px-2.5 py-1 text-2xs font-bold tracking-widest uppercase'
---

<section
  id="roadmap"
  class="mx-auto max-w-9xl px-4 pt-8 pb-16 lg:px-20 lg:pt-10 lg:pb-24"
>
  <div class="flex flex-col gap-12 lg:gap-16">
    {populated.map(({ area, items }) => <div
      class="flex flex-col gap-6 md:flex-row md:gap-16"
    >
      <h2
        class="shrink-0 text-xs font-bold tracking-widest text-primary-comfy-yellow uppercase md:w-56 md:pt-1"
      >
        {t(`roadmap.area.${area}`)}
      </h2>

      <ol class="flex min-w-0 flex-1 list-none flex-col gap-8">
        {items.map(({ id, title, stage, date, Content }) => <li class="min-w-0">
          <h3
            class="text-lg font-light wrap-break-word text-primary-comfy-canvas"
          >
            {title}
          </h3>

          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span
              class={`${chip} border-primary-comfy-yellow/30 text-primary-comfy-yellow`}
            >
              {t(`roadmap.stage.${stage}`)}
            </span>
            {date && <span
              class={`${chip} border-primary-comfy-canvas/20 text-primary-comfy-canvas/70`}
            >
              {date}
            </span>}
          </div>

          <div
            class="roadmap-entry mt-3 text-sm font-light wrap-break-word text-primary-comfy-canvas/70"
            data-entry={id}
          >
            <Content />
          </div>
        </li>)}
      </ol>
    </div>)}
  </div>
</section>

<style>
  .roadmap-entry :global(p) {
    margin: 0 0 0.75rem;
  }
  .roadmap-entry :global(p:last-child) {
    margin-bottom: 0;
  }
  .roadmap-entry :global(a) {
    color: var(--color-primary-comfy-yellow);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s;
  }
  .roadmap-entry :global(a:hover) {
    opacity: 0.7;
  }
</style>
