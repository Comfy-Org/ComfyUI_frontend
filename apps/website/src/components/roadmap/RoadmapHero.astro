---
import { externalLinks } from '@/config/routes'

const { t } = Astro.locals
---

<section class="mx-auto max-w-9xl px-4 pt-16 pb-8 lg:px-20 lg:pt-24 lg:pb-10">
  <div class="max-w-3xl">
    <span
      class="text-xs font-bold tracking-widest text-primary-comfy-yellow uppercase"
    >
      {t('roadmap.eyebrow')}
    </span>
    <h1
      class="mt-4 text-4xl/tight font-light text-balance text-primary-comfy-canvas lg:text-6xl/tight"
    >
      {t('roadmap.heading')}
    </h1>
    <p class="mt-6 text-base font-light text-primary-comfy-canvas/70">
      {t('roadmap.intro')}
    </p>
    <p class="mt-4 text-sm font-light text-primary-comfy-canvas/70">
      {t('roadmap.changelog.prompt')}{' '}
      <a
        class="text-primary-comfy-yellow underline underline-offset-2 transition-opacity hover:opacity-70"
        href={externalLinks.changelog}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('roadmap.changelog.linkLabel')}
      </a>
    </p>
  </div>
</section>
