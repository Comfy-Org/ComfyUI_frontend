---
const staff = Astro.locals.site
const local = Astro.locals.siteLocalAccess
const adminPage =
  Astro.url.pathname === '/admin' || Astro.url.pathname.startsWith('/admin/')
const t = Astro.locals.t
---

{!adminPage && (staff || local) && <a
  data-astro-reload
  href={staff ? '/admin/' : '/admin/local-access'}
  class="fixed right-6 bottom-6 z-40 flex h-10 items-center gap-2 rounded-lg border border-admin-line bg-admin-card px-4 font-admin text-sm text-admin-fg shadow-admin-popover transition-colors hover:bg-admin-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-admin-fg"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
  >
    <path d="M4 5h16v14H4zM9 5v14M12 9h5M12 13h5" />
  </svg>
  {t(staff ? 'cmsAdmin.title' : 'cmsAdmin.localReview')}
</a>}
