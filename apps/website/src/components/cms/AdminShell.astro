---
import { ExternalLink, FileStack, History, Inbox, Users } from '@lucide/vue'
import { cn } from '@comfyorg/tailwind-utils'
import StatusLabel from '@/components/cms/ui/StatusLabel.vue'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  current: 'draft' | 'content' | 'history' | 'testers'
  draftCount?: number
  contentCount?: number
}
const { current, draftCount, contentCount } = Astro.props
const session = Astro.locals.site
if (!session) return new Response('Not found', { status: 404 })
const t = Astro.locals.t
const latest = session.review.history.find(
  (event) => event.action === 'PUBLISH' || event.action === 'REVERT'
)
const links = [
  { key: 'draft', href: '/admin/', icon: Inbox, count: draftCount },
  {
    key: 'content',
    href: '/admin/content/',
    icon: FileStack,
    count: contentCount
  },
  { key: 'history', href: '/admin/history/', icon: History, count: undefined }
] as const
const item =
  'flex h-9 shrink-0 items-center gap-2 rounded-lg px-3 text-sm whitespace-nowrap text-admin-fg/80 transition-colors hover:bg-admin-hover hover:text-admin-fg focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-admin-fg [&_svg]:size-4 [&_svg]:shrink-0 [&_svg]:text-admin-muted'
---

<BaseLayout title={t('cmsAdmin.title')} bare noindex>
  <div
    class="grid min-h-screen grid-cols-[minmax(0,1fr)] bg-admin-page font-admin text-admin-fg lg:grid-cols-[15rem_minmax(0,1fr)]"
  >
    <aside
      class="flex flex-col gap-4 border-b border-admin-line bg-admin-chrome px-3 py-3 lg:sticky lg:top-0 lg:h-screen lg:border-r lg:border-b-0"
    >
      <p class="px-2 pt-1 text-sm font-medium text-admin-muted">
        {t('cmsAdmin.title')}
      </p>
      <nav
        aria-label={t('cmsAdmin.nav.label')}
        class="flex gap-1 overflow-x-auto lg:flex-col"
      >
        {links.map((link) => {
          const active = current === link.key
          return <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class={cn(
              item,
              active && 'bg-admin-line text-admin-fg [&_svg]:text-admin-fg'
            )}
          >
            <link.icon aria-hidden="true" />
            <span class="flex-1">{t(`cmsAdmin.nav.${link.key}`)}</span>
            {link.count !== undefined && <span
              class="text-xs text-admin-muted tabular-nums"
              >{link.count}</span
            >}
          </a>
        })}
        {Astro.locals.siteLocalAccess && !Astro.locals.siteDemo && (
          <>
            <p
              class="mt-4 hidden h-6 items-center px-3 text-xs font-medium tracking-[0.06em] text-admin-subtle uppercase lg:flex"
            >
              {t('cmsAdmin.nav.tools')}
            </p>
            <a
              href="/admin/testers"
              aria-current={current === 'testers' ? 'page' : undefined}
              class={cn(
                item,
                current === 'testers' &&
                  'bg-admin-line text-admin-fg [&_svg]:text-admin-fg'
              )}
            >
              <Users aria-hidden="true" />
              {t('cmsTesters.title')}
            </a>
          </>
        )}
      </nav>
      <div
        class="mt-auto hidden gap-1 rounded-lg border border-admin-line p-3 lg:grid"
      >
        {Astro.locals.siteDemo && (
          <StatusLabel tone="warning" label={t('cmsAdmin.demo')} />
        )}
        <StatusLabel
          tone="success"
          label={t('cmsAdmin.live', {
            revision: session.review.live.revision_id
          })}
        />
        {latest && <p class="text-xs text-admin-muted">
          {t('cmsAdmin.history.by', { actor: latest.actor_uid })}
        </p>}
        <a
          href="/hub/models/"
          target="_blank"
          rel="noopener"
          class="mt-1 inline-flex items-center gap-1.5 text-xs text-admin-muted hover:text-admin-fg"
        >
          {t('cmsAdmin.liveSite')}
          <ExternalLink class="size-3" aria-hidden="true" />
        </a>
      </div>
    </aside>
    <section class="min-w-0 px-4 py-6 sm:px-8 lg:py-8">
      <div class="max-w-10xl">
        <slot />
      </div>
    </section>
  </div>
</BaseLayout>
