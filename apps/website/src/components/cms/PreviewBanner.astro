---
import PreviewBar from '@/components/cms/PreviewBar.vue'
import { resolveLocale } from '@/config/locales'
import { buildQueue } from '@/lib/cms/queue'

const session = Astro.locals.site
const preview = session?.preview
const pagePath = Astro.url.pathname
  .replace(/^\/zh-CN(?=\/)/, '')
  .replace(/\/$/, '')
const pageItem = session?.review.draft.items.find(
  (item) => item.slug === pagePath
)
const adminPage =
  Astro.url.pathname === '/admin' || Astro.url.pathname.startsWith('/admin/')
const changes = session
  ? buildQueue(session.review, []).flatMap((item) =>
      item.source === 'catalog'
        ? [
            {
              id: item.id,
              title: item.title,
              change: item.change,
              slug: item.slug,
              visibleFrom: item.visibleFrom
            }
          ]
        : []
    )
  : []
---

{session && preview && !adminPage && (
  <PreviewBar
    client:load
    csrf={session.csrf}
    view={preview.view}
    editHref={pageItem ? `/admin/edit/${pageItem.uid}` : undefined}
    now={preview.now}
    changes={changes}
    pathname={Astro.url.pathname}
    locale={resolveLocale(Astro.currentLocale)}
  />
)}
