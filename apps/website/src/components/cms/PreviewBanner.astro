---
import PreviewBar from '@/components/cms/PreviewBar.vue'
import { resolveLocale } from '@/config/locales'
import { buildQueue } from '@/lib/cms/queue'

const session = Astro.locals.site
const preview = session?.preview
const changes = session
  ? buildQueue(session.review, []).flatMap((item) =>
      item.source === 'catalog'
        ? [
            {
              id: item.id,
              title: item.title,
              change: item.change,
              slug: item.slug,
              visibleFrom: item.visibleFrom
            }
          ]
        : []
    )
  : []
---

{session && preview?.view === 'DRAFT' && (
  <PreviewBar
    client:load
    csrf={session.csrf}
    now={preview.now}
    changes={changes}
    pathname={Astro.url.pathname}
    locale={resolveLocale(Astro.currentLocale)}
  />
)}
