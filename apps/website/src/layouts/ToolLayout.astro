---
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'
import GoogleTagManager from '../components/common/GoogleTagManager.astro'
import type { Locale } from '../i18n/translations'

/**
 * A full-window shell for standalone tools: no site header, footer or banner,
 * no smooth scroll. The tool draws its own top bar. Analytics stay because
 * the Workshop flags are answered by PostHog.
 */
interface Props {
  title: string
  description: string
  locale?: Locale
}

const { title, description, locale = 'en' } = Astro.props
---

<!doctype html>
<html lang={locale} class="ppformula-metric-fallback">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>

    <script is:inline>
      try {
        const probe = new FontFace('__ppformula_metric_probe', 'local(Arial)', {
          ascentOverride: '50%'
        })
        if (probe.ascentOverride === '50%')
          document.documentElement.classList.remove('ppformula-metric-fallback')
      } catch {
        // The class already present on <html> supplies the legacy fallback.
      }
    </script>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Bold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Semibold.woff2"
      crossorigin
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#211927" />

    <GoogleTagManager part="head" />
  </head>
  <body class="overflow-hidden bg-primary-comfy-ink antialiased">
    <GoogleTagManager part="noscript" />
    <div
      class="dark-theme h-svh w-screen bg-primary-comfy-ink font-formula text-primary-comfy-canvas"
    >
      <slot />
    </div>

    <Analytics />

    <script>
      import { capturePageview, initPostHog } from '../scripts/posthog'

      if (import.meta.env.PROD) {
        initPostHog()
        capturePageview()
      }
    </script>
  </body>
</html>
