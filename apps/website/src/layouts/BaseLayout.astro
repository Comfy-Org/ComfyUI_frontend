---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'
import SiteFooter from '../components/common/SiteFooter.vue'
import HeaderMain from '../components/common/HeaderMain/HeaderMain.vue'
import AnnouncementBanner from '../templates/drops/AnnouncementBanner.vue'
import { LOCALE_PREFIXES } from '../config/locales'
import { bannerConfig, getBannerData } from '../config/banner'
import { isNoindexPathname } from '../config/indexing'
import {
  canonicalPath,
  hreflangAlternates,
  ogLocale,
  ogLocaleAlternate
} from '../lib/hreflang'
import { markdownTwinPath } from '../lib/markdown-twin-path'
import { isHrefActive } from '../composables/useCurrentPath'
import {
  BANNER_DISMISS_ATTR,
  BANNER_STORAGE_KEY,
  createBannerVersion,
  evaluateBannerVisibility
} from '../utils/banner'
import { fetchGitHubStars, formatStarCount } from '../utils/github'
import { buildPageGraph, pageContext } from '../utils/jsonLd'
import type { Crumb, JsonLdNode, WebPageType } from '../utils/jsonLd'
import JsonLdGraph from '../components/common/JsonLdGraph.astro'

interface Props {
  title: string
  description?: string
  keywords?: string[]
  ogImage?: string
  noindex?: boolean
  pageType?: WebPageType
  breadcrumbs?: Crumb[]
  mainEntityId?: string
  extraJsonLd?: (JsonLdNode | null | undefined)[]
}

const {
  title,
  description = 'Comfy is the AI creation engine for visual professionals who demand control.',
  keywords,
  ogImage = 'https://media.comfy.org/website/comfy.webp',
  noindex = false,
  pageType,
  breadcrumbs,
  mainEntityId,
  extraJsonLd,
} = Astro.props

const keywordsContent = keywords && keywords.length > 0 ? keywords.join(', ') : undefined

// `originPathname`, not `url.pathname`: with i18n fallback rewrites, Astro
// reports the ENGLISH path it rendered FROM, while originPathname keeps the URL
// actually requested. Every locale-aware thing on the page — canonical, JSON-LD,
// breadcrumbs, hreflang — has to describe the page a reader asked for.
const { siteUrl, locale, url } = pageContext(
  Astro.site,
  Astro.originPathname,
  Astro.currentLocale,
)
// NOT `new URL(url)`. Once a locale is served by the i18n fallback, Astro
// reports the ENGLISH pathname during the render, so a canonical taken from it
// declares the English page the original. That is right for a held-back locale
// and catastrophic for a translated one: it would have told Google the English
// page is the original for every Chinese page on the site.
const canonicalURL = new URL(canonicalPath(new URL(url).pathname, locale), url)
const shouldNoindex =
  noindex || isNoindexPathname(Astro.originPathname)
const alternates = shouldNoindex
  ? []
  : // `locale` comes from Astro.currentLocale, which is the ONLY thing that
    // knows a rewritten fallback page is Japanese: Astro reports the English
    // pathname during that render.
    hreflangAlternates(canonicalURL.pathname, canonicalURL.origin, locale)
const openGraphLocale = ogLocale(locale)
const openGraphLocaleAlternate = ogLocaleAlternate(locale, alternates)
const ogImageURL = new URL(ogImage, Astro.site ?? 'https://comfy.org')
const rawStars = await fetchGitHubStars('Comfy-Org', 'ComfyUI')
const githubStars = rawStars ? formatStarCount(rawStars) : ''

// Announcement banner — build-time visibility gate + content-hash version key.
// A promo never advertises the page you are already on, so the banner is
// suppressed when its CTA points at the current path.
const bannerData = getBannerData(bannerConfig, locale)
const bannerVisible =
  evaluateBannerVisibility(bannerConfig, {
    currentLocale: locale,
    currentSection: 'sitewide',
    now: new Date(),
  }) && !isHrefActive(bannerData.link?.href ?? '', Astro.originPathname)
const bannerVersion = createBannerVersion(bannerData, locale)

const gtmId = 'GTM-NP9JM6K7'
const gtmEnabled = import.meta.env.PROD

const structuredData = shouldNoindex
  ? undefined
  : buildPageGraph(
      { siteUrl, locale },
      {
        // The canonical, not the path Astro reported. During a fallback render
        // that path is the ENGLISH one, so the graph claimed a Chinese page WAS
        // the English page: same @id, same url. Structured data has to agree
        // with the canonical tag or it describes a different page than the one
        // being served.
        url: canonicalURL.href,
        name: title,
        description,
        imageUrl: ogImageURL.href,
        type: pageType,
        crumbs: breadcrumbs,
        mainEntityId,
      },
      ...(extraJsonLd ?? []),
    )
---

<!doctype html>
{
  /* <html> must stay overflow: visible — body's overflow (incl. reka-ui's
     dialog scroll lock) only propagates to the viewport when the root is
     visible. The horizontal clip lives on <body>. */
}
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#211927" />
    <link rel="canonical" href={canonicalURL.href} />
    {
      !shouldNoindex && (
        <link
          rel="alternate"
          type="text/markdown"
          href={markdownTwinPath(canonicalURL.pathname)}
        />
      )
    }
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={openGraphLocale} />
    {
      openGraphLocaleAlternate && (
        <meta property="og:locale:alternate" content={openGraphLocaleAlternate} />
      )
    }
    <meta property="og:site_name" content="Comfy" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@comaboratory" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Structured Data -->
    {structuredData && <JsonLdGraph graph={structuredData} />}
    <slot name="head" />

    <!-- Google Tag Manager -->
    {gtmEnabled && (
      <script is:inline define:vars={{ gtmId }}>
        ;(function (w, d, s, l, i) {
          w[l] = w[l] || []
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : ''
          j.async = true
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
          f.parentNode.insertBefore(j, f)
        })(window, document, 'script', 'dataLayer', gtmId)
      </script>
    )}

    <ClientRouter />

    <!-- Chrome initializes a video's muted state from the `muted` attribute
         only during document parsing, not for the DOMParser-built pages the
         ClientRouter swaps in — re-assert it before paint or autoplaying
         videos come back with sound. -->
    <script>
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll('video').forEach((video) => {
          if (video.hasAttribute('muted')) video.muted = true
        })
      })
    </script>

    <!-- Hide an already-dismissed announcement banner before first paint (no flash/shift). -->
    {bannerVisible && (
      <script
        is:inline
        define:vars={{
          bannerVersion,
          storageKey: BANNER_STORAGE_KEY,
          dismissAttr: BANNER_DISMISS_ATTR
        }}
      >
        try {
          const dismissed = JSON.parse(localStorage.getItem(storageKey) || '{}')
          if (dismissed && dismissed[bannerVersion] === true) {
            document.documentElement.setAttribute(dismissAttr, '')
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body class="bg-primary-comfy-ink text-white font-formula antialiased overflow-x-clip">
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    {bannerVisible && (
      <AnnouncementBanner
        data={bannerData}
        version={bannerVersion}
        locale={locale}
        client:load
      />
    )}
    <HeaderMain locale={locale} github-stars={githubStars} client:load />
    <!-- Horizontal clip lives here (not on <html>, which must stay overflow:
         visible for reka-ui's dialog scroll lock). <body>'s clip does not
         contain overflow once <html> is visible, because the root propagates
         body overflow to the viewport; clipping <main> keeps the page from
         exceeding the viewport width. -->
    <main class="overflow-x-clip">
      <slot />
    </main>
    <SiteFooter locale={locale}
        alternates={alternates} client:load />

    <Analytics />
    {/*
      @vercel/analytics bakes `Astro.url.pathname` into the element and offers
      no prop to override it. With i18n fallback rewrites that path is the
      ENGLISH one, so every Chinese and Japanese pageview would be reported
      against the English URL and the localized sites would look like they had
      no traffic at all.

      Corrected through the element's own data attribute, which its constructor
      reads. Safe to do here: the vendor's script is `type="module"` and
      therefore deferred, while this classic inline script runs immediately, so
      the attribute is right before the element upgrades.

      The page's OWN url, not its canonical: a held-back Japanese page points its
      canonical at English, but its traffic is still Japanese traffic.
    */}
    <!--
      Crossing locales has to be a real page load.

      ClientRouter swaps the document without re-evaluating any module, and in
      production the browser deliberately loads only its own page's dictionary
      — an English reader never downloads Chinese. A client-side swap into
      another locale therefore leaves the incoming islands asking for a
      dictionary that was never fetched, and `t()` throws rather than render
      text the server did not. The page looks broken until a refresh, which is
      a full load and fetches the right one.

      This is not only the language switcher. `localizeHref` returns an
      unprefixed path for a route a locale does not publish, so an ordinary
      footer link from /zh-CN/about to /terms-of-service crosses locales too.
      Hence one listener rather than an attribute on links nobody can
      enumerate.

      `loader` is the documented override point for the loading phase.
    -->
    <script is:inline define:vars={{ localePrefixes: LOCALE_PREFIXES }}>
      document.addEventListener('astro:before-preparation', (event) => {
        const localeOf = (pathname) =>
          localePrefixes.find(
            (prefix) =>
              pathname === prefix || pathname.startsWith(prefix + '/')
          ) ?? ''
        if (localeOf(event.to.pathname) === localeOf(event.from.pathname)) {
          return
        }
        event.loader = async () => {
          window.location.assign(event.to.href)
          // The browser is leaving; never resolve, so nothing swaps first.
          await new Promise(() => {})
        }
      })
    </script>

    <script is:inline define:vars={{ analyticsPath: new URL(url).pathname }}>
      document
        .querySelector('vercel-analytics')
        ?.setAttribute('data-pathname', analyticsPath)
    </script>

    <script>
      import { initSmoothScroll, cancelScroll } from '../scripts/smoothScroll'
      import { ScrollTrigger } from '../scripts/gsapSetup'
      import { initPostHog, capturePageview } from '../scripts/posthog'
      import { reifyMediaElements } from '../scripts/reifyMediaElements'

      initSmoothScroll()

      if (import.meta.env.PROD) {
        initPostHog()
        document.addEventListener('astro:page-load', capturePageview)
      }

      document.addEventListener('astro:page-load', () => {
        ScrollTrigger.refresh()
      })

      document.addEventListener('astro:before-preparation', () => {
        cancelScroll()
      })

      // Synchronous, so it runs before island hydration touches the DOM.
      document.addEventListener('astro:after-swap', () => {
        reifyMediaElements(document.body)
      })
    </script>
  </body>
</html>
