---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import '@/styles/global.css'
import SiteFooter from '@/components/common/SiteFooter.vue'
import GoogleTagManager from '@/components/common/GoogleTagManager.astro'
import HeaderMain from '@/components/common/HeaderMain/HeaderMain.vue'
import AnnouncementBanner from '@/templates/drops/AnnouncementBanner.vue'
import { bannerConfig, getBannerData } from '@/config/banner'
import { getRoutes } from '@/config/routes'
import {
  headIndexing,
  isIndexableBuild,
  isNoindexPathname
} from '@/config/indexing'
import { isWorkshopInBuild } from '@/config/workshop-release'
import {
  hreflangAlternates,
  ogLocale,
  ogLocaleAlternates
} from '@/lib/hreflang'
import { markdownTwinPath } from '@/lib/markdown-twin-path'
import { isHrefActive } from '@/composables/useCurrentPath'
import {
  BANNER_DISMISS_ATTR,
  BANNER_STORAGE_KEY,
  createBannerVersion,
  evaluateBannerVisibility
} from '@/utils/banner'
import { fetchGitHubStars, formatStarCount } from '@/utils/github'
import {
  DEFAULT_OG_IMAGE,
  buildPageGraph,
  pageContext,
  webPageName
} from '@/utils/jsonLd'
import type { Crumb, JsonLdNode, WebPageType } from '@/utils/jsonLd'
import JsonLdGraph from '@/components/common/JsonLdGraph.astro'

type PPFormulaFace =
  'Light' | 'Regular' | 'Medium' | 'Semibold' | 'Bold' | 'NarrowSemibold'

interface Props {
  title: string
  pageName?: string
  description?: string
  keywords?: string[]
  ogImage?: string
  ogImageAlt?: string
  noindex?: boolean
  /** Set on a page that duplicates another address, e.g. an old model URL. */
  canonicalPath?: string
  pageType?: WebPageType
  breadcrumbs?: Crumb[]
  mainEntityId?: string
  extraJsonLd?: (JsonLdNode | null | undefined)[]
  minimal?: boolean
  hideAnnouncementBanner?: boolean
  /** PP Formula faces this page renders above the fold beyond the site-wide set. */
  preloadFonts?: readonly PPFormulaFace[]
}

const {
  title,
  pageName = webPageName(title),
  description = 'Comfy is the AI creation engine for visual professionals who demand control.',
  keywords,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = ogImage === DEFAULT_OG_IMAGE ? 'Comfy' : pageName,
  noindex = false,
  canonicalPath,
  pageType,
  breadcrumbs,
  mainEntityId,
  extraJsonLd,
  minimal = false,
  hideAnnouncementBanner = false,
  preloadFonts = []
} = Astro.props

const keywordsContent =
  keywords && keywords.length > 0 ? keywords.join(', ') : undefined

const { siteUrl, locale, url } = pageContext(
  Astro.site,
  canonicalPath ?? Astro.url.pathname,
  Astro.currentLocale
)
const canonicalURL = new URL(url)
const shouldNoindex = noindex || isNoindexPathname(Astro.url.pathname)
const head = headIndexing({
  pageNoindex: shouldNoindex,
  indexableBuild: isIndexableBuild()
})
const alternates = head.emitAlternates
  ? hreflangAlternates(canonicalURL.pathname, canonicalURL.origin)
  : []
const openGraphLocale = ogLocale(locale)
const openGraphLocaleAlternates = ogLocaleAlternates(locale, alternates)
const ogImageURL = new URL(ogImage, Astro.site ?? 'https://comfy.org')
const rawStars = await fetchGitHubStars('Comfy-Org', 'ComfyUI')
const githubStars = rawStars ? formatStarCount(rawStars) : ''

// Announcement banner — build-time visibility gate + content-hash version key.
// A promo never advertises the page you are already on, so the banner is
// suppressed when its CTA points at the current path.
const bannerData = getBannerData(bannerConfig, locale)
const bannerVisible =
  !hideAnnouncementBanner &&
  evaluateBannerVisibility(bannerConfig, {
    currentLocale: locale,
    currentSection: 'sitewide',
    now: new Date()
  }) &&
  !isHrefActive(bannerData.link?.href ?? '', Astro.url.pathname)
const bannerVersion = createBannerVersion(bannerData, locale)

const structuredData = head.emitStructuredData
  ? buildPageGraph(
      { siteUrl, locale },
      {
        url,
        name: pageName,
        description,
        imageUrl: ogImageURL.href,
        type: pageType,
        crumbs: breadcrumbs,
        mainEntityId
      },
      ...(extraJsonLd ?? [])
    )
  : undefined
---

<!doctype html>
{/* <html> must stay overflow: visible — body's overflow (incl. reka-ui's
     dialog scroll lock) only propagates to the viewport when the root is
     visible. The horizontal clip lives on <body>. */}
<html
  lang={locale}
  data-banner-version={bannerVisible ? bannerVersion : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    {head.robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#211927" />
    {head.emitCanonical && <link rel="canonical" href={canonicalURL.href} />}

    <!-- Every PP Formula face that renders above the fold. `font-display:
         optional` drops a face that misses its short block period for the
         whole page load, so an unpreloaded face silently renders as the
         fallback — which is what put a fallback headline into a committed
         visual baseline. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Light.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Bold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-Semibold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PPFormula-NarrowSemibold.woff2"
      crossorigin
    />
    {preloadFonts.map((face) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={`/fonts/PPFormula-${face}.woff2`}
        crossorigin
      />
    ))}
    {head.emitMarkdownTwinLink && (
      <link
        rel="alternate"
        type="text/markdown"
        href={markdownTwinPath(canonicalURL.pathname)}
      />
    )}
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    {ogImage === DEFAULT_OG_IMAGE && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={openGraphLocale} />
    {openGraphLocaleAlternates.map((alternate) => (
      <meta property="og:locale:alternate" content={alternate} />
    ))}
    <meta property="og:site_name" content="Comfy" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ComfyUI" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data -->
    {structuredData && <JsonLdGraph graph={structuredData} />}
    <slot name="head" />

    <GoogleTagManager part="head" />

    <ClientRouter />

    <!-- Chrome initializes a video's muted state from the `muted` attribute
         only during document parsing, not for the DOMParser-built pages the
         ClientRouter swaps in — re-assert it before paint or autoplaying
         videos come back with sound. -->
    <script>
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll('video').forEach((video) => {
          if (video.hasAttribute('muted')) video.muted = true
        })
      })
    </script>
    <!-- Hide an already-dismissed announcement banner before first paint (no flash/shift). -->
    {bannerVisible && <script
      is:inline
      define:vars={{
        bannerVersion,
        storageKey: BANNER_STORAGE_KEY,
        dismissAttr: BANNER_DISMISS_ATTR
      }}
    >
      try {
        const dismissed = JSON.parse(localStorage.getItem(storageKey) || '{}')
        if (dismissed && dismissed[bannerVersion] === true) {
          document.documentElement.setAttribute(dismissAttr, '')
        }
      } catch (e) {}
    </script>}
  </head>
  <body
    class="overflow-x-clip bg-primary-comfy-ink font-formula text-white antialiased"
  >
    <GoogleTagManager part="noscript" />

    {bannerVisible && !minimal && (
      <AnnouncementBanner
        data={bannerData}
        version={bannerVersion}
        locale={locale}
        client:load
      />
    )}
    {minimal ? (
      <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <a
          href={getRoutes(locale).home}
          class="inline-block"
          aria-label="Comfy"
        >
          <img src="/icons/logo.svg" alt="Comfy" class="h-9 w-auto" />
        </a>
      </div>
    ) : (
      <HeaderMain
        locale={locale}
        github-stars={githubStars}
        workshop-in-build={isWorkshopInBuild()}
        client:load
      />
    )}
    <!-- Horizontal clip lives here (not on <html>, which must stay overflow:
         visible for reka-ui's dialog scroll lock). <body>'s clip does not
         contain overflow once <html> is visible, because the root propagates
         body overflow to the viewport; clipping <main> keeps the page from
         exceeding the viewport width. -->
    <main class="overflow-x-clip">
      <slot />
    </main>
    {!minimal && (
      <SiteFooter locale={locale} client:visible={{ rootMargin: '200px' }} />
    )}

    <Analytics />

    <script>
      import { initSmoothScroll, cancelScroll } from '@/scripts/smoothScroll'
      import { ScrollTrigger } from '@/scripts/gsapSetup'
      import { initPostHog, capturePageview } from '@/scripts/posthog'
      import { reifyMediaElements } from '@/scripts/reifyMediaElements'
      import {
        BANNER_DISMISS_ATTR,
        BANNER_STORAGE_KEY,
        toClosedBanners
      } from '@/utils/banner'

      initSmoothScroll()

      if (import.meta.env.DEV) {
        void import('@/scripts/agentation').then(({ mountAgentation }) =>
          mountAgentation()
        )
      }

      if (import.meta.env.PROD) {
        initPostHog()
        document.addEventListener('astro:page-load', capturePageview)
      }

      document.addEventListener('astro:page-load', () => {
        ScrollTrigger.refresh()
      })

      document.addEventListener('astro:before-preparation', () => {
        cancelScroll()
      })

      document.addEventListener('astro:before-swap', ({ newDocument }) => {
        try {
          const closed = toClosedBanners(
            JSON.parse(localStorage.getItem(BANNER_STORAGE_KEY) || '{}')
          )
          const version = newDocument.documentElement.dataset.bannerVersion
          newDocument.documentElement.toggleAttribute(
            BANNER_DISMISS_ATTR,
            version !== undefined && closed[version] === true
          )
        } catch {}
      })

      // Synchronous, so it runs before island hydration touches the DOM.
      document.addEventListener('astro:after-swap', () => {
        reifyMediaElements(document.body)
      })
    </script>
  </body>
</html>
