+package middleware
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"testing"
+)
+
+func TestElevenLabsSoundGenerationTranslatesPublicModelForUpstream(t *testing.T) {
+	t.Parallel()
+
+	const route = "/proxy/elevenlabs/v1/sound-generation"
+	for _, tc := range []struct {
+		name   string
+		model  string
+		router bool
+	}{
+		{name: "direct proxy omitted"},
+		{name: "direct proxy null", model: `,"model_id":null`},
+		{name: "direct proxy alias", model: `,"model_id":"eleven_sfx_v2"`},
+		{name: "router omitted", router: true},
+		{name: "router alias", model: `,"model_id":"eleven_sfx_v2"`, router: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			body := []byte(`{"text":"a door creaking open","duration_seconds":2,"prompt_influence":0.4,"loop":true,"future_seed":9007199254740993` + tc.model + `}`)
+			if tc.router {
+				target, notFound := ResolveRouterModel("elevenlabs", "eleven_sfx_v2", nil)
+				if notFound != nil {
+					t.Fatal("public sound model no longer resolves")
+				}
+				var err *RouterBodyModelError
+				body, err = RouterBodyForTarget(target, body)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			cancelled, params, out := runElevenLabsRewrite(t, elevenLabsTestProvider().Endpoints()[route], http.MethodPost, route, string(body))
+			if cancelled != nil {
+				t.Fatalf("request refused: %v", cancelled)
+			}
+			if params["model"] != "eleven_sfx_v2" || params["duration"] != float64(2) {
+				t.Fatalf("billing identity or duration changed: %v", params)
+			}
+			if out.URL.Host != "api.elevenlabs.io" || out.URL.Path != "/v1/sound-generation" {
+				t.Fatalf("wrong upstream destination: %s", out.URL)
+			}
+			if out.Header.Get("xi-api-key") != "upstream-elevenlabs-key" {
+				t.Fatal("provider authentication was not applied")
+			}
+			encoded, err := io.ReadAll(out.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var got map[string]json.RawMessage
+			if err := json.Unmarshal(encoded, &got); err != nil {
+				t.Fatal(err)
+			}
+			for key, want := range map[string]string{
+				"model_id":         `"eleven_text_to_sound_v2"`,
+				"text":             `"a door creaking open"`,
+				"duration_seconds": "2",
+				"prompt_influence": "0.4",
+				"loop":             "true",
+				"future_seed":      "9007199254740993",
+			} {
+				if string(got[key]) != want {
+					t.Errorf("upstream %s = %s, want %s", key, got[key], want)
+				}
+			}
+			if out.ContentLength != int64(len(encoded)) || out.Header.Get("Content-Length") != strconv.Itoa(len(encoded)) {
+				t.Fatal("rewritten body's length metadata is stale")
+			}
+			if out.GetBody == nil {
+				t.Fatal("rewritten request has no repeatable body")
+			}
+			replay, err := out.GetBody()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer replay.Close()
+			replayed, err := io.ReadAll(replay)
+			if err != nil || string(replayed) != string(encoded) {
+				t.Fatal("repeated body differs from outbound body")
+			}
+		})
+	}
+}
+
+func TestElevenLabsSoundGenerationTranslationDoesNotAdmitAnotherModel(t *testing.T) {
+	t.Parallel()
+
+	const route = "/proxy/elevenlabs/v1/sound-generation"
+	for _, model := range []string{"eleven_v3", "eleven_text_to_sound_v2", "eleven_text_to_sound_v3", "unknown"} {
+		t.Run(model, func(t *testing.T) {
+			t.Parallel()
+			body := `{"text":"a door creaking open","duration_seconds":2,"model_id":"` + model + `"}`
+			cancelled, params, _ := runElevenLabsRewrite(t, elevenLabsTestProvider().Endpoints()[route], http.MethodPost, route, body)
+			if cancelled == nil || params != nil {
+				t.Fatalf("unpriced model was admitted: cancelled=%v params=%v", cancelled, params)
+			}
+		})
+	}
+}
