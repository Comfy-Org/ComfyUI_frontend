# Matches the Postgres service in docker-compose.yml (host port 5433 avoids
# clashing with a native Postgres on the default 5432). On Vercel this is the
# Supabase *session pooler* URI (port 5432 on *.pooler.supabase.com) — the
# direct db.<ref>.supabase.co host is IPv6-only and unreachable from Functions.
DATABASE_URL=postgres://payload:payload@localhost:5433/payload_cms

# Generate one with: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Dev admin account (create the first user in the admin UI)
PAYLOAD_ADMIN_EMAIL=dev@comfy.local
PAYLOAD_ADMIN_PASSWORD=changeme

# Media object storage (GCS). Leave GCS_BUCKET unset for local dev to keep media
# on the Next server's local disk (/api/media/file/...). Set all of these to
# serve media from the bucket behind the media.comfy.org CDN — uploads then land
# in the bucket and each media doc's url becomes an absolute CDN url.
# GCS_CREDENTIALS_JSON is a service-account key (object-admin on the bucket) as a
# single-line JSON string — keep it in .env / Vercel only, never commit it.
# GCS_BUCKET=comfy-org-videos
# GCS_PROJECT_ID=dreamboothy
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Object-key prefix + CDN url path for CMS-managed uploads (defaults shown).
# GCS_MEDIA_PREFIX=website/cms
# GCS_PUBLIC_BASE_URL=https://media.comfy.org

# Production website deploy hook (Vercel). POSTed by the admin "Rebuild site"
# button; keep it in .env / Vercel only, never commit it.
# WEBSITE_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Always-SSR website preview deployment. When set, draft-enabled collections get
# an admin "Preview" link pointing at it; unset disables the link.
# WEBSITE_PREVIEW_URL=https://preview.comfy.org

# Schema changes are applied by committed migrations (src/migrations), not by
# dev push — `push` only runs when NODE_ENV !== 'production'. After changing a
# collection, run `pnpm --filter @comfyorg/cms migrate:create <name>` against an
# *empty* database and commit the result; the Vercel build runs `payload migrate`
# before `next build`. Generate migrations with GCS_BUCKET set, so the media
# `prefix` column the storage plugin adds is included.
