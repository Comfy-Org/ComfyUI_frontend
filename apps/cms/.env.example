# Matches the Postgres service in docker-compose.yml (host port 5433 avoids
# clashing with a native Postgres on the default 5432)
DATABASE_URL=postgres://payload:payload@localhost:5433/payload_cms

# Generate one with: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Dev admin account (used by the seed in a later ticket; create the first user
# in the admin UI until then)
PAYLOAD_ADMIN_EMAIL=dev@comfy.local
PAYLOAD_ADMIN_PASSWORD=changeme

# Media object storage (GCS). Leave GCS_BUCKET unset for local dev to keep media
# on the Next server's local disk (/api/media/file/...). Set all of these to
# serve media from the bucket behind the media.comfy.org CDN — uploads then land
# in the bucket and each media doc's url becomes an absolute CDN url.
# GCS_CREDENTIALS_JSON is a service-account key (object-admin on the bucket) as a
# single-line JSON string — keep it in .env / Vercel only, never commit it.
GCS_BUCKET=comfy-org-videos
GCS_PROJECT_ID=dreamboothy
GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Object-key prefix + CDN url path for CMS-managed uploads (defaults shown).
GCS_MEDIA_PREFIX=website/cms
GCS_PUBLIC_BASE_URL=https://media.comfy.org
