+import { numericIdFromSeed } from "./digest.js";
+function isRecord(value) {
+    return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function collectGroups(graph) {
+    const groups = Array.isArray(graph["groups"]) ? graph["groups"].filter(isRecord) : [];
+    const definitions = graph["definitions"];
+    if (!isRecord(definitions) || !Array.isArray(definitions["subgraphs"]))
+        return groups;
+    return groups.concat(definitions["subgraphs"].filter(isRecord).flatMap(collectGroups));
+}
+export function normalizeLegacyWorkflowGroupIds(content) {
+    const normalized = structuredClone(content);
+    const groups = collectGroups(normalized);
+    const numericIds = new Set(groups.flatMap((group) => typeof group["id"] === "number" ? [group["id"]] : []));
+    const identities = new Map();
+    for (const group of groups) {
+        const id = group["id"];
+        if (typeof id !== "string" || id.length === 0)
+            continue;
+        const numericId = numericIdFromSeed(id);
+        const previousId = identities.get(numericId);
+        if (numericIds.has(numericId) || (previousId !== undefined && previousId !== id)) {
+            throw new Error("Cannot normalize legacy workflow group IDs: numeric identity collision");
+        }
+        identities.set(numericId, id);
+        group["id"] = numericId;
+    }
