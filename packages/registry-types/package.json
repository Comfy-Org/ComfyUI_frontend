{
  "name": "@comfyorg/registry-types",
  "version": "1.0.0",
  "description": "Comfy Registry API TypeScript types",
  "files": [
    "src",
    "dist-types/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@comfyorg/registry-types": "./src/comfyRegistryTypes.ts",
      "types": "./dist-types/comfyRegistryTypes.d.ts",
      "default": "./src/comfyRegistryTypes.ts"
    }
  },
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsx ../../scripts/vue-tsc-native.ts --noEmit",
    "build": "tsc -b tsconfig.declarations.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
