{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist-types",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/declarations.tsbuildinfo",
    "types": [],
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.stories.ts",
    "src/**/__fixtures__/**"
  ],
  "references": [
    {
      "path": "../object-info-parser/tsconfig.build.json"
    },
    {
      "path": "../registry-types/tsconfig.declarations.json"
    }
  ]
}
