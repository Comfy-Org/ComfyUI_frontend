    "tailwindcss": "^4.1.0",
    "vue": "^3.5.40",
    "vue-component-type-helpers": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@vueuse/core": {
      "optional": true
    },
    "@vueuse/integrations": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "vue": {
      "optional": true
