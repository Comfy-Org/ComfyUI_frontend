{
  "name": "@comfyorg/design-system",
  "version": "1.1.0",
  "description": "Shared design system for ComfyUI Frontend",
  "homepage": "https://comfy.org",
  "license": "MIT",
  "author": {
    "name": "Comfy Org",
    "email": "support@comfy.org",
    "url": "https://www.comfy.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comfy-Org/ComfyUI_frontend.git"
  },
  "files": [
    "dist",
    "src/css",
    "src/icons",
    "src/button.variants.ts",
    "src/select.variants.ts",
    "src/tag.variants.ts",
    "src/workspaceAvatar.ts",
    "dist-types/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    "./*": "./src/components/*.vue",
    "./lib/select/types": "./src/components/select/types.ts",
    "./lib/menu/menuStyles": "./src/components/menu/menuStyles.ts",
    "./lib/dialog/dialog.variants": "./src/components/dialog/dialog.variants.ts",
    "./lib/input-group/inputGroup.variants": "./src/components/input-group/inputGroup.variants.ts",
    "./lib/tooltip/tooltipConfig": "./src/components/tooltip/tooltipConfig.ts",
    "./components.css": "./dist/components.css",
    "./css/*": "./src/css/*",
    "./icons/*": "./src/icons/*",
    "./button.variants": {
      "types": "./dist-types/button.variants.d.ts",
      "default": "./src/button.variants.ts"
    },
    "./select.variants": {
      "types": "./dist-types/select.variants.d.ts",
      "default": "./src/select.variants.ts"
    },
    "./tag.variants": {
      "types": "./dist-types/tag.variants.d.ts",
      "default": "./src/tag.variants.ts"
    },
    "./workspaceAvatar": {
      "types": "./dist-types/workspaceAvatar.d.ts",
      "default": "./src/workspaceAvatar.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.vue.d.ts",
        "import": "./dist/*.vue.js"
      },
      "./lib/select/types": {
        "types": "./dist/select/types.d.ts",
        "import": "./dist/select/types.js"
      },
      "./lib/menu/menuStyles": {
        "types": "./dist/menu/menuStyles.d.ts",
        "import": "./dist/menu/menuStyles.js"
      },
      "./lib/dialog/dialog.variants": {
        "types": "./dist/dialog/dialog.variants.d.ts",
        "import": "./dist/dialog/dialog.variants.js"
      },
      "./lib/input-group/inputGroup.variants": {
        "types": "./dist/input-group/inputGroup.variants.d.ts",
        "import": "./dist/input-group/inputGroup.variants.js"
      },
      "./lib/tooltip/tooltipConfig": {
        "types": "./dist/tooltip/tooltipConfig.d.ts",
        "import": "./dist/tooltip/tooltipConfig.js"
      },
      "./components.css": "./dist/components.css",
      "./css/*": "./src/css/*",
      "./icons/*": "./src/icons/*",
      "./button.variants": {
        "types": "./dist-types/button.variants.d.ts",
        "default": "./src/button.variants.ts"
      },
      "./select.variants": {
        "types": "./dist-types/select.variants.d.ts",
        "default": "./src/select.variants.ts"
      },
      "./tag.variants": {
        "types": "./dist-types/tag.variants.d.ts",
        "default": "./src/tag.variants.ts"
      },
      "./workspaceAvatar": {
        "types": "./dist-types/workspaceAvatar.d.ts",
        "default": "./src/workspaceAvatar.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -b tsconfig.declarations.json",
    "prepack": "pnpm build",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "typecheck": "tsx ../../scripts/vue-tsc-native.ts --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@iconify/tools": "catalog:",
    "@iconify/utils": "catalog:",
    "@vueuse/core": "catalog:",
    "chart.js": "^4.5.0",
    "cva": "catalog:",
    "dompurify": "catalog:",
    "es-toolkit": "^1.39.9",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@comfyorg/tailwind-utils": "workspace:^",
    "@storybook/vue3-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "reka-ui": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-component-type-helpers": "catalog:"
  },
  "peerDependencies": {
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.40",
    "vue-component-type-helpers": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "reka-ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-component-type-helpers": {
      "optional": true
    }
  }
}
