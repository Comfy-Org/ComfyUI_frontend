{
  "name": "@comfyorg/account-ui",
  "version": "1.0.0-alpha.0",
  "description": "The view layer over the framework-free core of @comfyorg/account-core: Vue composables and components that present the shared operation lifecycle, payment projection, checkout and sign-in pieces without choosing a router or a window strategy. The checkout components are styled with the @comfyorg/design-system theme and primeicons: load the design-system CSS and primeicons.css, and add this package's dist to your Tailwind sources",
  "keywords": [],
  "homepage": "https://comfy.org",
  "license": "MIT",
  "author": {
    "name": "Comfy Org",
    "email": "support@comfy.org",
    "url": "https://www.comfy.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comfy-Org/ComfyUI_frontend.git",
    "directory": "packages/account-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*.vue": {
      "@comfyorg/account-ui": "./src/*.vue",
      "types": "./dist-types/*.vue.d.ts",
      "default": "./src/*.vue"
    },
    "#/*": {
      "@comfyorg/account-ui": "./src/*.ts",
      "types": "./dist-types/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    "./billing": {
      "types": "./dist-types/billing/index.d.ts",
      "default": "./src/billing/index.ts"
    },
    "./billing/stripe": {
      "types": "./dist-types/billing/stripe/index.d.ts",
      "default": "./src/billing/stripe/index.ts"
    },
    "./billing/checkout": {
      "types": "./dist-types/billing/checkout/index.d.ts",
      "default": "./src/billing/checkout/index.ts"
    },
    "./billing/catalog": {
      "types": "./dist-types/billing/catalog.d.ts",
      "default": "./src/billing/catalog.ts"
    },
    "./auth/PasswordRules": {
      "types": "./dist-types/auth/PasswordRules.vue.d.ts",
      "default": "./src/auth/PasswordRules.vue"
    },
    "./auth/SocialAuthButtons": {
      "types": "./dist-types/auth/SocialAuthButtons.vue.d.ts",
      "default": "./src/auth/SocialAuthButtons.vue"
    },
    "./auth/TurnstileWidget": {
      "types": "./dist-types/auth/TurnstileWidget.vue.d.ts",
      "default": "./src/auth/TurnstileWidget.vue"
    },
    "./auth/regionGate": {
      "types": "./dist-types/auth/regionGate.d.ts",
      "default": "./src/auth/regionGate.ts"
    },
    "./auth/regionProbe": {
      "types": "./dist-types/auth/regionProbe.d.ts",
      "default": "./src/auth/regionProbe.ts"
    },
    "./auth/turnstileGate": {
      "types": "./dist-types/auth/turnstileGate.d.ts",
      "default": "./src/auth/turnstileGate.ts"
    },
    "./auth/lifecycleScope": {
      "types": "./dist-types/auth/lifecycleScope.d.ts",
      "default": "./src/auth/lifecycleScope.ts"
    },
    "./auth/useGenerationGuard": {
      "types": "./dist-types/auth/useGenerationGuard.d.ts",
      "default": "./src/auth/useGenerationGuard.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./billing": {
        "types": "./dist/billing/index.d.ts",
        "import": "./dist/billing/index.js"
      },
      "./billing/stripe": {
        "types": "./dist/billing/stripe/index.d.ts",
        "import": "./dist/billing/stripe/index.js"
      },
      "./billing/checkout": {
        "types": "./dist/billing/checkout/index.d.ts",
        "import": "./dist/billing/checkout/index.js"
      },
      "./billing/catalog": {
        "types": "./dist/billing/catalog.d.ts",
        "import": "./dist/billing/catalog.js"
      },
      "./auth/PasswordRules": {
        "types": "./dist/auth/PasswordRules.d.ts",
        "import": "./dist/auth/PasswordRules.js"
      },
      "./auth/SocialAuthButtons": {
        "types": "./dist/auth/SocialAuthButtons.d.ts",
        "import": "./dist/auth/SocialAuthButtons.js"
      },
      "./auth/TurnstileWidget": {
        "types": "./dist/auth/TurnstileWidget.d.ts",
        "import": "./dist/auth/TurnstileWidget.js"
      },
      "./auth/regionGate": {
        "types": "./dist/auth/regionGate.d.ts",
        "import": "./dist/auth/regionGate.js"
      },
      "./auth/regionProbe": {
        "types": "./dist/auth/regionProbe.d.ts",
        "import": "./dist/auth/regionProbe.js"
      },
      "./auth/turnstileGate": {
        "types": "./dist/auth/turnstileGate.d.ts",
        "import": "./dist/auth/turnstileGate.js"
      },
      "./auth/lifecycleScope": {
        "types": "./dist/auth/lifecycleScope.d.ts",
        "import": "./dist/auth/lifecycleScope.js"
      },
      "./auth/useGenerationGuard": {
        "types": "./dist/auth/useGenerationGuard.d.ts",
        "import": "./dist/auth/useGenerationGuard.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "build": "pnpm run clean && vite build --logLevel error",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run build",
    "lint": "oxlint src --type-aware && eslint src",
    "test": "vitest run",
    "typecheck": "tsx ../../scripts/vue-tsc-native.ts --noEmit"
  },
  "dependencies": {
    "@comfyorg/account-core": "workspace:^"
  },
  "devDependencies": {
    "@comfyorg/design-system": "workspace:^",
    "@comfyorg/published-package-build": "workspace:*",
    "@comfyorg/tailwind-utils": "workspace:^",
    "@comfyorg/test-utils": "workspace:*",
    "@stripe/stripe-js": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vueuse/core": "catalog:",
    "happy-dom": "catalog:",
    "reka-ui": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@comfyorg/design-system": "^1.1.0",
    "@stripe/stripe-js": "^9.0.0",
    "@vueuse/core": "^14.4.0",
    "primeicons": "^7.0.0",
    "reka-ui": "^2.6.2",
    "vue": "^3.5.40"
  },
  "peerDependenciesMeta": {
    "@stripe/stripe-js": {
      "optional": true
    }
  }
}
