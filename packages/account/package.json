{
  "name": "@comfyorg/account",
  "version": "0.0.0-poc",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "guard": "bash scripts/verify-import-guard.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/account/src"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": ">=3.5 <4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
