  "scripts": {
    "build": "pnpm run clean && vue-tsc -p tsconfig.build.json && node --input-type=module -e \"import { copyFileSync, readdirSync, rmSync } from 'node:fs'; for (const name of readdirSync('src/vue')) { if (!name.endsWith('.vue')) continue; rmSync('dist/vue/' + name + '.js', { force: true }); copyFileSync('src/vue/' + name, 'dist/vue/' + name) }\"",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "lint": "oxlint src --type-aware && eslint src",
    "smoke:pack": "tsx scripts/smokePack.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit --project scripts/tsconfig.json"
  },
  "dependencies": {
    "@comfyorg/ingest-types": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/user-event": "catalog:",
