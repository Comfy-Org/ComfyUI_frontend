{
  "name": "@comfyorg/ingest-types",
  "version": "1.3.0",
  "description": "Comfy Cloud Ingest API TypeScript types and Zod schemas",
  "homepage": "https://comfy.org",
  "license": "MIT",
  "author": {
    "name": "Comfy Org",
    "email": "support@comfy.org",
    "url": "https://www.comfy.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comfy-Org/ComfyUI_frontend.git",
    "directory": "packages/ingest-types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./zod": {
      "types": "./dist-types/zod.gen.d.ts",
      "default": "./src/zod.gen.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./zod": {
        "types": "./dist/zod.gen.d.ts",
        "import": "./dist/zod.gen.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "build": "pnpm run clean && vite build --logLevel error",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run build",
    "generate": "openapi-ts",
    "typecheck": "tsx ../../scripts/vue-tsc-native.ts --noEmit"
  },
  "devDependencies": {
    "@comfyorg/published-package-build": "workspace:*",
    "@hey-api/openapi-ts": "0.97.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
