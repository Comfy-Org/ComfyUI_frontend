{
  "name": "@comfyorg/account-core",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Shared account layer: a framework-free session core that exchanges a signed-in identity for the workspace-scoped Cloud JWT with valid-on-read freshness, plus the package-owned Firebase identity entry. It has no view layer and no Vue dependency; the composables and unstyled components ship from @comfyorg/account-ui",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./boundedOperation": "./src/core/boundedOperation.ts",
    "./lazyIdentity": "./src/core/lazyIdentity.ts",
    "./session": "./src/core/session.ts",
    "./billing": "./src/core/billing/index.ts",
    "./firebase": "./src/firebase/index.ts",
    "./web": "./src/web/crossTabRefresh.ts",
    "./testing": "./src/testing.ts",
    "./customerRecovery": "./src/core/customerRecovery.ts",
    "./signInSchemas": "./src/signInSchemas.ts",
    "./turnstile": "./src/turnstile.ts",
    "./turnstileScript": "./src/turnstileScript.ts",
    "./firebaseAuthError": "./src/firebaseAuthError.ts",
    "./provisioning": "./src/provisioning.ts",
    "./redirect": "./src/redirect.ts",
    "./telemetry": "./src/telemetry.ts",
    "./webviewDetection": "./src/webviewDetection.ts"
  },
  "scripts": {
    "lint": "oxlint src --type-aware && eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@comfyorg/ingest-types": "workspace:*",
    "@comfyorg/shared-frontend-utils": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "firebase": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "firebase": "^11.6.0"
  }
}
