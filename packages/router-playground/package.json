{
  "name": "@comfyorg/router-playground",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "The Comfy Router playground engine behind comfy.org/models: reads a model's page contract, derives and validates its form, encodes files, builds the provider request, and reads the response. Shared so the Developer Platform runs the same models the same way.",
